@inject Localizer L
@using Kela.Web.Helpers
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
@functions
{
    static string LangLabel(string code) => code switch
    {
        "az" => "Azərbaycanca",
        "en" => "English",
        "ru" => "Русский",
        "tr" => "Türkçe",
        _ => code,
    };
}
<form method="post" asp-controller="Home" asp-action="Lang" class="inline-flex">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <select name="lang" class="select select-sm min-w-36" onchange="this.form.submit()" aria-label="Language">
        @foreach (var code in AppConstants.Langs)
        {
            <option value="@code" selected="@(code == L.Active)">@LangLabel(code)</option>
        }
    </select>
</form>

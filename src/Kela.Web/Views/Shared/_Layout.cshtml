@using System.Security.Claims
@using Kela.Web.Helpers
@using Microsoft.AspNetCore.Antiforgery
@inject Localizer L
@inject SiteConfigService SiteConfig
@inject IAntiforgery Antiforgery
@{
    Layout = null;
    await SiteConfig.LoadAsync();
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var home = AppConstants.HomeRouteFor(role);
    var fullName = User.Identity?.Name ?? "";
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = (parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "");
    if (initials.Length == 0) initials = "?";
    var roleKey = role switch
    {
        AppConstants.RoleTeacher => "role.Teacher",
        AppConstants.RoleStudent => "role.Student",
        AppConstants.RoleParent => "role.Parent",
        _ => "common.unknownRole",
    };
    var path = Context.Request.Path.Value ?? "";
    List<(string Label, string Url, string Icon)> navItems = role switch
    {
        AppConstants.RoleTeacher => [
            (L.T("nav.dashboard"), "/teacher/dashboard", "dashboard"),
            (L.T("nav.students"), "/teacher/students", "students"),
            (L.T("nav.workspaces"), "/teacher/workspaces", "folder"),
            (L.T("nav.attendance"), "/teacher/attendance", "calendar-check"),
            (L.T("nav.settings"), "/teacher/settings", "settings"),
        ],
        AppConstants.RoleStudent => [
            (L.T("nav.dashboard"), "/student/dashboard", "dashboard"),
            (L.T("nav.myCourses"), "/student/courses", "book"),
        ],
        AppConstants.RoleParent => [
            (L.T("nav.dashboard"), "/parent/dashboard", "dashboard"),
            (L.T("nav.myChildren"), "/parent/children", "classes"),
        ],
        _ => [],
    };

    string Active(string url) => string.Equals(path, url, StringComparison.OrdinalIgnoreCase)
        ? " bg-primary-50 text-primary font-semibold"
        : "";
}
<!DOCTYPE html>
<html lang="@L.Active">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - @SiteConfig.SiteName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-base-200">
    <header class="sticky top-0 z-50">
        <div class="navbar bg-base-100 shadow-sm">
            <div class="navbar-start">
                <div class="dropdown">
                    <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
                    </div>
                    <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
                        @foreach (var item in navItems)
                        {
                            <li>
                                <a class="@(Active(item.Url))" href="@item.Url">
                                    <app-icon name="@item.Icon" class="w-4 h-4" />
                                    <span>@item.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <a class="btn btn-ghost text-xl gap-2 px-2" href="@home">
                    <span class="flex size-8 items-center justify-center rounded-lg bg-primary text-white">
                        <app-icon name="book" class="w-5 h-5" />
                    </span>
                    <span class="font-bold">@SiteConfig.SiteName</span>
                </a>
            </div>
            <div class="navbar-center hidden lg:flex">
                <ul class="menu menu-horizontal px-1">
                    @foreach (var item in navItems)
                    {
                        <li>
                            <a class="@(Active(item.Url))" href="@item.Url">
                                <app-icon name="@item.Icon" class="w-4 h-4" />
                                <span>@item.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div class="navbar-end gap-2">
                @await Html.PartialAsync("_LanguageSwitcher")
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="btn btn-ghost gap-2">
                        <app-avatar initials="@initials" />
                        <span class="hidden md:inline">@fullName</span>
                        <app-icon name="chevron-down" class="w-3.5 h-3.5" />
                    </div>
                    <div tabindex="0" class="dropdown-content menu z-50 mt-3 w-52 rounded-box bg-base-100 p-2 shadow-xl">
                        <li><span class="badge badge-ghost w-full">@L.T(roleKey)</span></li>
                        <li>
                            <form method="post" asp-controller="Auth" asp-action="Logout" class="w-full" id="logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="flex w-full items-center gap-2 text-error">
                                    <app-icon name="logout" class="w-4 h-4" />
                                    <span>@L.T("nav.logout")</span>
                                </button>
                            </form>
                        </li>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="flex w-full flex-1 flex-col gap-6 p-4 md:p-6">
        @if (TempData["Success"] is string success)
        {
            <app-alert type="success" icon="check">@success</app-alert>
        }
        @if (TempData["Error"] is string error)
        {
            <app-alert type="error" icon="lock">@error</app-alert>
        }
        @RenderBody()
    </main>

    <footer class="p-4 text-center text-xs text-base-content/40">© @DateTime.Now.Year @SiteConfig.SiteName</footer>
    <script src="~/lib/external/axios/axios.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

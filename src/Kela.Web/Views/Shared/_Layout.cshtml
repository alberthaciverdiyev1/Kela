@using System.Security.Claims
@using Kela.Web.Helpers
@using Microsoft.AspNetCore.Antiforgery
@inject Localizer L
@inject SiteConfigService SiteConfig
@inject IAntiforgery Antiforgery
@{
    Layout = null;
    await SiteConfig.LoadAsync();
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var home = AppConstants.HomeRouteFor(role);
    var fullName = User.Identity?.Name ?? "";
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = (parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "");
    if (initials.Length == 0) initials = "?";
    var roleKey = role switch
    {
        AppConstants.RoleTeacher => "role.Teacher",
        AppConstants.RoleStudent => "role.Student",
        AppConstants.RoleParent => "role.Parent",
        _ => "common.unknownRole",
    };
    var path = Context.Request.Path.Value ?? "";
    List<(string Label, string Url, string Icon)> navItems = role switch
    {
        AppConstants.RoleTeacher => [
            (L.T("nav.dashboard"), "/teacher/dashboard", "dashboard"),
            (L.T("nav.students"), "/teacher/students", "students"),
            (L.T("nav.classes"), "/teacher/classes", "classes"),
            (L.T("nav.settings"), "/teacher/settings", "settings"),
        ],
        AppConstants.RoleStudent => [
            (L.T("nav.dashboard"), "/student/dashboard", "dashboard"),
            (L.T("nav.myCourses"), "/student/courses", "book"),
        ],
        AppConstants.RoleParent => [
            (L.T("nav.dashboard"), "/parent/dashboard", "dashboard"),
            (L.T("nav.myChildren"), "/parent/children", "classes"),
        ],
        _ => [],
    };

    string Active(string url) => string.Equals(path, url, StringComparison.OrdinalIgnoreCase)
        ? " bg-primary-50 text-primary font-semibold"
        : "";
}
<!DOCTYPE html>
<html lang="@L.Active">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - @SiteConfig.SiteName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-base-100">
    <header class="sticky top-0 z-50 border-b border-base-200 bg-base-100">
        <div class="mx-auto flex h-16 w-full max-w-6xl items-center gap-4 px-4">
            <a class="flex items-center gap-2.5" href="@home">
                <span class="flex size-9 items-center justify-center rounded-lg bg-primary text-white">
                    <app-icon name="book" class="w-5 h-5" />
                </span>
                <span class="text-xl font-bold text-base-content">@SiteConfig.SiteName</span>
            </a>
            <nav class="hidden items-center gap-1 md:flex">
                @foreach (var item in navItems)
                {
                    <a class="flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-medium text-base-content/60 hover:bg-base-200 hover:text-primary@(Active(item.Url))" href="@item.Url">
                        <app-icon name="@item.Icon" class="w-4 h-4" />
                        <span>@item.Label</span>
                    </a>
                }
            </nav>
            <div class="ml-auto flex items-center gap-2">
                @await Html.PartialAsync("_LanguageSwitcher")
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
                        <app-avatar initials="@initials" />
                        <span class="hidden md:inline">@fullName</span>
                        <app-icon name="chevron-down" class="w-3.5 h-3.5" />
                    </div>
                    <div tabindex="0" class="dropdown-content menu z-50 mt-2 w-52 rounded-box bg-base-100 p-2 shadow-xl">
                        <li><span class="badge w-full bg-primary/10 text-primary border-transparent">@L.T(roleKey)</span></li>
                        <li>
                            <form method="post" asp-controller="Auth" asp-action="Logout" class="w-full">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="flex w-full items-center gap-2 text-error">
                                    <app-icon name="logout" class="w-4 h-4" />
                                    <span>@L.T("nav.logout")</span>
                                </button>
                            </form>
                        </li>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 p-4 md:p-6">
        @if (TempData["Success"] is string success)
        {
            <app-alert type="success" icon="check">@success</app-alert>
        }
        @if (TempData["Error"] is string error)
        {
            <app-alert type="error" icon="lock">@error</app-alert>
        }
        @RenderBody()
    </main>

    <footer class="p-4 text-center text-xs text-base-content/40">© @DateTime.Now.Year @SiteConfig.SiteName</footer>
    <script src="~/lib/external/axios/axios.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using System.Security.Claims
@{
    var titleKey = ViewData["TitleKey"] as string ?? "comingSoon.title";
    ViewData["Title"] = L.T(titleKey);
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var home = AppConstants.HomeRouteFor(role);
}
<app-card center narrow>
    <div class="mx-auto mb-4 text-base-content/40">
        <app-icon name="book" class="w-8 h-8" />
    </div>
    <h1 class="text-xl font-semibold tracking-tight">@L.T(titleKey)</h1>
    <p class="text-base-content/60">@L.T("comingSoon.desc")</p>
    <app-btn href="@home" variant="secondary" icon="chevron-down" icon-class="-rotate-90">@L.T("comingSoon.back")</app-btn>
</app-card>

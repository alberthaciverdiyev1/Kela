@inject Localizer L
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@L.Active">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kela</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-base-200">
    <div class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-linear-to-br from-primary via-primary-400 to-primary-700 p-4">
        <div class="pointer-events-none absolute -left-32 -top-32 size-96 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-24 -right-16 size-72 rounded-full bg-white/10"></div>
        <div class="absolute right-4 top-4 z-10">
            @await Html.PartialAsync("_LanguageSwitcher")
        </div>
        <div class="relative z-10 w-full max-w-md">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/external/axios/axios.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

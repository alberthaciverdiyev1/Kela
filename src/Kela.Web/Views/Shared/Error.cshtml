@{
    ViewData["Title"] = "Hata";
    Layout = null;
}
<!DOCTYPE html>
<html lang="@L.Active">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kela</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen items-center justify-center bg-base-200 p-4">
    <div class="w-full max-w-md">
        <app-card center>
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-full bg-error/10 text-error">
                <app-icon name="lock" />
            </div>
            <h1 class="text-2xl font-bold">@L.T("common.error")</h1>
            <p class="text-base-content/60">@L.T("error.generic")</p>
            <app-btn href="/" variant="primary">@L.T("comingSoon.back")</app-btn>
        </app-card>
    </div>
</body>
</html>

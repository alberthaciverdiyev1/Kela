@{
    ViewData["Title"] = L.T("noAccess.title");
    Layout = null;
}
<!DOCTYPE html>
<html lang="@L.Active">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kela</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen items-center justify-center bg-base-200 p-4">
    <div class="w-full max-w-md">
        <app-card center>
            <div class="mx-auto mb-4 text-warning/60">
                <app-icon name="lock" class="w-8 h-8" />
            </div>
            <h1 class="text-xl font-semibold tracking-tight">@L.T("noAccess.title")</h1>
            <p class="text-base-content/60">@L.T("noAccess.desc1")</p>
            <p class="text-base-content/60">@L.T("noAccess.desc2")</p>
            <form method="post" asp-controller="Auth" asp-action="Logout">
                @Html.AntiForgeryToken()
                <app-btn type="submit" variant="primary" icon="logout">@L.T("nav.logout")</app-btn>
            </form>
        </app-card>
    </div>
    <script src="~/lib/external/axios/axios.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

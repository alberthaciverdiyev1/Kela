@model Kela.Web.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = L.T("auth.register");
    Layout = "_AuthLayout";
}
<div class="card overflow-hidden border border-base-200 bg-base-100">
    <div class="border-b border-base-200 px-6 py-6 text-center">
        <h1 class="text-xl font-semibold tracking-tight">@L.T("auth.register")</h1>
        <p class="mt-1 text-sm text-base-content/60">@L.T("auth.registerSubtitle")</p>
    </div>

    <div class="p-6">
        <form method="post" asp-action="Register" novalidate id="register-form">
            @Html.AntiForgeryToken()
            <div id="register-form-fields">
                @await Html.PartialAsync("_RegisterFields", Model)
            </div>
        </form>
    </div>

    <div class="border-t border-base-200 bg-base-100 px-6 py-4 text-center text-sm text-base-content/60">
        <span>@L.T("auth.haveAccount")</span>
        <a class="font-semibold text-primary" asp-controller="Auth" asp-action="Login">@L.T("auth.login")</a>
    </div>
</div>

@section Scripts {
    <script src="~/src/pages/auth.js" asp-append-version="true"></script>
}

@model Kela.Web.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = L.T("auth.register");
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <div class="auth-card-head">
        <div class="auth-card-icon">
            <app-icon name="sparkles" />
        </div>
        <h1 class="auth-card-title">@L.T("auth.register")</h1>
        <p class="auth-card-subtitle">@L.T("auth.registerSubtitle")</p>
    </div>

    <div class="auth-card-body">
        <form method="post" asp-action="Register" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <app-field for="FirstName" label="@L.T("auth.firstName")">
                <input asp-for="FirstName" class="input" autocomplete="given-name" placeholder="@L.T("auth.firstName")" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </app-field>

            <app-field for="LastName" label="@L.T("auth.lastName")">
                <input asp-for="LastName" class="input" autocomplete="family-name" placeholder="@L.T("auth.lastName")" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </app-field>

            <app-field for="Email" label="@L.T("auth.email")">
                <input asp-for="Email" class="input" autocomplete="email" inputmode="email" placeholder="@L.T("auth.email")" />
                <span asp-validation-for="Email" class="field-error"></span>
            </app-field>

            <app-field for="Password" label="@L.T("auth.password")">
                <input asp-for="Password" type="password" class="input" autocomplete="new-password" placeholder="@L.T("auth.password")" />
                <span asp-validation-for="Password" class="field-error"></span>
            </app-field>

            <app-field for="ConfirmPassword" label="@L.T("auth.passwordConfirm")">
                <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password" placeholder="@L.T("auth.passwordConfirm")" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </app-field>

            <app-btn type="submit" variant="primary" block>@L.T("auth.register")</app-btn>
        </form>
    </div>

    <div class="auth-card-footer">
        <span>@L.T("auth.haveAccount")</span>
        <a asp-controller="Auth" asp-action="Login">@L.T("auth.login")</a>
    </div>
</div>

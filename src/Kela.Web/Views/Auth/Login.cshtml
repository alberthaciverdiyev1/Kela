@model Kela.Web.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = L.T("auth.login");
    Layout = "_AuthLayout";
}
<div class="card overflow-hidden border border-base-200 bg-base-100">
    <div class="border-b border-base-200 px-6 py-6 text-center">
        <h1 class="text-xl font-semibold tracking-tight">@L.T("auth.login")</h1>
        <p class="mt-1 text-sm text-base-content/60">@L.T("auth.loginSubtitle")</p>
    </div>

    <div class="p-6">
        @if (TempData["Success"] is string success)
        {
            <app-alert type="success" icon="check">@success</app-alert>
        }

        <form method="post" asp-action="Login" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary mb-4 text-sm text-error"></div>

            <app-field for="Email" label="@L.T("auth.email")">
                <input asp-for="Email" class="input w-full" autocomplete="email" inputmode="email" placeholder="@L.T("auth.email")" />
                <span asp-validation-for="Email" class="field-error text-error text-xs mt-1"></span>
            </app-field>

            <app-field for="Password" label="@L.T("auth.password")">
                <input asp-for="Password" type="password" class="input w-full" autocomplete="current-password" placeholder="@L.T("auth.password")" />
                <span asp-validation-for="Password" class="field-error text-error text-xs mt-1"></span>
            </app-field>

            <app-btn type="submit" variant="primary" block>@L.T("auth.login")</app-btn>
        </form>
    </div>

    <div class="border-t border-base-200 bg-base-100 px-6 py-4 text-center text-sm text-base-content/60">
        <span>@L.T("auth.noAccount")</span>
        <a class="font-semibold text-primary" asp-controller="Auth" asp-action="Register">@L.T("auth.register")</a>
    </div>
</div>

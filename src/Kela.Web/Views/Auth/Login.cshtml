@model Kela.Web.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = L.T("auth.login");
    Layout = "_AuthLayout";
}
<div class="card overflow-hidden border border-base-200 bg-base-100">
    <div class="border-b border-base-200 px-6 py-6 text-center">
        <h1 class="text-xl font-semibold tracking-tight">@L.T("auth.login")</h1>
        <p class="mt-1 text-sm text-base-content/60">@L.T("auth.loginSubtitle")</p>
    </div>

    <div class="p-6">
        @if (TempData["Success"] is string success)
        {
            <app-alert type="success" icon="check">@success</app-alert>
        }

        <form method="post" asp-action="Login" novalidate id="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div id="login-form-fields">
                @await Html.PartialAsync("_LoginFields", Model)
            </div>
        </form>
    </div>

    <div class="border-t border-base-200 bg-base-100 px-6 py-4 text-center text-sm text-base-content/60">
        <span>@L.T("auth.noAccount")</span>
        <a class="font-semibold text-primary" asp-controller="Auth" asp-action="Register">@L.T("auth.register")</a>
    </div>
</div>

@section Scripts {
    <script src="~/src/pages/auth.js" asp-append-version="true"></script>
}

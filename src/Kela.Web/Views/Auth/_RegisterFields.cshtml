@model Kela.Web.Models.Auth.RegisterViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary mb-4 text-sm text-error"></div>

<app-field for="FirstName" label="@L.T("auth.firstName")">
    <input asp-for="FirstName" class="input w-full" autocomplete="given-name" placeholder="@L.T("auth.firstName")" />
    <span asp-validation-for="FirstName" class="field-error text-error text-xs mt-1"></span>
</app-field>

<app-field for="LastName" label="@L.T("auth.lastName")">
    <input asp-for="LastName" class="input w-full" autocomplete="family-name" placeholder="@L.T("auth.lastName")" />
    <span asp-validation-for="LastName" class="field-error text-error text-xs mt-1"></span>
</app-field>

<app-field for="Email" label="@L.T("auth.email")">
    <input asp-for="Email" class="input w-full" autocomplete="email" inputmode="email" placeholder="@L.T("auth.email")" />
    <span asp-validation-for="Email" class="field-error text-error text-xs mt-1"></span>
</app-field>

<app-field for="Password" label="@L.T("auth.password")">
    <input asp-for="Password" type="password" class="input w-full" autocomplete="new-password" placeholder="@L.T("auth.password")" />
    <span asp-validation-for="Password" class="field-error text-error text-xs mt-1"></span>
</app-field>

<app-field for="ConfirmPassword" label="@L.T("auth.passwordConfirm")">
    <input asp-for="ConfirmPassword" type="password" class="input w-full" autocomplete="new-password" placeholder="@L.T("auth.passwordConfirm")" />
    <span asp-validation-for="ConfirmPassword" class="field-error text-error text-xs mt-1"></span>
</app-field>

<app-btn type="submit" variant="primary" block>@L.T("auth.register")</app-btn>

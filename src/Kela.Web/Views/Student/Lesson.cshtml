@model Kela.Web.Models.Lessons.LessonEditorViewModel
@{
    Layout = "_Layout";
    var l = Model.Lesson;
    var apiBase = Model.VideoStreamUrl.Substring(0, Model.VideoStreamUrl.IndexOf("/api/lessons"));
}
<div class="flex flex-col gap-6">
    <app-page-head title="@l.Title" subtitle="@L.T("lessons.editorSubtitle")">
        <app-btn variant="secondary" icon="arrow-left" href="/student/dashboard">@L.T("common.back")</app-btn>
    </app-page-head>

    <div class="card overflow-hidden border border-base-200 bg-base-100">
        <video id="student-lesson-video" class="aspect-video w-full bg-black" controls playsinline
               poster="@(string.IsNullOrEmpty(l.ThumbnailPath) ? "" : apiBase + l.ThumbnailPath)"
               src="@Model.VideoStreamUrl"></video>
    </div>

    <app-card>
        <div class="flex items-center justify-between text-sm">
            <span class="text-base-content/60">@L.T("lessons.duration")</span>
            <span class="font-semibold">@FormatDuration(l.DurationSeconds)</span>
        </div>
    </app-card>
</div>

@functions {
    private static string FormatDuration(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:00}:{ts.Seconds:00}"
            : $"{ts.Minutes:00}:{ts.Seconds:00}";
    }
}

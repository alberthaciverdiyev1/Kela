@using System.Security.Claims
@{
    ViewData["Title"] = L.T("nav.dashboard");
    var name = User.Identity?.Name ?? "";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = (parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "");
    if (initials.Length == 0) initials = "?";
}
<div class="stack">
    <app-panel-head tone="success" initials="@initials" title="@L.T("panel.welcome", new { name })" chip="@L.T("role.Student")" />

    <div class="stat-grid">
        <app-stat icon="book" tone="primary" label="@L.T("nav.myCourses")" value="0" />
        <app-stat icon="check-circle" tone="success" label="@L.T("nav.attendance")" value="0" />
        <app-stat icon="star" tone="warning" label="@L.T("nav.grades")" value="0" />
    </div>

    <div class="card">
        <app-alert type="info">@L.T("student.info")</app-alert>
    </div>
</div>

@using System.Security.Claims
@{
    ViewData["Title"] = L.T("nav.dashboard");
    var name = User.Identity?.Name ?? "";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = (parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "");
    if (initials.Length == 0) initials = "?";
}
<div class="flex flex-col gap-6">
    <app-panel-head initials="@initials" title="@L.T("panel.welcome", new { name })" chip="@L.T("role.Admin")" />

    <div class="grid gap-4 sm:grid-cols-2">
        <app-card>
            <div class="flex items-center gap-4">
                <span class="flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <app-icon name="quiz" class="w-5 h-5" />
                </span>
                <div class="flex flex-1 flex-col items-start gap-1">
                    <h2 class="text-base font-bold">@L.T("questions.title")</h2>
                    <p class="text-sm text-base-content/60">@L.T("questions.subtitle")</p>
                </div>
                <app-btn variant="primary" icon="quiz" href="/admin/questions">@L.T("library.open")</app-btn>
            </div>
        </app-card>
    </div>

    <app-card>
        <app-alert type="info">@L.T("admin.info")</app-alert>
    </app-card>
</div>

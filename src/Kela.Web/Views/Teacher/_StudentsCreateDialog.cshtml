@model Kela.Web.Models.Students.CreateStudentViewModel
<app-modal id="create-student-dialog" icon="user-plus" title="@L.T("students.new")"
           form action="/teacher/students/create">
    <div id="create-form-fields">
        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
        <app-field for="FirstName" label="@L.T("students.field.firstName")" required="true">
            <input id="FirstName" name="FirstName" class="input" value="@Model?.FirstName" autocomplete="off"/>
            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "field-error" })
        </app-field>
        <app-field for="LastName" label="@L.T("students.field.lastName")">
            <input id="LastName" name="LastName" class="input" autocomplete="off" value="@Model?.LastName"/>
            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "field-error" })
        </app-field>
        <app-field for="PhoneNumber" label="@L.T("students.field.phone")" required="true">
            <input id="PhoneNumber" name="PhoneNumber" class="input" type="tel" autocomplete="tel"
                   value="@Model?.PhoneNumber"/>
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-error" })
        </app-field>
        <app-field for="Email" label="@L.T("students.field.email")">
            <input id="Email" name="Email" class="input" type="email" autocomplete="off" value="@Model?.Email"/>
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
        </app-field>
        <app-alert type="info">@L.T("students.info")</app-alert>
        <div class="modal-foot">
            <app-btn variant="secondary"
                     onclick="document.getElementById('create-student-dialog').close()">@L.T("common.cancel")</app-btn>
            <app-btn variant="primary" type="submit">@L.T("students.create")</app-btn>
        </div>
    </div>
</app-modal>

@model Kela.Web.Helpers.StudentCreatedResponse
<app-modal id="credentials-dialog" icon="check-circle" icon-success title="@L.T("students.createdTitle")">
    <app-alert type="success" icon="check">@L.T("students.createdMsg")</app-alert>
    <div class="rounded-xl border border-base-300 p-4">
        <div class="mb-2 text-xs text-base-content/60">@L.T("students.emailPassword")</div>
        <div class="flex items-center gap-2">
            <input id="credentials-text" class="input w-full font-mono text-sm" readonly value="@($"{Model.Email} | {Model.Password}")" />
            <app-btn icon-only variant="info" icon="copy" icon-class="w-4 h-4" id="credentials-copy" title="@L.T("students.copy")" onclick="copyCredentials()" />
        </div>
    </div>
    <app-alert type="warning" icon="lock">@L.T("students.passwordOnce")</app-alert>
    <div class="flex justify-end gap-2">
        <app-btn variant="primary" onclick="document.getElementById('credentials-dialog').close()">@L.T("common.confirm")</app-btn>
    </div>
</app-modal>

@model Kela.Web.Helpers.StudentCreatedResponse
<app-modal id="credentials-dialog" icon="check-circle" icon-success title="@L.T("students.createdTitle")">
    <app-alert type="success" icon="check">@L.T("students.createdMsg")</app-alert>
    <div class="creds-box">
        <div class="creds-label">@L.T("students.emailPassword")</div>
        <div class="creds-row">
            <input id="credentials-text" class="input creds-input" readonly value="@($"{Model.Email} | {Model.Password}")" />
            <app-btn icon-only variant="info" icon="copy" icon-class="icon-sm" id="credentials-copy" title="@L.T("students.copy")" onclick="copyCredentials()" />
        </div>
    </div>
    <app-alert type="warning" icon="lock">@L.T("students.passwordOnce")</app-alert>
    <div class="modal-foot">
        <app-btn variant="primary" onclick="document.getElementById('credentials-dialog').close()">@L.T("common.confirm")</app-btn>
    </div>
</app-modal>

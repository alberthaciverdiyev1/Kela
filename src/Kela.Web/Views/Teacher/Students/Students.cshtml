@{
    ViewData["Title"] = L.T("students.title");
}
<div class="flex flex-col gap-6">
    <app-page-head title="@L.T("students.title")" subtitle="@L.T("students.subtitle")">
        <app-btn variant="primary" icon="user-plus" onclick="document.getElementById('create-student-dialog').showModal()">@L.T("students.new")</app-btn>
    </app-page-head>

    <div class="flex">
        <label class="input flex w-full max-w-sm items-center gap-2">
            <app-icon name="search" class="w-4 h-4 opacity-40" />
            <input id="students-search" name="search" class="grow" type="search" placeholder="@L.T("nav.search")" autocomplete="off" />
        </label>
    </div>

    <div id="students-list" class="flex flex-col gap-6"></div>

    @await Html.PartialAsync("~/Views/Teacher/Students/_StudentsCreateDialog.cshtml", new Kela.Web.Models.Students.CreateStudentViewModel())

    <dialog id="credentials-dialog" class="modal"></dialog>
</div>

@section Scripts {
    <script src="~/lib/internal/pagination.js" asp-append-version="true"></script>
    <script src="~/src/pages/students.js" asp-append-version="true"></script>
}

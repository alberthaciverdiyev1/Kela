@model string
@{
    var p = Model;
}
<div class="field mb-0">
    <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-text">@L.T("questions.text")</label>
    <textarea id="@(p)-text" name="text" class="textarea w-full" rows="3"></textarea>
</div>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-option-a">A. @L.T("questions.option")</label>
        <input id="@(p)-option-a" name="optionA" class="input w-full" type="text" autocomplete="off" />
    </div>
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-option-b">B. @L.T("questions.option")</label>
        <input id="@(p)-option-b" name="optionB" class="input w-full" type="text" autocomplete="off" />
    </div>
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-option-c">C. @L.T("questions.option")</label>
        <input id="@(p)-option-c" name="optionC" class="input w-full" type="text" autocomplete="off" />
    </div>
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-option-d">D. @L.T("questions.optionOptional")</label>
        <input id="@(p)-option-d" name="optionD" class="input w-full" type="text" autocomplete="off" />
    </div>
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-option-e">E. @L.T("questions.optionOptional")</label>
        <input id="@(p)-option-e" name="optionE" class="input w-full" type="text" autocomplete="off" />
    </div>
    <div class="field mb-0">
        <label class="block text-sm font-semibold mb-1.5 text-base-content" for="@(p)-correct">@L.T("questions.correct")</label>
        <select id="@(p)-correct" name="correctOption" class="select w-full">
            <option value="0">A</option>
            <option value="1">B</option>
            <option value="2">C</option>
            <option value="3">D</option>
            <option value="4">E</option>
        </select>
    </div>
</div>

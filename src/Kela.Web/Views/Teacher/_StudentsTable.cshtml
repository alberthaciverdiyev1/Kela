@model Kela.Web.Models.Students.StudentsIndexViewModel
@{
    var search = Model.Search?.Trim();

    var filtered = string.IsNullOrEmpty(search)
        ? Model.Items
        : Model.Items.Where(s =>
            s.FirstName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.LastName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (s.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.PhoneNumber?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
}
<div id="students-list">
    <app-table
        empty="@(filtered.Count == 0)"
        empty-icon="students"
        empty-text="@L.T("students.empty")"
        columns="@(["students.col.firstName", "students.col.lastName", "students.col.phone", "students.col.email", "students.col.birthDate", "students.col.city"])"
        actions-column
        page="@Model.Page"
        total-pages="@Model.TotalPages"
        prev-text="@L.T("pager.prev")"
        next-text="@L.T("pager.next")">
        <tbody>
        @foreach (var s in filtered)
        {
            <tr>
                <td>@Display.Render(s.FirstName)</td>
                <td>@Display.Render(s.LastName)</td>
                <td>@Display.Render(s.PhoneNumber)</td>
                <td class="cell-email">@s.Email</td>
                <td>@Display.Render(s.BirthDate)</td>
                <td>@Display.Render(s.CityName)</td>
                <td class="col-actions">
                    <app-btn
                        icon-only
                        variant="danger"
                        icon="trash"
                        icon-class="icon-sm"
                        title="@L.T("students.delete")"
                        data-delete-id="@s.Id"
                        data-delete-url="/teacher/students/@s.Id/delete"
                        data-page="@Model.Page"
                        data-confirm="@L.T("students.deleteConfirm", new { name = $"{s.FirstName} {s.LastName}".Trim() })"/>
                </td>
            </tr>
        }
        </tbody>
    </app-table>
</div>

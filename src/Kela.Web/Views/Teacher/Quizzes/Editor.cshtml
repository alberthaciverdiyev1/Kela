@model Kela.Web.Models.Quizzes.QuizEditorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
}
<div id="quiz-editor" class="flex flex-col gap-6" data-content-id="@Model.ContentId">
    <app-page-head title="@Model.Title" subtitle="@L.T("quiz.editorSubtitle")">
        <div class="flex gap-2">
            <app-btn variant="secondary" icon="arrow-left" href="/teacher/library">@L.T("common.back")</app-btn>
            <app-btn variant="secondary" icon="plus" onclick="document.getElementById('quiz-new-question-dialog').showModal()">@L.T("quiz.newQuestion")</app-btn>
            <app-btn variant="primary" icon="copy" onclick="document.getElementById('quiz-add-question-dialog').showModal()">@L.T("quiz.addQuestion")</app-btn>
        </div>
    </app-page-head>

    <div id="quiz-questions-list" class="flex flex-col gap-3"></div>

    <app-modal id="quiz-add-question-dialog" title="@L.T("quiz.addQuestion")">
        <div class="flex flex-col gap-4">
            <label class="input flex items-center gap-2">
                <app-icon name="search" class="w-4 h-4 opacity-40" />
                <input id="quiz-add-search" type="search" class="grow" placeholder="@L.T("nav.search")" autocomplete="off" />
            </label>
            <ul id="quiz-add-list" class="menu menu-sm max-h-80 overflow-auto rounded-box border border-base-200 bg-base-100 p-0"></ul>
            <div class="flex justify-end gap-2">
                <app-btn variant="secondary" onclick="document.getElementById('quiz-add-question-dialog').close()">@L.T("common.cancel")</app-btn>
                <app-btn variant="primary" id="quiz-add-confirm">@L.T("quiz.addSelected")</app-btn>
            </div>
        </div>
    </app-modal>

    <app-modal id="quiz-new-question-dialog" title="@L.T("quiz.newQuestion")">
        <form id="quiz-new-question-form" class="flex flex-col gap-4" novalidate>
            @await Html.PartialAsync("~/Views/Teacher/Questions/_QuestionFields.cshtml", "quiz-new")
            <div class="flex justify-end gap-2">
                <app-btn variant="secondary" onclick="document.getElementById('quiz-new-question-dialog').close()">@L.T("common.cancel")</app-btn>
                <app-btn variant="primary" type="submit">@L.T("common.save")</app-btn>
            </div>
        </form>
    </app-modal>
</div>

@section Scripts {
    <script src="~/src/pages/quizEditor.js" asp-append-version="true"></script>
}

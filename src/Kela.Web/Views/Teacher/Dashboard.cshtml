@using System.Security.Claims
@{
    ViewData["Title"] = L.T("nav.dashboard");
    var name = User.Identity?.Name ?? "";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = (parts.Length > 0 ? parts[0][..1] : "") + (parts.Length > 1 ? parts[1][..1] : "");
    if (initials.Length == 0) initials = "?";
}
<div class="stack">
    <app-panel-head tone="primary" initials="@initials" title="@L.T("panel.welcome", new { name })" chip="@L.T("role.Teacher")" />

    <div class="stat-grid">
        <app-stat icon="classes" tone="primary" label="@L.T("nav.classes")" value="0" />
        <app-stat icon="students" tone="success" label="@L.T("nav.students")" value="0" />
        <app-stat icon="sparkles" tone="warning" label="@L.T("nav.homework")" value="0" />
    </div>

    <div class="card">
        <app-alert type="info">@L.T("teacher.info")</app-alert>
    </div>
</div>

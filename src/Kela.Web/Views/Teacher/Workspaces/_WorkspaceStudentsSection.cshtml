@model Kela.Web.Models.Workspaces.WorkspaceDetailViewModel
<div id="workspace-students-section" class="flex flex-col gap-6">
    <div class="card overflow-hidden border border-base-200 bg-base-100">
        <div class="flex items-center justify-between border-b border-base-200 px-5 py-4">
            <h2 class="text-base font-bold">@L.T("workspaces.detail.students")</h2>
            <span class="badge badge-ghost">@Model.Workspace.StudentCount</span>
        </div>
        @if (Model.Workspace.Students.Count == 0)
        {
            <div class="flex flex-col items-center gap-2 px-5 py-10 text-center">
                <span class="text-base-300"><app-icon name="students" class="w-10 h-10"/></span>
                <p class="text-sm text-base-content/50">@L.T("workspaces.detail.emptyStudents")</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="whitespace-nowrap bg-base-200/50 text-xs font-semibold uppercase tracking-wider text-base-content/50">@L.T("students.col.firstName")</th>
                            <th class="whitespace-nowrap bg-base-200/50 text-xs font-semibold uppercase tracking-wider text-base-content/50">@L.T("students.col.email")</th>
                            <th class="w-1 whitespace-nowrap bg-base-200/50 text-right"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.Workspace.Students)
                    {
                        <tr>
                            <td>@($"{s.FirstName} {s.LastName}".Trim())</td>
                            <td class="text-base-content/60">@s.Email</td>
                            <td class="w-1 whitespace-nowrap text-right">
                                <app-btn icon-only variant="danger" icon="user-minus"
                                         icon-class="w-4 h-4"
                                         title="@L.T("workspaces.detail.remove")"
                                         data-remove-student="@s.Id"
                                         data-workspace-id="@Model.Workspace.Id"/>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card border border-base-200 bg-base-100">
        <div class="border-b border-base-200 px-5 py-4">
            <h2 class="text-base font-bold">@L.T("workspaces.detail.addStudents")</h2>
        </div>
        <div class="px-5 py-4">
            @if (Model.AvailableStudents.Count == 0)
            {
                <p class="text-sm text-base-content/50">@L.T("workspaces.detail.noAvailable")</p>
            }
            else
            {
                <form id="add-students-form" method="post" action="/teacher/workspaces/@Model.Workspace.Id/students" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        @foreach (var s in Model.AvailableStudents)
                        {
                            <label class="flex items-center gap-3 rounded-box border border-base-200 px-3 py-2.5">
                                <input type="checkbox" name="studentIds" value="@s.UserId" class="checkbox checkbox-sm"/>
                                <span class="text-sm">@($"{s.FirstName} {s.LastName}".Trim())</span>
                            </label>
                        }
                    </div>
                    <div class="mt-4 flex justify-end">
                        <app-btn variant="primary" type="submit" icon="user-plus">@L.T("workspaces.detail.add")</app-btn>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

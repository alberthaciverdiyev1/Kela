@model Kela.Web.Models.Workspaces.WorkspaceShellViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
}
<div class="flex flex-col gap-6">
    <app-page-head title="@Model.Name"
                   subtitle="@L.T("workspaces.detail.studentCountSubtitle", new { count = Model.StudentCount })">
        <div class="flex gap-2">
            <app-btn variant="secondary" icon="arrow-left" href="/teacher/workspaces">@L.T("common.back")</app-btn>
            <app-btn variant="secondary" icon="calendar-check"
                     href="/teacher/attendance?workspaceId=@Model.Id">@L.T("attendance.title")</app-btn>
            <app-btn variant="primary" icon="edit"
                     onclick="document.getElementById('rename-workspace-dialog').showModal()">@L.T("workspaces.rename")</app-btn>
        </div>
    </app-page-head>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <app-stat id="stat-student-count" icon="user-plus" label="@L.T("workspaces.detail.studentCount")" value="@Model.StudentCount.ToString()"/>
        <app-stat id="stat-created" icon="calendar" tone="info" label="@L.T("workspaces.detail.created")"
                  value="@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")"/>
    </div>

    <div class="card overflow-hidden border border-base-200 bg-base-100">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-200 px-5 py-4">
            <h2 class="text-base font-bold">@L.T("workspaces.detail.files")</h2>
            <div class="flex flex-wrap gap-2">
                <app-btn variant="secondary" icon="folder-plus" onclick="document.getElementById('ws-folder-dialog').showModal()">@L.T("library.newFolder")</app-btn>
                <app-btn variant="secondary" icon="copy" onclick="document.getElementById('ws-copy-dialog').showModal()">@L.T("library.copyFolder")</app-btn>
                <app-btn variant="primary" icon="plus" onclick="document.getElementById('ws-add-content-dialog').showModal()">@L.T("library.addContent")</app-btn>
            </div>
        </div>
        <nav id="workspace-breadcrumb" class="flex flex-wrap items-center gap-1 px-5 pt-4 text-sm"></nav>
        <div id="workspace-files" data-workspace-id="@Model.Id" class="px-5 py-4"></div>
    </div>

    <div id="workspace-students-section" data-workspace-id="@Model.Id" class="flex flex-col gap-6"></div>

    <app-modal id="rename-workspace-dialog" title="@L.T("workspaces.rename.title")"
               form action="/teacher/workspaces/@Model.Id/rename">
        <div id="rename-form-fields">
            @await Html.PartialAsync("~/Views/Teacher/Workspaces/_WorkspaceRenameFields.cshtml", new Kela.Web.Models.Workspaces.CreateWorkspaceViewModel())
        </div>
    </app-modal>
</div>

<app-modal id="ws-folder-dialog" title="@L.T("library.newFolder")">
    <form id="ws-folder-form" class="flex flex-col gap-4" novalidate>
        <div class="field mb-0">
            <label class="block text-sm font-semibold mb-1.5 text-base-content" for="ws-folder-name">@L.T("library.folderName")</label>
            <input id="ws-folder-name" name="name" class="input w-full" type="text" autocomplete="off" />
        </div>
        <div class="flex justify-end gap-2">
            <app-btn variant="secondary" onclick="document.getElementById('ws-folder-dialog').close()">@L.T("common.cancel")</app-btn>
            <app-btn variant="primary" type="submit">@L.T("common.save")</app-btn>
        </div>
    </form>
</app-modal>

<app-modal id="ws-add-content-dialog" title="@L.T("library.addContent")">
    <div class="flex flex-col gap-4">
        <label class="input flex items-center gap-2">
            <app-icon name="search" class="w-4 h-4 opacity-40" />
            <input id="ws-add-content-search" type="search" class="grow" placeholder="@L.T("nav.search")" autocomplete="off" />
        </label>
        <ul id="ws-add-content-list" class="menu menu-sm max-h-80 overflow-auto rounded-box border border-base-200 bg-base-100 p-0"></ul>
        <div class="flex justify-end gap-2">
            <app-btn variant="secondary" onclick="document.getElementById('ws-add-content-dialog').close()">@L.T("common.cancel")</app-btn>
            <app-btn variant="primary" id="ws-add-content-confirm">@L.T("library.add")</app-btn>
        </div>
    </div>
</app-modal>

<app-modal id="ws-copy-dialog" title="@L.T("library.copyFolder")">
    <div class="flex flex-col gap-4">
        <label class="input flex items-center gap-2">
            <app-icon name="search" class="w-4 h-4 opacity-40" />
            <input id="ws-copy-search" type="search" class="grow" placeholder="@L.T("nav.search")" autocomplete="off" />
        </label>
        <ul id="ws-copy-list" class="menu menu-sm max-h-80 overflow-auto rounded-box border border-base-200 bg-base-100 p-0"></ul>
        <div class="flex justify-end gap-2">
            <app-btn variant="secondary" onclick="document.getElementById('ws-copy-dialog').close()">@L.T("common.cancel")</app-btn>
            <app-btn variant="primary" id="ws-copy-confirm">@L.T("library.copy")</app-btn>
        </div>
    </div>
</app-modal>

<div id="file-manager-modals"></div>

@section Scripts {
    <script src="~/src/fileManager.js" asp-append-version="true"></script>
    <script src="~/src/pages/workspaceFiles.js" asp-append-version="true"></script>
    <script src="~/src/pages/workspaces.js" asp-append-version="true"></script>
}

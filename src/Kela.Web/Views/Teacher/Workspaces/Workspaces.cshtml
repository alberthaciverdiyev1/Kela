@{
    Layout = "_Layout";
    ViewData["Title"] = L.T("workspaces.title");
}
<div class="flex flex-col gap-6">
    <app-page-head title="@L.T("workspaces.title")" subtitle="@L.T("workspaces.subtitle")">
        <app-btn variant="primary" icon="plus" onclick="document.getElementById('create-workspace-dialog').showModal()">@L.T("workspaces.new")</app-btn>
    </app-page-head>

    <div class="flex">
        <label class="input flex w-full max-w-sm items-center gap-2">
            <app-icon name="search" class="w-4 h-4 opacity-40" />
            <input id="workspaces-search" name="search" class="grow" type="search" placeholder="@L.T("nav.search")" autocomplete="off" />
        </label>
    </div>

    <div id="workspaces-list" class="flex flex-col gap-6"></div>

    @await Html.PartialAsync("~/Views/Teacher/Workspaces/_WorkspaceCreateDialog.cshtml", new Kela.Web.Models.Workspaces.CreateWorkspaceViewModel())
</div>

@section Scripts {
    <script src="~/lib/internal/pagination.js" asp-append-version="true"></script>
    <script src="~/src/pages/workspaces.js" asp-append-version="true"></script>
}

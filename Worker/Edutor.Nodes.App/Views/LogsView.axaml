<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Edutor.Nodes.App.Views.LogsView">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="Jurnallar" Classes="h1" />
      <TextBox Grid.Column="1" Width="240" Watermark="Axtar" Text="{Binding Filter}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Classes="ghost" Content="Təmizlə" Click="OnClear" />
    </Grid>

    <Border Classes="card" Padding="10">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Line}" FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="11.5" TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>

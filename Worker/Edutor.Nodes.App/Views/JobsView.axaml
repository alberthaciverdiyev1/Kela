<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Edutor.Nodes.App.Views.JobsView">

  <StackPanel Spacing="16">
    <TextBlock Text="Tapşırıqlar" Classes="h1" />

    <TextBox Watermark="Filtrlə (resolution və ya ID)" Text="{Binding Filter}" />

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="İcra olunanlar" Classes="label" />

        <ItemsControl ItemsSource="{Binding Active}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="60,60,110,110,*,70,80" Margin="0,5">
                <TextBlock Grid.Column="0" Text="{Binding JobId, StringFormat='#{0}'}" Classes="value" />
                <TextBlock Grid.Column="1" Text="{Binding Resolution}" Classes="value" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Lane}" Classes="value" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding SourceName}" Classes="value" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                  <ProgressBar Width="160" Height="6" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Progress, StringFormat='{}{0:P0}'}" Classes="value" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding Fps, StringFormat='{}{0:0.#} fps'}" Classes="value" />
                <Button Grid.Column="6" Classes="ghost" Content="Ləğv et"
                        Click="OnCancel" Tag="{Binding JobId}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Hazırda iş yoxdur" Classes="label" IsVisible="{Binding !HasActive}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Bitmiş işlər" Classes="label" />

        <ItemsControl ItemsSource="{Binding Finished}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="80,90,110,90,*" Margin="0,4">
                <TextBlock Grid.Column="0" Text="{Binding JobId, StringFormat='#{0}'}" Classes="value" />
                <TextBlock Grid.Column="1" Text="{Binding Resolution}" Classes="value" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Success}" Classes="value" />
                <TextBlock Grid.Column="3" Text="{Binding DurationSeconds, StringFormat='{}{0:0}s'}" Classes="value" />
                <TextBlock Grid.Column="4" Text="{Binding Error}" Classes="value" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

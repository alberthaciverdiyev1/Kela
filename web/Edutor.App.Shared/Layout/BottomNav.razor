@using Edutor.App.Shared.Services.Localization
@implements IDisposable
@inject NavigationManager Nav
@inject Localizer L

<nav class="fixed bottom-0 left-1/2 z-20 flex h-[72px] w-full max-w-[430px] -translate-x-1/2 items-center justify-around border-t border-brand-104 bg-white/95 px-3 backdrop-blur md:hidden">
    <BottomItem Href="/" Label="@L["Nav_Home"]" IconName="dashboard" MatchAll="true" />
    <BottomItem Href="/groups" Label="@L["Nav_Groups"]" IconName="book" />
    <BottomItem Href="/exams" Label="@L["Nav_Exam"]" IconName="file" />
    <BottomItem Href="/homeworks" Label="@L["Nav_Homeworks"]" IconName="clipboard-check" />
    <BottomItem Href="/notifications" Label="@L["Nav_Notifications"]" IconName="bell" />
    <button type="button" @onclick="() => _moreOpen = true"
            class="flex min-w-0 flex-1 flex-col items-center gap-1 text-center text-[10px] font-semibold @(MoreActive ? "text-brand-671" : "text-sage-369")">
        <Icon Name="sliders" Class="size-5" />
        <span class="w-full truncate">@L["Nav_More"]</span>
    </button>
</nav>

<MoreMenu Sheet="true" Open="_moreOpen" OnClose="() => _moreOpen = false" />

@code {
    private bool _moreOpen;

    private static readonly string[] MorePaths =
        ["/profile", "/notes", "/attendance", "/payments", "/results", "/notifications", "/contact"];

    private bool MoreActive => MorePaths.Any(p =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/').Equals(p.TrimStart('/'), StringComparison.OrdinalIgnoreCase));

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _moreOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        L.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

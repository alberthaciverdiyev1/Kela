@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject ApiClient ApiClient
@inject AppApi Api
@inject TokenStore Store
@inject IScreenGuard ScreenGuard
@inject PushTokenService Push

@using Edutor.App.Shared.Services.Localization
@inject Localizer Lang

@if (!_ready)
{
    <Loader/>
}
else if (!Auth.IsAuthenticated)
{
    <Login InviteToken="@_inviteToken"/>
}
else
{
    <div class="min-h-screen bg-brand-102 text-brand-836">
        <TopNav/>
        <div class="mx-auto min-h-screen w-full max-w-[430px] overflow-x-hidden bg-brand-022 shadow-[0_0_60px_rgba(23,77,58,0.12)] md:max-w-none md:px-8 md:shadow-none">
            @* Səhifə keçidində və dil dəyişəndə məzmun yenidən render olunur (animasiya üçün) *@
            <div @key="RenderKey" class="@TransitionClass">
                @Body
            </div>
            <FeedbackButton/>
            <BottomNav/>
            <AudioPlayerBar/>
        </div>

        <Modal Open="_pushPromptOpen" Title="@Lang["Push_PromptTitle"]" OnClose="() => _pushPromptOpen = false">
            <div class="flex items-start gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-081 text-brand-671"><Icon Name="bell" Class="size-5" /></span>
                <p class="text-[13px] leading-5 text-brand-755">@Lang["Push_PromptBody"]</p>
            </div>
            <div class="mt-4 flex gap-2">
                <button type="button" @onclick="() => _pushPromptOpen = false"
                        class="flex-1 rounded-xl border border-brand-104 py-3 text-sm font-bold text-brand-727">
                    @Lang["Push_PromptLater"]
                </button>
                <button type="button" @onclick="AllowPushAsync" disabled="@_pushBusy"
                        class="flex-1 rounded-xl bg-brand-671 py-3 text-sm font-bold text-white disabled:opacity-60">
                    @Lang["Push_PromptAllow"]
                </button>
            </div>
        </Modal>
    </div>
}

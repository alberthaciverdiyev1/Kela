@using Edutor.App.Shared.Services.Localization
@inject NavigationManager Nav
@inject AuthState Auth
@inject Localizer L

@* backdrop-blur yoxdur: backdrop-filter başlığı fixed uşaqlar üçün containing block edir
   və avatar menyusunun örtüyü yalnız başlığın hündürlüyünü tuturdu. *@
<header class="sticky top-0 z-30 hidden h-[68px] grid-cols-[auto_1fr_auto] items-center gap-6 border-b border-brand-086 bg-brand-022/95 px-8 md:grid">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
        <div class="flex size-8 items-center justify-center rounded-lg bg-brand-743 text-white">
            <Icon Name="book" Class="size-4" />
        </div>
        <span class="text-[19px] font-semibold tracking-[-0.04em]">@L["App_Name"]</span>
    </a>

    @* Ortalanmış menyu; overflow-x-auto: dar ekranlarda maddeler itməz, sürüşdürülə bilər *@
    <nav class="-mx-2 flex items-center justify-center gap-1 overflow-x-auto px-2 [scrollbar-width:none]">
        <TopNavItem Href="/" Label="@L["Nav_Overview"]" IconName="dashboard" MatchAll="true" />
        <TopNavItem Href="/groups" Label="@L["Nav_Groups"]" IconName="book" />
        <TopNavItem Href="/homeworks" Label="@L["Nav_Homeworks"]" IconName="clipboard-check" />
        <TopNavItem Href="/exams" Label="@L["Nav_Exams"]" IconName="file" />
        <TopNavItem Href="/results" Label="@L["Nav_Results"]" IconName="clipboard-check" />
        <TopNavItem Href="/contact" Label="@L["Nav_Contact"]" IconName="mail" />
    </nav>

    <div class="flex items-center justify-self-end gap-3">
        <a href="/notifications" aria-label="@L["Nav_Notifications"]"
           class="grid size-9 place-items-center rounded-full text-sage-473 transition hover:bg-brand-041 hover:text-brand-743">
            <Icon Name="bell" Class="size-[18px]" />
        </a>
        <span class="max-w-[160px] truncate text-[13px] font-semibold text-brand-722">@(Auth.User?.FullName ?? L["Common_Student"])</span>
        <div class="relative">
            <button type="button" @onclick="() => _moreOpen = true" aria-label="@L["Nav_More"]"
                    aria-haspopup="true" aria-expanded="@_moreOpen"
                    class="flex items-center gap-1 rounded-full py-0.5 pl-0.5 pr-2 outline-none ring-brand-253 transition hover:bg-brand-041 focus-visible:ring-2 @(_moreOpen ? "ring-2" : null)">
                @if (!string.IsNullOrWhiteSpace(Auth.User?.Image))
                {
                    <img src="@Auth.User!.Image" alt="" class="size-9 rounded-full object-cover" />
                }
                else
                {
                    <span class="grid size-9 place-items-center rounded-full bg-brand-103 text-[13px] font-bold text-brand-835">@(Auth.User?.Initial ?? "L")</span>
                }
                <Icon Name="chevron-down" Class="@($"size-3.5 text-sage-473 {(_moreOpen ? "rotate-180" : "")}")" />
            </button>
            <MoreMenu Sheet="false" Open="_moreOpen" OnClose="() => _moreOpen = false" />
        </div>
    </div>
</header>

@code {
    private bool _moreOpen;

    protected override void OnInitialized() => L.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
}

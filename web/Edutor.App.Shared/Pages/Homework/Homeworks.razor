@inherits RefreshablePage
@inject Localizer L
@inject AppApi Api
@page "/homeworks"

<PageTitle>@L["Homeworks_Title"]</PageTitle>
<PageHeader Title="@L["Homeworks_Title"]" Back="/" />

<div @key="_loading" class="px-5 pb-28 pt-6 @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <SkeletonCardGrid Count="4" />
    }
    else if (_homeworks.Count == 0)
    {
        <EmptyState Text="@L["Homeworks_Empty"]" />
    }
    else
    {
        <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var h in _homeworks)
            {
                <a href="@($"/homeworks/{h.Id}")"
                   class="block rounded-2xl border border-brand-090 bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)] transition hover:border-brand-467">
                    <div class="flex items-start justify-between gap-3">
                        <h3 class="min-w-0 flex-1 truncate text-[15px] font-bold text-brand-784">@h.Title</h3>
                        <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold @StatusClass(h.Status)">@StatusLabel(h.Status)</span>
                    </div>

                    <p class="mt-2 text-[12px] font-medium text-sage-410">
                        @L["Homework_Due"]: @h.DueDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <div class="mt-3 flex flex-wrap items-center gap-2 text-[11px] font-semibold">
                        @if (h.QuizCount > 0)
                        {
                            <span class="rounded-full bg-brand-081 px-2.5 py-1 text-brand-698">
                                @L.Format("Homework_QuizProgress", h.QuizzesCompleted, h.QuizCount)
                            </span>
                        }
                        @if (h.Score is decimal score)
                        {
                            <span class="rounded-full bg-brand-103 px-2.5 py-1 text-brand-698">@L["Homework_Score"]: @score</span>
                        }
                        @if (h.IsLate)
                        {
                            <span class="rounded-full bg-[#fdecef] px-2.5 py-1 text-danger-539">@L["Homework_Late"]</span>
                        }
                    </div>
                </a>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<Edutor.App.Shared.Dtos.Homework.StudentHomeworkSummaryDto> _homeworks = new();

    protected override void OnInitialized() => OnRefresh(FetchAsync);

    protected override async Task OnInitializedAsync()
    {
        await FetchAsync();
        _loading = false;
    }

    private async Task FetchAsync()
    {
        try { _homeworks = await Api.HomeworksAsync(); }
        catch { }
    }

    private string StatusLabel(string status) => status switch
    {
        "submitted" => L["Homework_StatusSubmitted"],
        "graded" => L["Homework_StatusGraded"],
        "returned" => L["Homework_StatusReturned"],
        _ => L["Homework_StatusAssigned"]
    };

    private string StatusClass(string status) => status switch
    {
        "submitted" => "bg-[#fdf6e3] text-[#8a6d1a]",
        "graded" => "bg-brand-103 text-brand-698",
        "returned" => "bg-[#fdecef] text-danger-539",
        _ => "bg-brand-081 text-sage-410"
    };
}

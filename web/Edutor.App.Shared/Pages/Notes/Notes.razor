@inherits RefreshablePage
@inject Localizer L
@inject AppApi Api
@page "/notes"

<PageTitle>@L["Notes_Title"]</PageTitle>
<PageHeader Title="@L["Notes_Title"]" Back="/profile" />

<div @key="_loading" class="px-5 pb-28 pt-6 lg:mx-auto lg:max-w-[820px] @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <SkeletonCardGrid Count="3" />
    }
    else
    {
        <div class="flex items-center gap-2">
            @foreach (var tab in Tabs)
            {
                <button type="button" @onclick="() => SetScopeAsync(tab.Value)"
                        class="rounded-full px-3.5 py-1.5 text-[12px] font-bold transition @(_scope == tab.Value ? "bg-brand-671 text-white" : "bg-brand-081 text-brand-669")">
                    @L[tab.Key]
                </button>
            }
            <button type="button" @onclick="StartCreate"
                    class="ml-auto inline-flex items-center gap-1 rounded-full bg-brand-671 px-3.5 py-1.5 text-[12px] font-bold text-white">
                <Icon Name="plus" Class="size-3.5" />
                @L["Notes_New"]
            </button>
        </div>

        @if (_error is not null && !_formOpen)
        {
            <p class="mt-3 rounded-xl bg-[#fdecef] px-3 py-2 text-[12px] font-semibold text-danger-539">@_error</p>
        }

        @if (_formOpen)
        {
            <section class="mt-4 rounded-2xl border border-brand-104 bg-white p-4">
                <p class="text-[13px] font-bold text-brand-784">@(_editingId is null ? L["Notes_CreateTitle"] : L["Notes_EditTitle"])</p>

                <input @bind="_title" type="text" maxlength="190" placeholder="@L["Notes_TitlePlaceholder"]"
                       class="mt-3 w-full rounded-xl border border-brand-104 px-3 py-2.5 text-[13px] outline-none focus:border-brand-467" />
                <textarea @bind="_body" rows="4" maxlength="4000" placeholder="@L["Notes_BodyPlaceholder"]"
                          class="mt-2 w-full resize-none rounded-xl border border-brand-104 px-3 py-2.5 text-[13px] outline-none focus:border-brand-467"></textarea>

                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <button type="button" @onclick='() => SetVisibilityAsync("private")'
                            class="rounded-full px-3 py-1.5 text-[12px] font-bold @(_visibility == "private" ? "bg-brand-671 text-white" : "bg-brand-081 text-brand-669")">
                        <Icon Name="lock" Class="mr-1 inline size-3" />@L["Notes_Private"]
                    </button>
                    <button type="button" @onclick='() => SetVisibilityAsync("group")'
                            class="rounded-full px-3 py-1.5 text-[12px] font-bold @(_visibility == "group" ? "bg-brand-671 text-white" : "bg-brand-081 text-brand-669")">
                        <Icon Name="users" Class="mr-1 inline size-3" />@L["Notes_Group"]
                    </button>

                    @if (_visibility == "group" && _groups.Count > 0)
                    {
                        <select @bind="_groupId" class="rounded-full border border-brand-104 bg-white px-3 py-1.5 text-[12px] font-semibold text-brand-722 outline-none focus:border-brand-467">
                            @foreach (var g in _groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    }
                </div>

                @if (_error is not null)
                {
                    <p class="mt-3 rounded-xl bg-[#fdecef] px-3 py-2 text-[12px] font-semibold text-danger-539">@_error</p>
                }

                <div class="mt-4 flex items-center gap-2">
                    <button type="button" @onclick="SaveAsync" disabled="@_saving"
                            class="rounded-xl bg-brand-671 px-4 py-2.5 text-[13px] font-bold text-white disabled:opacity-60">
                        @L["Common_Save"]
                    </button>
                    <button type="button" @onclick="CancelForm" class="rounded-xl px-4 py-2.5 text-[13px] font-bold text-sage-459">
                        @L["Common_Cancel"]
                    </button>
                </div>
            </section>
        }

        @if (_notes.Count == 0)
        {
            <EmptyState Class="mt-8 text-center text-[13px] text-sage-410" Text="@L["Notes_Empty"]" />
        }
        else
        {
            <section class="mt-4 grid gap-3">
                @foreach (var note in _notes)
                {
                    <article class="rounded-2xl border border-brand-090 bg-white p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                @if (!string.IsNullOrWhiteSpace(note.Title))
                                {
                                    <h3 class="truncate text-[14px] font-bold text-brand-784">@note.Title</h3>
                                }
                                <p class="mt-1 whitespace-pre-line text-[13px] leading-5 text-sage-459">@note.Body</p>
                            </div>
                            @if (note.IsMine)
                            {
                                <div class="flex shrink-0 items-center gap-1">
                                    <button type="button" @onclick="() => StartEdit(note)" class="rounded-lg p-2 text-sage-478" aria-label="@L["Common_Edit"]">
                                        <Icon Name="edit" Class="size-4" />
                                    </button>
                                    <button type="button" @onclick="() => AskDelete(note.Id)" class="rounded-lg p-2 text-sage-478" aria-label="@L["Common_Delete"]">
                                        <Icon Name="x" Class="size-4" />
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-2 text-[10px] font-bold">
                            <span class="rounded-full px-2.5 py-1 @(note.Visibility == "group" ? "bg-brand-103 text-brand-698" : "bg-brand-081 text-sage-410")">
                                @(note.Visibility == "group"
                                    ? string.Format(L["Notes_SharedWith"], note.GroupName)
                                    : L["Notes_Private"])
                            </span>

                            @if (!note.IsMine)
                            {
                                <span class="rounded-full bg-brand-081 px-2.5 py-1 text-brand-669">@note.AuthorName</span>
                            }

                            @if (note.ContentId is long contentId && note.LessonId is long lessonId)
                            {
                                <a href="/lessons/@lessonId/content/@contentId"
                                   class="rounded-full bg-brand-049 px-2.5 py-1 text-brand-639">
                                    @(note.ContentTitle ?? note.LessonTitle)
                                    @if (note.PositionSeconds is int seconds)
                                    {
                                        <span>· @FormatTime(seconds)</span>
                                    }
                                </a>
                            }

                            <span class="ml-auto font-medium text-sage-300">@note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>

                        @if (_confirmDeleteId == note.Id)
                        {
                            <div class="mt-3 flex items-center gap-2 rounded-xl bg-[#fdecef] px-3 py-2">
                                <p class="flex-1 text-[12px] font-semibold text-danger-539">@L["Notes_DeleteConfirm"]</p>
                                <button type="button" @onclick="() => DeleteAsync(note.Id)" class="rounded-lg bg-danger-539 px-3 py-1.5 text-[12px] font-bold text-white">@L["Common_Delete"]</button>
                                <button type="button" @onclick="() => _confirmDeleteId = null" class="rounded-lg px-3 py-1.5 text-[12px] font-bold text-sage-459">@L["Common_Cancel"]</button>
                            </div>
                        }
                    </article>
                }
            </section>
        }
    }
</div>

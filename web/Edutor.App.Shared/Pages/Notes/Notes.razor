@using Edutor.App.Shared.Dtos.StudentNote
@inherits RefreshablePage
@inject Localizer L
@inject AppApi Api
@page "/notes"

<PageTitle>@L["Notes_Title"]</PageTitle>
<PageHeader Title="@L["Notes_Title"]" Back="/profile" />

<div @key="_loading" class="px-5 pb-28 pt-6 lg:mx-auto lg:max-w-[1100px] @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <SkeletonCardGrid Count="3" />
    }
    else
    {
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="relative flex-1">
                <input @bind="_search" @bind:event="oninput" type="search" placeholder="@L["Notes_Search"]"
                       class="w-full rounded-xl border border-brand-104 bg-white px-3.5 py-2.5 text-[13px] outline-none focus:border-brand-467" />
            </div>
            <div class="flex items-center gap-2">
                @foreach (var tab in Tabs)
                {
                    <button type="button" @onclick="() => SetScopeAsync(tab.Value)"
                            class="rounded-full px-3.5 py-1.5 text-[12px] font-bold transition @(_scope == tab.Value ? "bg-brand-671 text-white" : "bg-brand-081 text-brand-669")">
                        @L[tab.Key]
                    </button>
                }
            </div>
        </div>

        @if (_error is not null && !_composerOpen)
        {
            <p class="mt-3 rounded-xl bg-[#fdecef] px-3 py-2 text-[12px] font-semibold text-danger-539">@_error</p>
        }

        <div class="mx-auto mt-4 max-w-2xl rounded-2xl border border-brand-104 bg-white shadow-sm">
            @if (!_composerOpen)
            {
                <button type="button" @onclick="OpenComposer"
                        class="w-full px-4 py-3 text-left text-[13px] font-semibold text-sage-410">
                    @L["Notes_TakeNote"]
                </button>
            }
            else
            {
                <div class="px-4 py-3" style="background-color:@Bg(_draftColor)">
                    <input @bind="_title" type="text" maxlength="190" placeholder="@L["Notes_TitlePlaceholder"]"
                           class="w-full bg-transparent text-[14px] font-bold text-brand-784 outline-none" />
                    <textarea @bind="_body" rows="4" maxlength="4000" placeholder="@L["Notes_BodyPlaceholder"]"
                              class="mt-2 w-full resize-none bg-transparent text-[13px] leading-5 outline-none"></textarea>

                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <button type="button" @onclick='() => SetVisibility("private")'
                                class="rounded-full px-2.5 py-1 text-[11px] font-bold @(_visibility == "private" ? "bg-brand-671 text-white" : "bg-white/70 text-brand-669")">
                            <Icon Name="lock" Class="mr-1 inline size-3" />@L["Notes_Private"]
                        </button>
                        <button type="button" @onclick='() => SetVisibility("group")'
                                class="rounded-full px-2.5 py-1 text-[11px] font-bold @(_visibility == "group" ? "bg-brand-671 text-white" : "bg-white/70 text-brand-669")">
                            <Icon Name="users" Class="mr-1 inline size-3" />@L["Notes_Group"]
                        </button>

                        @if (_visibility == "group" && _groups.Count > 0)
                        {
                            <select @bind="_groupId" class="rounded-full border border-brand-104 bg-white px-2.5 py-1 text-[11px] font-semibold text-brand-722 outline-none">
                                @foreach (var g in _groups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        }

                        <button type="button" @onclick="ToggleDraftPin"
                                class="rounded-full px-2.5 py-1 text-[11px] font-bold @(_draftPinned ? "bg-brand-671 text-white" : "bg-white/70 text-brand-669")">
                            <Icon Name="pin" Class="mr-1 inline size-3" />@(_draftPinned ? L["Notes_Unpin"] : L["Notes_Pin"])
                        </button>
                    </div>

                    <div class="mt-3 flex flex-wrap items-center gap-1.5">
                        @foreach (var color in Palette)
                        {
                            <button type="button" @onclick="() => _draftColor = color.Key"
                                    class="size-6 rounded-full border @(_draftColor == color.Key ? "border-brand-784 ring-2 ring-brand-253" : "border-black/10")"
                                    style="background-color:@color.Hex" aria-label="@color.Key"></button>
                        }
                    </div>

                    @if (_error is not null)
                    {
                        <p class="mt-2 rounded-xl bg-[#fdecef] px-3 py-2 text-[12px] font-semibold text-danger-539">@_error</p>
                    }

                    <div class="mt-3 flex items-center justify-end gap-2">
                        <button type="button" @onclick="CancelComposer" class="rounded-xl px-3 py-2 text-[12px] font-bold text-sage-459">
                            @L["Common_Cancel"]
                        </button>
                        <button type="button" @onclick="SaveAsync" disabled="@_saving"
                                class="rounded-xl bg-brand-671 px-4 py-2 text-[12px] font-bold text-white disabled:opacity-60">
                            @L["Common_Save"]
                        </button>
                    </div>
                </div>
            }
        </div>

        var visible = FilteredNotes();
        @if (_notes.Count == 0)
        {
            <EmptyState Class="mt-8 text-center text-[13px] text-sage-410" Text="@L["Notes_Empty"]" />
        }
        else if (visible.Count == 0)
        {
            <EmptyState Class="mt-8 text-center text-[13px] text-sage-410" Text="@L["Notes_NoMatch"]" />
        }
        else
        {
            var pinned = visible.Where(n => n.IsPinned).ToList();
            var others = visible.Where(n => !n.IsPinned).ToList();

            @if (pinned.Count > 0)
            {
                <p class="mt-6 text-[10px] font-bold uppercase tracking-wider text-sage-300">@L["Notes_Pinned"]</p>
                <section class="mt-2 columns-1 gap-3 sm:columns-2 lg:columns-3">
                    @foreach (var note in pinned)
                    {
                        @RenderCard(note)
                    }
                </section>
            }

            @if (others.Count > 0)
            {
                @if (pinned.Count > 0)
                {
                    <p class="mt-6 text-[10px] font-bold uppercase tracking-wider text-sage-300">@L["Notes_Others"]</p>
                }
                <section class="mt-2 columns-1 gap-3 sm:columns-2 lg:columns-3">
                    @foreach (var note in others)
                    {
                        @RenderCard(note)
                    }
                </section>
            }
        }
    }
</div>

@code {
    private RenderFragment RenderCard(StudentNoteDto note) => __builder =>
    {
        <article class="mb-3 break-inside-avoid rounded-2xl border border-black/5 p-4 shadow-sm" style="background-color:@Bg(note.Color)">
            <div class="flex items-start gap-2">
                <div class="min-w-0 flex-1">
                    @if (!string.IsNullOrWhiteSpace(note.Title))
                    {
                        <h3 class="break-words text-[14px] font-bold text-brand-784">@note.Title</h3>
                    }
                    <p class="mt-1 whitespace-pre-line break-words text-[13px] leading-5 text-sage-459">@note.Body</p>
                </div>

                @if (note.IsMine)
                {
                    <button type="button" @onclick="() => TogglePinAsync(note)"
                            class="shrink-0 rounded-lg p-1.5 @(note.IsPinned ? "text-brand-698" : "text-sage-300")"
                            aria-label="@(note.IsPinned ? L["Notes_Unpin"] : L["Notes_Pin"])">
                        <Icon Name="pin" Class="size-4" />
                    </button>
                }
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-2 text-[10px] font-bold">
                <span class="rounded-full bg-white/70 px-2.5 py-1 @(note.Visibility == "group" ? "text-brand-698" : "text-sage-410")">
                    @(note.Visibility == "group"
                        ? string.Format(L["Notes_SharedWith"], note.GroupName)
                        : L["Notes_Private"])
                </span>

                @if (!note.IsMine)
                {
                    <span class="rounded-full bg-white/70 px-2.5 py-1 text-brand-669">@note.AuthorName</span>
                }

                @if (note.ContentId is long contentId && note.LessonId is long lessonId)
                {
                    <a href="/lessons/@lessonId/content/@contentId" class="rounded-full bg-white/70 px-2.5 py-1 text-brand-639">
                        @(note.ContentTitle ?? note.LessonTitle)
                        @if (note.PositionSeconds is int seconds)
                        {
                            <span>· @FormatTime(seconds)</span>
                        }
                    </a>
                }

                <span class="ml-auto font-medium text-sage-300">@note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            </div>

            @if (note.IsMine)
            {
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    @foreach (var color in Palette)
                    {
                        <button type="button" @onclick="() => SetColorAsync(note, color.Key)"
                                class="size-5 rounded-full border @(note.Color == color.Key ? "border-brand-784 ring-2 ring-brand-253" : "border-black/10")"
                                style="background-color:@color.Hex" aria-label="@color.Key"></button>
                    }

                    <div class="ml-auto flex items-center gap-1">
                        <button type="button" @onclick="() => StartEdit(note)" class="rounded-lg p-1.5 text-sage-478" aria-label="@L["Common_Edit"]">
                            <Icon Name="edit" Class="size-3.5" />
                        </button>
                        <button type="button" @onclick="() => AskDelete(note.Id)" class="rounded-lg p-1.5 text-sage-478" aria-label="@L["Common_Delete"]">
                            <Icon Name="x" Class="size-3.5" />
                        </button>
                    </div>
                </div>
            }

            @if (_confirmDeleteId == note.Id)
            {
                <div class="mt-3 flex items-center gap-2 rounded-xl bg-[#fdecef] px-3 py-2">
                    <p class="flex-1 text-[12px] font-semibold text-danger-539">@L["Notes_DeleteConfirm"]</p>
                    <button type="button" @onclick="() => DeleteAsync(note.Id)" class="rounded-lg bg-danger-539 px-3 py-1.5 text-[12px] font-bold text-white">@L["Common_Delete"]</button>
                    <button type="button" @onclick="() => _confirmDeleteId = null" class="rounded-lg px-3 py-1.5 text-[12px] font-bold text-sage-459">@L["Common_Cancel"]</button>
                </div>
            }
        </article>
    };
}

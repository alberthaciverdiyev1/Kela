@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@page "/lessons/{LessonId:long}/content/{ContentId:long}"
@implements IDisposable
@inject AppApi Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AudioPlayerService Player

<PageTitle>@L["Type_Material"]</PageTitle>

<PageHeader Title="@(_content is null ? L["Type_Material"] : L.TypeLabel(_content.Type))" Back="javascript:history.back()"/>

<div @key="_loading" class="px-5 pb-28 pt-5 lg:mx-auto lg:max-w-[1100px] @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <Skeleton Class="mt-1 h-7 w-2/3 rounded-md"/>
        <Skeleton Class="mt-5 aspect-video w-full rounded-2xl"/>
        <Skeleton Class="mt-5 h-3 w-full rounded-md"/>
        <Skeleton Class="mt-2 h-3 w-5/6 rounded-md"/>
        <Skeleton Class="mt-2 h-3 w-2/3 rounded-md"/>
    }
    else if (_content is null)
    {
        <EmptyState Text="@L["Lesson_MaterialNotFound"]"/>
    }
    else
    {
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
            <div>
        <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@_content.Title</h2>

        @if (IsVideo && _content.IsProcessing)
        {
            <div class="mt-5 rounded-2xl border border-brand-090 bg-white p-6 text-center">
                <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-061 text-brand-671">
                    <Icon Name="clock" Class="size-6" />
                </span>
                <p class="mt-3 text-[13px] font-semibold text-brand-722">@L["Video_NotReady"]</p>
            </div>
        }
        else if (IsVideo && _content.IsFailed)
        {
            <div class="mt-5 rounded-2xl border border-[#fecaca] bg-[#fef2f2] p-6 text-center text-[13px] font-semibold text-danger-539">
                @L["Video_Failed"]
            </div>
        }
        else if (IsVideo)
        {
            <div class="mt-5 overflow-hidden rounded-2xl bg-black shadow-[0_6px_20px_rgba(23,61,48,0.12)]">
                <video @ref="_videoRef" controls playsinline preload="metadata" @onended="MarkAsync"
                       class="aspect-video w-full bg-black"></video>
            </div>
        }
        else if (IsVoice)
        {
            <div class="mt-5 rounded-2xl border border-brand-090 bg-white p-6 text-center">
                <button type="button" @onclick="PlayAudio"
                        class="mx-auto flex size-16 items-center justify-center rounded-full bg-brand-671 text-white shadow-lg transition hover:bg-brand-698">
                    <Icon Name="play" Class="ml-1 size-7" />
                </button>
                <p class="mt-3 text-[12px] text-sage-410">@L["Lesson_VoicePlaysBelow"]</p>
            </div>
        }
        else
        {
            <div class="mt-5 rounded-2xl border border-brand-090 bg-white p-4">
                <button type="button" @onclick="OpenDocument"
                        class="w-full rounded-xl bg-brand-671 py-3.5 text-sm font-bold text-white">@L["Lesson_OpenDocument"]</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_content.Description))
        {
            <p class="mt-5 text-[13px] leading-5 text-sage-459">@_content.Description</p>
        }

        <div class="mt-6">
            <button type="button" @onclick="MarkAsync" disabled="@_done"
                    class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-[13px] font-bold @(_done ? "bg-brand-075 text-sage-410" : "bg-brand-081 text-brand-671")">
                <Icon Name="@(_done ? "check" : "chevron-right")" Class="size-4" />
                @(_done ? L["Lesson_Completed"] : L["Lesson_MarkCompleted"])
            </button>
        </div>

        @if (IsVideo || IsVoice)
        {
            <section class="mt-6 rounded-2xl border border-brand-090 bg-white p-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-[13px] font-bold text-brand-784">@L["Notes_ContentTitle"]</h3>
                    <button type="button" @onclick="StartNoteAsync"
                            class="inline-flex items-center gap-1 rounded-full bg-brand-081 px-3 py-1.5 text-[12px] font-bold text-brand-671">
                        <Icon Name="plus" Class="size-3.5" />
                        @L["Notes_AddHere"]
                        @if (_noteAt is int at)
                        {
                            <span>· @FormatTime(at)</span>
                        }
                    </button>
                </div>

                @if (_noteError is not null && !_noteFormOpen)
                {
                    <p class="mt-2 text-[11px] font-semibold text-danger-539">@_noteError</p>
                }

                @if (_noteFormOpen)
                {
                    <div class="mt-3 rounded-2xl border border-brand-104 bg-brand-027 p-3.5">
                        <textarea @bind="_noteBody" rows="3" maxlength="4000" placeholder="@L["Notes_BodyPlaceholder"]"
                                  class="w-full resize-none rounded-xl border border-brand-104 bg-white px-3.5 py-2.5 text-[13px] leading-5 outline-none transition focus:border-brand-467"></textarea>

                        <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                            @if (_noteAt is int noteAt)
                            {
                                <span class="mr-1 rounded-full bg-white px-2 py-1 text-[11px] font-bold tabular-nums text-brand-671">@FormatTime(noteAt)</span>
                            }
                            <button type="button" @onclick='() => SetNoteVisibility("private")'
                                    class="rounded-full px-3 py-1 text-[11px] font-bold transition @(_noteVisibility == "private" ? "bg-brand-671 text-white" : "bg-white text-brand-669")">
                                @L["Notes_Private"]
                            </button>
                            <button type="button" @onclick='() => SetNoteVisibility("group")'
                                    class="rounded-full px-3 py-1 text-[11px] font-bold transition @(_noteVisibility == "group" ? "bg-brand-671 text-white" : "bg-white text-brand-669")">
                                @L["Notes_Group"]
                            </button>
                            @if (_noteVisibility == "group" && _noteGroups.Count > 0)
                            {
                                <select @bind="_noteGroupId" class="rounded-full border border-brand-104 bg-white px-2.5 py-1 text-[11px] font-semibold text-brand-722 outline-none focus:border-brand-467">
                                    @foreach (var g in _noteGroups)
                                    {
                                        <option value="@g.Id">@g.Name</option>
                                    }
                                </select>
                            }
                        </div>

                        @if (_noteError is not null)
                        {
                            <p class="mt-2 text-[11px] font-semibold text-danger-539">@_noteError</p>
                        }

                        <div class="mt-3 flex items-center justify-end gap-2 border-t border-brand-090 pt-3">
                            <button type="button" @onclick="() => _noteFormOpen = false"
                                    class="rounded-xl px-3 py-2 text-[12px] font-bold text-sage-459">
                                @L["Common_Cancel"]
                            </button>
                            <button type="button" @onclick="SaveNoteAsync" disabled="@_noteSaving"
                                    class="rounded-xl bg-brand-671 px-4 py-2 text-[12px] font-bold text-white disabled:opacity-60">
                                @L["Common_Save"]
                            </button>
                        </div>
                    </div>
                }

                @if (_notes.Count == 0)
                {
                    <p class="mt-3 text-[12px] text-sage-410">@L["Notes_NoNotes"]</p>
                }
                else
                {
                    <ul class="mt-3 grid gap-2">
                        @foreach (var note in _notes)
                        {
                            <li class="rounded-xl border border-brand-080 p-3">
                                <div class="flex items-start gap-2">
                                    <div class="min-w-0 flex-1">
                                        @if (!string.IsNullOrWhiteSpace(note.Title))
                                        {
                                            <p class="truncate text-[12px] font-bold text-brand-784">@note.Title</p>
                                        }
                                        <p class="mt-0.5 whitespace-pre-line text-[12px] leading-5 text-sage-459">@note.Body</p>
                                    </div>
                                    @if (note.IsMine)
                                    {
                                        <button type="button" @onclick="() => _noteToDelete = note" class="rounded-lg p-1.5 text-sage-478" aria-label="@L["Common_Delete"]">
                                            <Icon Name="x" Class="size-3.5" />
                                        </button>
                                    }
                                </div>
                                <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[10px] font-bold">
                                    @if (note.PositionSeconds is int seconds)
                                    {
                                        <button type="button" @onclick="() => JumpAsync(note)"
                                                class="rounded-full bg-brand-081 px-2 py-0.5 tabular-nums text-brand-671" title="@L["Notes_Jump"]">
                                            @FormatTime(seconds)
                                        </button>
                                    }
                                    <span class="rounded-full px-2 py-0.5 @(note.Visibility == "group" ? "bg-brand-103 text-brand-698" : "bg-brand-081 text-sage-410")">
                                        @(note.Visibility == "group"
                                            ? string.Format(L["Notes_SharedWith"], note.GroupName)
                                            : L["Notes_Private"])
                                    </span>
                                    @if (!note.IsMine)
                                    {
                                        <span class="rounded-full bg-brand-081 px-2 py-0.5 text-brand-669">@note.AuthorName</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                <a href="/notes" class="mt-3 inline-flex items-center gap-1 text-[11px] font-bold text-brand-671">
                    @L["Notes_AllNotes"]
                    <Icon Name="chevron-right" Class="size-3.5" />
                </a>
            </section>
        }
            </div>

            @if (_siblings.Count > 0)
            {
                <aside class="lg:sticky lg:top-4">
                    <h3 class="mb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-brand-671">@RelatedTitle</h3>
                    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                        @foreach (var s in _siblings)
                        {
                            <a href="/lessons/@LessonId/content/@s.Id"
                               class="flex items-center gap-3 rounded-xl border border-brand-090 bg-white p-3 transition hover:border-brand-467">
                                <span class="relative size-16 shrink-0 overflow-hidden rounded-lg bg-brand-081 text-brand-698">
                                    @if (s.Type == "video")
                                    {
                                        @if (!string.IsNullOrWhiteSpace(s.ThumbnailUrl))
                                        {
                                            <img src="@s.ThumbnailUrl" alt="" class="absolute inset-0 h-full w-full object-cover" />
                                        }
                                        else
                                        {
                                            @* Çoxsaylı <video> elementi WebView-i dondurur → statik ikon göstərilir *@
                                            <span class="grid h-full w-full place-items-center"><Icon Name="play" Class="size-5" /></span>
                                        }
                                        <span class="absolute inset-0 grid place-items-center">
                                            <span class="grid size-6 place-items-center rounded-full bg-black/45 text-white"><Icon Name="play" Class="size-3" /></span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grid h-full w-full place-items-center"><Icon Name="@IconFor(s.Type)" Class="size-5" /></span>
                                    }
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-[13px] font-semibold text-brand-776">@s.Title</span>
                                    <span class="mt-0.5 block text-[11px] text-sage-410">@L.TypeLabel(s.Type)</span>
                                </span>
                                <Icon Name="chevron-right" Class="size-4 shrink-0 text-sage-300" />
                            </a>
                        }
                    </div>
                </aside>
            }
        </div>
    }
</div>

<Modal Open="_noteToDelete is not null" Title="@L["Common_Delete"]" OnClose="() => _noteToDelete = null">
    <p class="text-[13px] leading-5 text-sage-459">@L["Notes_DeleteConfirm"]</p>
    <div class="mt-4 flex justify-end gap-2">
        <button type="button" @onclick="() => _noteToDelete = null"
                class="rounded-xl px-3 py-2 text-[12px] font-bold text-sage-459">
            @L["Common_Cancel"]
        </button>
        <button type="button" @onclick="ConfirmDeleteNoteAsync" disabled="@_noteDeleting"
                class="rounded-xl bg-danger-539 px-4 py-2 text-[12px] font-bold text-white disabled:opacity-60">
            @L["Common_Delete"]
        </button>
    </div>
</Modal>

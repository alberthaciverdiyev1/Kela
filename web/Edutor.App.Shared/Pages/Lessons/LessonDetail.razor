@inherits RefreshablePage
@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@page "/lessons/{LessonId:long}"
@inject AppApi Api

<PageTitle>@L["Materials_Title"]</PageTitle>

<PageHeader Title="@L["Materials_Title"]" Back="javascript:history.back()"/>

<div @key="_loading" class="px-5 pb-28 pt-5 @(!_loading ? "page-fade" : null)">
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@(Title ?? L["Lesson_Default"])</h2>

    @if (_loading)
    {
        <SkeletonCardGrid Count="4"/>
    }
    else if (_contents.Count == 0 && _quizzes.Count == 0)
    {
        <EmptyState Text="@L["LessonDetail_Empty"]"/>
    }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @if (_videos.Count > 0)
            {
                <SectionCard Icon="play" Title="@L["Section_Videos"]" Subtitle="@L.Format("Section_VideosCount", _videos.Count)"
                             Href="@($"/lessons/{LessonId}/contents/video")"/>
            }
            @if (_files.Count > 0)
            {
                <SectionCard Icon="file" Title="@L["Section_Files"]" Subtitle="@L.Format("Section_FilesCount", _files.Count)"
                             Href="@($"/lessons/{LessonId}/contents/file")" Tone="bg-sun-063 text-sun-461"/>
            }
            @if (_voices.Count > 0)
            {
                <SectionCard Icon="chart" Title="@L["Section_Voices"]" Subtitle="@L.Format("Section_VoicesCount", _voices.Count)"
                             Href="@($"/lessons/{LessonId}/contents/voice")" Tone="bg-sky-041 text-sky-406"/>
            }
            @if (_quizzes.Count > 0)
            {
                <SectionCard Icon="clipboard-check" Title="@L["Quizzes_Title"]" Subtitle="@L.Format("Section_QuizzesCount", _quizzes.Count)"
                             Href="@($"/lessons/{LessonId}/quizzes")"/>
            }
        </section>
    }
</div>

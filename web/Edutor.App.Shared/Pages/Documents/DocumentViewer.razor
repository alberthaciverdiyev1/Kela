@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@page "/document"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@L["Document_Title"]</PageTitle>

<PageHeader Title="@(string.IsNullOrWhiteSpace(_title) ? L["Document_Title"] : _title)" Back="javascript:history.back()" Sticky="true"/>

@if (string.IsNullOrEmpty(_url))
{
    <EmptyState Text="@L["Document_NotFound"]" Class="px-5 py-10 text-sm text-sage-410"/>
}
else
{
    <div class="min-h-[60vh] bg-[#f0f2f1] pb-6 pt-3">
        <div @ref="_pdfRef" class="mx-auto min-h-[60vh] w-full max-w-[900px] select-none"
             @oncontextmenu="() => { }" @oncontextmenu:preventDefault="true"></div>
    </div>
}

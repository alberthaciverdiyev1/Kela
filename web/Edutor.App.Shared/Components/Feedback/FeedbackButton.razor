@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@* Geri bildiriş düyməsi — şagird ↔ admin söhbəti. *@
<div class="pointer-events-none fixed inset-x-0 bottom-24 z-40 mx-auto flex max-w-[430px] justify-end px-5 md:max-w-none md:px-8">
    <button type="button" @onclick="OpenAsync" aria-label="@L["Feedback_Title"]"
            class="pointer-events-auto relative grid size-12 place-items-center rounded-full bg-brand-671 text-white shadow-[0_8px_24px_rgba(23,77,58,0.28)] active:scale-95 transition">
        <Icon Name="mail" Class="size-5" />
        @if (_hasReply)
        {
            <span class="absolute -right-0.5 -top-0.5 size-3 rounded-full bg-danger-539 ring-2 ring-white"></span>
        }
    </button>
</div>

<Modal Open="_open" Title="@L["Feedback_Title"]" OnClose="CloseAsync">
    <div class="space-y-3">
        <div class="max-h-[45vh] space-y-2 overflow-y-auto">
            @if (_loading)
            {
                <p class="py-6 text-center text-[13px] text-sage-410">@L["Common_Loading"]</p>
            }
            else if (_messages.Count == 0)
            {
                <p class="py-4 text-center text-[13px] text-sage-410">@L["Feedback_Placeholder"]</p>
            }
            else
            {
                @foreach (var m in _messages)
                {
                    <div class="flex @(m.SenderRole == "admin" ? "justify-start" : "justify-end")">
                        <div class="max-w-[82%] rounded-2xl px-3 py-2 text-[14px] @(m.SenderRole == "admin" ? "bg-brand-081 text-brand-784" : "bg-brand-671 text-white")">
                            <p class="whitespace-pre-wrap break-words">@m.Body</p>
                            @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                            {
                                <a href="@m.ImageUrl" target="_blank" rel="noopener">
                                    <img src="@m.ImageUrl" alt="" class="mt-2 max-h-32 rounded-lg object-contain" />
                                </a>
                            }
                            <span class="mt-1 block text-[10px] @(m.SenderRole == "admin" ? "text-sage-410" : "text-white/70")">
                                @m.CreatedAt.ToLocalTime().ToString("HH:mm")
                                @if (m.SenderRole != "admin" && m.IsRead) { <text>· @L["Feedback_Read"]</text> }
                            </span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="flex items-end gap-2 border-t border-brand-090 pt-3">
            <textarea @bind="_message" rows="2"
                      class="flex-1 resize-none rounded-2xl border border-brand-090 bg-brand-102 p-3 text-[14px] text-brand-836 outline-none focus:border-brand-671"
                      placeholder="@L["Feedback_Placeholder"]"></textarea>
            <label class="grid size-10 shrink-0 cursor-pointer place-items-center rounded-xl border border-brand-090 text-sage-478" title="@L["Feedback_Attach"]">
                <Icon Name="file" Class="size-4" />
                <InputFile OnChange="OnFile" class="hidden" accept="image/*" />
            </label>
            <button type="button" disabled="@_busy" @onclick="SendAsync"
                    class="shrink-0 rounded-2xl bg-brand-671 px-4 py-3 text-[14px] font-bold text-white disabled:opacity-60">
                @L["Feedback_Send"]
            </button>
        </div>

        @if (_file is not null)
        {
            <p class="truncate text-[12px] text-sage-410">@_file.Name</p>
        }
        @if (_error)
        {
            <p class="text-[13px] font-semibold text-red-600">@(_errorMessage ?? L["Feedback_Error"])</p>
        }
    </div>
</Modal>

@inherits RefreshablePage
@inject Localizer L
@inject AppApi Api
@page "/homeworks/{Id:long}"

<PageTitle>@(_homework?.Title ?? L["Homeworks_Title"])</PageTitle>
<PageHeader Title="@(_homework?.Title ?? L["Homeworks_Title"])" Back="/homeworks" />

<div @key="_loading" class="px-5 pb-28 pt-6 @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <SkeletonCardGrid Count="2" />
    }
    else if (_homework is null)
    {
        <EmptyState Text="@L["Homework_Error"]" />
    }
    else
    {
        <section class="rounded-2xl border border-brand-090 bg-white p-5 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full px-2.5 py-1 text-[10px] font-bold @StatusClass(_homework.Status)">@StatusLabel(_homework.Status)</span>
                @if (_homework.IsLate)
                {
                    <span class="rounded-full bg-[#fdecef] px-2.5 py-1 text-[10px] font-bold text-danger-539">@L["Homework_Late"]</span>
                }
            </div>

            <p class="mt-3 text-[13px] font-medium text-sage-410">
                @L["Homework_Due"]: @_homework.DueDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                · @L["Homework_MaxScore"]: @_homework.MaxScore
            </p>

            @if (!string.IsNullOrWhiteSpace(_homework.Description))
            {
                <div class="mt-3 text-[14px] leading-6 text-brand-755 [&_a]:text-brand-671 [&_a]:underline [&_h2]:mt-3 [&_h2]:text-[16px] [&_h2]:font-bold [&_h2]:text-brand-784 [&_h3]:mt-3 [&_h3]:text-[15px] [&_h3]:font-semibold [&_h3]:text-brand-776 [&_img]:my-2 [&_img]:max-w-full [&_img]:rounded-xl [&_li]:mt-1 [&_p]:mt-2 [&_strong]:font-bold [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mt-2 [&_ol]:list-decimal [&_ol]:pl-5">@((MarkupString)_homework.Description)</div>
            }
        </section>

        @if (_homework.Quizzes.Count > 0)
        {
            <section class="mt-4 rounded-2xl border border-brand-090 bg-white p-5">
                <h2 class="text-[15px] font-bold text-brand-784">@L["Homework_Quizzes"]</h2>

                @if (!_homework.AllQuizzesCompleted)
                {
                    <p class="mt-2 rounded-xl bg-[#fdf6e3] px-3 py-2 text-[12px] font-semibold text-[#8a6d1a]">
                        @L["Homework_QuizzesPending"]
                    </p>
                }

                <div class="mt-3 space-y-2">
                    @foreach (var q in _homework.Quizzes)
                    {
                        <div class="flex items-center justify-between gap-3 rounded-xl bg-brand-024 px-4 py-3">
                            <div class="min-w-0">
                                <p class="truncate text-[14px] font-semibold text-brand-776">@q.Title</p>
                                <p class="mt-0.5 text-[11px] text-sage-410">
                                    @q.QuestionCount @L["Homework_Questions"]
                                    @if (q.Completed)
                                    {
                                        <span> · @q.CorrectCount/@q.QuestionCount · @q.ScorePercent%</span>
                                    }
                                </p>
                            </div>
                            <a href="@($"/exams/{q.QuizId}")"
                               class="shrink-0 rounded-xl bg-brand-671 px-3 py-2 text-[12px] font-bold text-white">
                                @(q.Completed ? L["Homework_ReviewQuiz"] : L["Homework_StartQuiz"])
                            </a>
                        </div>
                    }
                </div>
            </section>
        }

        @if (_homework.Score is decimal score || !string.IsNullOrWhiteSpace(_homework.Feedback))
        {
            <section class="mt-4 rounded-2xl border border-brand-090 bg-white p-5">
                <h2 class="text-[15px] font-bold text-brand-784">@L["Homework_Feedback"]</h2>
                @if (_homework.Status == "returned")
                {
                    <p class="mt-2 text-[12px] font-semibold text-danger-539">@L["Homework_Returned"]</p>
                }
                <div class="mt-2 flex flex-wrap gap-2 text-[12px] font-semibold">
                    @if (_homework.Score is decimal s)
                    {
                        <span class="rounded-full bg-brand-103 px-2.5 py-1 text-brand-698">@L["Homework_Score"]: @s / @_homework.MaxScore</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_homework.Feedback))
                {
                    <p class="mt-2 whitespace-pre-wrap text-[14px] leading-6 text-brand-755">@_homework.Feedback</p>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(_homework.Text) || !string.IsNullOrWhiteSpace(_homework.Link) || _homework.Files.Count > 0)
        {
            <section class="mt-4 rounded-2xl border border-brand-090 bg-white p-5">
                <h2 class="text-[15px] font-bold text-brand-784">@L["Homework_YourAnswer"]</h2>
                @if (!string.IsNullOrWhiteSpace(_homework.Text))
                {
                    <p class="mt-2 whitespace-pre-wrap text-[14px] leading-6 text-brand-755">@_homework.Text</p>
                }
                @if (!string.IsNullOrWhiteSpace(_homework.Link))
                {
                    <a href="@_homework.Link" target="_blank" rel="noopener" class="mt-2 block truncate text-[13px] font-semibold text-brand-671 underline">@_homework.Link</a>
                }
                @if (_homework.Files.Count > 0)
                {
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var f in _homework.Files)
                        {
                            <a href="@f.Url" target="_blank" rel="noopener"
                               class="rounded-xl border border-brand-104 px-3 py-2 text-[12px] font-semibold text-brand-698 hover:bg-brand-022">
                                @f.FileName
                            </a>
                        }
                    </div>
                }
            </section>
        }

        @if (_homework.CanSubmit)
        {
            <section class="mt-4 rounded-2xl border border-brand-090 bg-white p-5">
                <h2 class="text-[15px] font-bold text-brand-784">
                    @(_homework.AttemptCount > 0 ? L["Homework_Resubmit"] : L["Homework_Submit"])
                </h2>

                <textarea @bind="_text" rows="5" placeholder="@L["Homework_AnswerPlaceholder"]"
                          class="mt-3 w-full rounded-2xl border border-brand-104 bg-brand-024 p-4 text-[14px] outline-none focus:border-brand-467"></textarea>

                <input @bind="_link" type="url" placeholder="@L["Homework_LinkPlaceholder"]"
                       class="mt-3 w-full rounded-2xl border border-brand-104 bg-white px-4 py-3 text-[13px] outline-none focus:border-brand-467" />

                <div class="mt-3">
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-2xl border border-dashed border-brand-104 px-4 py-3 text-[13px] font-semibold text-brand-698 hover:bg-brand-022">
                        <Icon Name="file" Class="size-4" />
                        @L["Homework_AddFiles"]
                        <InputFile OnChange="OnFilesSelected" multiple class="hidden" />
                    </label>
                    <p class="mt-1 text-[11px] text-sage-410">@L["Homework_FileHint"]</p>

                    @if (_files.Count > 0)
                    {
                        <div class="mt-2 flex flex-wrap gap-2">
                            @foreach (var file in _files)
                            {
                                <span class="inline-flex items-center gap-2 rounded-xl bg-brand-024 px-3 py-1.5 text-[12px] font-medium text-brand-755">
                                    @file.Name
                                    <button type="button" @onclick="() => RemoveFile(file)" class="text-danger-539" aria-label="@L["Homework_RemoveFile"]">✕</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="mt-3 text-[13px] font-semibold text-danger-539">@_error</p>
                }
                @if (!string.IsNullOrWhiteSpace(_success))
                {
                    <p class="mt-3 text-[13px] font-semibold text-brand-698">@_success</p>
                }

                <button type="button" @onclick="SubmitAsync" disabled="@_busy"
                        class="mt-4 w-full rounded-2xl bg-brand-671 py-3.5 text-sm font-bold text-white disabled:opacity-60">
                    @(_busy ? L["Common_Loading"] : (_homework.AttemptCount > 0 ? L["Homework_Resubmit"] : L["Homework_Submit"]))
                </button>
            </section>
        }
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    private bool _loading = true;
    private bool _busy;
    private Edutor.App.Shared.Dtos.Homework.StudentHomeworkDetailDto? _homework;
    private readonly List<IBrowserFile> _files = new();
    private string _text = string.Empty;
    private string _link = string.Empty;
    private string? _error;
    private string? _success;

    protected override void OnInitialized() => OnRefresh(FetchAsync);

    protected override async Task OnInitializedAsync()
    {
        await FetchAsync();
        _loading = false;
    }

    private async Task FetchAsync()
    {
        try
        {
            _homework = await Api.HomeworkAsync(Id);
            _text = _homework.Text ?? string.Empty;
            _link = _homework.Link ?? string.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var file in e.GetMultipleFiles(5))
        {
            if (file.Size > 10 * 1024 * 1024) { _error = L["Homework_FileTooLarge"]; continue; }
            if (_files.Count >= 5) { _error = L["Homework_MaxFiles"]; break; }
            if (_files.All(x => x.Name != file.Name)) _files.Add(file);
        }
    }

    private void RemoveFile(IBrowserFile file) => _files.Remove(file);

    private async Task SubmitAsync()
    {
        if (_homework is null || _busy) return;

        _error = null;
        _success = null;
        _busy = true;

        var streams = new List<Stream>();
        try
        {
            var uploads = new List<Edutor.App.Shared.Dtos.Homework.HomeworkUploadFile>();
            foreach (var file in _files)
            {
                var stream = file.OpenReadStream(10 * 1024 * 1024);
                streams.Add(stream);
                uploads.Add(new Edutor.App.Shared.Dtos.Homework.HomeworkUploadFile(stream, file.Name, file.ContentType));
            }

            _homework = await Api.SubmitHomeworkAsync(Id, _text, _link, uploads);
            _text = _homework.Text ?? string.Empty;
            _link = _homework.Link ?? string.Empty;
            _files.Clear();
            _success = L["Homework_Submitted"];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            foreach (var stream in streams) stream.Dispose();
            _busy = false;
        }
    }

    private string StatusLabel(string status) => status switch
    {
        "submitted" => L["Homework_StatusSubmitted"],
        "graded" => L["Homework_StatusGraded"],
        "returned" => L["Homework_StatusReturned"],
        _ => L["Homework_StatusAssigned"]
    };

    private string StatusClass(string status) => status switch
    {
        "submitted" => "bg-[#fdf6e3] text-[#8a6d1a]",
        "graded" => "bg-brand-103 text-brand-698",
        "returned" => "bg-[#fdecef] text-danger-539",
        _ => "bg-brand-081 text-sage-410"
    };
}

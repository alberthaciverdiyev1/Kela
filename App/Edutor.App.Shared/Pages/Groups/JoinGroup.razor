@inherits RefreshablePage
@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@inject AppApi Api
@inject ApiClient ApiClient
@inject AuthState Auth
@inject TokenStore Store
@inject NavigationManager Nav
@page "/join/{Token}"

<PageTitle>@L["Groups_JoinTitle"]</PageTitle>

<PageHeader Title="@L["Groups_JoinTitle"]" Back="/groups"/>

<div @key="_loading" class="px-5 pb-28 pt-6 @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <div class="mx-auto h-44 w-full max-w-md animate-pulse rounded-3xl bg-brand-081"></div>
    }
    else if (_info is null && _otherTenant is not null)
    {
        <section class="mx-auto w-full max-w-md rounded-3xl border border-brand-090 bg-white p-5 shadow-[0_10px_40px_rgba(36,78,62,0.08)]">
            <h2 class="text-xl font-bold tracking-[-0.02em] text-brand-784">@_otherTenant.Name</h2>
            <p class="mt-3 text-sm leading-relaxed text-sage-410">@L.Format("Groups_JoinOtherTenant", _otherTenant.Name)</p>

            @if (_switchError is not null)
            {
                <p class="mt-3 text-xs font-semibold text-danger-539">@_switchError</p>
            }

            @if (_savedAccount is not null)
            {
                <button type="button" @onclick="SwitchSavedAccountAsync" disabled="@_switchBusy"
                        class="mt-4 w-full rounded-2xl bg-brand-671 py-3 text-sm font-bold text-white disabled:opacity-60">
                    @L.Format("Groups_JoinSwitchSaved", _savedAccount.Email)
                </button>
            }

            <button type="button" @onclick="SignInOtherAsync" disabled="@_switchBusy"
                    class="mt-3 w-full rounded-2xl border border-brand-104 py-3 text-sm font-bold text-brand-727 disabled:opacity-60">
                @L["Groups_JoinSignInOther"]
            </button>
        </section>
    }
    else if (_info is null)
    {
        <EmptyState Text="@L["Groups_JoinNotFound"]"/>
    }
    else
    {
        <section class="mx-auto w-full max-w-md overflow-hidden rounded-3xl border border-brand-090 bg-white shadow-[0_10px_40px_rgba(36,78,62,0.08)]">
            @if (HasImage)
            {
                <img src="@_info.Image" alt="" class="h-40 w-full object-cover"/>
            }
            <div class="p-5">
                <h2 class="text-xl font-bold tracking-[-0.02em] text-brand-784">@_info.Name</h2>
                @if (!string.IsNullOrWhiteSpace(_info.TeacherName))
                {
                    <p class="mt-1 text-xs font-semibold text-sage-410">@L["Groups_JoinTeacher"]: @_info.TeacherName</p>
                }
                @if (!string.IsNullOrWhiteSpace(_info.Description))
                {
                    <p class="mt-3 text-sm leading-relaxed text-sage-410">@_info.Description</p>
                }

                @if (_info.Status is "member" or "approved")
                {
                    <div class="mt-5 rounded-2xl bg-brand-081 px-4 py-3 text-sm font-semibold text-brand-698">@L["Groups_JoinMember"]</div>
                    <a href="/groups" class="mt-3 block w-full rounded-2xl bg-brand-671 py-3 text-center text-sm font-bold text-white">@L["Groups_JoinGo"]</a>
                }
                else if (_info.Status == "pending")
                {
                    <div class="mt-5 rounded-2xl bg-[#fdf6e3] px-4 py-3 text-sm font-semibold text-[#8a6d1a]">@L["Groups_JoinPending"]</div>
                }
                else
                {
                    @if (_info.Status == "rejected")
                    {
                        <div class="mt-4 rounded-2xl bg-[#fdecef] px-4 py-3 text-sm font-semibold text-[#c0392b]">@L["Groups_JoinRejected"]</div>
                    }
                    <button type="button" @onclick="RequestAsync" disabled="@_busy"
                            class="mt-4 w-full rounded-2xl bg-brand-671 py-3 text-sm font-bold text-white disabled:opacity-60">
                        @(_busy ? L["Login_Wait"] : L["Groups_JoinButton"])
                    </button>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="mt-3 text-xs font-semibold text-danger-539">@_error</p>
                }
            </div>
        </section>
    }
</div>

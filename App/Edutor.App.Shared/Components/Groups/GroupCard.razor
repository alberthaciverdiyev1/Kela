@using Edutor.App.Shared.Services.Localization
@inject Localizer L
@* Qrup kartı (şaquli) — Groups (siyahı) səhifəsi üçün. *@
<a href="/groups/@Group.Id" class="block overflow-hidden rounded-2xl border border-brand-090 bg-white shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
    <div class="relative flex h-[132px] items-center justify-center overflow-hidden @Tone">
        @if (Group.HasImage)
        {
            <img src="@Group.Image" alt="" class="absolute inset-0 h-full w-full object-cover" />
        }
        else
        {
            <span class="text-5xl font-black @ToneText">@Group.Initial</span>
        }
        <span class="absolute bottom-3 right-3 flex size-10 items-center justify-center rounded-full bg-white text-brand-639 shadow-md"><Icon Name="play" Class="ml-0.5 size-4" /></span>
    </div>
    <div class="p-4">
        <h3 class="font-bold leading-5 tracking-[-0.02em] text-brand-776">@Group.Name</h3>
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-medium text-sage-382">
            <span class="text-brand-698">@(string.IsNullOrWhiteSpace(Group.Description) ? L["Common_General"] : Group.Description)</span>
            <span class="flex items-center gap-1"><Icon Name="users" Class="size-3" />@string.Format(L["Group_StudentsCount"], Group.StudentCount)</span>
        </div>
        <span class="mt-4 inline-flex items-center gap-1 text-[12px] font-bold text-brand-639">@L["Group_ViewLessons"] <Icon Name="chevron-right" Class="size-3.5" /></span>
    </div>
</a>

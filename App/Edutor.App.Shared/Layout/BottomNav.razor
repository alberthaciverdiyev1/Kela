@using Edutor.App.Shared.Services.Localization
@implements IDisposable
@inject NavigationManager Nav
@inject Localizer L

<nav class="fixed bottom-0 left-1/2 z-20 flex h-[72px] w-full max-w-[430px] -translate-x-1/2 items-center justify-around border-t border-brand-104 bg-white/95 px-3 backdrop-blur md:hidden">
    <BottomItem Href="/" Label="@L["Nav_Home"]" IconName="dashboard" MatchAll="true" />
    <BottomItem Href="/groups" Label="@L["Nav_Groups"]" IconName="book" />
    <BottomItem Href="/exams" Label="@L["Nav_Exam"]" IconName="file" />
    <BottomItem Href="/homeworks" Label="@L["Nav_Homeworks"]" IconName="clipboard-check" />
    <BottomItem Href="/profile" Label="@L["Nav_Profile"]" IconName="users" />
</nav>

@code {
    protected override void OnInitialized() => L.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}

@using Kela.App.Shared.Services.Localization
@inject Localizer L
@inject AppApi Api
@inject ApiClient ApiClient
@inject AuthState Auth
@inject TokenStore Store

<main class="flex min-h-dvh justify-center bg-[#f3f6f3] font-sans text-[#071e27] lg:items-stretch lg:justify-start">
    <div class="relative mx-auto flex min-h-dvh w-full max-w-[430px] flex-col overflow-hidden bg-white shadow-[0_0_55px_#123a2514] lg:mx-0 lg:max-w-none lg:flex-row lg:shadow-none">
        @* --- Hero --- *@
        <section class="relative h-[260px] flex-none bg-[#e5eee4] lg:h-auto lg:flex-1" aria-label="@L["Login_HeroAria"]">
            <img class="block h-full w-full object-cover object-[center_48%]" src="_content/Kela.App.Shared/images/login-hero.jpg" alt="" />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[60px] bg-gradient-to-t from-[#d0eccf59] to-transparent lg:hidden"></div>
        </section>

        @* --- Ağ panel --- *@
        <section class="relative z-[1] -mt-[15px] flex flex-1 flex-col rounded-t-[38px] bg-white px-4 pb-11 pt-[13px] lg:mt-0 lg:justify-center lg:overflow-y-auto lg:rounded-none lg:px-16">
            <div class="mx-auto mb-[15px] h-[5px] w-[35px] rounded-full bg-[#e2e5e6] lg:hidden"></div>
            <h1 class="m-0 text-center text-[31px] font-extrabold leading-[1.18] tracking-[-1.2px] lg:text-[34px]">@(_register ? L["Login_HeadingRegister"] : L["Login_HeadingLogin"])</h1>
            <p class="mt-2 mb-[23px] text-center text-sm text-[#727c8d]">@(_register ? L["Login_SubRegister"] : L["Login_SubLogin"])</p>

            <div class="flex items-center justify-between">
                <h2 class="text-sm font-[750] tracking-[-.2px]">@L["Login_SelectCourse"]</h2>
                <button type="button" class="flex items-center gap-1.5 border-0 bg-transparent p-0 text-xs font-semibold text-[#087e42]" @onclick="OpenModal">
                    @L["Login_SeeAll"]
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 5 7 7-7 7" /></svg>
                </button>
            </div>

            <div class="mr-[-16px] mt-2.5 flex gap-2 overflow-x-auto pb-[7px] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:mr-0 lg:flex-wrap lg:overflow-visible lg:pb-0" role="group" aria-label="@L["Login_CoursesAria"]">
                @if (_tenants.Count == 0)
                {
                    <p class="text-sm text-[#a0a8b7]">@L["Login_NoTenants"]</p>
                }
                else
                {
                    foreach (var t in _tenants.Take(10))
                    {
                        var tenant = t;
                        <button type="button"
                                class="flex h-20 w-[76px] shrink-0 flex-col items-center justify-center gap-[7px] rounded-[17px] border border-[#f0f1f2] bg-[#f9fafb] p-0 transition aria-pressed:border-[#098849] aria-pressed:bg-[#effaf1]"
                                aria-pressed="@(_tenantId == tenant.Id ? "true" : "false")" @onclick="() => Select(tenant)">
                            @if (!string.IsNullOrWhiteSpace(tenant.Logo))
                            {
                                <img class="h-[38px] w-[38px] rounded-xl object-cover" src="@tenant.Logo" alt="" />
                            }
                            else
                            {
                                <span class="text-[30px] leading-[33px]">@Emoji(tenant)</span>
                            }
                            <span class="max-w-[70px] truncate text-[10px] text-[#101e27]">@tenant.Name</span>
                        </button>
                    }
                }
            </div>

            <form class="mt-[17px]" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                @if (_register)
                {
                    <div class="mb-[15px]">
                        <label class="mb-[7px] block text-sm font-[750]" for="fullName">@L["Login_FullName"]</label>
                        <div class="flex h-[52px] items-center gap-3 rounded-[17px] border border-[#d7dce5] bg-gradient-to-br from-white to-[#fbfbfc] px-[15px] transition focus-within:border-[#0d9250] focus-within:shadow-[0_0_0_3px_#0d925018]">
                            <input id="fullName" class="w-full min-w-0 border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" @bind="_fullName" placeholder="@L["Login_FullNamePlaceholder"]" />
                        </div>
                    </div>
                    <div class="mb-[15px]">
                        <label class="mb-[7px] block text-sm font-[750]" for="phone">@L["Login_Phone"]</label>
                        <div class="flex h-[52px] items-center gap-3 rounded-[17px] border border-[#d7dce5] bg-gradient-to-br from-white to-[#fbfbfc] px-[15px] transition focus-within:border-[#0d9250] focus-within:shadow-[0_0_0_3px_#0d925018]">
                            <input id="phone" class="w-full min-w-0 border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" @bind="_phone" placeholder="+994..." />
                        </div>
                    </div>
                }

                <div class="mb-[15px]">
                    <label class="mb-[7px] block text-sm font-[750]" for="email">@L["Login_Email"]</label>
                    <div class="flex h-[52px] items-center gap-3 rounded-[17px] border border-[#d7dce5] bg-gradient-to-br from-white to-[#fbfbfc] px-[15px] transition focus-within:border-[#0d9250] focus-within:shadow-[0_0_0_3px_#0d925018]">
                        <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 6 10 7 10-7" /></svg>
                        <input id="email" type="email" class="w-full min-w-0 border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" @bind="_email" placeholder="Email" autocomplete="email" />
                    </div>
                </div>

                <div class="mb-[15px]">
                    <label class="mb-[7px] block text-sm font-[750]" for="password">@L["Login_Password"]</label>
                    <div class="flex h-[52px] items-center gap-3 rounded-[17px] border border-[#d7dce5] bg-gradient-to-br from-white to-[#fbfbfc] px-[15px] transition focus-within:border-[#0d9250] focus-within:shadow-[0_0_0_3px_#0d925018]">
                        <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="12" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><path d="M12 15v3" /></svg>
                        <input id="password" type="@(_show ? "text" : "password")" class="w-full min-w-0 border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" @bind="_password" placeholder="••••••••" autocomplete="current-password" />
                        <button class="flex border-0 bg-transparent p-[5px] text-[#7d8798]" type="button" @onclick="() => _show = !_show" aria-label="@L["Login_ShowPassword"]">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                @if (_show)
                                {
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                                }
                                else
                                {
                                    <path d="M3 3 21 21" /><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" /><path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c5.1 0 9 5 9 7a11.7 11.7 0 0 1-3.1 3.8" /><path d="M6.1 6.1C3.8 7.6 3 10 3 12c0 2 3.9 7 9 7 1.1 0 2.1-.2 3.1-.6" />
                                }
                            </svg>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="mb-3 rounded-xl bg-[#fdecef] px-3 py-2 text-xs font-semibold text-[#c0392b]">@_error</div>
                }

                <button type="submit" disabled="@_busy" class="mt-px h-[51px] w-full rounded-[26px] border-0 bg-gradient-to-r from-[#128c4b] to-[#0b8d48] text-base font-[750] text-white shadow-[0_10px_18px_#0b8d4814] disabled:opacity-60">@(_busy ? L["Login_Wait"] : (_register ? L["Login_Register"] : L["Login_SignIn"]))</button>
            </form>

            <p class="mt-[18px] text-center text-[13px] text-[#6e7889]">
                @(_register ? L["Login_HaveAccount"] : L["Login_NoAccount"])
                <button type="button" class="border-0 bg-transparent p-0 font-[750] text-[#087d43] underline underline-offset-2" @onclick="Toggle">@(_register ? L["Login_SignIn"] : L["Login_Register"])</button>
            </p>
        </section>
    </div>

    @* --- Kurs seçimi modalı --- *@
    @if (_modalOpen)
    {
        <div class="fixed inset-0 z-50 flex items-end justify-center bg-[#0b1b21a1] lg:items-center" role="dialog" aria-modal="true" aria-label="@L["Login_Courses"]" @onclick="CloseModal">
            <div class="flex h-[min(75dvh,650px)] w-full max-w-[430px] flex-col rounded-t-[25px] bg-white px-[18px] py-[22px] lg:h-auto lg:max-h-[82dvh] lg:max-w-[520px] lg:rounded-3xl" @onclick:stopPropagation="true">
                <div class="mb-3.5 flex items-center justify-between text-base">
                    <strong>@L["Login_SelectCourse"]</strong>
                    <button type="button" aria-label="@L["Common_Close"]" class="text-2xl" @onclick="CloseModal">×</button>
                </div>
                <input class="w-full rounded-[13px] border border-[#d8dfe3] px-3.5 py-3 outline-none focus:border-[#128c4b]" placeholder="@L["Login_SearchCourse"]" @bind="_search" @bind:event="oninput" />
                <div class="mt-3 flex-1 overflow-auto">
                    @foreach (var t in Filtered())
                    {
                        var tenant = t;
                        <button type="button" class="flex w-full items-center gap-3 border-0 border-b border-[#f1f3f4] bg-transparent px-2 py-3 text-left @(_tenantId == tenant.Id ? "rounded-[10px] bg-[#f1faf3] text-[#087e42]" : "")" @onclick="() => SelectFromModal(tenant)">
                            @if (!string.IsNullOrWhiteSpace(tenant.Logo))
                            {
                                <img class="h-[30px] w-[30px] shrink-0 rounded-[9px] object-cover" src="@tenant.Logo" alt="" />
                            }
                            else
                            {
                                <span class="text-2xl">@Emoji(tenant)</span>
                            }
                            <span>@tenant.Name</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</main>

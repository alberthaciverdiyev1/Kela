@using Kela.App.Shared.Services.Localization
@inject Localizer L
@* Nəticə kartı — quiz adı, tarix, müddət, səviyyə, doğru/yanlış, faiz, bal. *@
<a href="/results/@Result.AttemptId" class="block rounded-2xl border border-brand-090 bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
    <div class="flex items-start justify-between gap-3">
        <p class="min-w-0 flex-1 text-[14px] font-semibold leading-5 text-brand-776">@Result.QuizTitle</p>
        <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold @LevelClass">@Level</span>
    </div>
    <p class="mt-1 text-[11px] text-sage-410">@DateLabel · @DurationLabel</p>

    <div class="mt-3 grid grid-cols-3 gap-2 border-y border-sage-059 py-3 text-center">
        <div><p class="text-[16px] font-bold text-brand-671">@Result.CorrectCount</p><p class="text-[10px] text-sage-410">@L["Result_Correct"]</p></div>
        <div><p class="text-[16px] font-bold text-danger-539">@Wrong</p><p class="text-[10px] text-sage-410">@L["Result_Wrong"]</p></div>
        <div><p class="text-[16px] font-bold text-brand-776">@Result.TotalQuestions</p><p class="text-[10px] text-sage-410">@L["Result_Questions"]</p></div>
    </div>

    <div class="mt-3 flex items-center gap-3">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-brand-075">
            <div class="h-full rounded-full bg-brand-671" style="width:@(Result.ScorePercent)%"></div>
        </div>
        <span class="text-[12px] font-bold text-brand-671">@(Result.ScorePercent)%</span>
    </div>

    <div class="mt-3 flex items-center justify-between">
        <span class="text-[11px] text-sage-410">@string.Format(L["Result_Score"], Score)</span>
        <span class="inline-flex items-center gap-1 text-[12px] font-bold text-brand-639">@L["Result_Details"] <Icon Name="chevron-right" Class="size-3.5" /></span>
    </div>
</a>

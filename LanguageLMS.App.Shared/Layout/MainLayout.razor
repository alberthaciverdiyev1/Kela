@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject ApiClient ApiClient
@inject AppApi Api
@inject TokenStore Store

@if (!_ready)
{
    <Loader/>
}
else if (!Auth.IsAuthenticated)
{
    <Login/>
}
else
{
    <div class="min-h-screen bg-brand-102 text-brand-836">
        <NavMenu/>
        <div
            class="mx-auto min-h-screen w-full max-w-[430px] overflow-x-hidden bg-brand-022 shadow-[0_0_60px_rgba(23,77,58,0.12)] lg:ml-[236px] lg:max-w-none lg:shadow-none">
            @Body
            <BottomNav/>
        </div>
    </div>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;

        if (!Auth.IsAuthenticated)
        {
            await RestoreAsync();
        }

        _ready = true;
    }

    /// <summary>localStorage-dəki tokeni bərpa edir və istifadəçini /api/auth/me ilə yeniləyir.</summary>
    private async Task RestoreAsync()
    {
        try
        {
            var token = await Store.GetAsync();
            if (string.IsNullOrWhiteSpace(token)) return;

            ApiClient.Token = token;
            var user = await Api.MeAsync();
            Auth.Set(token, user);
        }
        catch
        {
            ApiClient.Token = null;
            try
            {
                await Store.RemoveAsync();
            }
            catch
            {
                /* JS hazır deyil */
            }
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}

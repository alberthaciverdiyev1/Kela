@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject ApiClient ApiClient
@inject AppApi Api
@inject TokenStore Store

@if (!_ready)
{
    <Loader/>
}
else if (!Auth.IsAuthenticated)
{
    <Login/>
}
else
{
    <div class="min-h-screen bg-brand-102 text-brand-836">
        <NavMenu/>
        <div
            class="mx-auto min-h-screen w-full max-w-[430px] overflow-x-hidden bg-brand-022 shadow-[0_0_60px_rgba(23,77,58,0.12)] lg:ml-[236px] lg:max-w-none lg:shadow-none">
            @Body
            <BottomNav/>
            <AudioPlayerBar/>
        </div>
    </div>
}

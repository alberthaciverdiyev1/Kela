@inject NavigationManager Nav

<aside class="fixed inset-y-0 left-0 hidden w-[236px] flex-col border-r border-brand-112 bg-brand-012 px-5 py-7 lg:flex">
    <a href="/" class="flex items-center gap-2.5 px-2">
        <div class="flex size-8 items-center justify-center rounded-lg bg-brand-743 text-white">
            <Icon Name="book" Class="size-4" />
        </div>
        <span class="text-[19px] font-semibold tracking-[-0.04em]">LanguageLMS</span>
    </a>

    <div class="mt-14 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-sage-349">Workspace</div>
    <nav class="mt-3 flex flex-col gap-1">
        <NavItem Href="/" Label="Overview" IconName="dashboard" MatchAll="true" />
        <NavItem Href="/groups" Label="Groups" IconName="book" />
        <NavItem Href="/exams" Label="Exams" IconName="file" />
        <NavItem Href="/results" Label="Results" IconName="clipboard-check" />
        <NavItem Href="/notifications" Label="Notifications" IconName="bell" />
        <NavItem Href="/profile" Label="Profile" IconName="users" />
    </nav>

    <div class="mt-auto border-t border-brand-082 px-3 pt-5">
        <NavItem Href="/contact" Label="Contact" IconName="mail" />
        </div>
</aside>

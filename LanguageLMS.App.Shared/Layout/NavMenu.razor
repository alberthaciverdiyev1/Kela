@inject NavigationManager Nav

<aside class="fixed inset-y-0 left-0 hidden w-[236px] flex-col border-r border-[#dbeae3] bg-[#fbfdfc] px-5 py-7 lg:flex">
    <a href="/" class="flex items-center gap-2.5 px-2">
        <div class="flex size-8 items-center justify-center rounded-lg bg-[#176c4b] text-white">
            <Icon Name="book" Class="size-4" />
        </div>
        <span class="text-[19px] font-semibold tracking-[-0.04em]">LanguageLMS</span>
    </a>

    <div class="mt-14 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[#9bb1a8]">Workspace</div>
    <nav class="mt-3 flex flex-col gap-1">
        <NavItem Href="/" Label="Overview" IconName="dashboard" MatchAll="true" />
        <NavItem Href="/courses" Label="Courses" IconName="book" />
        <NavItem Href="/exams" Label="Exams" IconName="file" />
        <NavItem Href="/results" Label="Results" IconName="clipboard-check" />
        <NavItem Href="/profile" Label="Profile" IconName="users" />
    </nav>

    <div class="mt-auto border-t border-[#e5efea] px-3 pt-5">
        <p class="text-[12px] font-semibold text-[#315d4c]">Keep your rhythm.</p>
        <p class="mt-1 text-[11px] leading-5 text-[#8aa39a]">A little progress each day adds up.</p>
    </div>
</aside>

@code {
    private string ToPath(string href) => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
}

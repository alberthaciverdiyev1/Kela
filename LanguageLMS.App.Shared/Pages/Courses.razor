@page "/courses"
@inject AppApi Api
@inject NavigationManager Nav

<PageTitle>Courses</PageTitle>

<header class="flex h-[72px] items-center justify-between border-b border-brand-080 bg-brand-027 px-5">
    <a href="/" class="flex size-10 items-center justify-center rounded-full bg-white text-brand-600 shadow-sm"><Icon Name="arrow-left" Class="size-5" /></a>
    <h1 class="text-[18px] font-bold tracking-[-0.04em] text-brand-784">Courses</h1>
    <button class="relative rounded-xl p-2 text-sage-478"><Icon Name="bell" Class="size-[19px]" /><span class="absolute right-1.5 top-1.5 size-1.5 rounded-full bg-sun-367"></span></button>
</header>

<div class="px-5 pb-28 pt-6">
    <section class="rounded-[24px] bg-brand-081 p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Find your next skill</p>
        <h2 class="mt-2 max-w-[270px] text-[27px] font-bold leading-tight tracking-[-0.055em] text-brand-804">Learn something that moves you forward.</h2>
        <p class="mt-3 text-sm leading-5 text-sage-524">Curated courses made for your pace and your goals.</p>
    </section>

    <div class="mt-7 flex items-center justify-between">
        <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Browse library</p><h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">All courses</h2></div>
    </div>

    @if (_loading)
    {
        <p class="mt-6 text-sm text-sage-410">Yüklənir...</p>
    }
    else if (_groups.Count == 0)
    {
        <p class="mt-6 text-sm text-sage-410">Hələ qrupunuz yoxdur.</p>
    }
    else
    {
        <section class="mt-5 flex flex-col gap-4">
            @foreach (var (g, i) in _groups.Select((g, i) => (g, i)))
            {
                <article class="overflow-hidden rounded-2xl border border-brand-090 bg-white shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
                    <div class="relative flex h-[132px] items-center justify-center @Tone(i)">
                        <span class="text-5xl font-black @ToneText(i)">@(string.IsNullOrEmpty(g.Name) ? "?" : g.Name[..1].ToUpper())</span>
                        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold text-brand-643">Course</span>
                        <button class="absolute bottom-3 right-3 flex size-10 items-center justify-center rounded-full bg-white text-brand-639 shadow-md"><Icon Name="play" Class="ml-0.5 size-4" /></button>
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold leading-5 tracking-[-0.02em] text-brand-776">@g.Name</h3>
                        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-medium text-sage-382">
                            <span class="text-brand-698">@(g.Description ?? "Ümumi")</span>
                            <span class="flex items-center gap-1"><Icon Name="users" Class="size-3" />@g.StudentCount tələbə</span>
                        </div>
                        <a href="/courses/@g.Id" class="mt-4 inline-flex items-center gap-1 text-[12px] font-bold text-brand-639">Dərslərə bax <Icon Name="chevron-right" Class="size-3.5" /></a>
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<Group> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        try { _groups = await Api.GroupsAsync(); } catch { }
        _loading = false;
    }

    private static string Tone(int i) => (i % 4) switch { 0 => "bg-brand-083", 1 => "bg-sky-061", 2 => "bg-sun-069", _ => "bg-grape-051" };
    private static string ToneText(int i) => (i % 4) switch { 0 => "text-brand-698", 1 => "text-sky-531", 2 => "text-sun-529", _ => "text-grape-447" };
}

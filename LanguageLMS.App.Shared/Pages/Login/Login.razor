@inject AppApi Api
@inject ApiClient ApiClient
@inject AuthState Auth
@inject TokenStore Store

<main class="min-h-screen bg-brand-101 text-brand-804">
    <div class="relative mx-auto flex min-h-screen w-full max-w-[430px] flex-col bg-white shadow-[0_0_60px_rgba(23,77,58,0.12)]">

        @* --- Hero: fotoqrafiya + badge-lər --- *@
        <div class="relative h-[40vh] min-h-[300px] w-full overflow-hidden">
            <img src="_content/LanguageLMS.App.Shared/images/welcome-hero.jpg" alt=""
                 class="h-full w-full object-cover" />
        </div>

        @* --- Ağ panel (welcome + login) --- *@
        <section class="relative -mt-9 flex flex-1 flex-col rounded-t-[30px] bg-white px-6 pb-8 pt-8">
            <h1 class="text-center text-[27px] font-bold tracking-[-0.05em] text-brand-804">
                @(_register ? "Hesab yarat." : "Öz yolunu seç.")
            </h1>
            <p class="mt-2 text-center text-[13px] leading-5 text-sage-459">
                @(_register ? "Qeydiyyatdan keç və öyrənməyə başla." : "Müxtəlif təkliflərimizdən sən də yararlan.")
            </p>

            <form class="mt-7 flex flex-col gap-4" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                @if (_register)
                {
                    <label class="block">
                        <span class="text-[12px] font-semibold text-brand-804">Ad və soyad</span>
                        <input @bind="_fullName" placeholder="Adın" class="mt-1.5 w-full rounded-2xl border border-brand-104 bg-white px-4 py-3.5 text-sm font-medium text-brand-755 outline-none placeholder:text-sage-271 focus:border-brand-467" />
                    </label>
                    <label class="block">
                        <span class="text-[12px] font-semibold text-brand-804">Telefon (istəyə bağlı)</span>
                        <input @bind="_phone" placeholder="+994..." class="mt-1.5 w-full rounded-2xl border border-brand-104 bg-white px-4 py-3.5 text-sm font-medium text-brand-755 outline-none placeholder:text-sage-271 focus:border-brand-467" />
                    </label>
                }

                <label class="block">
                    <span class="text-[12px] font-semibold text-brand-804">Email</span>
                    <input @bind="_email" type="email" placeholder="Email" class="mt-1.5 w-full rounded-2xl border border-brand-104 bg-white px-4 py-3.5 text-sm font-medium text-brand-755 outline-none placeholder:text-sage-271 focus:border-brand-467" />
                </label>

                <label class="block">
                    <span class="text-[12px] font-semibold text-brand-804">Şifrə</span>
                    <div class="mt-1.5 flex items-center gap-2 rounded-2xl border border-brand-104 bg-white px-4 focus-within:border-brand-467">
                        <input @bind="_password" type="@(_show ? "text" : "password")" placeholder="••••••••" class="min-w-0 flex-1 bg-transparent py-3.5 text-sm font-medium text-brand-755 outline-none placeholder:text-sage-271" />
                        <button type="button" @onclick="() => _show = !_show" class="shrink-0 text-sage-380" aria-label="Şifrəni göstər">
                            <Icon Name="@(_show ? "eye-off" : "eye")" Class="size-5" />
                        </button>
                    </div>
                </label>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="rounded-xl bg-danger-043 px-3 py-2 text-xs font-semibold text-danger-539">@_error</p>
                }

                <button type="submit" disabled="@_busy" class="mt-1 rounded-2xl bg-brand-639 py-4 text-sm font-bold text-white shadow-[0_10px_22px_rgba(30,154,106,0.2)] transition hover:bg-brand-712 disabled:opacity-60">
                    @(_busy ? "Gözləyin..." : (_register ? "Qeydiyyat" : "Daxil ol"))
                </button>
            </form>

            <p class="mt-6 text-center text-[13px] text-sage-463">
                @(_register ? "Hesabınız var?" : "Hesabınız yoxdur?")
                <button type="button" @onclick="Toggle" class="font-bold text-brand-639 underline cursor-pointer">@(_register ? "Daxil ol" : "Qeydiyyat")</button>
            </p>
        </section>
    </div>
</main>

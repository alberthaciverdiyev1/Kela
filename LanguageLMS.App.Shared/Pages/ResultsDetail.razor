@page "/results/{AttemptId:long}"
@inject AppApi Api

<PageTitle>Nəticə</PageTitle>

<header class="flex h-[72px] items-center justify-between border-b border-brand-080 bg-brand-027 px-5">
    <a href="/results" class="flex size-10 items-center justify-center rounded-full bg-white text-brand-600 shadow-sm"><Icon Name="arrow-left" Class="size-5" /></a>
    <h1 class="max-w-[220px] truncate text-[18px] font-bold tracking-[-0.04em] text-brand-784">Nəticə</h1>
    <span class="size-10"></span>
</header>

@if (_loading)
{
    <Loader/>
}
else if (_detail is null)
{
    <p class="px-5 py-10 text-sm text-sage-410">Nəticə tapılmadı.</p>
}
else
{
    <div class="px-5 pb-28 pt-6">
        <div class="rounded-[24px] bg-brand-836 p-6 text-white">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-253">@_detail.QuizTitle</p>
            <p class="mt-4 text-5xl font-semibold tracking-[-0.06em]">@_detail.ScorePercent%</p>
            <p class="mt-2 text-[13px] text-brand-286">@_detail.CorrectCount / @_detail.TotalQuestions düzgün cavab</p>
        </div>

        <p class="mt-8 text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Cavablar</p>
        <section class="mt-3 flex flex-col gap-3">
            @{ var no = 0; }
            @foreach (var it in _detail.Items)
            {
                no++;
                <div class="rounded-2xl border bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)] @(it.IsRight ? "border-brand-149" : "border-danger-043")">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full @(it.IsRight ? "bg-brand-671 text-white" : "bg-danger-539 text-white")">
                            <Icon Name="@(it.IsRight ? "check" : "x")" Class="size-3.5" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[13px] font-semibold leading-5 text-brand-776">@no. @it.Title</p>
                            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px]">
                                <span class="text-sage-410">Sizin cavab:
                                    <b class="@(it.IsRight ? "text-brand-671" : "text-danger-539")">@(string.IsNullOrEmpty(it.StudentAnswer) ? "—" : it.StudentAnswer)</b>
                                </span>
                                <span class="text-sage-410">Doğru cavab: <b class="text-brand-671">@it.CorrectAnswer</b></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public long AttemptId { get; set; }
    private bool _loading = true;
    private QuizResultDetail? _detail;

    protected override async Task OnInitializedAsync()
    {
        try { _detail = await Api.ResultDetailAsync(AttemptId); } catch { }
        _loading = false;
    }
}

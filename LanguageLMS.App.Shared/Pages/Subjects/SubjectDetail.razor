@page "/subjects/{SubjectId:long}"
@inject AppApi Api

<PageTitle>Dərslər</PageTitle>

<PageHeader Title="Dərslər" Back="/groups"/>

<div class="px-5 pb-28 pt-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Lessons</p>
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">Dərslər</h2>

    @if (_loading) { <Loader/> }
    else if (_lessons.Count == 0) { <EmptyState Text="Bu fənn üzrə dərs yoxdur."/> }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @for (var i = 0; i < _lessons.Count; i++)
            {
                <LessonCard Lesson="_lessons[i]" Index="@(i + 1)"/>
            }
        </section>
    }
</div>

@page "/profile"
@inject AppApi Api
@inject AuthState Auth
@inject TokenStore Store

<PageTitle>Profile</PageTitle>

<header class="flex h-[68px] items-center justify-between border-b border-brand-096 px-5">
    <span class="rounded-lg p-2 text-sage-527"><Icon Name="arrow-left" Class="size-5" /></span>
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-sage-500">Profile</p>
    <span class="rounded-lg p-2 text-sage-527"><Icon Name="settings" Class="size-5" /></span>
</header>

<section class="border-b border-brand-100 px-5 pb-8 pt-8">
    <div class="flex items-start gap-4">
        <div class="relative shrink-0">
            <div class="flex size-[82px] items-center justify-center rounded-full bg-brand-103 text-3xl font-black text-brand-835">@(Auth.User?.Initial ?? "L")</div>
            <span class="absolute -bottom-1 -right-1 flex size-7 items-center justify-center rounded-full bg-brand-743 text-white ring-4 ring-brand-022"><Icon Name="edit" Class="size-3" /></span>
        </div>
        <div class="min-w-0 pt-1">
            <h1 class="text-[24px] font-semibold tracking-[-0.055em]">@(Auth.User?.FullName ?? "Şagird")</h1>
            <p class="mt-1 text-[13px] text-sage-459">@(Auth.User?.Email ?? "")</p>
            <p class="mt-3 text-[11px] font-medium text-sage-355">@(Auth.User?.Phone ?? "")</p>
        </div>
    </div>
    <div class="mt-7 grid grid-cols-3 divide-x divide-brand-100 border-y border-brand-100 py-4 text-center">
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_groups</p><p class="mt-1 text-[10px] text-sage-410">Groups</p></div>
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_quizzes</p><p class="mt-1 text-[10px] text-sage-410">Exams</p></div>
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_completed</p><p class="mt-1 text-[10px] text-sage-410">Completed</p></div>
    </div>
</section>

<section class="px-5 pt-7">
    <div class="mb-4"><p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-671">Milestones</p><h2 class="mt-1 text-[20px] font-semibold tracking-[-0.04em]">Achievements</h2></div>
    <div class="-mx-5 flex gap-3 overflow-x-auto px-5 pb-1">
        <div class="min-w-[158px] border-l-2 border-brand-100 pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-sun-063 text-sun-461"><Icon Name="flame" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">7 day streak</h3><p class="mt-1 text-[10px] text-sage-410">Keep it going</p>
        </div>
        <div class="min-w-[158px] border-l-2 border-brand-100 pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-brand-061 text-brand-639"><Icon Name="trophy" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">First milestone</h3><p class="mt-1 text-[10px] text-sage-410">3 courses completed</p>
        </div>
        <div class="min-w-[158px] border-l-2 border-brand-100 pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-sky-041 text-sky-406"><Icon Name="award" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">Top learner</h3><p class="mt-1 text-[10px] text-sage-410">Top 10% this month</p>
        </div>
    </div>
</section>

<section class="px-5 pt-8 pb-28">
    <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-brand-671">Account</p>
    <div class="divide-y divide-brand-075 border-y border-brand-075">
        <div class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="book" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">My courses</span><span class="mt-0.5 block text-[10px] text-sage-410">@_groups active</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </div>
        <div class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="shield" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Privacy & security</span><span class="mt-0.5 block text-[10px] text-sage-410">Protected</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </div>
        <button class="flex w-full items-center gap-3 py-4 text-left" @onclick="Logout">
            <span class="flex size-8 items-center justify-center rounded-lg bg-danger-043 text-danger-539"><Icon Name="settings" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold text-danger-539">Log out</span><span class="mt-0.5 block text-[10px] text-sage-410">Sign out of your account</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </button>
    </div>
</section>

@code {
    private int _groups;
    private int _quizzes;
    private int _completed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _groups = (await Api.StudentGroupsAsync()).Count;
            _quizzes = (await Api.QuizzesAsync()).Count;
            var progress = await Api.ProgressAsync();
            _completed = progress.Items.Sum(i => i.CompletedContents);
        }
        catch { }
    }

    private async Task Logout()
    {
        try { await Api.LogoutAsync(); } catch { }
        try { await Store.RemoveAsync(); } catch { }
        Auth.Clear();
    }
}

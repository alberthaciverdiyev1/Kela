@page "/profile"
@inject AppApi Api
@inject AuthState Auth
@inject TokenStore Store

<PageTitle>Profil</PageTitle>

<header class="flex h-[68px] items-center justify-between border-b border-brand-096 px-5">
    <span class="rounded-lg p-2 text-sage-527"></span>
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-sage-500">Profil</p>
    <span class="rounded-lg p-2 text-sage-527"></span>
</header>

@* --- Profil məlumatı (yalnız oxunur) --- *@
<section class="border-b border-brand-100 px-5 pb-8 pt-8">
    <div class="flex items-start gap-4">
        <div class="flex size-[82px] shrink-0 items-center justify-center rounded-full bg-brand-103 text-3xl font-black text-brand-835">@(Auth.User?.Initial ?? "L")</div>
        <div class="min-w-0 pt-1">
            <h1 class="text-[24px] font-semibold tracking-[-0.055em]">@(Auth.User?.FullName ?? "Şagird")</h1>
            <p class="mt-1 text-[13px] text-sage-459">@(Auth.User?.Email ?? "")</p>
            @if (!string.IsNullOrWhiteSpace(Auth.User?.Phone))
            {
                <p class="mt-3 text-[11px] font-medium text-sage-355">@Auth.User!.Phone</p>
            }
        </div>
    </div>
</section>

@* --- Hesab əməliyyatları --- *@
<section class="px-5 pb-28 pt-7">
    <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-brand-671">Hesab</p>

    <div class="divide-y divide-brand-075 border-y border-brand-075">
        @if (!string.IsNullOrWhiteSpace(Auth.User?.Phone))
        {
            <button type="button" @onclick="() => OpenPhone()" class="flex w-full items-center gap-3 py-4 text-left">
                <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="phone" Class="size-4" /></span>
                <span class="flex-1"><span class="block text-[13px] font-semibold">Telefonu dəyiş</span><span class="mt-0.5 block text-[10px] text-sage-410">@Auth.User!.Phone</span></span>
                <Icon Name="chevron-right" Class="size-4 text-sage-300" />
            </button>
        }

        <button type="button" @onclick="() => _passwordOpen = true" class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="lock" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Şifrəni dəyiş</span><span class="mt-0.5 block text-[10px] text-sage-410">Hesab təhlükəsizliyi</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </button>

        <div class="flex w-full items-center gap-3 py-4">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="bell" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Bildirişlər</span><span class="mt-0.5 block text-[10px] text-sage-410">Bildirişləri aktiv/deaktiv et</span></span>
            <button type="button" @onclick="ToggleNotificationsAsync" class="relative h-6 w-11 rounded-full transition @(_notifications ? "bg-brand-671" : "bg-brand-100")">
                <span class="absolute top-0.5 size-5 rounded-full bg-white shadow transition-all @(_notifications ? "left-5" : "left-0.5")"></span>
            </button>
        </div>

        <a href="mailto:info@languagelms.com" class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="mail" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Bizimlə əlaqə</span><span class="mt-0.5 block text-[10px] text-sage-410">info@languagelms.com</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </a>

        <button type="button" @onclick="OpenPrivacyAsync" class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-brand-049 text-brand-639"><Icon Name="shield" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Gizlilik siyasəti</span><span class="mt-0.5 block text-[10px] text-sage-410">İstifadə şərtləri və gizlilik</span></span>
            <Icon Name="chevron-right" Class="size-4 text-sage-300" />
        </button>

        @* İşləməyən (yalnız görünən) hesab silmə *@
        <div class="flex w-full items-center gap-3 py-4 opacity-60" aria-disabled="true">
            <span class="flex size-8 items-center justify-center rounded-lg bg-danger-043 text-danger-539"><Icon Name="x" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold text-danger-539">Hesabı sil</span><span class="mt-0.5 block text-[10px] text-sage-410">Hazırda mövcud deyil</span></span>
        </div>
    </div>

    <button type="button" @onclick="() => _logoutOpen = true" class="mt-6 w-full rounded-2xl border border-danger-043 bg-danger-043/40 py-3.5 text-sm font-bold text-danger-539">
        Çıxış
    </button>
</section>

@* --- Modallar --- *@
<Modal Open="_phoneOpen" Title="Telefonu dəyiş" OnClose="() => _phoneOpen = false">
    <input @bind="_phone" placeholder="+994..." class="w-full rounded-xl border border-brand-104 bg-brand-024 px-4 py-3 text-sm outline-none focus:border-brand-467" />
    @if (!string.IsNullOrEmpty(_phoneError)) { <p class="mt-2 text-xs font-semibold text-danger-539">@_phoneError</p> }
    <button type="button" @onclick="SavePhoneAsync" disabled="@_busy" class="mt-4 w-full rounded-xl bg-brand-671 py-3 text-sm font-bold text-white disabled:opacity-60">Yadda saxla</button>
</Modal>

<Modal Open="_passwordOpen" Title="Şifrəni dəyiş" OnClose="() => _passwordOpen = false">
    <input @bind="_currentPassword" type="password" placeholder="Cari şifrə" class="w-full rounded-xl border border-brand-104 bg-brand-024 px-4 py-3 text-sm outline-none focus:border-brand-467" />
    <input @bind="_newPassword" type="password" placeholder="Yeni şifrə" class="mt-3 w-full rounded-xl border border-brand-104 bg-brand-024 px-4 py-3 text-sm outline-none focus:border-brand-467" />
    @if (!string.IsNullOrEmpty(_passwordError)) { <p class="mt-2 text-xs font-semibold text-danger-539">@_passwordError</p> }
    <button type="button" @onclick="SavePasswordAsync" disabled="@_busy" class="mt-4 w-full rounded-xl bg-brand-671 py-3 text-sm font-bold text-white disabled:opacity-60">Yadda saxla</button>
</Modal>

<Modal Open="_privacyOpen" Title="Gizlilik siyasəti" OnClose="() => _privacyOpen = false">
    @if (_privacyLoading)
    {
        <p class="text-sm text-sage-410">Yüklənir...</p>
    }
    else if (_privacy.Count == 0)
    {
        <p class="text-sm text-sage-410">Məlumat yoxdur.</p>
    }
    else
    {
        <div class="max-h-[60vh] space-y-4 overflow-auto pr-1">
            @foreach (var p in _privacy)
            {
                <div>
                    <p class="text-[12px] font-bold uppercase tracking-[0.12em] text-brand-639">@p.Type</p>
                    <p class="mt-1 whitespace-pre-line text-[13px] leading-5 text-brand-755">@p.Content</p>
                </div>
            }
        </div>
    }
</Modal>

<Modal Open="_logoutOpen" Title="Çıxış" OnClose="() => _logoutOpen = false">
    <p class="text-[13px] leading-5 text-sage-459">Hesabdan çıxmaq istədiyinizə əminsiniz?</p>
    <div class="mt-5 flex gap-3">
        <button type="button" @onclick="() => _logoutOpen = false" class="flex-1 rounded-xl border border-brand-104 py-3 text-sm font-bold text-brand-727">Ləğv et</button>
        <button type="button" @onclick="LogoutAsync" class="flex-1 rounded-xl bg-danger-539 py-3 text-sm font-bold text-white">Çıxış</button>
    </div>
</Modal>

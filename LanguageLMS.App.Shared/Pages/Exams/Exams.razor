@page "/exams"
@inject AppApi Api

<PageTitle>İmtahanlar</PageTitle>

<PageHeader Title="İmtahanlar" Back="/">
    <Right>
        <a href="/results" class="rounded-xl p-2 text-sage-478" aria-label="Nəticələr"><Icon Name="clipboard-check" Class="size-[19px]" /></a>
    </Right>
</PageHeader>

<div class="px-5 pb-28 pt-6">
    <h2 class="text-xl font-bold tracking-[-0.04em] text-brand-784">Mövcud imtahanlar</h2>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_quizzes.Count == 0)
    {
        <EmptyState Text="Hələ imtahan təyin olunmayıb."/>
    }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var q in _quizzes)
            {
                <QuizCard Quiz="q"/>
            }
        </section>
    }
</div>

@page "/results"
@inject AppApi Api

<PageTitle>Nəticələr</PageTitle>

<PageHeader Title="Nəticələr" Back="/"/>

<div class="px-5 pb-28 pt-6">
    @if (_loading)
    {
        <Loader/>
    }
    else
    {
        <div class="mt-4 grid grid-cols-2 gap-3">
            <label class="block">
                <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-sage-410">Başlanğıc</span>
                <input type="date" @bind="_from" @bind:after="RecomputeAsync"
                       class="mt-1 w-full rounded-xl border border-brand-104 bg-white px-3 py-2 text-[13px] text-brand-755 outline-none focus:border-brand-467" />
            </label>
            <label class="block">
                <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-sage-410">Son</span>
                <input type="date" @bind="_to" @bind:after="RecomputeAsync"
                       class="mt-1 w-full rounded-xl border border-brand-104 bg-white px-3 py-2 text-[13px] text-brand-755 outline-none focus:border-brand-467" />
            </label>
        </div>

        <div class="mt-4 grid grid-cols-3 gap-3 rounded-2xl bg-brand-836 p-4 text-center text-white">
            <div><p class="text-2xl font-semibold tracking-[-0.04em]">@_count</p><p class="text-[10px] text-brand-286">İmtahan</p></div>
            <div><p class="text-2xl font-semibold tracking-[-0.04em]">@_avg%</p><p class="text-[10px] text-brand-286">Orta bal</p></div>
            <div><p class="text-2xl font-semibold tracking-[-0.04em]">@_best%</p><p class="text-[10px] text-brand-286">Ən yaxşı</p></div>
        </div>

        @if (_filtered.Count == 0)
        {
            <EmptyState Text="Bu aralıqda nəticə yoxdur."/>
        }
        else
        {
            <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var r in _filtered)
                {
                    <ResultCard Result="r"/>
                }
            </section>
        }
    }
</div>

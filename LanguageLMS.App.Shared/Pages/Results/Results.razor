@page "/results"
@inject AppApi Api

<PageTitle>Nəticələr</PageTitle>

<PageHeader Title="Nəticələr" Back="/"/>

<div class="px-5 pb-28 pt-6">
    <h2 class="text-xl font-bold tracking-[-0.04em] text-brand-784">Nəticələrim</h2>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_results.Count == 0)
    {
        <EmptyState Text="Hələ imtahan verməmisiniz."/>
    }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @foreach (var r in _results)
            {
                <ResultCard Result="r"/>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<QuizResultSummary> _results = new();

    protected override async Task OnInitializedAsync()
    {
        try { _results = await Api.ResultsAsync(); } catch { }
        _loading = false;
    }
}

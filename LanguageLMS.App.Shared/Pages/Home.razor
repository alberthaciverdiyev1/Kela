@page "/"
@inject AppApi Api
@inject AuthState Auth

<PageTitle>LanguageLMS</PageTitle>

@if (_loading)
{
    <div class="flex min-h-screen items-center justify-center text-sage-459">Yüklənir...</div>
}
else
{
    <header class="sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-brand-086 bg-brand-022/95 px-5 backdrop-blur lg:px-10">
        <div class="flex items-center gap-2.5">
            <div class="flex size-8 items-center justify-center rounded-full bg-brand-103 text-[13px] font-bold text-brand-835">@(Auth.User?.Initial ?? "L")</div>
            <span class="text-[13px] font-semibold text-brand-722">@(Auth.User?.FullName ?? "Şagird")</span>
        </div>
        <button class="relative rounded-lg p-2 text-sage-498" aria-label="Notifications">
            <Icon Name="bell" Class="size-[18px]" />
            <span class="absolute right-1.5 top-1.5 size-1.5 rounded-full bg-sun-386"></span>
        </button>
    </header>

    <main class="mx-auto max-w-[1180px] px-5 pb-28 pt-8 lg:px-10 lg:pb-12 lg:pt-12">
        <section class="mt-1">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-671">Learning stories</p>
                <span class="text-[11px] text-sage-382">Swipe to explore</span>
            </div>
            <div class="-mx-5 flex gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none]">
                @for (var i = 0; i < _banners.Count; i++)
                {
                    var idx = i;
                    var b = _banners[i];
                    <button type="button" class="flex w-[66px] shrink-0 flex-col items-center gap-2 text-center"
                            @onclick="() => OpenStory(idx)">
                        <span class="rounded-full p-[3px] ring-2 ring-offset-2 ring-offset-brand-022 @(b.IsNew ? "ring-brand-671" : "ring-brand-149")">
                            <img src="@b.Image" alt="" class="size-[54px] rounded-full object-cover" />
                        </span>
                        <span class="w-full truncate text-[10px] font-semibold text-sage-561">@b.Title</span>
                    </button>
                }
                @if (_banners.Count == 0)
                {
                    <span class="self-center text-[11px] text-sage-382">Hələ banner yoxdur</span>
                }
            </div>
        </section>

        <section class="mt-10">
            <div class="mb-4 flex items-end justify-between">
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-671">Your queue</p>
                    <h2 class="mt-1 text-[22px] font-semibold tracking-[-0.04em]">Continue learning</h2>
                </div>
                <a href="/courses" class="flex items-center gap-1 text-[12px] font-semibold text-brand-671">View all <Icon Name="chevron-right" Class="size-3.5" /></a>
            </div>
            <div class="grid gap-4 lg:grid-cols-2">
                @foreach (var g in _studentGroups)
                {
                    var pct = _groupProgress.GetValueOrDefault(g.Id);
                    <a href="@($"/courses/{g.Id}")" class="group flex overflow-hidden rounded-xl border border-brand-104 bg-white">
                        <div class="relative w-[112px] shrink-0 sm:w-[150px]">
                            @if (!string.IsNullOrEmpty(g.Image))
                            {
                                <img src="@g.Image" alt="" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center bg-brand-083 text-3xl font-black text-brand-698">
                                    @(string.IsNullOrEmpty(g.Name) ? "?" : g.Name[..1].ToUpper())
                                </div>
                            }
                            <span class="absolute left-2.5 top-2.5 rounded bg-white/90 px-2 py-1 text-[9px] font-bold text-brand-669">@g.StudentCount şagird</span>
                        </div>
                        <div class="min-w-0 flex-1 p-4">
                            <p class="text-[10px] font-medium text-sage-376">@g.Description</p>
                            <h3 class="mt-2 line-clamp-2 text-[14px] font-semibold leading-5 text-brand-776">@g.Name</h3>
                            <div class="mt-5 flex items-center gap-3">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-brand-075">
                                    <div class="h-full rounded-full bg-brand-671" style="width:@(pct)%"></div>
                                </div>
                                <span class="text-[11px] font-bold text-brand-671">@(pct)%</span>
                            </div>
                        </div>
                    </a>
                }
                @if (_studentGroups.Count == 0)
                {
                    <p class="text-[12px] text-sage-410">Hələ qrupunuz yoxdur.</p>
                }
            </div>
        </section>

        <section class="mt-10 grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-xl border border-brand-104 bg-white p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-[15px] font-semibold">Upcoming</h2>
                        <p class="mt-1 text-[11px] text-sage-410">This week</p>
                    </div>
                    <Icon Name="calendar" Class="size-[18px] text-sage-486" />
                </div>
                <div class="mt-5 flex items-center gap-3 border-t border-sage-059 pt-4">
                    <div class="w-10 shrink-0 text-center"><p class="text-[10px] font-bold uppercase text-brand-671">May</p><p class="text-lg font-semibold leading-5">24</p></div>
                    <div class="min-w-0 flex-1"><p class="truncate text-[13px] font-semibold">Design systems workshop</p><p class="mt-1 flex items-center gap-1 text-[11px] text-sage-410"><Icon Name="clock" Class="size-3" /> 10:00 AM · 60 min</p></div>
                </div>
                <div class="mt-4 flex items-center gap-3 border-t border-sage-059 pt-4">
                    <div class="w-10 shrink-0 text-center"><p class="text-[10px] font-bold uppercase text-sun-482">May</p><p class="text-lg font-semibold leading-5">27</p></div>
                    <div class="min-w-0 flex-1"><p class="truncate text-[13px] font-semibold">Quiz deadline</p><p class="mt-1 flex items-center gap-1 text-[11px] text-sage-410"><Icon Name="file" Class="size-3" /> @(_quizCount) imtahan</p></div>
                </div>
            </div>
            <div class="rounded-xl bg-brand-836 p-5 text-white">
                <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-253">Ümumi irəliləyiş</p>
                <p class="mt-6 text-4xl font-semibold tracking-[-0.06em]">@_overallPercent%</p>
                <p class="mt-2 text-[12px] leading-5 text-brand-286">@_completedContents / @_totalContents material tamamlandı. Belə davam!</p>
                <div class="mt-6 h-1.5 w-full overflow-hidden rounded-full bg-brand-667">
                    <div class="h-full rounded-full bg-brand-341" style="width:@(_overallPercent)%"></div>
                </div>
            </div>
        </section>
    </main>

    @if (_storyOpen && _banners.Count > 0)
    {
        <StoryViewer Banners="_banners" StartIndex="_storyIndex" OnClose="CloseStory" />
    }
}

@code {
    private bool _loading = true;
    private bool _storyOpen;
    private int _storyIndex;
    private int _quizCount;
    private int _overallPercent;
    private int _completedContents;
    private int _totalContents;
    private List<BannerResponse> _banners = [];
    private List<GroupResponse> _studentGroups = [];
    private readonly Dictionary<long, int> _groupProgress = new();

    private void OpenStory(int index)
    {
        _storyIndex = index;
        _storyOpen = true;
    }

    private void CloseStory() => _storyOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var quizzes = await Api.QuizzesAsync();
            _banners = await Api.BannersAsync();
            _quizCount = quizzes.Count;
            _studentGroups = await Api.StudentGroupsAsync();

            // Şagird progressi: ümumi + hər qrup üzrə (fənn statistikasından hesablanır)
            var stats = await Api.StatisticsAsync();
            _overallPercent = stats.Overview.CompletionPercent;
            _completedContents = stats.Overview.CompletedContents;
            _totalContents = stats.Overview.TotalContents;

            var bySubject = stats.BySubject.ToDictionary(s => s.SubjectId);
            foreach (var group in _studentGroups)
            {
                var total = 0;
                var done = 0;
                try
                {
                    var subjects = await Api.SubjectsAsync(group.Id);
                    foreach (var subject in subjects)
                    {
                        if (bySubject.TryGetValue(subject.Id, out var st))
                        {
                            total += st.TotalContents;
                            done += st.CompletedContents;
                        }
                    }
                }
                catch { /* fənn gəlməzsə 0 */ }

                _groupProgress[group.Id] = total > 0 ? (int)Math.Round(done * 100.0 / total) : 0;
            }
        }
        catch
        {
            // API əlçatmazsa boş qalır
        }

        _loading = false;
    }
}

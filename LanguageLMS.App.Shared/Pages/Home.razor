@page "/"
@inject AppApi Api
@inject AuthState Auth

<PageTitle>LanguageLMS</PageTitle>

@if (_loading)
{
    <div class="flex min-h-screen items-center justify-center text-[#7b998e]">Yüklənir...</div>
}
else
{
    <header class="sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-[#e4eee9] bg-[#f8fbf9]/95 px-5 backdrop-blur lg:px-10">
        <div class="flex items-center gap-2.5">
            <div class="flex size-8 items-center justify-center rounded-full bg-[#d1fae5] text-[13px] font-bold text-[#064e3b]">@(Auth.User?.Initial ?? "L")</div>
            <span class="text-[13px] font-semibold text-[#315d4c]">@(Auth.User?.FullName ?? "Şagird")</span>
        </div>
        <button class="relative rounded-lg p-2 text-[#6f9183]" aria-label="Notifications">
            <Icon Name="bell" Class="size-[18px]" />
            <span class="absolute right-1.5 top-1.5 size-1.5 rounded-full bg-[#e48755]"></span>
        </button>
    </header>

    <main class="mx-auto max-w-[1180px] px-5 pb-28 pt-8 lg:px-10 lg:pb-12 lg:pt-12">
        <section class="mt-1">
            <div class="mb-3 flex items-center justify-between">
                <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#27815e]">Learning stories</p>
                <span class="text-[11px] text-[#91aaa0]">Swipe to explore</span>
            </div>
            <div class="-mx-5 flex gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none]">
                @foreach (var b in _banners)
                {
                    <button class="flex w-[66px] shrink-0 flex-col items-center gap-2 text-center">
                            <span class="rounded-full p-[3px] ring-2 ring-offset-2 ring-offset-[#f8fbf9]">
                            <img src="@b.Image" alt="" class="size-[54px] rounded-full object-cover" />
                        </span>
                        <span class="w-full truncate text-[10px] font-semibold text-[#5d8373]">@b.Title</span>
                    </button>
                }
            </div>
        </section>

        <section class="mt-10">
            <div class="mb-4 flex items-end justify-between">
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#27815e]">Your queue</p>
                    <h2 class="mt-1 text-[22px] font-semibold tracking-[-0.04em]">Continue learning</h2>
                </div>
                <a href="/courses" class="flex items-center gap-1 text-[12px] font-semibold text-[#27815e]">View all <Icon Name="chevron-right" Class="size-3.5" /></a>
            </div>
            <div class="grid gap-4 lg:grid-cols-2">
                @foreach (var c in ContinueItems)
                {
                    <article class="group flex overflow-hidden rounded-xl border border-[#deebe4] bg-white">
                        <div class="relative w-[112px] shrink-0 sm:w-[150px]">
                            @if (!string.IsNullOrEmpty(c.Image))
                            {
                                <img src="@c.Image" alt="" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center bg-[#dff5ed] text-3xl font-black text-[#16845a]">
                                    @(string.IsNullOrEmpty(c.Title) ? "?" : c.Title[..1].ToUpper())
                                </div>
                            }
                            <span class="absolute left-2.5 top-2.5 rounded bg-white/90 px-2 py-1 text-[9px] font-bold text-[#38715b]">@c.Category</span>
                        </div>
                        <div class="min-w-0 flex-1 p-4">
                            <p class="text-[10px] font-medium text-[#94aaa1]">@c.Meta</p>
                            <h3 class="mt-2 line-clamp-2 text-[14px] font-semibold leading-5 text-[#244e3e]">@c.Title</h3>
                            <div class="mt-5 flex items-center gap-3">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-[#e8f0eb]">
                                    <div class="h-full rounded-full bg-[#27815e]" style="width:@(c.Progress)%"></div>
                                </div>
                                <span class="text-[11px] font-bold text-[#27815e]">@(c.Progress)%</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="mt-10 grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-xl border border-[#deebe4] bg-white p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-[15px] font-semibold">Upcoming</h2>
                        <p class="mt-1 text-[11px] text-[#8aa39a]">This week</p>
                    </div>
                    <Icon Name="calendar" Class="size-[18px] text-[#6c9a85]" />
                </div>
                <div class="mt-5 flex items-center gap-3 border-t border-[#edf3ef] pt-4">
                    <div class="w-10 shrink-0 text-center"><p class="text-[10px] font-bold uppercase text-[#27815e]">May</p><p class="text-lg font-semibold leading-5">24</p></div>
                    <div class="min-w-0 flex-1"><p class="truncate text-[13px] font-semibold">Design systems workshop</p><p class="mt-1 flex items-center gap-1 text-[11px] text-[#8aa39a]"><Icon Name="clock" Class="size-3" /> 10:00 AM · 60 min</p></div>
                </div>
                <div class="mt-4 flex items-center gap-3 border-t border-[#edf3ef] pt-4">
                    <div class="w-10 shrink-0 text-center"><p class="text-[10px] font-bold uppercase text-[#d18137]">May</p><p class="text-lg font-semibold leading-5">27</p></div>
                    <div class="min-w-0 flex-1"><p class="truncate text-[13px] font-semibold">Quiz deadline</p><p class="mt-1 flex items-center gap-1 text-[11px] text-[#8aa39a]"><Icon Name="file" Class="size-3" /> @(_quizCount) imtahan</p></div>
                </div>
            </div>
            <div class="rounded-xl bg-[#173d30] p-5 text-white">
                <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#a5d8c2]">Learning streak</p>
                <p class="mt-6 text-4xl font-semibold tracking-[-0.06em]">12 days</p>
                <p class="mt-2 text-[12px] leading-5 text-[#a6c6b8]">You are building a consistent habit. Keep it going.</p>
                <div class="mt-6 flex gap-1.5">
                    @foreach (var active in new[] { 1, 1, 1, 1, 1, 1, 0 })
                    {
                        <span class="size-2 rounded-full @(active == 1 ? "bg-[#7dd3a9]" : "bg-[#416957]")"></span>
                    }
                </div>
            </div>
        </section>
    </main>
}

@code {
    private bool _loading = true;
    private int _quizCount;
    private List<BannerResponse> _banners = new List<BannerResponse>();

    private record ContinueCard(string Title, string Category, string Meta, int Progress, string? Image);

    private List<ContinueCard> ContinueItems { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var quizzes = await Api.QuizzesAsync();
            _banners = await Api.BannersAsync();
            _quizCount = quizzes.Count;

            var progress = await Api.ProgressAsync();
            foreach (var item in progress.Items.Take(4))
            {
                ContinueItems.Add(new ContinueCard(
                    item.LessonTitle, "Dərs", $"{item.CompletedContents} / {item.TotalContents} material",
                    item.ProgressPercent, null));
            }
        }
        catch { /* API əlçatmazsa demo data */ }

        if (ContinueItems.Count == 0)
        {
            ContinueItems.Add(new ContinueCard("UI/UX Design Fundamentals", "Design", "12 of 18 lessons", 68,
                "https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&fit=crop&w=900&q=85"));
            ContinueItems.Add(new ContinueCard("Modern JavaScript from Zero", "Development", "8 of 20 lessons", 42,
                "https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=900&q=85"));
        }

        _loading = false;
    }
}

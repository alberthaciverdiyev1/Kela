@page "/courses/{GroupId:long}"
@inject AppApi Api

<PageTitle>Course</PageTitle>

<header class="flex h-[72px] items-center justify-between border-b border-[#e5f0eb] bg-[#f6faf8] px-5">
    <a href="/courses" class="flex size-10 items-center justify-center rounded-full bg-white text-[#4c806d] shadow-sm"><Icon Name="arrow-left" Class="size-5" /></a>
    <h1 class="text-[18px] font-bold tracking-[-0.04em] text-[#214d3d] @(Name is null ? "" : "max-w-[220px] truncate")">@(Name ?? "Course")</h1>
    <span class="size-10"></span>
</header>

<div class="px-5 pb-28 pt-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#1e9a6a]">Subjects</p>
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-[#214d3d]">Fənlər</h2>

    @if (_loading) { <p class="mt-6 text-sm text-[#8aa39a]">Yüklənir...</p> }
    else if (_subjects.Count == 0) { <p class="mt-6 text-sm text-[#8aa39a]">Bu qrupda fənn yoxdur.</p> }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @foreach (var s in _subjects)
            {
                <a href="/subjects/@s.Id" class="flex items-center gap-4 rounded-2xl border border-[#e2eee8] bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
                    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#e0f5ec] text-[#16845a]"><Icon Name="book" Class="size-5" /></div>
                    <p class="min-w-0 flex-1 truncate text-[14px] font-semibold text-[#244e3e]">@s.Name</p>
                    <Icon Name="chevron-right" Class="size-4 text-[#a8bdb4]" />
                </a>
            }
        </section>
    }
</div>

@code {
    [Parameter] public long GroupId { get; set; }
    private bool _loading = true;
    private List<Subject> _subjects = new();
    private string? Name;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var groups = await Api.GroupsAsync();
            Name = groups.FirstOrDefault(g => g.Id == GroupId)?.Name;
            _subjects = await Api.SubjectsAsync(GroupId);
        }
        catch { }
        _loading = false;
    }
}

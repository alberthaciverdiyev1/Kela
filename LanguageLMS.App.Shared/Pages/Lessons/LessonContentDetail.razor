@page "/lessons/{LessonId:long}/content/{ContentId:long}"
@implements IDisposable
@inject AppApi Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AudioPlayerService Player

<PageTitle>Material</PageTitle>

<PageHeader Title="@(_content?.TypeLabel ?? "Material")" Back="javascript:history.back()"/>

<div class="px-5 pb-28 pt-5">
    @if (_loading)
    {
        <Loader/>
    }
    else if (_content is null)
    {
        <EmptyState Text="Material tapılmadı."/>
    }
    else
    {
        <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@_content.Title</h2>

        @if (IsVideo)
        {
            <div class="mt-5 overflow-hidden rounded-2xl bg-black shadow-[0_6px_20px_rgba(23,61,48,0.12)]">
                <video @ref="_videoRef" controls playsinline preload="metadata" @onended="MarkAsync"
                       class="aspect-video w-full bg-black"></video>
            </div>
        }
        else if (IsVoice)
        {
            <div class="mt-5 rounded-2xl border border-brand-090 bg-white p-6 text-center">
                <button type="button" @onclick="PlayAudio"
                        class="mx-auto flex size-16 items-center justify-center rounded-full bg-brand-671 text-white shadow-lg transition hover:bg-brand-698">
                    <Icon Name="play" Class="ml-1 size-7" />
                </button>
                <p class="mt-3 text-[12px] text-sage-410">Aşağıdakı pleyerdə oynayır</p>
            </div>
        }
        else
        {
            <div class="mt-5 rounded-2xl border border-brand-090 bg-white p-4">
                <button type="button" @onclick="OpenDocument"
                        class="w-full rounded-xl bg-brand-671 py-3.5 text-sm font-bold text-white">Sənədi aç</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_content.Description))
        {
            <p class="mt-5 text-[13px] leading-5 text-sage-459">@_content.Description</p>
        }

        <div class="mt-6">
            <button type="button" @onclick="MarkAsync" disabled="@_done"
                    class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-[13px] font-bold @(_done ? "bg-brand-075 text-sage-410" : "bg-brand-081 text-brand-671")">
                <Icon Name="@(_done ? "check" : "chevron-right")" Class="size-4" />
                @(_done ? "Tamamlandı" : "Tamamlandı kimi işarələ")
            </button>
        </div>
    }
</div>

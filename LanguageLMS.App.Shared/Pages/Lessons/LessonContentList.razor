@page "/lessons/{LessonId:long}/contents/{Type}"
@inject AppApi Api

<PageTitle>@_categoryTitle</PageTitle>

<PageHeader Title="@_categoryTitle" Back="@($"/lessons/{LessonId}")"/>

<div class="px-5 pb-28 pt-5">
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@(Title ?? "Dərs")</h2>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_items.Count == 0)
    {
        <EmptyState Text="Bu bölmədə material yoxdur."/>
    }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @foreach (var c in _items)
            {
                <ContentCard Content="c" LessonId="LessonId"/>
            }
        </section>
    }
</div>

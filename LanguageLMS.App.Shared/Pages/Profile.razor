@page "/profile"
@inject AppApi Api
@inject AuthState Auth

<PageTitle>Profile</PageTitle>

<header class="flex h-[68px] items-center justify-between border-b border-[#e1ece6] px-5">
    <span class="rounded-lg p-2 text-[#668b7d]"><Icon Name="arrow-left" Class="size-5" /></span>
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#6e9182]">Profile</p>
    <span class="rounded-lg p-2 text-[#668b7d]"><Icon Name="settings" Class="size-5" /></span>
</header>

<section class="border-b border-[#dfece5] px-5 pb-8 pt-8">
    <div class="flex items-start gap-4">
        <div class="relative shrink-0">
            <div class="flex size-[82px] items-center justify-center rounded-full bg-[#d1fae5] text-3xl font-black text-[#064e3b]">@(Auth.User?.Initial ?? "L")</div>
            <span class="absolute -bottom-1 -right-1 flex size-7 items-center justify-center rounded-full bg-[#176c4b] text-white ring-4 ring-[#f8fbf9]"><Icon Name="edit" Class="size-3" /></span>
        </div>
        <div class="min-w-0 pt-1">
            <h1 class="text-[24px] font-semibold tracking-[-0.055em]">@(Auth.User?.FullName ?? "Şagird")</h1>
            <p class="mt-1 text-[13px] text-[#7b998e]">@(Auth.User?.Email ?? "")</p>
            <p class="mt-3 text-[11px] font-medium text-[#9aafa7]">@(Auth.User?.Phone ?? "")</p>
        </div>
    </div>
    <div class="mt-7 grid grid-cols-3 divide-x divide-[#dfece5] border-y border-[#dfece5] py-4 text-center">
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_groups</p><p class="mt-1 text-[10px] text-[#8aa39a]">Courses</p></div>
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_quizzes</p><p class="mt-1 text-[10px] text-[#8aa39a]">Exams</p></div>
        <div><p class="text-xl font-semibold tracking-[-0.04em]">@_completed</p><p class="mt-1 text-[10px] text-[#8aa39a]">Completed</p></div>
    </div>
</section>

<section class="px-5 pt-7">
    <div class="mb-4"><p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#27815e]">Milestones</p><h2 class="mt-1 text-[20px] font-semibold tracking-[-0.04em]">Achievements</h2></div>
    <div class="-mx-5 flex gap-3 overflow-x-auto px-5 pb-1">
        <div class="min-w-[158px] border-l-2 border-[#dfece5] pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-[#fff1df] text-[#d8873b]"><Icon Name="flame" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">7 day streak</h3><p class="mt-1 text-[10px] text-[#8aa39a]">Keep it going</p>
        </div>
        <div class="min-w-[158px] border-l-2 border-[#dfece5] pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-[#e8f7ef] text-[#1e9a6a]"><Icon Name="trophy" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">First milestone</h3><p class="mt-1 text-[10px] text-[#8aa39a]">3 courses completed</p>
        </div>
        <div class="min-w-[158px] border-l-2 border-[#dfece5] pl-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-[#eef0fb] text-[#687cc7]"><Icon Name="award" Class="size-4" /></div>
            <h3 class="mt-3 text-[12px] font-semibold">Top learner</h3><p class="mt-1 text-[10px] text-[#8aa39a]">Top 10% this month</p>
        </div>
    </div>
</section>

<section class="px-5 pt-8 pb-28">
    <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[#27815e]">Account</p>
    <div class="divide-y divide-[#e8f0eb] border-y border-[#e8f0eb]">
        <div class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-[#edf8f2] text-[#1e9a6a]"><Icon Name="book" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">My courses</span><span class="mt-0.5 block text-[10px] text-[#8aa39a]">@_groups active</span></span>
            <Icon Name="chevron-right" Class="size-4 text-[#a8bdb4]" />
        </div>
        <div class="flex w-full items-center gap-3 py-4 text-left">
            <span class="flex size-8 items-center justify-center rounded-lg bg-[#edf8f2] text-[#1e9a6a]"><Icon Name="shield" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold">Privacy & security</span><span class="mt-0.5 block text-[10px] text-[#8aa39a]">Protected</span></span>
            <Icon Name="chevron-right" Class="size-4 text-[#a8bdb4]" />
        </div>
        <button class="flex w-full items-center gap-3 py-4 text-left" @onclick="Logout">
            <span class="flex size-8 items-center justify-center rounded-lg bg-[#fdeceb] text-[#c0392b]"><Icon Name="settings" Class="size-4" /></span>
            <span class="flex-1"><span class="block text-[13px] font-semibold text-[#c0392b]">Log out</span><span class="mt-0.5 block text-[10px] text-[#8aa39a]">Sign out of your account</span></span>
            <Icon Name="chevron-right" Class="size-4 text-[#a8bdb4]" />
        </button>
    </div>
</section>

@code {
    private int _groups;
    private int _quizzes;
    private int _completed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _groups = (await Api.GroupsAsync()).Count;
            _quizzes = (await Api.QuizzesAsync()).Count;
            var progress = await Api.ProgressAsync();
            _completed = progress.Items.Sum(i => i.CompletedContents);
        }
        catch { }
    }

    private async Task Logout()
    {
        try { await Api.LogoutAsync(); } catch { }
        Auth.Clear();
    }
}

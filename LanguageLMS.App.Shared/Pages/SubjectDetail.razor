@page "/subjects/{SubjectId:long}"
@inject AppApi Api

<PageTitle>Lessons</PageTitle>

<header class="flex h-[72px] items-center justify-between border-b border-brand-080 bg-brand-027 px-5">
    <a href="/courses" class="flex size-10 items-center justify-center rounded-full bg-white text-brand-600 shadow-sm"><Icon Name="arrow-left" Class="size-5" /></a>
    <h1 class="max-w-[220px] truncate text-[18px] font-bold tracking-[-0.04em] text-brand-784">Dərslər</h1>
    <span class="size-10"></span>
</header>

<div class="px-5 pb-28 pt-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Lessons</p>
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">Dərslər</h2>

    @if (_loading) { <p class="mt-6 text-sm text-sage-410">Yüklənir...</p> }
    else if (_lessons.Count == 0) { <p class="mt-6 text-sm text-sage-410">Bu fənn üzrə dərs yoxdur.</p> }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @foreach (var (l, i) in _lessons.Select((l, i) => (l, i)))
            {
                <a href="/lessons/@l.Id" class="flex items-center gap-4 rounded-2xl border border-brand-090 bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
                    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-sky-061 text-[12px] font-bold text-sky-531">@(i + 1)</div>
                    <p class="min-w-0 flex-1 truncate text-[14px] font-semibold text-brand-776">@l.Title</p>
                    <Icon Name="chevron-right" Class="size-4 text-sage-300" />
                </a>
            }
        </section>
    }
</div>

@code {
    [Parameter] public long SubjectId { get; set; }
    private bool _loading = true;
    private List<Lesson> _lessons = new();

    protected override async Task OnInitializedAsync()
    {
        try { _lessons = await Api.LessonsAsync(SubjectId); } catch { }
        _loading = false;
    }
}

@page "/groups/{GroupId:long}"
@inject AppApi Api
@inject NavigationManager Nav

<PageTitle>Qrup</PageTitle>

<PageHeader Title="@(Name ?? "Qrup")" Back="/groups"/>

<div class="px-5 pb-28 pt-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Subjects</p>
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">Fənlər</h2>

    @if (_loading) { <Loader/> }
    else if (_subjects.Count == 0) { <EmptyState Text="Bu qrupda fənn yoxdur."/> }
    else
    {
        <section class="mt-5 flex flex-col gap-3">
            @foreach (var s in _subjects)
            {
                <SubjectCard Subject="s"/>
            }
        </section>
    }
</div>

@code {
    [Parameter] public long GroupId { get; set; }
    private bool _loading = true;
    private List<SubjectDto> _subjects = new();
    private string? Name;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var groups = await Api.StudentGroupsAsync();
            Name = groups.FirstOrDefault(g => g.Id == GroupId)?.Name;
            _subjects = await Api.SubjectsAsync(GroupId);

            // Qrupda tək fənn varsa, fənn siyahısını göstərmədən birbaşa dərslərə keç
            if (_subjects.Count == 1)
            {
                Nav.NavigateTo($"/subjects/{_subjects[0].Id}", replace: true);
                return;
            }
        }
        catch { }
        _loading = false;
    }
}

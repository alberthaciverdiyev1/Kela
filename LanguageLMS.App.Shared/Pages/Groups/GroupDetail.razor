@page "/groups/{GroupId:long}"
@inject AppApi Api
@inject NavigationManager Nav

<PageTitle>Qrup</PageTitle>

<PageHeader Title="Fənlər" Back="/groups"/>

<div class="px-5 pb-28 pt-6">
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@(Name ?? "Qrup")</h2>

    @if (_loading) { <Loader/> }
    else if (_subjects.Count == 0) { <EmptyState Text="Bu qrupda fənn yoxdur."/> }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var s in _subjects)
            {
                <SubjectCard Subject="s"/>
            }
        </section>
    }
</div>

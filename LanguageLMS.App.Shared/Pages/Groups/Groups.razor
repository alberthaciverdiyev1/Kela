@page "/groups"
@inject AppApi Api

<PageTitle>Qruplar</PageTitle>

<PageHeader Title="Qruplar" Back="/">
    <Right>
        <button class="relative rounded-xl p-2 text-sage-478" aria-label="Bildirişlər">
            <Icon Name="bell" Class="size-[19px]" />
            <span class="absolute right-1.5 top-1.5 size-1.5 rounded-full bg-sun-367"></span>
        </button>
    </Right>
</PageHeader>

<div class="px-5 pb-28 pt-6">
    <div class="mt-7 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-639">Browse library</p>
            <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">Bütün qruplar</h2>
        </div>
    </div>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_groups.Count == 0)
    {
        <EmptyState Text="Hələ qrupunuz yoxdur."/>
    }
    else
    {
        <section class="mt-5 flex flex-col gap-4">
            @for (var i = 0; i < _groups.Count; i++)
            {
                <GroupCard Group="_groups[i]" Index="i"/>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<GroupResponse> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        try { _groups = await Api.StudentGroupsAsync(); } catch { }
        _loading = false;
    }
}

@page "/document"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Sənəd</PageTitle>

<PageHeader Title="@(string.IsNullOrWhiteSpace(_title) ? "Sənəd" : _title)" Back="javascript:history.back()" Sticky="true"/>

@if (string.IsNullOrEmpty(_url))
{
    <EmptyState Text="Sənəd tapılmadı." Class="px-5 py-10 text-sm text-sage-410"/>
}
else
{
    <div @ref="_pdfRef" class="min-h-[60vh] select-none bg-white p-3"
         @oncontextmenu="() => { }" @oncontextmenu:preventDefault="true"></div>
}

@page "/document"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Sənəd</PageTitle>

<PageHeader Title="@(string.IsNullOrWhiteSpace(_title) ? "Sənəd" : _title)" Back="javascript:history.back()" Sticky="true"/>

@if (string.IsNullOrEmpty(_url))
{
    <EmptyState Text="Sənəd tapılmadı." Class="px-5 py-10 text-sm text-sage-410"/>
}
else
{
    <div @ref="_pdfRef" class="min-h-[60vh] select-none bg-white p-3"
         @oncontextmenu="() => { }" @oncontextmenu:preventDefault="true"></div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "url")] public string? UrlQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "title")] public string? TitleQuery { get; set; }

    private string? _url;
    private string? _title;
    private ElementReference _pdfRef;
    private string? _attached;

    protected override void OnParametersSet()
    {
        _url = UrlQuery;
        _title = TitleQuery;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(_url) && _attached != _url)
        {
            _attached = _url;
            await JS.InvokeVoidAsync("lmsPdf.render", _pdfRef, _url);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("lmsPdf.clear", _pdfRef); } catch { /* noop */ }
    }
}

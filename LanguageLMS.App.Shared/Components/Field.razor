<div class="flex flex-col gap-2 text-xs font-bold text-brand-645">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label>@Label</label>
    }
    <span class="flex items-center gap-3 rounded-2xl border border-brand-108 bg-white px-4 py-3.5 focus-within:border-brand-467 focus-within:ring-4 focus-within:ring-brand-098">
        @ChildContent
    </span>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

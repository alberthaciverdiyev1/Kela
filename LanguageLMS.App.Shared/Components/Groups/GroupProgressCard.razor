@* Qrup kartı (üfiqi, progress ilə) — Home səhifəsi üçün. *@
<a href="/groups/@Group.Id" class="group flex overflow-hidden rounded-xl border border-brand-104 bg-white">
    <div class="relative w-[112px] shrink-0 sm:w-[150px]">
        @if (Group.HasImage)
        {
            <img src="@Group.Image" alt="" class="h-full w-full object-cover" />
        }
        else
        {
            <div class="flex h-full w-full items-center justify-center bg-brand-083 text-3xl font-black text-brand-698">@Group.Initial</div>
        }
        <span class="absolute left-2.5 top-2.5 rounded bg-white/90 px-2 py-1 text-[9px] font-bold text-brand-669">@Group.StudentCount şagird</span>
    </div>
    <div class="min-w-0 flex-1 p-4">
        <p class="text-[10px] font-medium text-sage-376">@Group.Description</p>
        <h3 class="mt-2 line-clamp-2 text-[14px] font-semibold leading-5 text-brand-776">@Group.Name</h3>
        <div class="mt-5 flex items-center gap-3">
            <div class="h-1 flex-1 overflow-hidden rounded-full bg-brand-075">
                <div class="h-full rounded-full bg-brand-671" style="width:@(Group.ProgressPercent)%"></div>
            </div>
            <span class="text-[11px] font-bold text-brand-671">@(Group.ProgressPercent)%</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public GroupDto Group { get; set; } = default!;
}

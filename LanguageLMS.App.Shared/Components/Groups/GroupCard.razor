@* Qrup kartı (şaquli) — Groups (siyahı) səhifəsi üçün. *@
<a href="/groups/@Group.Id" class="block overflow-hidden rounded-2xl border border-brand-090 bg-white shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
    <div class="relative flex h-[132px] items-center justify-center overflow-hidden @Tone">
        @if (Group.HasImage)
        {
            <img src="@Group.Image" alt="" class="absolute inset-0 h-full w-full object-cover" />
        }
        else
        {
            <span class="text-5xl font-black @ToneText">@Group.Initial</span>
        }
        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold text-brand-643">Qrup</span>
        <span class="absolute bottom-3 right-3 flex size-10 items-center justify-center rounded-full bg-white text-brand-639 shadow-md"><Icon Name="play" Class="ml-0.5 size-4" /></span>
    </div>
    <div class="p-4">
        <h3 class="font-bold leading-5 tracking-[-0.02em] text-brand-776">@Group.Name</h3>
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-medium text-sage-382">
            <span class="text-brand-698">@(string.IsNullOrWhiteSpace(Group.Description) ? "Ümumi" : Group.Description)</span>
            <span class="flex items-center gap-1"><Icon Name="users" Class="size-3" />@Group.StudentCount tələbə</span>
        </div>
        <span class="mt-4 inline-flex items-center gap-1 text-[12px] font-bold text-brand-639">Dərslərə bax <Icon Name="chevron-right" Class="size-3.5" /></span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public GroupResponse Group { get; set; } = default!;
    [Parameter] public int Index { get; set; }

    private string Tone => (Index % 4) switch { 0 => "bg-brand-083", 1 => "bg-sky-061", 2 => "bg-sun-069", _ => "bg-grape-051" };
    private string ToneText => (Index % 4) switch { 0 => "text-brand-698", 1 => "text-sky-531", 2 => "text-sun-529", _ => "text-grape-447" };
}

@* Instagram üslubunda story viewer: banner-ləri tam ekran açır, avtomatik irəli keçir. *@
@implements IDisposable

@if (Banners.Count > 0)
{
    var current = Banners[_index];
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm"
         @onclick="CloseAsync">
        <div class="relative h-[100dvh] w-full max-w-[440px] overflow-hidden bg-black sm:h-[90vh] sm:rounded-2xl"
             @onclick:stopPropagation="true">

            @* Yuxarı qara örtük — yazılar oxunsun *@
            <div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-40"
                 style="background:linear-gradient(to bottom, rgba(0,0,0,.8), rgba(0,0,0,.25) 55%, transparent)"></div>

            @* Seqmentli progress bar (safe-area) *@
            <div class="absolute inset-x-0 top-0 z-30 flex gap-1 px-3"
                 style="padding-top: calc(env(safe-area-inset-top) + 12px)">
                @for (var i = 0; i < Banners.Count; i++)
                {
                    var idx = i;
                    <div class="h-[3px] flex-1 overflow-hidden rounded-full bg-white/30">
                        @if (idx < _index)
                        {
                            <div class="h-full w-full bg-white"></div>
                        }
                        else if (idx == _index)
                        {
                            <div @key="_index" class="h-full bg-white"
                                 style="width:0;animation:storybar @(DurationSeconds)s linear forwards"></div>
                        }
                    </div>
                }
            </div>

            @* Başlıq + bağla (safe-area) *@
            <div class="absolute inset-x-0 z-30 flex items-center gap-3 px-4"
                 style="top: calc(env(safe-area-inset-top) + 26px)">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-103 text-[12px] font-bold text-brand-835">
                    @(string.IsNullOrWhiteSpace(current.Title) ? "L" : current.Title[..1].ToUpper())
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-[13px] font-semibold text-white">@current.Title</p>
                    <p class="text-[10px] text-white/60">@(current.IsNew ? "Yeni" : "Banner")</p>
                </div>
                <button type="button" class="rounded-full p-1.5 text-white/80 transition hover:bg-white/10 hover:text-white"
                        @onclick="CloseAsync" aria-label="Bağla">
                    <Icon Name="x" Class="size-5" />
                </button>
            </div>

            @* Şəkil *@
            <img @key="_index" src="@current.Image" alt="@current.Title"
                 class="h-full w-full object-cover" style="animation:storyfade .25s ease-out" />

            @* Aşağı qara örtük — yazı oxunsun *@
            <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 p-5"
                 style="padding-bottom: calc(env(safe-area-inset-bottom) + 20px); background:linear-gradient(to top, rgba(0,0,0,.85), rgba(0,0,0,.3) 50%, transparent)">
                <p class="text-[15px] font-semibold leading-6 text-white">@current.Title</p>
            </div>

            @* Toxunma zonaları: sol = geri, sağ = irəli *@
            <button type="button" class="absolute left-0 top-0 z-10 h-full w-1/3" @onclick="Prev" aria-label="Əvvəlki"></button>
            <button type="button" class="absolute right-0 top-0 z-10 h-full w-1/3" @onclick="Next" aria-label="Növbəti"></button>
        </div>
    </div>
}

<style>
    @@keyframes storybar {
        from { width: 0; }
        to { width: 100%; }
    }
    @@keyframes storyfade {
        from { opacity: .4; transform: scale(1.01); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@* Dərs materialı sətri — LessonDetail üçün. *@
<div class="flex items-center gap-4 rounded-2xl border border-brand-090 bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-081 text-brand-698"><Icon Name="@IconName" Class="size-5" /></div>
    <div class="min-w-0 flex-1">
        <p class="truncate text-[14px] font-semibold text-brand-776">@Content.Title</p>
        <p class="mt-0.5 text-[11px] text-sage-382">@Content.TypeLabel@(Content.DurationSeconds is > 0 ? $" · {Content.DurationSeconds}s" : "")</p>
    </div>
    @if (ShowOpen)
    {
        <button type="button" @onclick="OnOpen" class="rounded-lg px-2.5 py-1.5 text-[12px] font-bold text-brand-639">Aç</button>
    }
    <button type="button" @onclick="OnMark" disabled="@Done" class="rounded-lg px-2.5 py-1.5 text-[12px] font-bold @(Done ? "text-sage-410" : "text-brand-671")">
        @(Done ? "✓ Tamam" : "Tamamlandı")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public ContentItemDto Content { get; set; } = default!;
    [Parameter] public bool Done { get; set; }
    [Parameter] public bool ShowOpen { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnMark { get; set; }

    private string IconName => Content.Type switch
    {
        "video" => "play",
        "file" => "file",
        "voice" => "chart",
        _ => "book"
    };
}

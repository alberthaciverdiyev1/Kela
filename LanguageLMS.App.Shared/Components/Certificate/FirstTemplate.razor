
<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Certificate of Achievement</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet"/>
</head>

<body class="min-h-screen bg-slate-100 flex items-center justify-center p-4">

  <!-- Certificate -->
  <div class="relative w-full max-w-[1056px] aspect-[1056/746] bg-white overflow-hidden shadow-xl border border-gray-200">

    <!-- Background decorative waves -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none"
         viewBox="0 0 1056 746"
         preserveAspectRatio="none">

      <!-- Top-right waves -->
      <path d="M635 8 H1048 V94 C987 49 939 34 866 35 C771 41 699 27 635 8Z"
            fill="#fff4bf"/>
      <path d="M650 8 H1048 V73 C994 39 937 28 860 31 C769 34 705 23 650 8Z"
            fill="#238a43"/>
      <path d="M714 8 H1048 V48 C970 19 884 21 808 24 C769 24 740 15 714 8Z"
            fill="#11532c"/>
      <path d="M884 38 C957 28 1008 49 1048 68 V94 C1004 64 953 46 884 38Z"
            fill="#ffbf00"/>

      <!-- Bottom-left decoration -->
      <path d="M5 373 C70 502 157 625 340 741 H5Z"
            fill="#fff4c2"/>
      <path d="M5 428 C83 550 177 660 352 741 H5Z"
            fill="#ffc400"/>
      <path d="M5 463 C100 593 211 690 366 741 H5Z"
            fill="#258b43"/>
      <path d="M5 663 C96 711 174 733 258 741 H5Z"
            fill="#11532c"/>

      <!-- Bottom curved layers -->
      <path d="M270 690 C515 781 828 746 1051 522 V741 H270Z"
            fill="#fff5c6"/>
      <path d="M300 701 C551 780 851 737 1051 557 V741 H300Z"
            fill="#ffc400"/>
      <path d="M322 713 C580 779 869 726 1051 585 V741 H322Z"
            fill="#268d43"/>
      <path d="M350 724 C611 775 885 716 1051 615 V741 H350Z"
            fill="#12542e"/>
      <path d="M810 741 C914 718 992 692 1051 664 V741Z"
            fill="#268d43"/>
    </svg>

    <!-- Medal -->
    <div class="absolute top-[10.5%] left-[5.7%] w-[12%] aspect-square">
      <!-- Ribbons -->
      <div class="absolute top-[64%] left-[9%] w-[37%] h-[78%] bg-gradient-to-r from-amber-500 via-yellow-200 to-amber-500 -rotate-[23deg]"
           style="clip-path:polygon(0 0,100% 0,100% 100%,50% 76%,0 100%)"></div>
      <div class="absolute top-[64%] right-[9%] w-[37%] h-[78%] bg-gradient-to-r from-amber-500 via-yellow-200 to-amber-500 rotate-[23deg]"
           style="clip-path:polygon(0 0,100% 0,100% 100%,50% 76%,0 100%)"></div>

      <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#ffe49a] via-[#bc822c] to-[#f9d77b] p-[4%] shadow-lg">
        <div class="w-full h-full rounded-full bg-gradient-to-br from-[#333333] to-[#111111] flex items-center justify-center">
          <span class="font-['Playfair_Display'] text-white font-bold text-[clamp(12px,2.5vw,27px)]">
            2026
          </span>
        </div>
      </div>
    </div>

    <!-- Header -->
    <header class="absolute top-[12.5%] left-[22%] w-[57%] text-center">
      <h1 class="font-['Playfair_Display'] font-extrabold text-[#10512b] text-[clamp(22px,6.3vw,70px)] leading-none tracking-tight">
        CERTIFICATE
      </h1>

      <div class="flex items-center justify-center gap-[1%] mt-[3%]">
        <div class="h-[2px] bg-[#195b32] flex-1"></div>
        <h2 class="font-['Playfair_Display'] font-bold text-[#10512b] whitespace-nowrap text-[clamp(10px,2.7vw,31px)]">
          OF ACHIEVEMENT
        </h2>
        <div class="h-[2px] bg-[#195b32] flex-1"></div>
      </div>
    </header>

    <!-- Recipient -->
    <main class="absolute top-[40.3%] left-[24%] w-[52%] text-center">
      <h3 class="text-[#a58042] italic font-medium text-[clamp(20px,5.5vw,60px)] leading-tight">
        Jala Əzimli
      </h3>

      <div class="w-full h-[2px] bg-[#155b35] mt-[3.5%]"></div>

      <p class="font-['DM_Sans'] text-[#454545] text-[clamp(9px,1.85vw,20px)] leading-[1.25] mt-[2%]">
        A certificate is awarded to an individual who has attained a
        specific accomplishment or achievement, whether in
        professional endeavors, projects, or training.
      </p>
    </main>

    <!-- Signatures -->
    <div class="absolute top-[65%] left-[24%] w-[53%] h-[22%] flex justify-between items-end">

      <div class="text-center">
        <div class="h-[75px]"></div>
        <p class="font-['Playfair_Display'] text-[clamp(11px,2.3vw,25px)] text-[#1a1a1a]">
          Estelle Darcy
        </p>
        <p class="font-['DM_Sans'] text-gray-600 text-[clamp(9px,1.6vw,17px)]">
          Advisor
        </p>
      </div>

      <div class="text-center">
        <!-- Decorative signature -->
        <svg viewBox="0 0 140 90" class="w-[110px] h-[75px] mx-auto mb-1">
          <path d="M20 77 L23 5 L32 67 L44 38 L47 76
                   Q57 22 62 45 Q69 79 84 62
                   Q111 12 129 39 Q140 61 106 76
                   Q87 83 72 63"
                fill="none"
                stroke="#333"
                stroke-width="1.4"
                stroke-linecap="round"/>
        </svg>
        <p class="font-['Playfair_Display'] text-[clamp(11px,2.3vw,25px)] text-[#1a1a1a]">
          Bailey Dupont
        </p>
        <p class="font-['DM_Sans'] text-gray-600 text-[clamp(9px,1.6vw,17px)]">
          Organizer
        </p>
      </div>
    </div>

  </div>
</body>
</html>

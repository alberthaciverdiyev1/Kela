
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Certificate of Excellence</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    @@page {
      size: A4 landscape;
      margin: 0;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
    }

    .serif {
      font-family: 'Playfair Display', Georgia, serif;
    }

    .certificate {
      width: 1122px;
      height: 794px;
      position: relative;
      overflow: hidden;
      background: #faf9f6;
    }

    @@media print {
      html, body {
        margin: 0;
        padding: 0;
        background: white !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .certificate {
        width: 297mm;
        height: 210mm;
        box-shadow: none !important;
      }
    }
  </style>
</head>

<body class="min-h-screen bg-[#e8e9ec] flex items-center justify-center p-6">

  <div class="certificate shadow-2xl">

    <!-- Outer navy frame -->
    <div class="absolute inset-0 border-[13px] border-[#14283b] pointer-events-none"></div>

    <!-- Inner gold frame -->
    <div class="absolute inset-[23px] border border-[#c3a46a]/70 pointer-events-none"></div>

    <!-- Decorative corners -->
    <svg class="absolute top-[23px] left-[23px] w-28 h-28" viewBox="0 0 120 120">
      <path d="M0 100 V0 H100" fill="none" stroke="#b9985e" stroke-width="3"/>
      <path d="M15 70 V15 H70" fill="none" stroke="#b9985e" stroke-width="1"/>
      <circle cx="15" cy="15" r="4" fill="#b9985e"/>
    </svg>

    <svg class="absolute top-[23px] right-[23px] w-28 h-28 rotate-90" viewBox="0 0 120 120">
      <path d="M0 100 V0 H100" fill="none" stroke="#b9985e" stroke-width="3"/>
      <path d="M15 70 V15 H70" fill="none" stroke="#b9985e" stroke-width="1"/>
      <circle cx="15" cy="15" r="4" fill="#b9985e"/>
    </svg>

    <svg class="absolute bottom-[23px] right-[23px] w-28 h-28 rotate-180" viewBox="0 0 120 120">
      <path d="M0 100 V0 H100" fill="none" stroke="#b9985e" stroke-width="3"/>
      <path d="M15 70 V15 H70" fill="none" stroke="#b9985e" stroke-width="1"/>
      <circle cx="15" cy="15" r="4" fill="#b9985e"/>
    </svg>

    <svg class="absolute bottom-[23px] left-[23px] w-28 h-28 -rotate-90" viewBox="0 0 120 120">
      <path d="M0 100 V0 H100" fill="none" stroke="#b9985e" stroke-width="3"/>
      <path d="M15 70 V15 H70" fill="none" stroke="#b9985e" stroke-width="1"/>
      <circle cx="15" cy="15" r="4" fill="#b9985e"/>
    </svg>

    <!-- Subtle watermark -->
    <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.045] w-[510px] h-[510px]"
         viewBox="0 0 400 400">
      <circle cx="200" cy="200" r="160" fill="none" stroke="#14283b" stroke-width="10"/>
      <circle cx="200" cy="200" r="135" fill="none" stroke="#14283b" stroke-width="2"/>
      <path d="M200 85 L228 165 L313 165 L245 216 L270 300 L200 250 L130 300 L155 216 L87 165 L172 165Z"
            fill="#14283b"/>
    </svg>

    <!-- Organization -->
    <div class="absolute top-[62px] left-0 right-0 flex flex-col items-center">

      <div class="w-[58px] h-[58px] rounded-full border border-[#b9985e] flex items-center justify-center">
        <svg width="35" height="35" viewBox="0 0 40 40" fill="none">
          <path d="M20 3 L35 11 V29 L20 37 L5 29 V11Z"
                stroke="#b9985e" stroke-width="1.6"/>
          <path d="M13 27 V13 L20 22 L27 13 V27"
                stroke="#14283b" stroke-width="2.3"
                stroke-linejoin="round"/>
        </svg>
      </div>

      <p class="mt-3 text-[11px] font-bold tracking-[0.38em] text-[#14283b] uppercase">
        Kela Academy
      </p>

      <p class="mt-1 text-[9px] tracking-[0.2em] text-[#9b865f] uppercase">
        Education & Excellence
      </p>
    </div>

    <!-- Main title -->
    <div class="absolute top-[204px] left-0 right-0 text-center">

      <div class="flex justify-center items-center gap-4">
        <div class="w-[55px] h-px bg-[#b9985e]"></div>
        <span class="text-[10px] tracking-[0.42em] font-semibold text-[#a28b65] uppercase">
          Official Recognition
        </span>
        <div class="w-[55px] h-px bg-[#b9985e]"></div>
      </div>

      <h1 class="serif text-[61px] leading-[1.2] text-[#14283b] mt-3">
        Certificate
      </h1>

      <p class="serif italic text-[27px] text-[#b9985e] mt-[-3px]">
        of Excellence
      </p>

    </div>

    <!-- Recipient -->
    <div class="absolute top-[370px] left-[120px] right-[120px] text-center">

      <p class="text-[13px] tracking-[0.12em] text-[#777d82]">
        This certificate is proudly presented to
      </p>

      <h2 class="serif text-[48px] text-[#14283b] mt-4 leading-tight">
        Jala Əzimli
      </h2>

      <div class="mx-auto w-[440px] h-px bg-gradient-to-r from-transparent via-[#b9985e] to-transparent mt-4"></div>

      <p class="text-[14px] text-[#656d74] mt-5 leading-[1.9] max-w-[690px] mx-auto">
        In recognition of outstanding dedication and successful completion
        of the <span class="font-bold text-[#14283b]">Advanced English Language Program</span>,
        demonstrating commitment to continuous learning and academic excellence.
      </p>

    </div>

    <!-- Bottom signatures -->
    <div class="absolute bottom-[96px] left-[110px] right-[110px] flex items-end justify-between">

      <!-- Date -->
      <div class="w-[220px] text-center">
        <p class="serif text-[20px] text-[#14283b] italic">
          October 13, 2026
        </p>
        <div class="h-px bg-[#b9985e] mt-2"></div>
        <p class="text-[10px] tracking-[0.18em] uppercase text-[#72777b] mt-3">
          Date of Issue
        </p>
      </div>

      <!-- Gold seal -->
      <div class="relative w-[112px] h-[112px] flex items-center justify-center -mb-2">

        <svg viewBox="0 0 120 120" class="absolute inset-0 w-full h-full">
          <path d="M60 3 L69 11 L81 7 L87 18 L100 18 L103 31 L115 37 L111 49 L118 60 L111 71 L115 83 L103 89 L100 102 L87 102 L81 113 L69 109 L60 117 L51 109 L39 113 L33 102 L20 102 L17 89 L5 83 L9 71 L2 60 L9 49 L5 37 L17 31 L20 18 L33 18 L39 7 L51 11Z"
                fill="#c4a16a"/>
          <circle cx="60" cy="60" r="43" fill="none" stroke="#fff6e6" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="35" fill="none" stroke="#fff6e6" stroke-width="0.7"/>
          <path d="M60 31 L67 50 L87 50 L71 62 L77 81 L60 69 L43 81 L49 62 L33 50 L53 50Z"
                fill="#fff6e6"/>
        </svg>

      </div>

      <!-- Signature -->
      <div class="w-[220px] text-center">
        <svg class="w-[145px] h-[40px] mx-auto mb-1" viewBox="0 0 180 55" fill="none">
          <path d="M8 40 C22 9 29 12 27 38 C40 13 47 12 43 39
                   C58 19 65 21 60 40 C76 13 83 19 78 38
                   C96 9 101 29 93 41 C112 24 118 25 125 38
                   C141 16 151 24 169 30"
                stroke="#14283b" stroke-width="2"
                stroke-linecap="round"/>
        </svg>
        <div class="h-px bg-[#b9985e] mt-2"></div>
        <p class="text-[10px] tracking-[0.18em] uppercase text-[#72777b] mt-3">
          Authorized Signature
        </p>
      </div>
    </div>

    <!-- Footer -->
    <div class="absolute bottom-[46px] left-0 right-0 text-center">
      <p class="text-[10px] tracking-[0.15em] text-[#9a9b9c]">
        CERTIFICATE ID: KELA-2026-001284
      </p>
    </div>

  </div>

</body>
</html>

@* Nəticə kartı — Results siyahısı üçün. *@
<a href="/results/@Result.AttemptId" class="flex items-center gap-4 rounded-2xl border border-brand-090 bg-white p-4 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
    <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-081 text-[12px] font-bold text-brand-698">@(Result.ScorePercent)%</div>
    <div class="min-w-0 flex-1">
        <p class="truncate text-[14px] font-semibold text-brand-776">@Result.QuizTitle</p>
        <p class="mt-0.5 text-[11px] text-sage-382">@Result.CorrectCount/@Result.TotalQuestions düzgün</p>
    </div>
    <Icon Name="chevron-right" Class="size-4 text-sage-300" />
</a>

@code {
    [Parameter, EditorRequired] public QuizResultSummaryDto Result { get; set; } = default!;
}

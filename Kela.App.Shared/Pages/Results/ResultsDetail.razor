@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/results/{AttemptId:long}"
@inject AppApi Api

<PageTitle>@L["Result_Detail"]</PageTitle>

<PageHeader Title="@L["Result_Detail"]" Back="/results"/>

@if (_loading)
{
    <div class="px-5 pb-28 pt-6">
        <div class="rounded-[24px] bg-brand-836 p-6">
            <div class="flex items-start justify-between gap-3">
                <Skeleton Class="h-3 w-40 rounded-md bg-white/20"/>
                <Skeleton Class="h-5 w-16 rounded-full bg-white/20"/>
            </div>
            <Skeleton Class="mt-4 h-12 w-32 rounded-md bg-white/20"/>
            <Skeleton Class="mt-3 h-3 w-48 rounded-md bg-white/20"/>
            <div class="mt-5 grid grid-cols-3 gap-3 border-t border-white/10 pt-4">
                <div class="flex flex-col items-center gap-1.5">
                    <Skeleton Class="h-6 w-10 rounded-md bg-white/20"/>
                    <Skeleton Class="h-2.5 w-14 rounded-md bg-white/20"/>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                    <Skeleton Class="h-6 w-10 rounded-md bg-white/20"/>
                    <Skeleton Class="h-2.5 w-14 rounded-md bg-white/20"/>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                    <Skeleton Class="h-6 w-10 rounded-md bg-white/20"/>
                    <Skeleton Class="h-2.5 w-14 rounded-md bg-white/20"/>
                </div>
            </div>
            <Skeleton Class="mt-5 h-1.5 w-full rounded-full bg-white/20"/>
        </div>

        <Skeleton Class="mt-8 h-3 w-32 rounded-md"/>
        <section class="mt-3 grid gap-3 sm:grid-cols-2">
            @for (var i = 0; i < 4; i++)
            {
                <div class="rounded-2xl border border-brand-090 bg-white p-4">
                    <Skeleton Class="h-3.5 w-3/4 rounded-md"/>
                    <Skeleton Class="mt-3 h-3 w-full rounded-md"/>
                    <Skeleton Class="mt-2 h-3 w-5/6 rounded-md"/>
                </div>
            }
        </section>
    </div>
}
else if (_detail is null)
{
    <EmptyState Text="@L["Result_NotFound"]" Class="px-5 py-10 text-sm text-sage-410"/>
}
else
{
    <div class="px-5 pb-28 pt-6">
        <div class="rounded-[24px] bg-brand-836 p-6 text-white">
            <div class="flex items-start justify-between gap-3">
                <p class="min-w-0 flex-1 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-253">@_detail.QuizTitle</p>
                <span class="shrink-0 rounded-full bg-white/15 px-2.5 py-1 text-[10px] font-bold text-white">@Level</span>
            </div>

            <p class="mt-4 text-5xl font-semibold tracking-[-0.06em]">@_detail.ScorePercent%</p>
            <p class="mt-2 text-[12px] text-brand-286">@DateLabel · @DurationLabel</p>

            <div class="mt-5 grid grid-cols-3 gap-3 border-t border-white/10 pt-4 text-center">
                <div><p class="text-xl font-semibold tracking-[-0.04em]">@_detail.CorrectCount</p><p class="text-[10px] text-brand-286">@L["Result_Correct"]</p></div>
                <div><p class="text-xl font-semibold tracking-[-0.04em]">@Wrong</p><p class="text-[10px] text-brand-286">@L["Result_Wrong"]</p></div>
                <div><p class="text-xl font-semibold tracking-[-0.04em]">@_detail.TotalQuestions</p><p class="text-[10px] text-brand-286">@L["Result_Questions"]</p></div>
            </div>

            <div class="mt-5 flex items-center gap-3">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-white/15">
                    <div class="h-full rounded-full bg-brand-341" style="width:@(_detail.ScorePercent)%"></div>
                </div>
                <span class="text-[11px] font-bold text-brand-341">@(_detail.ScorePercent)%</span>
            </div>

            <p class="mt-3 text-[11px] text-brand-286">@string.Format(L["Result_Score"], Score)</p>
        </div>

        <p class="mt-8 text-xs font-bold uppercase tracking-[0.14em] text-brand-639">@L["Result_Answers"]</p>
        <section class="mt-3 grid gap-3 sm:grid-cols-2">
            @for (var i = 0; i < _detail.Items.Count; i++)
            {
                <AnswerCard Item="_detail.Items[i]" Number="@(i + 1)"/>
            }
        </section>
    </div>
}

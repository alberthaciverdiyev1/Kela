@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/contact"
@inject AppApi Api

<PageTitle>@L["Contact_Title"]</PageTitle>

<PageHeader Title="@L["Contact_Title"]" Back="/profile"/>

<div @key="_loading" class="px-5 pb-28 pt-6 @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <section class="rounded-2xl border border-brand-090 bg-white p-5 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
            <div class="flex items-center gap-3">
                <Skeleton Class="size-12 rounded-xl"/>
                <Skeleton Class="h-5 w-44 rounded-md"/>
            </div>
            <Skeleton Class="mt-3 h-3 w-full rounded-md"/>
            <Skeleton Class="mt-2 h-3 w-5/6 rounded-md"/>
            <Skeleton Class="mt-3 h-3 w-1/2 rounded-md"/>
            <Skeleton Class="mt-4 h-9 w-32 rounded-xl"/>
        </section>
    }
    else
    {
        @* --- Yuxarı: kurs (tenant) --- *@
        @if (_course is not null)
        {
            <section class="rounded-2xl border border-brand-090 bg-white p-5 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(_course.Logo))
                    {
                        <img src="@_course.Logo" alt="" class="size-12 rounded-xl object-cover"/>
                    }
                    <h2 class="text-xl font-bold tracking-[-0.03em] text-brand-784">@(string.IsNullOrWhiteSpace(_course.Name) ? L["Contact_Title"] : _course.Name)</h2>
                </div>

                @if (!string.IsNullOrWhiteSpace(_course.Description))
                {
                    <p class="mt-3 whitespace-pre-line text-[13px] leading-6 text-sage-382">@_course.Description</p>
                }

                @if (!string.IsNullOrWhiteSpace(_course.Address))
                {
                    <p class="mt-3 text-[13px] text-brand-776">@_course.Address</p>
                }

                <ContactChannels Contact="_course"/>
            </section>
        }

        @* --- Aşağı: platforma (admin) --- *@
        @if (_platform is not null && HasChannels(_platform))
        {
            <h3 class="mt-8 px-1 text-sm font-bold uppercase tracking-wider text-sage-382">@L["Contact_Support"]</h3>
            <section class="mt-3 rounded-2xl border border-brand-090 bg-white p-5 shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
                @if (!string.IsNullOrWhiteSpace(_platform.Description))
                {
                    <p class="mb-1 whitespace-pre-line text-[13px] leading-6 text-sage-382">@_platform.Description</p>
                }
                <ContactChannels Contact="_platform"/>
            </section>
        }
    }
</div>

@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/subjects/{SubjectId:long}"
@inject AppApi Api

<PageTitle>@L["Lessons_Title"]</PageTitle>

<PageHeader Title="@L["Lessons_Title"]" Back="/groups"/>

<div class="px-5 pb-28 pt-6">
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@(Name ?? L["Subject_Default"])</h2>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_lessons.Count == 0)
    {
        <EmptyState Text="@L["SubjectDetail_Empty"]"/>
    }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @for (var i = 0; i < _lessons.Count; i++)
            {
                <LessonCard Lesson="_lessons[i]" Index="@(i + 1)"/>
            }
        </section>
    }
</div>

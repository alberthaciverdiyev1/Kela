@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/exams"
@inject AppApi Api

<PageTitle>@L["Exams_Title"]</PageTitle>

<PageHeader Title="@L["Exams_Title"]" Back="/">
    <Right>
        <a href="/results" class="rounded-xl p-2 text-sage-478" aria-label="@L["Nav_Results"]"><Icon Name="clipboard-check" Class="size-[19px]" /></a>
    </Right>
</PageHeader>

<div class="px-5 pb-28 pt-6">
    <h2 class="text-xl font-bold tracking-[-0.04em] text-brand-784">@L["Exams_Available"]</h2>

    @* --- Filter --- *@
    <div class="mt-4 flex flex-wrap gap-2">
        @foreach (var (key, label) in new[] { ("all", L["Exams_All"]), ("general", L["Exams_General"]), ("lesson", L["Exams_ByLesson"]) })
        {
            var k = key;
            <button type="button" @onclick="() => SetMode(k)"
                    class="rounded-full border px-4 py-1.5 text-[13px] font-semibold transition @(_mode == k ? "border-brand-698 bg-brand-081 text-brand-698" : "border-brand-090 bg-white text-sage-382 hover:bg-brand-022")">
                @label
            </button>
        }
    </div>

    @if (_mode == "lesson" && Lessons.Any())
    {
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var lesson in Lessons)
            {
                var lid = lesson.Id;
                <button type="button" @onclick="() => _lessonId = lid"
                        class="rounded-full border px-3.5 py-1 text-[12px] font-medium transition @(_lessonId == lid ? "border-brand-698 bg-brand-081 text-brand-698" : "border-brand-090 bg-white text-sage-382 hover:bg-brand-022")">
                    @lesson.Title
                </button>
            }
        </div>
    }

    @if (_loading)
    {
        <Loader/>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Text="@L["Exams_Empty"]"/>
    }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var q in Filtered)
            {
                <QuizCard Quiz="q"/>
            }
        </section>
    }
</div>

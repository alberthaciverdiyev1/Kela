@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/exams/{QuizId:long}"
@inject AppApi Api
@inject NavigationManager Nav

<PageTitle>@L["Nav_Exam"]</PageTitle>

<PageHeader Title="@(_quiz?.Title ?? L["Nav_Exam"])" Back="/exams"/>

<div class="px-5 pb-28 pt-6">
    @if (_error is not null) { <p class="text-sm text-danger-539">@_error</p> }
    else if (_result is not null)
    {
        <div class="rounded-[24px] bg-brand-836 p-6 text-white">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-253">@L["Result_Detail"]</p>
            <p class="mt-4 text-5xl font-semibold tracking-[-0.06em]">@_result.ScorePercent%</p>
            <p class="mt-2 text-[13px] text-brand-286">@L.Format("Exam_CorrectOf", _result.CorrectCount, _result.TotalQuestions)</p>
        </div>
        <a href="/results" class="mt-5 block rounded-2xl bg-brand-639 py-4 text-center text-sm font-bold text-white">@L["Exam_GoResults"]</a>
    }
    else if (_quiz is null)
    {
        <div class="flex items-center justify-between">
            <Skeleton Class="h-3 w-28 rounded-md"/>
            <Skeleton Class="h-6 w-20 rounded-full"/>
        </div>
        <Skeleton Class="mt-4 h-6 w-3/4 rounded-md"/>
        <div class="mt-5 flex flex-col gap-2">
            @for (var i = 0; i < 4; i++)
            {
                <div class="flex items-center gap-3 rounded-2xl border border-brand-108 bg-white px-4 py-3">
                    <Skeleton Class="size-4 shrink-0 rounded-full"/>
                    <Skeleton Class="h-3.5 w-2/3 rounded-md"/>
                </div>
            }
        </div>
        <div class="mt-6 flex gap-3">
            <Skeleton Class="h-[50px] flex-1 rounded-2xl"/>
            <Skeleton Class="h-[50px] flex-1 rounded-2xl"/>
        </div>
    }
    else if (_quiz.Questions.Count == 0) { <EmptyState Text="@L["Exam_NoQuestions"]"/> }
    else
    {
        var q = _quiz.Questions[_index];
        var isLast = _index == _quiz.Questions.Count - 1;

        <div class="flex items-center justify-between">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-639">@L.Format("Exam_QuestionOf", _index + 1, _quiz.Questions.Count)</p>
            @if (_quiz.DurationMinutes > 0)
            {
                <div class="flex items-center gap-1.5 rounded-full px-3 py-1 text-[13px] font-bold @(_remaining <= 60 ? "bg-[#fdecef] text-[#c0392b]" : "bg-brand-081 text-brand-639")">
                    <Icon Name="clock" Class="size-4"/>
                    <span>@FormatTime(_remaining)</span>
                </div>
            }
        </div>
        @if (q.HasTitleImage)
        {
            <img src="@q.TitleUrl" alt="" class="mx-auto mt-3 max-h-[38vh] w-auto max-w-full rounded-2xl border border-brand-090 object-contain" />
        }
        else if (!string.IsNullOrWhiteSpace(q.Title))
        {
            <h2 class="mt-2 text-[19px] font-semibold leading-6 text-brand-804">@q.Title</h2>
        }

        <div class="mt-5 flex flex-col gap-2">
            @foreach (var o in q.Options)
            {
                <label class="flex items-center gap-3 rounded-2xl border border-brand-108 bg-white px-4 py-3 @(IsSelected(q.Id, o.Key) ? "border-brand-467 ring-4 ring-brand-098" : "")">
                    <input type="radio" name="q_@q.Id" checked="@IsSelected(q.Id, o.Key)" @onchange="() => _answers[q.Id] = o.Key" class="size-4 shrink-0 accent-brand-639" />
                    @if (!string.IsNullOrWhiteSpace(o.Url))
                    {
                        <img src="@o.Url" alt="" class="h-16 w-16 shrink-0 rounded-xl border border-brand-090 object-cover" />
                    }
                    else
                    {
                        <span class="text-sm font-medium text-brand-755">@o.Key) @o.Text</span>
                    }
                </label>
            }
        </div>

        <div class="mt-6 flex gap-3">
            <button @onclick="Prev" disabled="@(_index == 0)" class="flex-1 rounded-2xl border border-brand-108 bg-white py-3.5 text-sm font-bold text-brand-727 disabled:opacity-50">@L["Exam_Prev"]</button>
            <button @onclick="NextAsync" disabled="@_busy" class="flex-1 rounded-2xl bg-brand-639 py-3.5 text-sm font-bold text-white disabled:opacity-60">
                @(isLast ? (_busy ? L["Login_Wait"] : L["Exam_Finish"]) : L["Exam_Next"])
            </button>
        </div>
    }

    @* --- Vaxt bitdi modalı --- *@
    @if (_timeUp)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
            <div class="w-full max-w-sm rounded-[24px] bg-white p-6 text-center shadow-2xl">
                <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-[#fdecef] text-[#c0392b]">
                    <Icon Name="clock" Class="size-7"/>
                </div>
                <p class="mt-4 text-lg font-bold text-brand-804">@L["Exam_TimeUp"]</p>
                <p class="mt-2 text-[13px] leading-5 text-sage-382">@L["Exam_TimeUpHint"]</p>
                <button type="button" class="mt-5 w-full rounded-2xl bg-brand-639 py-3.5 text-sm font-bold text-white active:opacity-90" @onclick="CloseTimeUpAndSubmitAsync">@L["Exam_SeeResults"]</button>
            </div>
        </div>
    }
</div>

@page "/exams/{QuizId:long}"
@inject AppApi Api
@inject NavigationManager Nav

<PageTitle>İmtahan</PageTitle>

<PageHeader Title="@(_quiz?.Title ?? "İmtahan")" Back="/exams"/>

<div class="px-5 pb-28 pt-6">
    @if (_error is not null) { <p class="text-sm text-danger-539">@_error</p> }
    else if (_result is not null)
    {
        <div class="rounded-[24px] bg-brand-836 p-6 text-white">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-253">Result</p>
            <p class="mt-4 text-5xl font-semibold tracking-[-0.06em]">@_result.ScorePercent%</p>
            <p class="mt-2 text-[13px] text-brand-286">@_result.CorrectCount / @_result.TotalQuestions düzgün</p>
        </div>
        <a href="/results" class="mt-5 block rounded-2xl bg-brand-639 py-4 text-center text-sm font-bold text-white">Nəticələrə keç</a>
    }
    else if (_quiz is null) { <Loader/> }
    else if (_quiz.Questions.Count == 0) { <EmptyState Text="Bu imtahanda sual yoxdur."/> }
    else
    {
        var q = _quiz.Questions[_index];
        var isLast = _index == _quiz.Questions.Count - 1;

        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-639">Sual @(_index + 1)/@_quiz.Questions.Count</p>
        <h2 class="mt-2 text-[19px] font-semibold leading-6 text-brand-804">@q.Title</h2>

        <div class="mt-5 flex flex-col gap-2">
            @foreach (var o in q.Options)
            {
                <label class="flex items-center gap-3 rounded-2xl border border-brand-108 bg-white px-4 py-3.5 @(IsSelected(q.Id, o.Key) ? "border-brand-467 ring-4 ring-brand-098" : "")">
                    <input type="radio" name="q_@q.Id" checked="@IsSelected(q.Id, o.Key)" @onchange="() => _answers[q.Id] = o.Key" class="size-4 accent-brand-639" />
                    <span class="text-sm font-medium text-brand-755">@o.Key) @o.Text</span>
                </label>
            }
        </div>

        <div class="mt-6 flex gap-3">
            <button @onclick="Prev" disabled="@(_index == 0)" class="flex-1 rounded-2xl border border-brand-108 bg-white py-3.5 text-sm font-bold text-brand-727 disabled:opacity-50">Əvvəlki</button>
            <button @onclick="NextAsync" disabled="@_busy" class="flex-1 rounded-2xl bg-brand-639 py-3.5 text-sm font-bold text-white disabled:opacity-60">
                @(isLast ? (_busy ? "Gözləyin..." : "Bitir") : "Növbəti")
            </button>
        </div>
    }
</div>

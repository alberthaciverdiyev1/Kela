@inherits RefreshablePage
@using Kela.App.Shared.Services.Localization
@inject Localizer L
@page "/attendance"
@inject AppApi Api

<PageTitle>@L["Attendance_MyTitle"]</PageTitle>

<PageHeader Title="@L["Attendance_MyTitle"]" Back="/profile"/>

<div @key="_loading" class="px-5 pb-28 pt-6 @(!_loading ? "page-fade" : null)">
    @if (_loading)
    {
        <Skeleton Class="h-9 w-full rounded-xl"/>
        <Skeleton Class="mt-4 h-[290px] w-full rounded-2xl"/>
    }
    else if (_groups.Count == 0)
    {
        <EmptyState Text="@L["Attendance_None"]"/>
    }
    else
    {
        @if (_groups.Count > 1)
        {
            <div class="-mx-5 mb-4 flex gap-2 overflow-x-auto px-5 pb-1 [scrollbar-width:none]">
                @foreach (var g in _groups)
                {
                    var id = g.Id;
                    <button type="button" @onclick="() => SelectGroupAsync(id)"
                            class="shrink-0 rounded-full border px-4 py-1.5 text-[13px] font-semibold transition @(_groupId == id ? "border-brand-698 bg-brand-081 text-brand-698" : "border-brand-090 bg-white text-sage-382")">
                        @g.Name
                    </button>
                }
            </div>
        }

        <div class="rounded-2xl border border-brand-090 bg-white p-4">
            <div class="flex items-center justify-between">
                <button type="button" @onclick="PrevMonthAsync" class="rounded-xl p-2 text-sage-473" aria-label="previous">
                    <Icon Name="chevron-right" Class="size-5 rotate-180" />
                </button>
                <p class="text-[15px] font-bold tracking-[-0.02em] text-brand-784">@MonthLabel</p>
                <button type="button" @onclick="NextMonthAsync" class="rounded-xl p-2 text-sage-473" aria-label="next">
                    <Icon Name="chevron-right" Class="size-5" />
                </button>
            </div>

            <div class="mt-3 grid grid-cols-7 gap-1">
                @foreach (var w in Weekdays)
                {
                    <span class="text-center text-[10px] font-bold uppercase tracking-wide text-sage-410">@w</span>
                }
            </div>

            <div class="mt-1 grid grid-cols-7 gap-1">
                @for (var i = 0; i < Leading; i++)
                {
                    <span></span>
                }
                @for (var day = 1; day <= DaysInMonth; day++)
                {
                    var d = day;
                    <div class="flex aspect-square items-center justify-center rounded-xl text-[13px] font-semibold @DayClass(d)">
                        @d
                    </div>
                }
            </div>
        </div>

        <p class="mt-4 text-center text-[12px] font-semibold text-sage-410">
            @string.Format(L["Attendance_MyMonthSummary"], _presentCount, _totalCount)
        </p>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-[11px] text-sage-410">
            <span class="flex items-center gap-1.5"><i class="size-2.5 rounded-full bg-brand-341"></i>@L["Attendance_Present"]</span>
            <span class="flex items-center gap-1.5"><i class="size-2.5 rounded-full bg-danger-539"></i>@L["Attendance_Absent"]</span>
            <span class="flex items-center gap-1.5"><i class="size-2.5 rounded-full bg-brand-100"></i>@L["Attendance_LegendNone"]</span>
        </div>
    }
</div>

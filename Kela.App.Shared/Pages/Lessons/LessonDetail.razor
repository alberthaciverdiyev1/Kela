@page "/lessons/{LessonId:long}"
@inject AppApi Api

<PageTitle>Materiallar</PageTitle>

<PageHeader Title="Materiallar" Back="javascript:history.back()"/>

<div class="px-5 pb-28 pt-5">
    <h2 class="mt-1 text-2xl font-bold tracking-[-0.04em] text-brand-784">@(Title ?? "Dərs")</h2>

    @if (_loading)
    {
        <Loader/>
    }
    else if (_contents.Count == 0 && _quizzes.Count == 0)
    {
        <EmptyState Text="Bu dərs üzrə material yoxdur."/>
    }
    else
    {
        <section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @if (_videos.Count > 0)
            {
                <SectionCard Icon="play" Title="Video dərslər" Subtitle="@($"{_videos.Count} video")"
                             Href="@($"/lessons/{LessonId}/contents/video")"/>
            }
            @if (_files.Count > 0)
            {
                <SectionCard Icon="file" Title="PDF-lər" Subtitle="@($"{_files.Count} material")"
                             Href="@($"/lessons/{LessonId}/contents/file")" Tone="bg-sun-063 text-sun-461"/>
            }
            @if (_voices.Count > 0)
            {
                <SectionCard Icon="chart" Title="Səs yazıları" Subtitle="@($"{_voices.Count} audio")"
                             Href="@($"/lessons/{LessonId}/contents/voice")" Tone="bg-sky-041 text-sky-406"/>
            }
            @if (_quizzes.Count > 0)
            {
                <SectionCard Icon="clipboard-check" Title="Quizlər" Subtitle="@($"{_quizzes.Count} quiz")"
                             Href="@($"/lessons/{LessonId}/quizzes")"/>
            }
        </section>
    }
</div>

@* Kart şəbəkəsi iskeleti — Groups/Subjects/Lessons/Quizzes/Results kimi
   səhifələrin kart siyahısını gözləyərkən formasını saxlayır.
   Tile: GroupCard kimi şaquli (şəkilli) kart, əks halda LessonCard kimi sətir kartı. *@
<section class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    @for (var i = 0; i < Count; i++)
    {
        <div class="overflow-hidden rounded-2xl border border-brand-090 bg-white shadow-[0_4px_15px_rgba(36,78,62,0.03)]">
            @if (Tile)
            {
                <Skeleton Class="h-[132px] w-full"/>
                <div class="p-4">
                    <Skeleton Class="h-4 w-2/3 rounded-md"/>
                    <div class="mt-3 flex gap-3">
                        <Skeleton Class="h-3 w-20 rounded-md"/>
                        <Skeleton Class="h-3 w-14 rounded-md"/>
                    </div>
                    <Skeleton Class="mt-4 h-3 w-28 rounded-md"/>
                </div>
            }
            else
            {
                <div class="flex items-center gap-4 p-4">
                    <Skeleton Class="size-11 shrink-0 rounded-xl"/>
                    <div class="min-w-0 flex-1">
                        <Skeleton Class="h-3.5 w-3/4 rounded-md"/>
                        <Skeleton Class="mt-2 h-3 w-1/3 rounded-md"/>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public int Count { get; set; } = 4;
    [Parameter] public bool Tile { get; set; }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject ApiClient ApiClient
@inject AppApi Api
@inject TokenStore Store
@inject IScreenGuard ScreenGuard
@inject PushTokenService Push

@using Kela.App.Shared.Services.Localization
@inject Localizer Lang

@if (!_ready)
{
    <Loader/>
}
else if (!Auth.IsAuthenticated)
{
    <Login/>
}
else
{
    <div class="min-h-screen bg-brand-102 text-brand-836">
        <TopNav/>
        <div class="mx-auto min-h-screen w-full max-w-[430px] overflow-x-hidden bg-brand-022 shadow-[0_0_60px_rgba(23,77,58,0.12)] md:max-w-none md:px-8 md:shadow-none">
            @* Dil dəyişəndə səhifə məzmunu da dərhal yenidən render olunsun *@
            <div @key="Lang.Current">
                @Body
            </div>
            <BottomNav/>
            <AudioPlayerBar/>
        </div>
    </div>
}

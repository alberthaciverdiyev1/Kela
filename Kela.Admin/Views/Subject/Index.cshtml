@{
    ViewData["Title"] = L["Nav_Subjects"];
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Subject_Create"],
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = L["Subject_Total"],
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4' />"
        }
    })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Subject_Search"],
            Sort = new FilterSortModel { },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/subject/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Name"] },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel {
    Title = L["Subject_Create"],
    WidthClass = "max-w-md",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

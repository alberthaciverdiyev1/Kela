@using Kela.Core.Modules.Tenant.Responses
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Login_Title"];
    var tenantList = ViewData["Tenants"] as IReadOnlyList<TenantResponse> ?? new List<TenantResponse>();
    var tenantOptions = tenantList.Select(t => new SelectOption { Value = t.Id.ToString(), Text = t.Name }).ToList();
}
<div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-lg">
    <div class="mb-6 flex items-center gap-3">
        <div class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white shadow-sm">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
        </div>
        <div>
            <p class="text-lg font-extrabold leading-none tracking-tight text-slate-900">Kela</p>
            <p class="mt-1 text-xs font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
        </div>
    </div>

    @if (ViewData["Error"] is string err)
    {
        <div class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600">@err</div>
    }

    <form method="post" action="/login" class="space-y-4">
        @Html.AntiForgeryToken()
        <partial name="Ui/_Select" model="@(new SelectModel { NativeRequired = true, Name = "TenantId", Id = "tenantId", Label = L["Common_Tenant"], Required = true, Options = tenantOptions })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
        <button type="submit" class="admin-button-primary w-full">@L["Common_SignIn"]</button>
    </form>
</div>

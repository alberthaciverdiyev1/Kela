<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kela.Nodes.App.Views.DashboardView">

  <StackPanel Spacing="16">
    <TextBlock Text="Dashboard" Classes="h1" />

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <Border Grid.Row="0" Grid.Column="0" Classes="card" Margin="0,0,8,8">
        <StackPanel Spacing="6">
          <TextBlock Text="Worker" Classes="label" />
          <TextBlock Text="{Binding WorkerState}" Classes="metric" />
          <TextBlock Text="{Binding Encoder}" Classes="value" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Classes="card" Margin="8,0,0,8">
        <StackPanel Spacing="6">
          <TextBlock Text="Paralel iş (icra / icazə)" Classes="label" />
          <TextBlock Text="{Binding Concurrency}" Classes="metric" />
          <TextBlock Text="{Binding DeviceSummary}" Classes="value" />
          <TextBlock Text="Kodlaşdırma zolaqları" Classes="label" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Lanes}" Classes="value" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="card" Margin="0,8,0,0">
        <StackPanel Spacing="10">
          <TextBlock Text="Cari konversiya" Classes="label" />
          <TextBlock Text="{Binding CurrentJob}" Classes="value" FontWeight="SemiBold" />

          <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="8" />
          <TextBlock Text="{Binding Progress}" Classes="value" />

          <Border Background="{DynamicResource PageBackground}" CornerRadius="8" Padding="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0">
                <TextBlock Text="Mənbə fayl" Classes="label" />
                <TextBlock Text="{Binding SourceName}" Classes="value" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Endirmə" Classes="label" HorizontalAlignment="Right" />
                <TextBlock Classes="value" HorizontalAlignment="Right">
                  <Run Text="{Binding Transfer}" /><Run Text="  ·  " /><Run Text="{Binding TransferSpeed}" />
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Kodlama sürəti" Classes="label" />
              <TextBlock Text="{Binding Fps}" Classes="value" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Sürət (realtime)" Classes="label" />
              <TextBlock Text="{Binding Speed}" Classes="value" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Qalan vaxt" Classes="label" />
              <TextBlock Text="{Binding Eta}" Classes="value" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Resurs istifadəsi" Classes="label" />
        <Grid ColumnDefinitions="*,*,*,*">
          <StackPanel Grid.Column="0">
            <TextBlock Text="CPU (worker)" Classes="label" />
            <TextBlock Text="{Binding Cpu}" Classes="value" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="GPU" Classes="label" />
            <TextBlock Text="{Binding Gpu}" Classes="value" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Yaddaş" Classes="label" />
            <TextBlock Text="{Binding Ram}" Classes="value" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="Disk" Classes="label" />
            <TextBlock Text="{Binding Disk}" Classes="value" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="İcra olunan işlər" Classes="label" />

        <ItemsControl ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="120,90,*,90" Margin="0,4">
                <TextBlock Grid.Column="0" Text="{Binding Resolution}" Classes="value" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Stage}" Classes="value" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="value" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Fps, StringFormat='{}{0:0.#} fps'}" Classes="value" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Hazırda iş yoxdur" Classes="label" IsVisible="{Binding !HasJobs}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

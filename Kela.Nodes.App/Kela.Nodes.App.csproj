<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android başlığı ayrıca qurulur: dotnet build -p:BuildAndroid=true -->
    <TargetFrameworks Condition="'$(BuildAndroid)' == 'true'">net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildAndroid)' != 'true'">net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Android" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kela.Nodes.Worker\Kela.Nodes.Worker.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- Masaüstü başlanğıcı Android-də MainActivity ilə əvəz olunur. -->
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!--
      ffmpeg/ffprobe "lib*.so" adı ilə verilir: Android ikililəri yalnız APK-nın
      native kitabxana qovluğundan icra etməyə icazə verir.
    -->
    <AndroidNativeLibrary Include="Platforms/Android/jniLibs/arm64-v8a/*.so" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android'">
    <!-- Android-ə xas fayllar masaüstü quruluşuna düşmür. -->
    <Compile Remove="Platforms/Android/**/*.cs" />
    <None Remove="Platforms/Android/**" />
    <AndroidResource Remove="Resources/**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>com.kela.nodes</ApplicationId>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!--
      Debug quruluşu default olaraq "Fast Deployment" işlədir: assembly-lər APK-ya
      salınmır, ayrıca cihaza köçürülməsini gözləyir. Adi 'adb install' ilə
      quraşdırılan tətbiq açılışda "No assemblies found" ilə çökür — ona görə
      assembly-lər həmişə APK-ya gömülür.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

</Project>

@{
    ViewData["Title"] = "Qruplar";
    var teachers = (PagedResponse<UserResponse>)ViewData["Teachers"]!;
    var teacherOptions = new List<SelectOption> { new() { Value = "", Text = "— Müəllim seçilməyib —" } };
    teacherOptions.AddRange(teachers.Data.Select(u => new SelectOption { Value = u.Id.ToString(), Text = $"{u.Name} {u.Surname}".Trim() }));
}
<script>window.TEACHERS = { @Html.Raw(string.Join(",", teachers.Data.Select(u => $"{u.Id}:\"{System.Text.Json.JsonEncodedText.Encode(($"{u.Name} {u.Surname}".Trim()))}\""))) }; </script>

<div class="mb-5 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-800">Qruplar</h2>
    <partial name="Ui/_Button" model="@(new ButtonModel { Text = "+ Yeni qrup", OnClick = "openCreate()" })" />
</div>

<div class="mb-4 flex items-end gap-2">
    <div class="w-64">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "search", Id = "search", Placeholder = "Ad üzrə axtar..." })" />
    </div>
    <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Axtar", Variant = "secondary", OnClick = "loadList(1)" })" />
</div>

<div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div id="listLoader" class="absolute inset-0 z-10 hidden items-center justify-center bg-white/70">
        <div class="h-9 w-9 animate-spin rounded-full border-4 border-slate-200 border-t-primary"></div>
    </div>
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Ad</th>
                <th class="px-4 py-3">Müəllim</th>
                <th class="px-4 py-3">Şagird</th>
                <th class="px-4 py-3 text-right">Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody id="rows" class="divide-y divide-slate-100"></tbody>
    </table>
</div>

<div id="pagination" class="mt-4 flex flex-wrap gap-2"></div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-lg rounded-xl bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 p-4">
            <h3 id="modalTitle" class="text-lg font-semibold text-slate-800">Yeni qrup</h3>
            <button type="button" onclick="closeModal()" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div id="formError" class="mx-6 mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600"></div>
        <form id="entityForm" class="space-y-4 p-6">
            <input type="hidden" id="entityId" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "name", Id = "name", Label = "Ad", Required = true })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "description", Id = "description", Label = "Təsvir" })" />
            <partial name="Ui/_Select" model="@(new SelectModel { Name = "user_id", Id = "user_id", Label = "Müəllim", Options = teacherOptions })" />
            <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "image", Id = "image", Label = "Şəkil", Accept = ".jpg,.jpeg,.png", Hint = "jpg/png, max 5MB" })" />
            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "İmtina", Variant = "secondary", OnClick = "closeModal()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Yadda saxla", Type = "submit" })" />
            </div>
        </form>
    </div>
</div>


<!-- Manage modal -->
<div id="manageModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl rounded-xl bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 p-4">
            <h3 id="manageTitle" class="text-lg font-semibold text-slate-800">İdarə</h3>
            <button type="button" onclick="closeManage()" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div class="flex gap-1 border-b border-slate-200 px-4 pt-3">
            <button type="button" data-tab="students" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('students')">Şagirdlər</button>
            <button type="button" data-tab="subjects" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('subjects')">Fənnlər</button>
            <button type="button" data-tab="quizzes" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('quizzes')">İmtahanlar</button>
        </div>
        <div class="max-h-[60vh] overflow-y-auto p-4">
            <div id="tab-students" class="manage-tab space-y-3">
                <div class="flex gap-2">
                    <select id="studentsSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
                    <button type="button" onclick="assignMember('students')" class="rounded-lg bg-primary px-4 py-2 text-sm text-white hover:bg-primary-600">Əlavə et</button>
                </div>
                <div id="studentsList" class="space-y-2"></div>
            </div>
            <div id="tab-subjects" class="manage-tab hidden space-y-3">
                <div class="flex gap-2">
                    <select id="subjectsSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
                    <button type="button" onclick="assignMember('subjects')" class="rounded-lg bg-primary px-4 py-2 text-sm text-white hover:bg-primary-600">Əlavə et</button>
                </div>
                <div id="subjectsList" class="space-y-2"></div>
            </div>
            <div id="tab-quizzes" class="manage-tab hidden space-y-3">
                <div class="flex gap-2">
                    <select id="quizzesSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
                    <button type="button" onclick="assignMember('quizzes')" class="rounded-lg bg-primary px-4 py-2 text-sm text-white hover:bg-primary-600">Əlavə et</button>
                </div>
                <div id="quizzesList" class="space-y-2"></div>
            </div>
        </div>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

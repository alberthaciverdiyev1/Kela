@{
    ViewData["Title"] = "İstifadəçilər";
    var typeFilter = new List<SelectOption>
    {
        new() { Value = "", Text = "Hamısı" },
        new() { Value = "admin", Text = "Admin" },
        new() { Value = "teacher", Text = "Müəllim" }
    };
    var typeOptions = new List<SelectOption>
    {
        new() { Value = "teacher", Text = "Müəllim" },
        new() { Value = "admin", Text = "Admin" }
    };
}

<div class="mb-5 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-800">İstifadəçilər</h2>
    <partial name="Ui/_Button" model="@(new ButtonModel { Text = "+ Yeni istifadəçi", OnClick = "openCreate()" })" />
</div>

<div class="mb-4 flex flex-wrap items-end gap-3">
    <div class="w-64">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "search", Id = "search", Placeholder = "Ad / email..." })" />
    </div>
    <div class="w-40">
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_type", Id = "filter_type", Label = "Tip", Options = typeFilter })" />
    </div>
    <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Axtar", Variant = "secondary", OnClick = "loadList(1)" })" />
</div>

<div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div id="listLoader" class="absolute inset-0 z-10 hidden items-center justify-center bg-white/70">
        <div class="h-9 w-9 animate-spin rounded-full border-4 border-slate-200 border-t-primary"></div>
    </div>
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Ad</th>
                <th class="px-4 py-3">Email</th>
                <th class="px-4 py-3">Telefon</th>
                <th class="px-4 py-3">Tip</th>
                <th class="px-4 py-3 text-right">Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody id="rows" class="divide-y divide-slate-100"></tbody>
    </table>
</div>

<div id="pagination" class="mt-4 flex flex-wrap gap-2"></div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-xl bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 p-4">
            <h3 id="modalTitle" class="text-lg font-semibold text-slate-800">Yeni istifadəçi</h3>
            <button type="button" onclick="closeModal()" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div id="formError" class="mx-6 mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600"></div>
        <form id="entityForm" class="space-y-4 p-6">
            <input type="hidden" id="entityId" />
            <div class="grid grid-cols-2 gap-4">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "name", Id = "name", Label = "Ad" })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "surname", Id = "surname", Label = "Soyad" })" />
            </div>
            <partial name="Ui/_Input" model="@(new InputModel { Name = "email", Id = "email", Label = "Email", Type = "email", Required = true })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "phoneNumber", Id = "phoneNumber", Label = "Telefon" })" />
            <partial name="Ui/_Select" model="@(new SelectModel { Name = "type", Id = "type", Label = "Tip", Options = typeOptions })" />
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Şifrə</label>
                <input id="password" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm" />
                <p id="passwordHint" class="mt-1 hidden text-xs text-slate-400">Boş buraxsan şifrə dəyişməz.</p>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "İmtina", Variant = "secondary", OnClick = "closeModal()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Yadda saxla", Type = "submit" })" />
            </div>
        </form>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

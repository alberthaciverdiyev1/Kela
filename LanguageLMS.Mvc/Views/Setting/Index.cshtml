@model LanguageLMS.Core.Modules.Setting.Responses.SettingResponse
@{
    ViewData["Title"] = "Parametrlər";
}
@if (!string.IsNullOrEmpty(Model.Logo))
{
    <script>window.LOGO_URL = "@Model.Logo";</script>
}

<div class="mb-5">
    <h2 class="text-xl font-semibold text-slate-800">Parametrlər</h2>
</div>

<form id="settingForm" class="max-w-2xl space-y-5 rounded-xl border border-slate-200 bg-white p-6">
    <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "logo", Id = "logo", Label = "Loqo", Accept = "image/*", Hint = "jpg/png" })" />

    <div class="grid grid-cols-2 gap-4">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "whatsappNumber", Id = "whatsappNumber", Label = "WhatsApp", Value = Model.WhatsappNumber })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "instagramUrl", Id = "instagramUrl", Label = "Instagram URL", Value = Model.InstagramUrl })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber1", Id = "contactNumber1", Label = "Əlaqə 1", Value = Model.ContactNumber1 })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber2", Id = "contactNumber2", Label = "Əlaqə 2", Value = Model.ContactNumber2 })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber3", Id = "contactNumber3", Label = "Əlaqə 3", Value = Model.ContactNumber3 })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber4", Id = "contactNumber4", Label = "Əlaqə 4", Value = Model.ContactNumber4 })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "facebookUrl", Id = "facebookUrl", Label = "Facebook URL", Value = Model.FacebookUrl })" />
    </div>

    <div class="grid grid-cols-2 gap-4">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "androidMinVersion", Id = "androidMinVersion", Label = "Android min versiya", Value = Model.AndroidMinVersion })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "iosMinVersion", Id = "iosMinVersion", Label = "iOS min versiya", Value = Model.IosMinVersion })" />
    </div>

    <div class="flex justify-end">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Yadda saxla", Type = "submit" })" />
    </div>
</form>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

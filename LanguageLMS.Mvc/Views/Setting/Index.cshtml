@model LanguageLMS.Core.Modules.Setting.Responses.SettingResponse
@{
    ViewData["Title"] = "Parametrlər";
}
@if (!string.IsNullOrEmpty(Model.Logo))
{
    <script>window.LOGO_URL = "@Model.Logo";</script>
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Parametrlər",
        Subtitle = "Tətbiqin brendinqini, əlaqə məlumatlarını və versiya tələblərini idarə edin." })" />

    <form id="settingForm" class="admin-card max-w-3xl space-y-8 p-6 sm:p-7">
        <div class="space-y-4">
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Brendinq</h3>
            </div>
            <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "logo", Id = "logo", Label = "Loqo", Accept = "image/*", Hint = "jpg/png" })" />
        </div>

        <div class="space-y-4 border-t border-border pt-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Əlaqə</h3>
            <div class="grid gap-4 sm:grid-cols-2">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "whatsappNumber", Id = "whatsappNumber", Label = "WhatsApp", Value = Model.WhatsappNumber })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "instagramUrl", Id = "instagramUrl", Label = "Instagram URL", Value = Model.InstagramUrl })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "facebookUrl", Id = "facebookUrl", Label = "Facebook URL", Value = Model.FacebookUrl })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber1", Id = "contactNumber1", Label = "Əlaqə nömrəsi 1", Value = Model.ContactNumber1 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber2", Id = "contactNumber2", Label = "Əlaqə nömrəsi 2", Value = Model.ContactNumber2 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber3", Id = "contactNumber3", Label = "Əlaqə nömrəsi 3", Value = Model.ContactNumber3 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber4", Id = "contactNumber4", Label = "Əlaqə nömrəsi 4", Value = Model.ContactNumber4 })" />
            </div>
        </div>

        <div class="space-y-4 border-t border-border pt-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Tətbiq versiyaları</h3>
            <div class="grid gap-4 sm:grid-cols-2">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "androidMinVersion", Id = "androidMinVersion", Label = "Android minimum versiya", Value = Model.AndroidMinVersion })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "iosMinVersion", Id = "iosMinVersion", Label = "iOS minimum versiya", Value = Model.IosMinVersion })" />
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-6">
            <button type="button" id="clearCacheBtn" class="admin-button-secondary">Keşi təmizlə</button>
            <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Yadda saxla", Type = "submit" })" />
        </div>
    </form>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

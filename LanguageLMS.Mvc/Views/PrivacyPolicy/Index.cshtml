@{
    ViewData["Title"] = "Gizlilik";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Gizlilik & Şərtlər",
        Subtitle = "Tətbiqdə göstərilən hüquqi sənədləri redaktə edin.",
        CreateText = "Yeni sənəd" })" />

    <div class="admin-card">
        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-40">Növ</th>
                            <th>Məzmun</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<partial name="_Modal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

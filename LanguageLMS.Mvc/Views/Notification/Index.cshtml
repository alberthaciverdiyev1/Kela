@{
    ViewData["Title"] = "Bildirişlər";
    var students = (PagedResponse<StudentListItemResponse>)ViewData["Students"]!;
}

<div class="mb-5 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-800">Bildirişlər</h2>
    <partial name="Ui/_Button" model="@(new ButtonModel { Text = "+ Yeni bildiriş", OnClick = "openCreate()" })" />
</div>

<div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div id="listLoader" class="absolute inset-0 z-10 hidden items-center justify-center bg-white/70">
        <div class="h-9 w-9 animate-spin rounded-full border-4 border-slate-200 border-t-primary"></div>
    </div>
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Başlıq</th>
                <th class="px-4 py-3">Mətn</th>
                <th class="px-4 py-3">Hədəf</th>
                <th class="px-4 py-3">Şəkil</th>
                <th class="px-4 py-3">Tarix</th>
                <th class="px-4 py-3 text-right">Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody id="rows" class="divide-y divide-slate-100"></tbody>
    </table>
</div>

<div id="pagination" class="mt-4 flex flex-wrap gap-2"></div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-xl bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 p-4">
            <h3 class="text-lg font-semibold text-slate-800">Yeni bildiriş</h3>
            <button type="button" onclick="closeModal()" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div id="formError" class="mx-6 mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600"></div>
        <form id="entityForm" class="space-y-4 p-6">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = "Başlıq", Required = true })" />
            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Mətn</label>
                <textarea id="body" rows="3" class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></textarea>
            </div>
            <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "image", Id = "image", Label = "Şəkil", Accept = "image/*", Hint = "jpg/png, max 5MB" })" />
            <partial name="Ui/_Switch" model="@(new SwitchModel { Name = "all", Id = "all", Label = "Hamıya göndər", Checked = true })" />
            <div id="studentsBlock" class="hidden">
                <label class="mb-1 block text-sm font-medium text-slate-700">Şagirdlər (bir neçə seçmək üçün Ctrl)</label>
                <select id="student_ids" multiple size="6" class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-2 text-sm">
                    @foreach (var s in students.Data)
                    {
                        <option value="@s.Id">@s.FullName (@s.Email)</option>
                    }
                </select>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "İmtina", Variant = "secondary", OnClick = "closeModal()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Göndər", Type = "submit" })" />
            </div>
        </form>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

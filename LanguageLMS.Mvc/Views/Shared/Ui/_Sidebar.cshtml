@{
    var controller = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    string Active(string c) => controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        ? "bg-primary-light text-primary font-semibold before:bg-primary"
        : "text-slate-700 hover:bg-surface-secondary before:bg-transparent";
}
<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-30 w-[252px] -translate-x-full border-r border-border bg-white transition-transform lg:static lg:shrink-0 lg:translate-x-0">
    <div class="flex h-[68px] items-center gap-3 px-6">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-primary text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
        </div>
        <span class="text-xl font-extrabold tracking-tight text-slate-900">LanguageLMS</span>
    </div>

    <nav class="space-y-1 px-4 py-5 text-[15px]">
        <a href="/dashboard" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Dashboard")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10h14V10" /></svg>
            Dashboard
        </a>
        <a href="/subject" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Subject")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4" /></svg>
            Fənlər
        </a>
        <a href="/lesson" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Lesson")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253" /></svg>
            Dərslər
        </a>
        <a href="/lesson-content" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("LessonContent")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h12" /></svg>
            Materiallar
        </a>
        <a href="/group" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Group")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87" /></svg>
            Qruplar
        </a>
        <a href="/question" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Question")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8.23 9a4 4 0 1 1 8 0c0 2-2 2.5-2 4M12 17h.01" /></svg>
            Suallar
        </a>
        <a href="/quiz" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Quiz")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4m5 2a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
            İmtahanlar
        </a>
        <a href="/students" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Students")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" /></svg>
            Şagirdlər
        </a>
        <a href="/notification" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Notification")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5m6 0a3 3 0 1 1-6 0" /></svg>
            Bildirişlər
        </a>
        <a href="/user" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("User")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 1 1 0 5.292M15 21H3v-1a6 6 0 0 1 12 0v1Zm0 0h6v-1a6 6 0 0 0-9-5.197" /></svg>
            İstifadəçilər
        </a>
        <a href="/setting" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("Setting")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 8.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1-.6H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15.4 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.2.38.31.8.31 1.24H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51.76Z" /></svg>
            Parametrlər
        </a>
        <a href="/privacy-policy" class="relative flex h-11 items-center gap-4 rounded-xl px-4 before:absolute before:left-0 before:h-6 before:w-1 before:rounded-full @Active("PrivacyPolicy")">
            <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.6-2A11 11 0 0 1 12 21 11 11 0 0 1 2.4 10 11 11 0 0 1 12 3a11 11 0 0 1 8.6 4Z" /></svg>
            Gizlilik
        </a>
    </nav>
</aside>

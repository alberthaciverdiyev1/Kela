@using LanguageLMS.Mvc.Models.Ui
@model InputModel
@{
    var id = Model.Id ?? Model.Name;
}
<div>
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label for="@id" class="mb-1 block text-sm font-semibold text-slate-700">@Model.Label</label>
    }
    <input type="@Model.Type" name="@Model.Name" id="@id" value="@Model.Value" placeholder="@Model.Placeholder" required="@Model.Required"
           class="admin-field" />
</div>

@model InputModel
@{
    var id = Model.Id ?? Model.Name;
}
<div>
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label for="@id" class="mb-1 block text-sm font-medium text-slate-700">@Model.Label</label>
    }
    <input type="@Model.Type" name="@Model.Name" id="@id" value="@Model.Value" placeholder="@Model.Placeholder" required="@Model.Required"
           class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm text-slate-900 focus:border-primary focus:ring-primary" />
</div>

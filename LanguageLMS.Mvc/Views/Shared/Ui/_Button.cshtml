@model ButtonModel
@{
    const string baseClass = "inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium px-4 py-2 focus:outline-none focus:ring-4";
    var variants = new Dictionary<string, string>
    {
        ["primary"] = "text-white bg-primary hover:bg-primary-600 focus:ring-primary-300",
        ["secondary"] = "text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 focus:ring-slate-200",
        ["danger"] = "text-white bg-red-600 hover:bg-red-700 focus:ring-red-300",
        ["ghost"] = "text-primary hover:bg-primary/10",
    };
    var cls = $"{baseClass} {variants.GetValueOrDefault(Model.Variant, variants["primary"])}";
}
@if (!string.IsNullOrEmpty(Model.Href))
{
    <a href="@Model.Href" id="@Model.Id" class="@cls">@Model.Text</a>
}
else
{
    <button type="@Model.Type" id="@Model.Id" onclick="@Model.OnClick" class="@cls">@Model.Text</button>
}

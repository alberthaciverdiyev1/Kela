@using LanguageLMS.Mvc.Models.Ui
@model ButtonModel
@{
    const string baseClass = "inline-flex min-h-11 items-center justify-center gap-2 rounded-[10px] px-4 py-2 text-sm font-bold focus:outline-none focus:ring-4";
    var variants = new Dictionary<string, string>
    {
        ["primary"] = "text-white bg-primary hover:bg-primary-600 focus:ring-primary/20",
        ["secondary"] = "text-slate-700 bg-white border border-border hover:bg-surface-secondary focus:ring-slate-200",
        ["danger"] = "text-white bg-danger hover:bg-red-600 focus:ring-danger/20",
        ["ghost"] = "text-primary hover:bg-primary/10",
    };
    var cls = $"{baseClass} {variants.GetValueOrDefault(Model.Variant, variants["primary"])}";
}
@if (!string.IsNullOrEmpty(Model.Href))
{
    <a href="@Model.Href" id="@Model.Id" class="@cls">@Model.Text</a>
}
else
{
    <button type="@Model.Type" id="@Model.Id" onclick="@Model.OnClick" class="@cls">@Model.Text</button>
}

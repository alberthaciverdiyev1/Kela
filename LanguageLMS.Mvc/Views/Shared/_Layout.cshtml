<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LanguageLMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-page text-ink antialiased">
    <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-ink/30 lg:hidden"></div>

    <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-40 flex w-[256px] -translate-x-full flex-col bg-white px-4 py-5 transition-transform duration-200 lg:translate-x-0">
        <div class="flex items-center gap-3 px-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-sm font-bold text-white">LL</a>
            <div>
                <p class="text-sm font-semibold text-ink">LanguageLMS</p>
                <p class="text-xs font-medium text-muted">Academy Admin</p>
            </div>
        </div>

        <button type="button" class="mt-6 flex w-full items-center gap-3 rounded-2xl border border-line bg-brand-50 px-3 py-3 text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white text-sm font-semibold text-brand-600">IA</span>
            <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-ink">International Academy</span>
                <span class="block truncate text-xs font-medium text-muted">Baku Campus</span>
            </span>
            <svg class="h-4 w-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </button>

        <nav class="mt-7 flex-1 space-y-7 overflow-y-auto">
            <div>
                <p class="px-3 text-xs font-semibold uppercase text-muted">Genel</p>
                <div class="mt-3 space-y-1">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex min-h-11 items-center gap-3 rounded-xl bg-brand-50 px-3 text-sm font-semibold text-brand-600">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13h8V3H3v10Zm10 8h8v-8h-8v8ZM3 21h8v-6H3v6Zm10-10h8V3h-8v8Z" /></svg>
                        Dashboard
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /></svg>
                        Takvim
                    </a>
                </div>
            </div>

            <div>
                <p class="px-3 text-xs font-semibold uppercase text-muted">Eğitim Yönetimi</p>
                <div class="mt-3 space-y-1">
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h7" /></svg>
                        Workspaces
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        Öğrenciler
                    </a>
                    <a asp-area="" asp-controller="Banner" asp-action="Index" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z" /></svg>
                        Ders İçerikleri
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 11 3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                        Quiz ve Sınavlar
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6M9 16h6M7 3h10l4 4v14H3V3h4Z" /></svg>
                        Ödevler
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                        Yoklama
                    </a>
                </div>
            </div>

            <div>
                <p class="px-3 text-xs font-semibold uppercase text-muted">Finans</p>
                <div class="mt-3 space-y-1">
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10h18M7 15h.01M11 15h2M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z" /></svg>
                        Ödemeler
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                        Ödeme Planları
                    </a>
                </div>
            </div>

            <div>
                <p class="px-3 text-xs font-semibold uppercase text-muted">Sistem</p>
                <div class="mt-3 space-y-1">
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 15l4-4 3 3 6-6" /></svg>
                        Raporlar
                    </a>
                    <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-muted hover:bg-slate-50 hover:text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6 1.65 1.65 0 0 0-.4 1.07V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 8.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-.6-1 1.65 1.65 0 0 0-1.07-.4H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6A1.65 1.65 0 0 0 10.4 3V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15.4 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.38.2.8.31 1.24.31H21a2 2 0 1 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15Z" /></svg>
                        Ayarlar
                    </a>
                </div>
            </div>
        </nav>

        <div class="mt-5 rounded-2xl bg-slate-50 p-3">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-sm font-semibold text-white">NA</span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-ink">Nigar Aliyeva</p>
                    <p class="truncate text-xs font-medium text-muted">Academic Manager</p>
                </div>
            </div>
        </div>
    </aside>

    <div class="min-h-screen lg:pl-[256px]">
        <header class="sticky top-0 z-20 border-b border-line bg-white/95 backdrop-blur">
            <div class="flex min-h-[72px] items-center gap-4 px-4 sm:px-6 lg:px-8">
                <button type="button" id="sidebarToggle" class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-white text-ink lg:hidden">
                    <span class="sr-only">Menüyü aç</span>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold text-muted">Admin Panel / @ViewData["Title"]</p>
                    <h1 class="truncate text-lg font-semibold text-ink">@ViewData["Title"]</h1>
                </div>
                <div class="hidden w-full max-w-sm md:block">
                    <label class="relative block">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" /></svg>
                        </span>
                        <input class="ui-input pl-10" type="search" placeholder="Öğrenci, sınıf veya içerik ara" />
                    </label>
                </div>
                <button type="button" class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-white text-muted hover:text-ink">
                    <span class="sr-only">Bildirimler</span>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                </button>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-sm font-semibold text-brand-600">NA</span>
            </div>
        </header>

        <main class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

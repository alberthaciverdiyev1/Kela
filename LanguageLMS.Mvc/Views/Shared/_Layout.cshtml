<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LanguageLMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-page text-ink antialiased">
    <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-ink/30 xl:hidden"></div>

    <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-40 flex w-[260px] -translate-x-full flex-col border-r border-line bg-white px-5 py-6 transition-transform duration-200 xl:translate-x-0">
        <div class="flex items-center gap-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-600 text-white">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
            </a>
            <div>
                <p class="text-lg font-bold text-ink">Language<span class="text-brand-600">LMS</span></p>
                <p class="text-xs font-medium text-muted">Teacher/Admin</p>
            </div>
        </div>

        <p class="mt-10 px-1 text-xs font-semibold uppercase text-muted">Menu</p>
        <nav class="mt-4 flex-1 space-y-1 overflow-y-auto">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex min-h-11 items-center gap-3 rounded-xl bg-brand-50 px-3 text-sm font-semibold text-brand-600">
                <span class="h-5 w-1 rounded-full bg-brand-600"></span>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13h8V3H3v10Zm10 8h8v-8h-8v8ZM3 21h8v-6H3v6Zm10-10h8V3h-8v8Z" /></svg>
                Dashboard
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h7v7H3V7Zm11 0h7v7h-7V7ZM3 17h7v4H3v-4Zm11 0h7v4h-7v-4Z" /></svg>
                Workspaces
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87" /></svg>
                Students
            </a>
            <a asp-area="" asp-controller="Banner" asp-action="Index" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z" /></svg>
                Courses & Content
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 11 3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                Quizzes & Exams
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6M9 16h6M7 3h10l4 4v14H3V3h4Z" /></svg>
                Assignments
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /></svg>
                Attendance
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10h18M7 15h.01M11 15h2M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z" /></svg>
                Payments
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 15l4-4 3 3 6-6" /></svg>
                Reports
            </a>
            <a href="#" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-ink hover:bg-slate-50">
                <span class="h-5 w-1"></span>
                <svg class="h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6 1.65 1.65 0 0 0-.4 1.07V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 8.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-.6-1 1.65 1.65 0 0 0-1.07-.4H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6A1.65 1.65 0 0 0 10.4 3V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15.4 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.38.2.8.31 1.24.31H21a2 2 0 1 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15Z" /></svg>
                Settings
            </a>
        </nav>

        <div class="mt-6 border-t border-line pt-5">
            <div class="flex items-center gap-3">
                <span class="relative flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-sm font-bold text-brand-600">
                    AM
                    <span class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white bg-brand-600"></span>
                </span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-ink">Alex Morgan</p>
                    <p class="truncate text-xs font-medium text-muted">Academic Manager</p>
                </div>
                <svg class="h-4 w-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>
    </aside>

    <div class="min-h-screen xl:pl-[260px]">
        <main class="mx-auto max-w-[1440px] px-4 py-4 sm:px-6 lg:px-8 xl:px-8">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

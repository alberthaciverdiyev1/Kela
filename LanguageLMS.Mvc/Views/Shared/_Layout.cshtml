<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LanguageLMS</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800">
    <header class="bg-white border-b border-slate-200">
        <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between">
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="text-lg font-semibold text-indigo-600">LanguageLMS</a>
            <ul class="flex items-center gap-6 text-sm font-medium">
                <li><a asp-area="" asp-controller="Home" asp-action="Index"
                       class="hover:text-indigo-600">Home</a></li>
                <li><a asp-area="" asp-controller="Banner" asp-action="Index"
                       class="hover:text-indigo-600">Banners</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy"
                       class="hover:text-indigo-600">Privacy</a></li>
            </ul>
        </nav>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-8">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-500">
            &copy; 2026 LanguageLMS
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

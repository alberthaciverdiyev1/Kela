@model BannerIndexViewModel
@{
    ViewData["Title"] = "Banners";
}

<div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Banners</h1>
    <a asp-action="Create" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        + New banner
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@ok</div>
}

<form method="get" class="mb-4 flex gap-2">
    <input name="search" value="@Model.Search" placeholder="Search by title..."
           class="w-64 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
    <button class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-900">Search</button>
</form>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Image</th>
                <th class="px-4 py-3">Title</th>
                <th class="px-4 py-3">New?</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        @foreach (var b in Model.Page.Data)
        {
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 text-slate-400">@b.Id</td>
                <td class="px-4 py-3">
                    <img src="@b.Image" alt="@b.Title" class="h-10 w-16 rounded border border-slate-200 object-cover" />
                </td>
                <td class="px-4 py-3 font-medium text-slate-800">@b.Title</td>
                <td class="px-4 py-3">
                    @if (b.IsNew)
                    {
                        <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">Yeni</span>
                    }
                </td>
                <td class="px-4 py-3">
                    <div class="flex items-center justify-end gap-4">
                        <a asp-action="Details" asp-route-id="@b.Id" class="text-slate-500 hover:text-slate-800">View</a>
                        <a asp-action="Edit" asp-route-id="@b.Id" class="text-indigo-600 hover:text-indigo-800">Edit</a>
                        <form asp-action="Delete" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Delete this?');">
                            <button type="submit" class="text-red-600 hover:text-red-800">Sil</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Page.Data.Any())
        {
            <tr>
                <td colspan="5" class="px-4 py-10 text-center text-slate-400">No results</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Page.LastPage > 1)
{
    <div class="mt-4 flex flex-wrap gap-2">
        @for (var i = 1; i <= Model.Page.LastPage; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search"
               class="rounded-lg px-3 py-1.5 text-sm @(i == Model.Page.CurrentPage ? "bg-indigo-600 text-white" : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">@i</a>
        }
    </div>
}

@model BannerResponse
@{
    ViewData["Title"] = "Banner details";
}

<div class="mb-6 flex items-center gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Banner details</h1>
    @if (Model.IsNew)
    {
        <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">Yeni</span>
    }
</div>

<div class="max-w-lg rounded-xl border border-slate-200 bg-white p-6">
    <img src="@Model.Image" alt="@Model.Title" class="h-48 w-full rounded-lg border border-slate-200 object-cover" />
    <dl class="mt-4 space-y-2 text-sm">
        <div class="flex justify-between">
            <dt class="text-slate-500">ID</dt>
            <dd class="font-medium text-slate-800">@Model.Id</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-slate-500">Title</dt>
            <dd class="font-medium text-slate-800">@Model.Title</dd>
        </div>
    </dl>
    <div class="mt-6 flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Edit</a>
        <a asp-action="Index" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50">Back</a>
    </div>
</div>

@model BannerFormViewModel
@{
    ViewData["Title"] = "New banner";
}

<h1 class="mb-6 text-2xl font-semibold text-slate-900">New banner</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data"
      class="max-w-lg rounded-xl border border-slate-200 bg-white p-6">
    <partial name="_Form" model="Model" />
    <div class="mt-6 flex gap-3">
        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Save</button>
        <a asp-action="Index" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50">Cancel</a>
    </div>
</form>

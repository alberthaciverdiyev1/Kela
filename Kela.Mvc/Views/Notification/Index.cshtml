@{
    ViewData["Title"] = "Bildirişlər";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Notifications"],
        Subtitle = L["Notification_Subtitle"],
        CreateText = L["Notification_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            ButtonText = L["Common_Search"]
        })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-16">#</th>
                            <th>@L["Common_Title"]</th>
                            <th>@L["Common_Body"]</th>
                            <th class="w-32">@L["Notification_Target"]</th>
                            <th class="w-24">@L["Common_Image"]</th>
                            <th class="w-44">Tarix</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = null,
    Title = L["Notification_Create"],
    WidthClass = "max-w-2xl",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Bildirişlər";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Bildirişlər",
        Subtitle = "Şagirdlərə göndərilən bildirişləri idarə edin.",
        CreateText = "Yeni bildiriş" })" />

    <div class="admin-card">
        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-16">#</th>
                            <th>Başlıq</th>
                            <th>Mətn</th>
                            <th class="w-32">Hədəf</th>
                            <th class="w-24">Şəkil</th>
                            <th class="w-44">Tarix</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "İcazələr";
}
<section class="admin-page">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="admin-page-title">İcazələr</h2>
            <p class="admin-page-subtitle">Rollara verilən icazələri idarə edin.</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <button type="button" onclick="openRole()" class="admin-button-secondary">Rol icazələri</button>
            <button type="button" onclick="openCreate()" class="admin-button-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
                Yeni icazə
            </button>
        </div>
    </div>

    <div class="admin-card">
        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>İcazə</th>
                            <th>Rollar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<partial name="_Modal" />
<partial name="_RoleModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Gizlilik";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Privacy_Title"],
        Subtitle = L["Privacy_Subtitle"],
        CreateText = L["Privacy_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            ButtonText = L["Common_Search"]
        })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Type"], WidthClass = "w-40" },
                                    new() { Label = L["Common_Content"] },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                

        </table>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
            </div>
        </div>
    </div>
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Privacy_Create"],
    WidthClass = "max-w-3xl",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

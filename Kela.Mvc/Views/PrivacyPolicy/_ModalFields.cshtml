<form id="entityForm" class="space-y-4 p-6">
    <partial name="Ui/_Input" model="@(new InputModel { Name = "type", Id = "type", Label = L["Privacy_TypeHint"], Required = true })" />
    <div>
        <label class="mb-1 block text-sm font-medium text-slate-700">@L["Privacy_ContentHtml"]</label>
        <textarea id="content" rows="12" class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-2.5 font-mono text-sm"></textarea>
    </div>
    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", OnClick = "AdminUI.closeModal('modal')" })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

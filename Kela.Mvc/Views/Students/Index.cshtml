@{
    ViewData["Title"] = "Şagirdlər";
    var activeOptions = new List<SelectOption>
    {
        new() { Value = "", Text = L["Common_All"] },
        new() { Value = "true", Text = L["Common_Active"] },
        new() { Value = "false", Text = L["Common_Inactive"] }
    };
}
<section class="admin-page">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="admin-page-title">@L["Nav_Students"]</h2>
            <p class="admin-page-subtitle">@L["Students_Subtitle"]</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <button type="button" id="trashBtn" class="admin-button-secondary" onclick="toggleTrash()">@L["Common_DeletedItems"]</button>
            <a href="/students/export" class="admin-button-secondary">⬇ Excel</a>
            <button type="button" onclick="openGenerate()" class="admin-button-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
                Şagird generasiya et
            </button>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="grow">
                <label class="relative block">
                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" /></svg>
                    </span>
                    <input id="search" name="search" type="search" class="admin-field pl-11" placeholder="@L["Students_Search"]" />
                </label>
            </div>
            <div class="w-40">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_active", Id = "filter_active", Label = L["Common_Status"], Options = activeOptions })" />
            </div>
            <button type="button" onclick="loadList(1)" class="admin-button-primary h-[46px] px-6">Axtar</button>
        </div>

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/students/bulk", CanActivate = true, CanDeactivate = true })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>@L["Common_Name"]</th>
                            <th>@L["Common_Email"]</th>
                            <th>@L["Common_Phone"]</th>
                            <th class="w-28">@L["Common_Status"]</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_GenerateModal" />
<partial name="_DevicesModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

<div id="generateModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 class="text-lg font-bold text-slate-900">@L["Students_GenerateTitle"]</h3>
            <button type="button" onclick="closeGenerate()" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <form id="generateForm" class="space-y-4 p-6">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "count", Id = "gen_count", Label = L["Students_GenerateCount"], Type = "number", Value = "10" })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "fullNamePrefix", Id = "gen_prefix", Label = L["Students_GeneratePrefix"], Value = "Student" })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "emailDomain", Id = "gen_domain", Label = L["Students_EmailDomain"], Value = "generated.local" })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "password", Id = "gen_password", Label = L["Common_Password"], Value = "student123" })" />
            <label class="flex items-center gap-2 text-sm font-medium text-slate-600"><input type="checkbox" id="gen_send" class="h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />@L["Students_SendCredentials"]</label>
            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", OnClick = "closeGenerate()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Create"], Type = "submit" })" />
            </div>
        </form>
    </div>
</div>

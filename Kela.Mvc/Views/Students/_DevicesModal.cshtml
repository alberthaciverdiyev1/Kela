<div id="devicesModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 id="devicesTitle" class="text-lg font-bold text-slate-900">@L["Students_Devices"]</h3>
            <button type="button" onclick="closeDevices()" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div class="p-4">
            <div id="devicesList" class="space-y-2"></div>
            <button type="button" onclick="unbindDevice()" class="mt-4 w-full rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50">@L["Students_ResetDevice"]</button>
        </div>
    </div>
</div>

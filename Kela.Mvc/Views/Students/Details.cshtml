@{
    var student = (StudentListItemResponse)ViewData["Student"]!;
    var stats = (StatisticsResponse)ViewData["Statistics"]!;
    var progress = (ProgressResponse)ViewData["Progress"]!;
    var results = (IReadOnlyList<QuizResultSummary>)ViewData["Results"]!;
    var violations = (IReadOnlyList<ScreenViolationResponse>)ViewData["Violations"]!;
}
<section class="admin-page">
    <div>
        <a href="/students" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
            Şagirdlər
        </a>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="admin-page-title">@student.FullName</h2>
            <p class="admin-page-subtitle">@student.Email @(string.IsNullOrEmpty(student.Phone) ? "" : "• " + student.Phone)</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            @if (student.IsActive)
            {
                <span class="badge badge-success">Aktiv</span>
            }
            else
            {
                <span class="badge badge-neutral">Deaktiv</span>
            }
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_lessons", Label = "Cəmi dərs",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_contents", Label = "Cəmi material", Accent = "bg-sky-100 text-sky-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M7 3h7l5 5v13H7V3Z' /><path stroke-linecap='round' stroke-linejoin='round' d='M14 3v6h5M10 14h6M10 18h4' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_done", Label = "Tamamlanan", Accent = "bg-success-bg text-success",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='m5 13 4 4L19 7' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_percent", Label = "Tamamlanma", Accent = "bg-violet-100 text-violet-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6v6l4 2M21 12A9 9 0 1 1 3 12a9 9 0 0 1 18 0Z' />" })" />
    </div>
    <script>
        document.getElementById('s_lessons').textContent = '@stats.Overview.TotalLessons';
        document.getElementById('s_contents').textContent = '@stats.Overview.TotalContents';
        document.getElementById('s_done').textContent = '@stats.Overview.CompletedContents';
        document.getElementById('s_percent').textContent = '@(stats.Overview.CompletionPercent)%';
    </script>

    <div class="admin-card">
        <div class="flex gap-1 border-b border-border px-4 pt-3">
            <button type="button" data-tab="subjects" class="detail-tabbtn rounded-t-lg px-4 py-2 text-sm font-semibold" onclick="switchDetailTab('subjects')">Fənlər üzrə</button>
            <button type="button" data-tab="lessons" class="detail-tabbtn rounded-t-lg px-4 py-2 text-sm font-semibold" onclick="switchDetailTab('lessons')">Dərslər üzrə</button>
            <button type="button" data-tab="results" class="detail-tabbtn rounded-t-lg px-4 py-2 text-sm font-semibold" onclick="switchDetailTab('results')">İmtahan nəticələri</button>
            <button type="button" data-tab="violations" class="detail-tabbtn rounded-t-lg px-4 py-2 text-sm font-semibold" onclick="switchDetailTab('violations')">Ekran pozuntuları</button>
        </div>

        <div id="tab-subjects" class="detail-tab p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th>Fənn</th><th class="w-40">Material</th><th class="w-32">Tamamlanan</th><th class="w-40">Faiz</th></tr></thead>
                    <tbody>
                        @if (stats.BySubject.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-sm text-slate-400">Məlumat yoxdur</td></tr>
                        }
                        else
                        {
                            foreach (var s in stats.BySubject)
                            {
                                <tr>
                                    <td class="font-semibold text-slate-800">@s.SubjectName</td>
                                    <td class="text-slate-500">@s.TotalContents</td>
                                    <td class="text-slate-500">@s.CompletedContents</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="h-2 w-24 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-primary" style="width:@(s.CompletionPercent)%"></div></div>
                                            <span class="text-sm font-semibold text-slate-700">@s.CompletionPercent%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-lessons" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th>Dərs</th><th class="w-40">Tamamlanan</th><th class="w-40">Faiz</th><th>Növbəti material</th></tr></thead>
                    <tbody>
                        @if (progress.Items.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-sm text-slate-400">Məlumat yoxdur</td></tr>
                        }
                        else
                        {
                            foreach (var p in progress.Items)
                            {
                                <tr>
                                    <td class="font-semibold text-slate-800">@p.LessonTitle</td>
                                    <td class="text-slate-500">@p.CompletedContents / @p.TotalContents</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="h-2 w-24 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-primary" style="width:@(p.ProgressPercent)%"></div></div>
                                            <span class="text-sm font-semibold text-slate-700">@p.ProgressPercent%</span>
                                        </div>
                                    </td>
                                    <td class="text-slate-500">@(p.NextContent?.Title ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-results" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th>İmtahan</th><th class="w-32">Cəhd</th><th class="w-40">Doğru / Sual</th><th class="w-32">Bal</th><th class="w-40">Tarix</th></tr></thead>
                    <tbody>
                        @if (results.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-sm text-slate-400">Nəticə yoxdur</td></tr>
                        }
                        else
                        {
                            foreach (var r in results)
                            {
                                <tr>
                                    <td class="font-semibold text-slate-800">@r.QuizTitle</td>
                                    <td class="text-slate-500">#@r.AttemptTime</td>
                                    <td class="text-slate-500">@r.CorrectCount / @r.TotalQuestions</td>
                                    <td><span class="font-semibold @(r.ScorePercent >= 50 ? "text-emerald-600" : "text-red-600")">@r.ScorePercent%</span></td>
                                    <td class="text-slate-500">@(r.StartDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-violations" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th>Növ</th><th>Səhifə</th><th class="w-44">Tarix</th><th>İstifadəçi agenti</th></tr></thead>
                    <tbody>
                        @if (violations.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-sm text-slate-400">Pozuntu qeydə alınmayıb</td></tr>
                        }
                        else
                        {
                            foreach (var v in violations)
                            {
                                <tr>
                                    <td><span class="rounded bg-danger-bg px-2 py-0.5 text-xs font-semibold text-danger">@v.Type</span></td>
                                    <td class="text-slate-500">@(v.Path ?? "—")</td>
                                    <td class="text-slate-500">@v.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="max-w-xs truncate text-slate-400" title="@v.UserAgent">@(v.UserAgent ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    function switchDetailTab(tab) {
        document.querySelectorAll('.detail-tab').forEach(el => el.classList.add('hidden'));
        document.getElementById('tab-' + tab).classList.remove('hidden');
        document.querySelectorAll('.detail-tabbtn').forEach(el => {
            const on = el.dataset.tab === tab;
            el.classList.toggle('bg-primary', on);
            el.classList.toggle('text-white', on);
            el.classList.toggle('text-slate-600', !on);
        });
    }
    document.addEventListener('DOMContentLoaded', () => switchDetailTab('subjects'));
</script>

<div id="questionsModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="w-full max-w-2xl rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 id="questionsTitle" class="text-lg font-bold text-slate-900">@L["Common_Questions"]</h3>
            <button type="button" onclick="closeQuestions()" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div class="max-h-[60vh] overflow-y-auto p-4">
            <div class="mb-4 flex gap-2">
                <select id="questionsSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
                <button type="button" onclick="assignQuestion()" class="rounded-lg bg-primary px-4 py-2 text-sm text-white hover:bg-primary-600">@L["Common_Add"]</button>
            </div>
            <div id="questionsList" class="space-y-2"></div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = L["Nav_Exams"];
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var lessonFilter = new List<SelectOption> { new() { Value = "", Text = L["Common_All"] } };
    lessonFilter.AddRange(lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }));
}
<script>window.LESSONS = { @Html.Raw(string.Join(",", lessons.Data.Select(l => $"{l.Id}:\"{System.Text.Json.JsonEncodedText.Encode(l.Title)}\""))) }; </script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Quiz_Create"],
        Sortable = true })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-44", Select = new SelectModel { Name = "filter_lesson", Id = "filter_lesson", Label = L["Common_Lesson"], Options = lessonFilter } }
            },
            Sort = new FilterSortModel {
                    Extra = new List<SelectOption> { new() { Value = "order_asc", Text = L["Sort_Manual"] } } },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Show"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/quiz/bulk", CanActivate = true, CanDeactivate = true })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Lesson"] },
                                    new() { Label = L["Common_Title"] },
                                    new() { Label = L["Common_Type"], WidthClass = "w-24" },
                                    new() { Label = L["Quiz_Duration"], WidthClass = "w-24" },
                                    new() { Label = L["Common_Questions"], WidthClass = "w-24" },
                                    new() { Label = L["Common_Active"], WidthClass = "w-24" },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Quiz_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />
@{
    var questionsModalBody = await Html.PartialAsync("_QuestionsModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "questionsModal",
    TitleId = "questionsTitle",
    Title = L["Common_Questions"],
    WidthClass = "max-w-2xl",
    ShowError = false,
    Body = questionsModalBody
})" />
<partial name="Ui/_SortModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

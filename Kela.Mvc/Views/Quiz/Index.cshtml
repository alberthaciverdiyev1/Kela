@{
    ViewData["Title"] = "İmtahanlar";
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var lessonFilter = new List<SelectOption> { new() { Value = "", Text = "Hamısı" } };
    lessonFilter.AddRange(lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }));
}
<script>window.LESSONS = { @Html.Raw(string.Join(",", lessons.Data.Select(l => $"{l.Id}:\"{System.Text.Json.JsonEncodedText.Encode(l.Title)}\""))) }; </script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "İmtahanlar",
        Subtitle = "Dərs və ümumi imtahanları, sual seçimini idarə edin.",
        CreateText = "Yeni imtahan",
        Sortable = true })" />

    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="w-72">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_lesson", Id = "filter_lesson", Label = "Dərs", Options = lessonFilter })" />
            </div>
            <button type="button" onclick="loadList(1)" class="admin-button-primary h-[46px] px-6">Göstər</button>
        </div>

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/quiz/bulk", CanActivate = true, CanDeactivate = true })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>Dərs</th>
                            <th>Başlıq</th>
                            <th class="w-24">Növ</th>
                            <th class="w-24">Müddət</th>
                            <th class="w-24">Suallar</th>
                            <th class="w-24">Aktiv</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />
<partial name="_QuestionsModal" />
<partial name="Ui/_SortModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Sertifikatlar";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Sertifikatlar",
        Subtitle = "Şablon seçin, mətni və imzanı bir dəfə doldurun.",
        CreateText = "Yeni sertifikat",
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = "Cəmi sertifikat",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M8 3h8l4 4v14H4V3z' /><path stroke-linecap='round' stroke-linejoin='round' d='M8 12h8M8 16h5' />"
        }
    })" />

    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="grow">
                <label class="relative block">
                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" /></svg>
                    </span>
                    <input id="search" name="search" type="search" class="admin-field pl-11" placeholder="Başlıq üzrə axtar..." />
                </label>
            </div>
            <button type="button" id="trashBtn" class="admin-button-secondary h-[46px] px-4" onclick="toggleTrash()">Silinənlər</button>
            <button type="button" onclick="loadList(1)" class="admin-button-primary h-[46px] px-6">Axtar</button>
        </div>

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/certificate/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>Başlıq</th>
                            <th class="w-40">Şablon</th>
                            <th class="w-28">İmza</th>
                            <th class="w-32">Tarix</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <p id="tableInfo" class="text-sm font-medium text-slate-500">Nəticələr yüklənir...</p>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

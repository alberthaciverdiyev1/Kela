@{
    ViewData["Title"] = "Sertifikatlar";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Certificates"],
        Subtitle = L["Certificate_Subtitle"],
        CreateText = L["Certificate_Create"],
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = L["Certificate_Total"],
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M8 3h8l4 4v14H4V3z' /><path stroke-linecap='round' stroke-linejoin='round' d='M8 12h8M8 16h5' />"
        }
    })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Certificate_Search"],
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/certificate/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>@L["Common_Title"]</th>
                            <th class="w-40">@L["Certificate_Template"]</th>
                            <th class="w-28">@L["Certificate_Signature"]</th>
                            <th class="w-32">Tarix</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <p id="tableInfo" class="text-sm font-medium text-slate-500">@L["Common_LoadingResults"]</p>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Certificate_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

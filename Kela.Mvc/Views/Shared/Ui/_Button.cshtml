@model ButtonModel
@{
    // Bütün variantlar input.css-dəki .admin-button-* komponentlərindən gəlir —
    // eyni görünüş həm Razor, həm JS tərəfdə paylaşılsın.
    var variants = new Dictionary<string, string>
    {
        ["primary"] = "admin-button-primary",
        ["secondary"] = "admin-button-secondary",
        ["danger"] = "admin-button-danger",
        ["ghost"] = "admin-button-ghost",
    };
    var cls = variants.GetValueOrDefault(Model.Variant, variants["primary"]);
}
@if (!string.IsNullOrEmpty(Model.Href))
{
    <a href="@Model.Href" id="@Model.Id" class="@cls">@Model.Text</a>
}
else
{
    <button type="@Model.Type" id="@Model.Id" onclick="@Model.OnClick" class="@cls">@Model.Text</button>
}

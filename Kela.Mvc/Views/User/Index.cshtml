@{
    ViewData["Title"] = "İstifadəçilər";
    var typeFilter = new List<SelectOption>
    {
        new() { Value = "", Text = L["Common_All"] },
        new() { Value = "admin", Text = L["Role_Admin"] },
        new() { Value = "teacher", Text = L["Role_Teacher"] }
    };
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Users"],
        Subtitle = L["User_Subtitle"],
        CreateText = L["User_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["User_Search"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-36", Select = new SelectModel { Name = "filter_type", Id = "filter_type", Label = L["Common_Type"], Options = typeFilter } }
            },
            ButtonText = L["Common_Search"]
        })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-16">#</th>
                            <th>Ad</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th class="w-28">Tip</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["User_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

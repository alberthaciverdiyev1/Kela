@{
    var subject = (SubjectResponse)ViewData["Subject"]!;
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var total = lessons.Total;
    var active = lessons.Data.Count(l => l.IsActive);
}
<section class="admin-page">
    <div>
        <a href="/subject" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
            Fənlər
        </a>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="admin-page-title">@subject.Name</h2>
            <p class="admin-page-subtitle">Bu fənnə aid dərslər.</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <a href="/lesson?subject_id=@subject.Id" class="admin-button-secondary">Dərslər səhifəsi</a>
            <a href="/lesson?subject_id=@subject.Id" class="admin-button-primary">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
                Dərs əlavə et
            </a>
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_lessons", Label = "Cəmi dərs",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_active_lessons", Label = "Aktiv dərs", Accent = "bg-sky-100 text-sky-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='m5 13 4 4L19 7' />" })" />
    </div>
    <script>
        document.getElementById('stat_lessons').textContent = '@total';
        document.getElementById('stat_active_lessons').textContent = '@active';
    </script>

    <div class="admin-card">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="w-16">#</th>
                        <th>Ad</th>
                        <th class="w-24">Sıra</th>
                        <th class="w-32">Status</th>
                        <th class="text-right">Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lessons.Data.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty">
                                    <svg class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h10" /></svg>
                                    <p class="text-base font-semibold text-slate-500">Hələ dərs yoxdur</p>
                                    <p class="text-sm">Bu fənnə ilk dərsi əlavə edin.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var l in lessons.Data.OrderBy(x => x.SortOrder))
                        {
                            <tr>
                                <td class="text-slate-400">@l.Id</td>
                                <td class="font-semibold text-slate-800">@l.Title</td>
                                <td class="text-slate-500">@l.SortOrder</td>
                                <td>
                                    @if (l.IsActive)
                                    {
                                        <span class="badge badge-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">Arxivdə</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <a href="/lesson-content?lesson_id=@l.Id" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-sm font-semibold text-slate-600 hover:bg-surface-secondary">Materiallar</a>
                                        <button type="button" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-sm font-semibold text-danger hover:bg-danger-bg" onclick="removeLesson(@l.Id)">Sil</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    var subjects = (PagedResponse<SubjectResponse>)ViewData["Subjects"]!;
    var subjectOptions = subjects.Data.Select(s => new SelectOption { Value = s.Id.ToString(), Text = s.Name }).ToList();
    var textImage = new List<SelectOption> { new() { Value = "text", Text = "Mətn" }, new() { Value = "image", Text = "Şəkil" } };
    var answers = new[] { "A", "B", "C", "D", "E" }.Select(a => new SelectOption { Value = a, Text = a }).ToList();
}
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 id="modalTitle" class="text-lg font-bold text-slate-900">Yeni sual</h3>
            <button type="button" onclick="closeModal()" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100">✕</button>
        </div>
        <div id="formError" class="mx-6 mt-4 hidden rounded-xl bg-danger-bg px-3 py-2 text-sm font-semibold text-danger"></div>
        <form id="entityForm" class="space-y-4 p-6">
            <input type="hidden" id="entityId" />
            <input type="hidden" id="rawTitle" />
            @foreach (var v in new[] { "A", "B", "C", "D", "E" })
            {
                <input type="hidden" id="raw@(v)" />
            }

            <partial name="Ui/_Select" model="@(new SelectModel { Name = "subject_id", Id = "subject_id", Label = "Fənn", Required = true, Options = subjectOptions })" />

            <div class="grid grid-cols-2 gap-4">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "title_type", Id = "title_type", Label = "Başlıq növü", Options = textImage })" />
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "variant_type", Id = "variant_type", Label = "Variant növü", Options = textImage })" />
            </div>

            <div id="titleTextBlock">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = "Sual mətni", Required = true })" />
            </div>
            <div id="titleImageBlock" class="hidden">
                <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "title_image", Id = "title_image", Label = "Sual şəkli", Accept = "image/*" })" />
            </div>

            <div id="variantsTextBlock" class="space-y-3">
                @foreach (var v in new[] { "A", "B", "C", "D", "E" })
                {
                    <partial name="Ui/_Input" model="@(new InputModel { Name = $"variant_{v.ToLower()}", Id = $"variant_{v.ToLower()}", Label = $"Variant {v}" })" />
                }
            </div>
            <div id="variantsImageBlock" class="hidden space-y-3">
                @foreach (var v in new[] { "A", "B", "C", "D", "E" })
                {
                    <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = $"variant_{v.ToLower()}_image", Id = $"variant_{v.ToLower()}_image", Label = $"Variant {v} şəkli", Accept = "image/*" })" />
                }
            </div>

            <div class="grid grid-cols-2 gap-4">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "correct_answer", Id = "correct_answer", Label = "Düzgün cavab", Options = answers })" />
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "İmtina", Variant = "secondary", OnClick = "closeModal()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = "Yadda saxla", Type = "submit" })" />
            </div>
        </form>
    </div>
</div>

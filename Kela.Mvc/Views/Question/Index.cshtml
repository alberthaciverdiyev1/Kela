@{
    ViewData["Title"] = L["Nav_Questions"];
    var subjects = (PagedResponse<SubjectResponse>)ViewData["Subjects"]!;
    var subjectFilter = new List<SelectOption> { new() { Value = "", Text = L["Common_All"] } };
    subjectFilter.AddRange(subjects.Data.Select(s => new SelectOption { Value = s.Id.ToString(), Text = s.Name }));
}
<script>window.SUBJECTS = { @Html.Raw(string.Join(",", subjects.Data.Select(s => $"{s.Id}:\"{System.Text.Json.JsonEncodedText.Encode(s.Name)}\""))) }; </script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Question_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Question_Search"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-44", Select = new SelectModel { Name = "filter_subject", Id = "filter_subject", Label = L["Common_Subject"], Options = subjectFilter } }
            },
            Sort = new FilterSortModel { },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/question/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Subject"], WidthClass = "w-44" },
                                    new() { Label = L["Common_Question"] },
                                    new() { Label = L["Question_Correct"], WidthClass = "w-28" },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Question_Create"],
    WidthClass = "max-w-3xl",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

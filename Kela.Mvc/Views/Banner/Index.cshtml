@{
    ViewData["Title"] = "Bannerlər";
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Banners"],
        Subtitle = L["Banner_Subtitle"],
        CreateText = L["Banner_Create"],
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = L["Banner_Total"],
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M4 5h16v14H4z' /><path stroke-linecap='round' stroke-linejoin='round' d='m4 15 4-4 5 5 3-3 4 4' /><circle cx='9' cy='9' r='1.5' />"
        }
    })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Banner_Search"],
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/banner/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th class="w-28">@L["Common_Image"]</th>
                            <th>@L["Common_Title"]</th>
                            <th class="w-28">Status</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <p id="tableInfo" class="text-sm font-medium text-slate-500">@L["Common_LoadingResults"]</p>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

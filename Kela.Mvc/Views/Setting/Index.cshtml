@model Kela.Core.Modules.Setting.Responses.SettingResponse
@{
    ViewData["Title"] = "Parametrlər";
}
@if (!string.IsNullOrEmpty(Model.Logo))
{
    <script>window.LOGO_URL = "@Model.Logo";</script>
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Settings"],
        Subtitle = L["Setting_Subtitle"] })" />

    <form id="settingForm" class="admin-card max-w-3xl space-y-8 p-6 sm:p-7">
        <div class="space-y-4">
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Brendinq</h3>
            </div>
            <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "logo", Id = "logo", Label = L["Setting_Logo"], Accept = "image/*", Hint = "jpg/png" })" />
        </div>

        <div class="space-y-4 border-t border-border pt-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">@L["Common_Contact"]</h3>
            <div class="grid gap-4 sm:grid-cols-2">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "whatsappNumber", Id = "whatsappNumber", Label = "WhatsApp", Value = Model.WhatsappNumber })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "instagramUrl", Id = "instagramUrl", Label = "Instagram URL", Value = Model.InstagramUrl })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "facebookUrl", Id = "facebookUrl", Label = "Facebook URL", Value = Model.FacebookUrl })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber1", Id = "contactNumber1", Label = L["Setting_ContactNumber", 1], Value = Model.ContactNumber1 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber2", Id = "contactNumber2", Label = L["Setting_ContactNumber", 2], Value = Model.ContactNumber2 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber3", Id = "contactNumber3", Label = L["Setting_ContactNumber", 3], Value = Model.ContactNumber3 })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "contactNumber4", Id = "contactNumber4", Label = L["Setting_ContactNumber", 4], Value = Model.ContactNumber4 })" />
            </div>
        </div>

        <div class="space-y-4 border-t border-border pt-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">@L["Setting_AppVersions"]</h3>
            <div class="grid gap-4 sm:grid-cols-2">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "androidMinVersion", Id = "androidMinVersion", Label = L["Setting_AndroidMin"], Value = Model.AndroidMinVersion })" />
                <partial name="Ui/_Input" model="@(new InputModel { Name = "iosMinVersion", Id = "iosMinVersion", Label = L["Setting_IosMin"], Value = Model.IosMinVersion })" />
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-6">
            <button type="button" id="clearCacheBtn" class="admin-button-secondary">@L["Setting_ClearCache"]</button>
            <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
        </div>
    </form>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

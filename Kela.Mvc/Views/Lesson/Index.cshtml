@{
    ViewData["Title"] = "Dərslər";
    var subjects = (PagedResponse<SubjectResponse>)ViewData["Subjects"]!;
    var subjectFilter = new List<SelectOption> { new() { Value = "", Text = "Hamısı" } };
    subjectFilter.AddRange(subjects.Data.Select(s => new SelectOption { Value = s.Id.ToString(), Text = s.Name }));
    var statusFilter = new List<SelectOption>
    {
        new() { Value = "", Text = "Hamısı" },
        new() { Value = "true", Text = "Aktiv" },
        new() { Value = "false", Text = "Arxivdə" }
    };
    var sortFilter = new List<SelectOption>
    {
        new() { Value = "new", Text = "Ən yeni" },
        new() { Value = "order", Text = "Sıra" }
    };
}
<script>window.SUBJECTS = { @Html.Raw(string.Join(",", subjects.Data.Select(s => $"{s.Id}:\"{System.Text.Json.JsonEncodedText.Encode(s.Name)}\""))) }; </script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Dərslər",
        Subtitle = "Fənlər üzrə dərsləri yaradın və sıralayın.",
        CreateText = "Yeni dərs" })" />

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_total", Label = "Cəmi dərs",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_active", Label = "Aktiv dərslər", Accent = "bg-sky-100 text-sky-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_archive", Label = "Arxivdə", Accent = "bg-warning-bg text-warning",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6v6l4 2M21 12A9 9 0 1 1 3 12a9 9 0 0 1 18 0Z' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "stat_material", Label = "Cəmi material", Accent = "bg-violet-100 text-violet-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M7 3h7l5 5v13H7V3Z' /><path stroke-linecap='round' stroke-linejoin='round' d='M14 3v6h5M10 14h6M10 18h4' />" })" />
    </div>

    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="grow">
                <label class="relative block">
                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" /></svg>
                    </span>
                    <input id="search" name="search" type="search" class="admin-field pl-11" placeholder="Dərs adı və ya müəllim üzrə axtar..." />
                </label>
            </div>
            <div class="w-44">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_subject", Id = "filter_subject", Label = "Fənn", Options = subjectFilter, Value = (string?)ViewData["SelectedSubjectId"] })" />
            </div>
            <div class="w-36">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_status", Id = "filter_status", Label = "Status", Options = statusFilter })" />
            </div>
            <div class="w-36">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_sort", Id = "filter_sort", Label = "Sırala", Options = sortFilter })" />
            </div>
            <button type="button" onclick="loadList(1)" class="admin-button-primary h-[46px] px-6">Axtar</button>
        </div>

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"></th>
                            <th class="w-16">#</th>
                            <th>Ad</th>
                            <th class="w-36">Fənn</th>
                            <th class="w-40">Qrup / Target</th>
                            <th class="w-24">Sıra</th>
                            <th class="w-32">Status</th>
                            <th class="w-40">Son yenilənmə</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <p id="tableInfo" class="text-sm font-medium text-slate-500">Nəticələr yüklənir...</p>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />
<partial name="_SettingsModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

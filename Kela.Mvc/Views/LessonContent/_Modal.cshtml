@{
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var typeOptions = new List<SelectOption>
    {
        new() { Value = "video", Text = L["Type_Video"] },
        new() { Value = "file", Text = L["LessonContent_TypeFile"] },
        new() { Value = "voice", Text = L["Type_Voice"] }
    };
}
<div id="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 id="modalTitle" class="text-lg font-bold text-slate-900">@L["Common_NewMaterial"]</h3>
            <button type="button" id="modalCloseBtn" onclick="closeModal()" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed">✕</button>
        </div>
        <div id="formError" class="mx-6 mt-4 hidden rounded-xl bg-danger-bg px-3 py-2 text-sm font-semibold text-danger"></div>
        <form id="entityForm" class="space-y-4 p-6">
            <input type="hidden" id="entityId" />
            <input type="hidden" id="sort_order" />
            <input type="hidden" id="description" />
            <partial name="Ui/_Select" model="@(new SelectModel {
                Name = "lesson_id", Id = "lesson_id", Label = L["Common_Lesson"], Required = true,
                Options = lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }).ToList()
            })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = L["Common_Title"], Required = true })" />
            <partial name="Ui/_Select" model="@(new SelectModel { Name = "type", Id = "type", Label = L["Common_Type"], Options = typeOptions })" />
            <div id="fileBlock">
                <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "file", Id = "file", Label = L["Common_File"], Hint = "Video böyükdürsə birbaşa R2-yə yüklənir" })" />
            </div>
            <partial name="Ui/_Switch" model="@(new SwitchModel { Name = "is_active", Id = "is_active", Label = L["Common_Active"], Checked = true })" />

            <div id="uploadProgress" class="hidden">
                <div class="mb-1.5 flex items-center justify-between text-xs font-semibold text-slate-500">
                    <span id="uploadLabel">@L["Common_Uploading"]</span>
                    <span id="uploadPercent">0%</span>
                </div>
                <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
                    <div id="uploadBar" class="h-full rounded-full bg-primary transition-[width] duration-200" style="width:0%"></div>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-[11px] font-medium text-slate-400">
                    <span id="uploadSpeed"></span>
                    <span id="uploadSize"></span>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", OnClick = "closeModal()", Id = "cancelBtn" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit", Id = "saveBtn" })" />
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "Materiallar";
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var lessonFilter = new List<SelectOption> { new() { Value = "", Text = L["Common_All"] } };
    lessonFilter.AddRange(lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }));
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Materials"],
        Subtitle = L["LessonContent_Subtitle"],
        CreateText = L["Common_NewMaterial"],
        Sortable = true })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-44", Select = new SelectModel { Name = "filter_lesson", Id = "filter_lesson", Label = L["Common_Lesson"], Options = lessonFilter, Value = (string?)ViewData["SelectedLessonId"] } }
            },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Show"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/lesson-content/bulk", CanActivate = true, CanDeactivate = true })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>@L["Common_Title"]</th>
                            <th class="w-28">@L["Common_Type"]</th>
                            <th class="w-32">@L["Video_Status"]</th>
                            <th class="w-24">Fayl</th>
                            <th class="w-24">Aktiv</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<div id="previewModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4">
    <div class="flex max-h-[90vh] w-full max-w-3xl flex-col rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-4">
            <h3 id="previewTitle" class="truncate pr-3 font-bold text-slate-800"></h3>
            <div class="flex items-center gap-1">
                <button type="button" id="previewFullscreenBtn" onclick="togglePreviewFullscreen()"
                        title="@L["Common_Fullscreen"]" aria-label="@L["Common_Fullscreen"]"
                        class="hidden rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                    </svg>
                </button>
                <button type="button" onclick="closePreview()" aria-label="@L["Common_Close"]" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100">✕</button>
            </div>
        </div>
        <div id="previewBody" class="overflow-auto p-4"></div>
    </div>
</div>

<partial name="_Modal" />
<partial name="Ui/_SortModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Materiallar";
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var lessonFilter = new List<SelectOption> { new() { Value = "", Text = "Hamısı" } };
    lessonFilter.AddRange(lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }));
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = "Materiallar",
        Subtitle = "Dərslərə aid video, fayl və səs materiallarını idarə edin.",
        CreateText = "Yeni material" })" />

    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="w-72">
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "filter_lesson", Id = "filter_lesson", Label = "Dərs", Options = lessonFilter, Value = (string?)ViewData["SelectedLessonId"] })" />
            </div>
            <button type="button" onclick="loadList(1)" class="admin-button-primary h-[46px] px-6">Göstər</button>
        </div>

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-16">#</th>
                            <th>Başlıq</th>
                            <th class="w-28">Növ</th>
                            <th class="w-24">Fayl</th>
                            <th class="w-20">Sıra</th>
                            <th class="w-24">Aktiv</th>
                            <th class="text-right">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

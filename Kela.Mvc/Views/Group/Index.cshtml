@{
    ViewData["Title"] = L["Nav_Groups"];
    var teachers = (PagedResponse<UserResponse>)ViewData["Teachers"]!;
}
<script>window.TEACHERS = { @Html.Raw(string.Join(",", teachers.Data.Select(u => $"{u.Id}:\"{System.Text.Json.JsonEncodedText.Encode(($"{u.Name} {u.Surname}".Trim()))}\""))) }; </script>

<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Group_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Group_Search"],
            Sort = new FilterSortModel { },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/group/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Name"] },
                                    new() { Label = L["Common_Teacher"] },
                                    new() { Label = L["Common_Student"], WidthClass = "w-28" },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Group_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />
@{
    var manageModalBody = await Html.PartialAsync("_ManageModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "manageModal",
    TitleId = "manageTitle",
    Title = L["Common_Manage"],
    WidthClass = "max-w-2xl",
    ShowError = false,
    Body = manageModalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

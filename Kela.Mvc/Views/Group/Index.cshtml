@{
    ViewData["Title"] = "Qruplar";
    var teachers = (PagedResponse<UserResponse>)ViewData["Teachers"]!;
}
<script>window.TEACHERS = { @Html.Raw(string.Join(",", teachers.Data.Select(u => $"{u.Id}:\"{System.Text.Json.JsonEncodedText.Encode(($"{u.Name} {u.Surname}".Trim()))}\""))) }; </script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        Title = L["Nav_Groups"],
        Subtitle = L["Group_Subtitle"],
        CreateText = L["Group_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Group_Search"],
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/group/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="w-12"><input type="checkbox" id="checkAll" class="h-5 w-5 rounded-md border-slate-300 text-primary focus:ring-primary" /></th>
                            <th class="w-16">#</th>
                            <th>@L["Common_Name"]</th>
                            <th>@L["Common_Teacher"]</th>
                            <th class="w-28">@L["Common_Student"]</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <div class="admin-table-footer">
            <span></span>
            <div id="pagination" class="flex flex-wrap justify-end gap-2"></div>
        </div>
    </div>
</section>

<partial name="_Modal" />
<partial name="_ManageModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

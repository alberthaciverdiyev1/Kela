<div class="flex gap-1 border-b border-border px-4 pt-3">
    <button type="button" data-tab="students" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('students')">@L["Nav_Students"]</button>
    <button type="button" data-tab="subjects" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('subjects')">@L["Nav_Subjects"]</button>
    <button type="button" data-tab="quizzes" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('quizzes')">@L["Nav_Exams"]</button>
    <button type="button" data-tab="logs" class="manage-tabbtn rounded-t-lg px-4 py-2 text-sm" onclick="switchTab('logs')">@L["Group_SubjectLogs"]</button>
</div>
<div class="max-h-[60vh] overflow-y-auto p-4">
    <div id="tab-students" class="manage-tab space-y-3">
        <div class="flex gap-2">
            <select id="studentsSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
            <button type="button" onclick="assignMember('students')" class="admin-button-primary !min-h-0 !py-2">@L["Common_Add"]</button>
            <button type="button" onclick="toggleGroupGen()" class="admin-button-secondary !min-h-0 !py-2">@L["Common_Generate"]</button>
        </div>

        <div id="groupGenPanel" class="hidden space-y-3 rounded-xl border border-border p-3">
            <div class="grid grid-cols-2 gap-2">
                <input id="gg_count" type="number" value="100" placeholder="100" class="admin-field" />
                <input id="gg_domain" value="kela.az" placeholder="domain" class="admin-field" />
                <input id="gg_prefix" value="Student" placeholder="prefix" class="admin-field" />
                <input id="gg_password" placeholder="parol (boş=random)" class="admin-field" />
            </div>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="toggleGroupGen()" class="admin-button-secondary">@L["Common_Cancel"]</button>
                <button type="button" onclick="generateIntoGroup()" class="admin-button-primary">@L["Common_Generate"]</button>
            </div>
        </div>

        <div id="studentsList" class="space-y-2"></div>
    </div>
    <div id="tab-subjects" class="manage-tab hidden space-y-3">
        <div class="flex gap-2">
            <select id="subjectsSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
            <button type="button" onclick="assignMember('subjects')" class="admin-button-primary !min-h-0 !py-2">@L["Common_Add"]</button>
        </div>
        <div id="subjectsList" class="space-y-2"></div>
    </div>
    <div id="tab-quizzes" class="manage-tab hidden space-y-3">
        <div class="flex gap-2">
            <select id="quizzesSelect" class="flex-1 rounded-lg border border-slate-300 bg-slate-50 p-2.5 text-sm"></select>
            <button type="button" onclick="assignMember('quizzes')" class="admin-button-primary !min-h-0 !py-2">@L["Common_Add"]</button>
        </div>
        <div id="quizzesList" class="space-y-2"></div>
    </div>
    <div id="tab-logs" class="manage-tab hidden space-y-3">
        <p class="text-sm text-slate-500">@L["Group_SubjectLogsHint"]</p>
        <div id="logsList" class="space-y-2"></div>
    </div>
</div>

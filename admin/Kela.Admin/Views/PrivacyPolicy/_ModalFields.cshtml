<form id="entityForm" class="space-y-4 p-6">
    <partial name="Ui/_Input" model="@(new InputModel { Name = "type", Id = "type", Label = L["Privacy_TypeHint"], Required = true })" />
    <partial name="Ui/_Editor" model="@(new EditorModel { Name = "content", Id = "content", Label = L["Privacy_ContentHtml"] })" />
    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

@{
    ViewData["Title"] = L["Nav_Certificates"];
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Certificate_Create"],
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = L["Certificate_Total"],
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M8 3h8l4 4v14H4V3z' /><path stroke-linecap='round' stroke-linejoin='round' d='M8 12h8M8 16h5' />"
        }
    })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Certificate_Search"],
            Sort = new FilterSortModel { },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/certificate/bulk" })" />

        <partial name="Ui/_Table" model="@(new TableModel
        {
            Selectable = true,
            Columns = new List<TableColumnModel>
            {
                    new() { Label = L["Common_Title"] },
                    new() { Label = L["Certificate_Template"], WidthClass = "w-40" },
                    new() { Label = L["Certificate_Signature"], WidthClass = "w-28" },
                    new() { Label = L["Common_Date"], WidthClass = "w-32" },
                    new() { Label = L["Common_Actions"], Right = true },
            }
        })" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Certificate_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

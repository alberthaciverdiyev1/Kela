@{
    Layout = "_AuthLayout";
    ViewData["FullBleed"] = true;
    ViewData["Title"] = L["Tenant_RegisterTitle"];
    var success = ViewData["Success"] is true;
}
<div class="grid min-h-screen w-full lg:grid-cols-2">
    @* --- Brend / izahat paneli --- *@
    <aside class="relative hidden flex-col justify-center overflow-hidden bg-gradient-to-br from-primary to-primary-700 p-12 text-white lg:flex xl:p-16">
        <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-white/5"></div>

        <div class="relative mx-auto w-full max-w-lg">
            <div class="flex items-center gap-3">
                <div class="grid h-12 w-12 place-items-center rounded-xl bg-white/15 text-white backdrop-blur">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
                </div>
                <div>
                    <p class="text-xl font-extrabold leading-none tracking-tight">Kela</p>
                    <p class="mt-1 text-xs font-medium text-white/70">@L["Sidebar_AdminPanel"]</p>
                </div>
            </div>

            <h1 class="mt-12 text-4xl font-extrabold leading-tight tracking-tight xl:text-5xl">@L["Tenant_RegisterHeroTitle"]</h1>
            <p class="mt-4 max-w-md text-base leading-relaxed text-white/75">@L["Tenant_RegisterHeroText"]</p>

            <ul class="mt-10 space-y-4">
                @foreach (var key in new[] { "Tenant_RegisterBenefit1", "Tenant_RegisterBenefit2", "Tenant_RegisterBenefit3" })
                {
                    <li class="flex items-start gap-3 text-base">
                        <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white/20">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        </span>
                        <span class="text-white/90">@L[key]</span>
                    </li>
                }
            </ul>

            <div class="mt-12 rounded-2xl bg-white/10 p-5 backdrop-blur">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/60">@L["Tenant_RegisterHowItWorks"]</p>
                <div class="mt-3 space-y-3 text-sm">
                    @foreach (var (n, key) in new[] { (1, "Tenant_RegisterStep1"), (2, "Tenant_RegisterStep2"), (3, "Tenant_RegisterStep3") })
                    {
                        <div class="flex items-center gap-3">
                            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white text-[11px] font-bold text-primary">@n</span>
                            <span class="text-white/85">@L[key]</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>

    @* --- Form paneli --- *@
    <section class="flex min-h-screen flex-col bg-white">
        <div class="flex items-center gap-3 border-b border-border px-6 py-4 lg:hidden">
            <div class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
            </div>
            <div>
                <p class="text-base font-extrabold leading-none text-slate-900">Kela</p>
                <p class="mt-1 text-[11px] font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
            </div>
        </div>

        <div class="flex flex-1 items-center justify-center px-6 py-10 sm:px-10">
            <div class="w-full max-w-xl">
                @if (success)
                {
                    <div class="text-center">
                        <span class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-emerald-50 text-emerald-600">
                            <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        </span>
                        <h2 class="mt-6 text-2xl font-extrabold tracking-tight text-slate-900">@L["Tenant_RegisterSuccessTitle"]</h2>
                        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-slate-500">@L["Tenant_RegisteredPending"]</p>
                        <a href="/login" class="admin-button-primary mt-8 inline-flex w-full max-w-xs justify-center">@L["Tenant_RegisterBackToLogin"]</a>
                    </div>
                }
                else
                {
                    <div class="mb-7">
                        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">@L["Tenant_Register"]</p>
                        <h2 class="mt-1.5 text-3xl font-extrabold tracking-tight text-slate-900">@L["Tenant_RegisterTitle"]</h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-500">@L["Tenant_RegisterSubtitle"]</p>
                    </div>

                    @if (ViewData["Error"] is string err)
                    {
                        <div class="mb-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
                    }

                    <form method="post" action="/register" enctype="multipart/form-data" class="space-y-6">
                        @Html.AntiForgeryToken()

                        <div>
                            <p class="mb-2 text-sm font-semibold text-slate-600">@L["Tenant_AccountType"]</p>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="cursor-pointer">
                                    <input type="radio" name="AccountType" value="course" class="peer sr-only" checked data-account-type />
                                    <span class="flex h-full items-center gap-3 rounded-xl border border-border bg-surface-secondary p-4 transition peer-checked:border-primary peer-checked:bg-primary-light">
                                        <svg class="h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
                                        <span class="font-semibold text-slate-800">@L["Tenant_AccountTypeCourse"]</span>
                                    </span>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="AccountType" value="teacher" class="peer sr-only" data-account-type />
                                    <span class="flex h-full items-center gap-3 rounded-xl border border-border bg-surface-secondary p-4 transition peer-checked:border-primary peer-checked:bg-primary-light">
                                        <svg class="h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" /></svg>
                                        <span class="font-semibold text-slate-800">@L["Tenant_AccountTypeTeacher"]</span>
                                    </span>
                                </label>
                            </div>
                            <p class="mt-2 text-xs text-slate-400">@L["Tenant_AccountTypeHint"]</p>
                        </div>

                        <div id="courseBlock">
                            <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                                <span class="grid h-5 w-5 place-items-center rounded-full bg-primary-light text-[10px] font-extrabold text-primary">1</span>
                                @L["Tenant_RegisterSectionCourse"]
                            </p>
                            <div class="grid items-end gap-4 sm:grid-cols-2">
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "CourseName", Id = "courseName", Label = L["Tenant_CourseName"], Required = true })" />
                                <div>
                                    <label for="logo" class="mb-1 block text-sm font-semibold text-slate-600">@L["Tenant_RegisterLogo"]</label>
                                    <label for="logo" class="flex h-[46px] cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-surface-secondary px-3 text-sm font-medium text-slate-500 transition hover:border-primary hover:bg-primary-light hover:text-primary">
                                        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0 4 4m-4-4L8 8M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                                        <span id="logoName" class="truncate">@L["Common_ChooseFile"]</span>
                                        <input id="logo" name="Logo" type="file" accept="image/png,image/jpeg,image/webp" class="hidden"
                                               data-logo-input data-empty="@L["Common_ChooseFile"]" />
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-border pt-6">
                            <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                                <span id="accountStepNo" class="grid h-5 w-5 place-items-center rounded-full bg-primary-light text-[10px] font-extrabold text-primary">2</span>
                                @L["Tenant_RegisterSectionAccount"]
                            </p>
                            <div class="grid gap-4 sm:grid-cols-2">
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "AdminName", Id = "adminName", Label = L["Common_Name"], Required = true })" />
                                <partial name="Ui/_Input" model="@(new InputModel { Name = "AdminSurname", Id = "adminSurname", Label = L["Common_Surname"] })" />
                            </div>
                            <div class="mt-4 space-y-4">
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "PhoneNumber", Id = "phoneNumber", Label = L["Common_Phone"], Type = "tel", Required = true })" />
                            </div>
                            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
                                <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "ConfirmPassword", Id = "confirmPassword", Label = L["Tenant_ConfirmPassword"], Type = "password", Required = true })" />
                            </div>
                        </div>

                        <label class="flex items-start gap-2.5 rounded-xl bg-surface-secondary px-3.5 py-3 text-sm text-slate-600">
                            <input type="checkbox" name="AcceptTerms" value="true" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />
                            <span>
                                @L["Tenant_AcceptTerms"]
                                <a href="/register/terms" target="_blank" class="font-semibold text-primary hover:underline">@L["Tenant_TermsLink"]</a>
                            </span>
                        </label>

                        <div class="hidden" aria-hidden="true">
                            <label>Website <input type="text" name="Website" tabindex="-1" autocomplete="off" /></label>
                        </div>

                        <button type="submit" class="admin-button-primary w-full">@L["Tenant_RegisterSubmit"]</button>
                    </form>

                    <p class="mt-6 text-center text-sm text-slate-500">
                        @L["Tenant_AlreadyHaveAccount"]
                        <a href="/login" class="font-semibold text-primary hover:underline">@L["Common_SignIn"]</a>
                    </p>
                }
            </div>
        </div>
    </section>
</div>

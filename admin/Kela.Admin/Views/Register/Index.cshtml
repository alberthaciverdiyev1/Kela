@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Tenant_RegisterTitle"];
    var success = ViewData["Success"] is true;
}
<div class="grid w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-xl lg:grid-cols-[1.05fr_1fr]">
    @* --- Brend / izahat paneli --- *@
    <aside class="relative hidden flex-col justify-between overflow-hidden bg-gradient-to-br from-primary to-primary-700 p-9 text-white lg:flex">
        <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-16 h-64 w-64 rounded-full bg-white/5"></div>

        <div class="relative">
            <div class="flex items-center gap-3">
                <div class="grid h-11 w-11 place-items-center rounded-xl bg-white/15 text-white backdrop-blur">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
                </div>
                <div>
                    <p class="text-lg font-extrabold leading-none tracking-tight">Kela</p>
                    <p class="mt-1 text-xs font-medium text-white/70">@L["Sidebar_AdminPanel"]</p>
                </div>
            </div>

            <h1 class="mt-10 text-3xl font-extrabold leading-tight tracking-tight">@L["Tenant_RegisterHeroTitle"]</h1>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/75">@L["Tenant_RegisterHeroText"]</p>

            <ul class="mt-8 space-y-3.5">
                @foreach (var key in new[] { "Tenant_RegisterBenefit1", "Tenant_RegisterBenefit2", "Tenant_RegisterBenefit3" })
                {
                    <li class="flex items-start gap-3 text-sm">
                        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-white/20">
                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        </span>
                        <span class="text-white/90">@L[key]</span>
                    </li>
                }
            </ul>
        </div>

        <div class="relative mt-10 rounded-2xl bg-white/10 p-4 backdrop-blur">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/60">@L["Tenant_RegisterHowItWorks"]</p>
            <div class="mt-3 space-y-2.5 text-sm">
                @foreach (var (n, key) in new[] { (1, "Tenant_RegisterStep1"), (2, "Tenant_RegisterStep2"), (3, "Tenant_RegisterStep3") })
                {
                    <div class="flex items-center gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white text-[11px] font-bold text-primary">@n</span>
                        <span class="text-white/85">@L[key]</span>
                    </div>
                }
            </div>
        </div>
    </aside>

    @* --- Form paneli --- *@
    <section class="p-6 sm:p-9">
        @if (success)
        {
            <div class="flex min-h-[420px] flex-col items-center justify-center text-center">
                <span class="grid h-16 w-16 place-items-center rounded-full bg-emerald-50 text-emerald-600">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                </span>
                <h2 class="mt-5 text-xl font-extrabold tracking-tight text-slate-900">@L["Tenant_RegisterSuccessTitle"]</h2>
                <p class="mt-2 max-w-sm text-sm leading-relaxed text-slate-500">@L["Tenant_RegisteredPending"]</p>
                <a href="/login" class="admin-button-primary mt-6 w-full max-w-xs">@L["Tenant_RegisterBackToLogin"]</a>
            </div>
        }
        else
        {
            <div class="mb-6">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">@L["Tenant_Register"]</p>
                <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-slate-900">@L["Tenant_RegisterTitle"]</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-500">@L["Tenant_RegisterSubtitle"]</p>
            </div>

            @if (ViewData["Error"] is string err)
            {
                <div class="mb-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
            }

            <form method="post" action="/register" class="space-y-5">
                @Html.AntiForgeryToken()

                <div>
                    <p class="mb-2.5 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                        <span class="grid h-5 w-5 place-items-center rounded-full bg-primary-light text-[10px] font-extrabold text-primary">1</span>
                        @L["Tenant_RegisterSectionCourse"]
                    </p>
                    <div class="space-y-4">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "CourseName", Id = "courseName", Label = L["Tenant_CourseName"], Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "Slug", Id = "slug", Label = L["Tenant_SlugHint"] })" />
                    </div>
                </div>

                <div class="border-t border-border pt-5">
                    <p class="mb-2.5 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
                        <span class="grid h-5 w-5 place-items-center rounded-full bg-primary-light text-[10px] font-extrabold text-primary">2</span>
                        @L["Tenant_RegisterSectionAdmin"]
                    </p>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "AdminName", Id = "adminName", Label = L["Tenant_AdminName"], Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "AdminSurname", Id = "adminSurname", Label = L["Tenant_AdminSurname"] })" />
                    </div>
                    <div class="mt-4 space-y-4">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "PhoneNumber", Id = "phoneNumber", Label = L["Tenant_PhoneOptional"] })" />
                    </div>
                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "ConfirmPassword", Id = "confirmPassword", Label = L["Tenant_ConfirmPassword"], Type = "password", Required = true })" />
                    </div>
                </div>

                <label class="flex items-start gap-2.5 rounded-xl bg-surface-secondary px-3.5 py-3 text-sm text-slate-600">
                    <input type="checkbox" name="AcceptTerms" value="true" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />
                    <span>
                        @L["Tenant_AcceptTerms"]
                        <a href="/register/terms" target="_blank" class="font-semibold text-primary hover:underline">@L["Tenant_TermsLink"]</a>
                    </span>
                </label>

                <button type="submit" class="admin-button-primary w-full">@L["Tenant_RegisterSubmit"]</button>
            </form>

            <p class="mt-5 text-center text-sm text-slate-500">
                @L["Tenant_AlreadyHaveAccount"]
                <a href="/login" class="font-semibold text-primary hover:underline">@L["Common_SignIn"]</a>
            </p>
        }
    </section>
</div>

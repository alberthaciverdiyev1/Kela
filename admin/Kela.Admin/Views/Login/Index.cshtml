@using Kela.Core.Modules.Tenant.Responses
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Login_Title"];
    var tenantList = ViewData["Tenants"] as IReadOnlyList<TenantResponse> ?? new List<TenantResponse>();
}
<div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-lg">
    <div class="mb-6 flex items-center gap-3">
        <div class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white shadow-sm">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
        </div>
        <div>
            <p class="text-lg font-extrabold leading-none tracking-tight text-slate-900">Kela</p>
            <p class="mt-1 text-xs font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
        </div>
    </div>

    @if (ViewData["Error"] is string err)
    {
        <div class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600">@err</div>
    }

    <form method="post" action="/login" class="space-y-4">
        @Html.AntiForgeryToken()
        @* Müəssisə seçimi App-dəki kimi kartlarla — radio group native yoxlama verir. *@
        <fieldset aria-labelledby="tenantLegend">
            <div class="mb-2 flex items-center justify-between">
                <span id="tenantLegend" class="block text-sm font-semibold text-slate-600">@L["Common_Tenant"]</span>
                <button type="button" id="tenantSeeAll" class="flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                    @L["Login_SeeAll"]
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" /></svg>
                </button>
            </div>
            @* App-dəki kimi üfüqi sürüşən kartlar — tenant sayı artdıqca səhifə uzanmır. *@
            <div class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                @foreach (var t in tenantList.Take(10))
                {
                    <label class="shrink-0 cursor-pointer">
                        <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="peer sr-only" required />
                        <span class="flex h-20 w-[76px] flex-col items-center justify-center gap-[7px] rounded-[17px] border border-border bg-surface-secondary p-0 text-center text-slate-700 transition hover:bg-surface peer-checked:border-primary peer-checked:bg-primary-light peer-checked:text-primary">
                            @if (!string.IsNullOrWhiteSpace(t.Logo))
                            {
                                <img src="@t.Logo" alt="" class="h-[38px] w-[38px] rounded-xl object-cover" />
                            }
                            else
                            {
                                <span class="grid h-[38px] w-[38px] place-items-center rounded-xl bg-primary/10 text-sm font-bold text-primary">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                            }
                            <span class="max-w-[70px] truncate text-[10px] font-semibold">@t.Name</span>
                        </span>
                    </label>
                }
            </div>
            @* İlk 10-dan sonrakı müəssisələr yalnız modalda görünür — seçim üçün gizli radio. *@
            @foreach (var t in tenantList.Skip(10))
            {
                <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="hidden" required />
            }
            <p id="tenantPicked" class="mt-2 hidden text-xs font-semibold text-primary"></p>
            @if (tenantList.Count == 0)
            {
                <p class="text-sm text-slate-400">@L["Js_Empty"]</p>
            }
        </fieldset>
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
        <button type="submit" class="admin-button-primary w-full">@L["Common_SignIn"]</button>
    </form>
</div>

@* Bütün müəssisələr yalnız axtarışlı modalda göstərilir. *@
<div id="tenantModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
        <div class="flex max-h-[80vh] w-full max-w-md flex-col rounded-2xl bg-white p-5 shadow-xl">
            <div class="mb-3 flex items-center justify-between">
                <strong class="text-base text-slate-900">@L["Login_SelectCourse"]</strong>
                <button type="button" id="tenantModalClose" aria-label="@L["Common_Close"]" class="text-2xl leading-none text-slate-400 transition hover:text-slate-700">&times;</button>
            </div>
            <input id="tenantSearch" type="search" placeholder="@L["Login_SearchCourse"]" class="admin-field mb-3" autocomplete="off" />
            <div id="tenantModalList" class="flex-1 space-y-1 overflow-auto">
                @foreach (var t in tenantList)
                {
                    <button type="button" data-tenant-id="@t.Id" data-tenant-name="@t.Name"
                            class="tenant-option flex w-full items-center gap-3 rounded-xl border border-transparent px-2 py-2.5 text-left text-slate-700 transition hover:bg-slate-50">
                        @if (!string.IsNullOrWhiteSpace(t.Logo))
                        {
                            <img src="@t.Logo" alt="" class="h-8 w-8 shrink-0 rounded-full object-cover" />
                        }
                        else
                        {
                            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-bold text-primary">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                        }
                        <span class="truncate text-sm font-medium">@t.Name</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('tenantModal');
            var list = document.getElementById('tenantModalList');
            var search = document.getElementById('tenantSearch');
            var radios = document.querySelectorAll('input[name="TenantId"]');

            function norm(v) {
                return String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/ı/g, 'i');
            }

            function syncSelected() {
                var checked = document.querySelector('input[name="TenantId"]:checked');
                var hint = document.getElementById('tenantPicked');

                list.querySelectorAll('.tenant-option').forEach(function (btn) {
                    var on = checked && btn.dataset.tenantId === checked.value;
                    btn.classList.toggle('border-primary', on);
                    btn.classList.toggle('bg-primary-light', on);
                    btn.classList.toggle('text-primary', on);
                });

                if (hint) {
                    hint.textContent = checked ? checked.dataset.name : '';
                    hint.classList.toggle('hidden', !checked);
                }
            }

            function openModal() {
                search.value = '';
                list.querySelectorAll('.tenant-option').forEach(function (b) { b.classList.remove('hidden'); });
                syncSelected();
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                search.focus();
            }

            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            document.getElementById('tenantSeeAll').addEventListener('click', openModal);
            document.getElementById('tenantModalClose').addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });

            search.addEventListener('input', function () {
                var q = norm(search.value).trim();
                list.querySelectorAll('.tenant-option').forEach(function (b) {
                    b.classList.toggle('hidden', !!q && norm(b.dataset.tenantName).indexOf(q) === -1);
                });
            });

            list.addEventListener('click', function (e) {
                var btn = e.target.closest('.tenant-option');
                if (!btn) return;

                var radio = document.querySelector('input[name="TenantId"][value="' + btn.dataset.tenantId + '"]');
                if (radio) { radio.checked = true; radio.dispatchEvent(new Event('change', { bubbles: true })); }
                syncSelected();
                closeModal();
            });

            radios.forEach(function (r) { r.addEventListener('change', syncSelected); });
        })();
    </script>

@using Kela.Core.Modules.Tenant.Responses
@{
    Layout = "_AuthLayout";
    ViewData["FullBleed"] = true;
    ViewData["Title"] = L["Login_Title"];
    var tenantList = ViewData["Tenants"] as IReadOnlyList<TenantResponse> ?? new List<TenantResponse>();
}
<div class="grid min-h-screen w-full lg:grid-cols-2">
    @* --- Brend paneli --- *@
    <aside class="relative hidden flex-col justify-center overflow-hidden bg-gradient-to-br from-primary to-primary-700 p-12 text-white lg:flex xl:p-16">
        <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-white/5"></div>

        <div class="relative mx-auto w-full max-w-lg">
            <div class="flex items-center gap-3">
                <div class="grid h-12 w-12 place-items-center rounded-xl bg-white/15 text-white backdrop-blur">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
                </div>
                <div>
                    <p class="text-xl font-extrabold leading-none tracking-tight">Kela</p>
                    <p class="mt-1 text-xs font-medium text-white/70">@L["Sidebar_AdminPanel"]</p>
                </div>
            </div>

            <h1 class="mt-12 text-4xl font-extrabold leading-tight tracking-tight xl:text-5xl">@L["Login_HeroTitle"]</h1>
            <p class="mt-4 max-w-md text-base leading-relaxed text-white/75">@L["Login_HeroText"]</p>

            <div class="mt-12 rounded-2xl bg-white/10 p-5 backdrop-blur">
                <p class="text-sm font-semibold text-white">@L["Login_NoAccount"]</p>
                <a href="/register" class="mt-3 inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-primary transition hover:bg-white/90">
                    @L["Tenant_Register"]
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" /></svg>
                </a>
            </div>
        </div>
    </aside>

    @* --- Form paneli --- *@
    <section class="flex min-h-screen flex-col bg-white">
        <div class="flex items-center gap-3 border-b border-border px-6 py-4 lg:hidden">
            <div class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
            </div>
            <div>
                <p class="text-base font-extrabold leading-none text-slate-900">Kela</p>
                <p class="mt-1 text-[11px] font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
            </div>
        </div>

        <div class="flex flex-1 items-center justify-center px-6 py-10 sm:px-10">
            <div class="w-full max-w-xl">
                <div class="mb-7">
                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">@L["Login_Title"]</p>
                    <h2 class="mt-1.5 text-3xl font-extrabold tracking-tight text-slate-900">@L["Login_HeroTitle"]</h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate-500">@L["Login_Subtitle"]</p>
                </div>

                @if (ViewData["Error"] is string err)
                {
                    <div class="mb-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
                }

                <form method="post" action="/login" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <fieldset aria-labelledby="tenantLegend">
                        <legend id="tenantLegend" class="mb-2 block text-sm font-semibold text-slate-600">@L["Common_Tenant"]</legend>

                        @* 2 sətir × 5 kart — ilk 10 tenant. *@
                        <div class="grid grid-cols-5 gap-1.5 sm:gap-2">
                            @foreach (var t in tenantList.Take(10))
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="peer sr-only" required />
                                    <span class="flex h-[76px] flex-col items-center justify-center gap-1.5 rounded-xl border border-border bg-surface-secondary px-1 text-center text-slate-700 transition hover:bg-surface peer-checked:border-primary peer-checked:bg-primary-light peer-checked:text-primary">
                                        @if (!string.IsNullOrWhiteSpace(t.Logo))
                                        {
                                            <img src="@t.Logo" alt="" class="h-8 w-8 rounded-lg object-cover" />
                                        }
                                        else
                                        {
                                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary/10 text-xs font-bold text-primary">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                                        }
                                        <span class="w-full truncate text-[9px] font-semibold sm:text-[10px]">@t.Name</span>
                                    </span>
                                </label>
                            }
                        </div>

                        @* İlk 10-dan sonrakı müəssisələr modalda; seçim üçün gizli radio. *@
                        @foreach (var t in tenantList.Skip(10))
                        {
                            <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="hidden" required />
                        }

                        <button type="button" id="tenantSeeAll"
                                class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-xl border border-border bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 shadow-md transition hover:-translate-y-0.5 hover:bg-surface-secondary hover:shadow-lg">
                            @L["Login_SeeAll"]
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                        </button>

                        <p id="tenantPicked" class="mt-2 hidden text-xs font-semibold text-primary"></p>
                        @if (tenantList.Count == 0)
                        {
                            <p class="mt-2 text-sm text-slate-400">@L["Js_Empty"]</p>
                        }
                    </fieldset>

                    <div class="border-t border-border pt-5 space-y-4">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
                    </div>

                    <button type="submit" class="admin-button-primary w-full">@L["Common_SignIn"]</button>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    @L["Login_NoAccount"]
                    <a href="/register" class="font-semibold text-primary hover:underline">@L["Tenant_Register"]</a>
                </p>
            </div>
        </div>
    </section>
</div>

@* Bütün müəssisələr axtarışlı modalda göstərilir. *@
<div id="tenantModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
    <div class="flex max-h-[80vh] w-full max-w-md flex-col rounded-2xl bg-white p-5 shadow-xl">
        <div class="mb-3 flex items-center justify-between">
            <strong class="text-base text-slate-900">@L["Login_SelectCourse"]</strong>
            <button type="button" id="tenantModalClose" aria-label="@L["Common_Close"]" class="text-2xl leading-none text-slate-400 transition hover:text-slate-700">&times;</button>
        </div>
        <input id="tenantSearch" type="search" placeholder="@L["Login_SearchCourse"]" class="admin-field mb-3" autocomplete="off" />
        <div id="tenantModalList" class="flex-1 space-y-1 overflow-auto">
            @foreach (var t in tenantList)
            {
                <button type="button" data-tenant-id="@t.Id" data-tenant-name="@t.Name"
                        class="tenant-option flex w-full items-center gap-3 rounded-xl border border-transparent px-2 py-2.5 text-left text-slate-700 transition hover:bg-slate-50">
                    @if (!string.IsNullOrWhiteSpace(t.Logo))
                    {
                        <img src="@t.Logo" alt="" class="h-8 w-8 shrink-0 rounded-full object-cover" />
                    }
                    else
                    {
                        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-bold text-primary">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                    }
                    <span class="truncate text-sm font-medium">@t.Name</span>
                </button>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var modal = document.getElementById('tenantModal');
        var list = document.getElementById('tenantModalList');
        var search = document.getElementById('tenantSearch');
        var radios = document.querySelectorAll('input[name="TenantId"]');

        function norm(v) {
            return String(v || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/ı/g, 'i');
        }

        function syncSelected() {
            var checked = document.querySelector('input[name="TenantId"]:checked');
            var hint = document.getElementById('tenantPicked');

            list.querySelectorAll('.tenant-option').forEach(function (btn) {
                var on = checked && btn.dataset.tenantId === checked.value;
                btn.classList.toggle('border-primary', on);
                btn.classList.toggle('bg-primary-light', on);
                btn.classList.toggle('text-primary', on);
            });

            if (hint) {
                hint.textContent = checked ? checked.dataset.name : '';
                hint.classList.toggle('hidden', !checked);
            }
        }

        function openModal() {
            search.value = '';
            list.querySelectorAll('.tenant-option').forEach(function (b) { b.classList.remove('hidden'); });
            syncSelected();
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            search.focus();
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('tenantSeeAll').addEventListener('click', openModal);
        document.getElementById('tenantModalClose').addEventListener('click', closeModal);
        modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });

        search.addEventListener('input', function () {
            var q = norm(search.value).trim();
            list.querySelectorAll('.tenant-option').forEach(function (b) {
                b.classList.toggle('hidden', !!q && norm(b.dataset.tenantName).indexOf(q) === -1);
            });
        });

        list.addEventListener('click', function (e) {
            var btn = e.target.closest('.tenant-option');
            if (!btn) return;

            var radio = document.querySelector('input[name="TenantId"][value="' + btn.dataset.tenantId + '"]');
            if (radio) { radio.checked = true; radio.dispatchEvent(new Event('change', { bubbles: true })); }
            syncSelected();
            closeModal();
        });

        radios.forEach(function (r) { r.addEventListener('change', syncSelected); });
    })();
</script>

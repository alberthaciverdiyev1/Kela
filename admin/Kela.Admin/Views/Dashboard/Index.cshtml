@model DashboardResponse
@{
    ViewData["Title"] = L["Nav_Dashboard"];
    var cards = new (string Label, string Value, string Accent, string Icon)[]
    {
        (L["Nav_Students"], Model.Students.Total.ToString(), "bg-primary-light text-primary", "<path stroke-linecap='round' stroke-linejoin='round' d='M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z' />"),
        (L["Dashboard_ActiveStudentCount"], Model.Students.Active.ToString(), "bg-success-bg text-success", "<path stroke-linecap='round' stroke-linejoin='round' d='m5 13 4 4L19 7' />"),
        (L["Dashboard_New7d"], Model.Students.New7d.ToString(), "bg-sky-100 text-sky-600", "<path stroke-linecap='round' stroke-linejoin='round' d='M12 8v4l3 2M21 12A9 9 0 1 1 3 12a9 9 0 0 1 18 0Z' />"),
        (L["Nav_Groups"], Model.Students.Groups.ToString(), "bg-violet-100 text-violet-600", "<path stroke-linecap='round' stroke-linejoin='round' d='M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87' />"),
    };
    var content = new (string Label, int Value)[]
    {
        (L["Nav_Subjects"], Model.Content.Subjects),
        (L["Nav_Lessons"], Model.Content.Lessons),
        (L["Nav_Materials"], Model.Content.Contents),
        (L["Dashboard_Videos"], Model.Content.Videos),
        (L["Dashboard_Files"], Model.Content.Files),
        (L["Dashboard_Voices"], Model.Content.Voices),
        (L["Nav_Exams"], Model.Content.Quizzes),
        (L["Common_Questions"], Model.Content.Questions),
    };
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel())" />

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @foreach (var card in cards)
        {
            <partial name="Ui/_StatCard" model="@(new StatCardModel {
                Label = card.Label, Value = card.Value, Accent = card.Accent, Icon = card.Icon })" />
        }
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Dashboard_QuizAttempts"], Value = Model.Activity.QuizAttempts30d.ToString(), ValueClass = "text-primary", Compact = true })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Dashboard_ActiveStudents"], Value = Model.Activity.StudentsAttempted30d.ToString(), ValueClass = "text-primary", Compact = true })" />
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
        <div class="admin-card p-5">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Nav_Students"]</h3>
            @{
                var studentsJson = System.Text.Json.JsonSerializer.Serialize(new[]
                {
                    new { label = L["Common_Active"].Value, value = Model.Students.Active, tone = "primary" },
                    new { label = L["Common_Inactive"].Value, value = Math.Max(0, Model.Students.Total - Model.Students.Active), tone = "slate" }
                });
            }
            <div class="flex flex-col items-center gap-4" data-chart="@studentsJson" data-chart-kind="donut"></div>
        </div>

        <div class="admin-card p-5 lg:col-span-2">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Dashboard_Content"]</h3>
            @{
                var contentChart = content.Select(c => new { label = c.Label, value = c.Value, tone = "primary" });
                var contentTones = new[] { "primary", "info", "violet", "warning", "primary", "info", "violet", "warning" };
                var contentChartJson = System.Text.Json.JsonSerializer.Serialize(
                    content.Select((c, i) => new { label = c.Label, value = c.Value, tone = contentTones[i % contentTones.Length] }));
            }
            <div class="space-y-3" data-chart="@contentChartJson"></div>
        </div>

        <div class="admin-card p-5">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Dashboard_TopSubjects"]</h3>
            @{
                var topJson = System.Text.Json.JsonSerializer.Serialize(
                    Model.TopSubjects.Select(x => new { label = x.Name, value = x.LessonCount, tone = "info" }));
            }
            @if (Model.TopSubjects.Count > 0)
            {
                <div class="space-y-3" data-chart="@topJson"></div>
            }
            else
            {
                <p class="text-sm text-slate-400">@L["Js_Empty"]</p>
            }
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
    <div class="admin-card p-5 lg:col-span-3">
        <h3 class="mb-2 text-base font-bold text-slate-900">@L["Dashboard_RecentStudents"]</h3>
        <ul class="divide-y divide-border text-sm">
            @foreach (var st in Model.RecentStudents)
            {
                <li class="flex items-center justify-between py-3">
                    <span class="text-slate-700">@st.FullName</span>
                    <span class="text-slate-400">@st.CreatedAt.ToString("dd.MM.yyyy")</span>
                </li>
            }
            @if (Model.RecentStudents.Count == 0)
            {
                <li class="py-3 text-slate-400">@L["Common_NoData"]</li>
            }
        </ul>
    </div>
</div>
</section>

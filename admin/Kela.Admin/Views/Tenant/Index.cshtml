@{
    ViewData["Title"] = L["Nav_Tenants"];
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Tenant_Create"] })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_Table" model="@(new TableModel
{
Columns = new List<TableColumnModel>
{
            new() { Label = L["Common_Name"] },
            new() { Label = L["Tenant_Slug"] },
            new() { Label = "Plan", WidthClass = "w-36" },
            new() { Label = L["Common_Status"], WidthClass = "w-32" },
            new() { Label = L["Common_Actions"], Right = true },
}
})" />
    </div>
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = null,
    Title = L["Tenant_Create"],
    WidthClass = "max-w-md",
    ShowError = false,
    Body = modalBody
})" />

<div id="planModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/40 p-4">
    <div class="w-full max-w-md rounded-2xl border border-border bg-white p-5 shadow-xl">
        <h3 class="mb-4 text-lg font-bold text-slate-900">Abunəlik planı</h3>

        <form id="planForm">
            <input type="hidden" id="planTenantId" />

            <label class="admin-label">Plan</label>
            <select id="planSelect" class="admin-input"></select>

            <label class="admin-label mt-3">Bitmə tarixi (boş = müddətsiz)</label>
            <input id="planExpires" type="date" class="admin-input" />

            <div class="mt-4 rounded-xl bg-surface-secondary p-3 text-sm text-slate-600">
                Ödənişdən sonra əlavə paket də əlavə edə bilərsiniz — plan limitinə dərhal təsir edir.
            </div>

            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="PlanModal.close()" class="admin-button admin-button-secondary">Ləğv et</button>
                <button type="submit" class="admin-button admin-button-primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

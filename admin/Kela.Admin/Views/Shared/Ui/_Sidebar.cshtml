@{
    var controller = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    var isAdmin = User.IsInRole(AuthRoles.Admin) || User.IsInRole(AuthRoles.SuperAdmin);
    var isSuperAdmin = User.IsInRole(AuthRoles.SuperAdmin);
    var switched = !string.IsNullOrEmpty(User.FindFirst("tenant_name")?.Value);
    var brandLogo = ViewData["BrandLogo"] as string;

    string Active(string c) => controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        ? "bg-primary-light text-primary"
        : "text-slate-600 hover:bg-surface-secondary hover:text-slate-900";
}
<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-30 flex w-[260px] -translate-x-full flex-col border-r border-border bg-white transition-transform duration-200 lg:static lg:shrink-0 lg:translate-x-0">
    <div class="flex h-16 shrink-0 items-center gap-3 border-b border-border px-5">
        @if (!string.IsNullOrWhiteSpace(brandLogo))
        {
            <img src="@brandLogo" alt="Logo" class="h-10 w-10 shrink-0 rounded-xl object-contain"/>
        }
        else
        {
            <div
                class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white shadow-sm">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z"/>
                </svg>
            </div>
        }
        <div class="min-w-0">
            <p class="text-base font-extrabold leading-none tracking-tight text-slate-900">Kela</p>
            <p class="mt-1 text-xs font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
        </div>
    </div>

    <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionMain"]</p>
            <a href="/dashboard"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Dashboard")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10h14V10"/>
                </svg>
                @L["Nav_Dashboard"]
            </a>
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionTeaching"]</p>
            <a href="/subject"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Subject")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4"/>
                </svg>
                @L["Nav_Subjects"]
            </a>
            <a href="/lesson"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Lesson")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253"/>
                </svg>
                @L["Nav_Lessons"]
            </a>
            <a href="/lesson-content"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("LessonContent")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h12"/>
                </svg>
                @L["Nav_Materials"]
            </a>
            <a href="/question"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Question")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8.23 9a4 4 0 1 1 8 0c0 2-2 2.5-2 4M12 17h.01"/>
                </svg>
                @L["Nav_Questions"]
            </a>
            <a href="/quiz"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Quiz")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="m9 12 2 2 4-4m5 2a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/>
                </svg>
                @L["Nav_Exams"]
            </a>
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionManagement"]</p>
            <a href="/group"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Group")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87"/>
                </svg>
                @L["Nav_Groups"]
                <span id="groupJoinBadge" class="ml-auto min-w-5 rounded-full bg-danger px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-white" style="display:none"></span>
            </a>
            <a href="/group-stat"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("GroupStat")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
                </svg>
                @L["Nav_GroupStats"]
            </a>
            <a href="/homework"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Homework")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4"/>
                </svg>
                @L["Nav_Homework"]
            </a>
            <a href="/students"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Students")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z"/>
                </svg>
                @L["Nav_Students"]
            </a>
            <a href="/subscription"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Subscription")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Abunəlik
            </a>
            @if (isSuperAdmin)
            {
                <a href="/plan"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Plan")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7"/></svg>
                    Planlar
                </a>
            }
            @if (isAdmin)
            {
                <a href="/payment"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Payment")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" d="M3 10h18m-4 5h2"/></svg>
                    Ödənişlər
                </a>
            }
            <a href="/attendance"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Attendance")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8 4v3m8-3v3M4 9h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm3.5 9 1.5 1.5L13 13"/>
                </svg>
                @L["Nav_Attendance"]
            </a>
            @if (isAdmin)
            {
                <a href="/user"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("User")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 4.354a4 4 0 1 1 0 5.292M15 21H3v-1a6 6 0 0 1 12 0v1Zm0 0h6v-1a6 6 0 0 0-9-5.197"/>
                    </svg>
                    @L["Nav_Users"]
                </a>
                @if (isSuperAdmin)
                {
                    <a href="/node"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Node")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.7">
                            <rect x="3" y="4" width="18" height="7" rx="2"/>
                            <rect x="3" y="13" width="18" height="7" rx="2"/>
                            <path stroke-linecap="round" d="M7 7.5h.01M7 16.5h.01"/>
                        </svg>
                        <span class="truncate">@L["Nav_Nodes"]</span>
                    </a>
                    <a href="/tenant"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Tenant")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M14 21V9h4a2 2 0 0 1 2 2v10M2 21h20M7 7h2M7 11h2M7 15h2"/>
                        </svg>
                        @L["Nav_Tenants"]
                        <span id="tenantPendingBadge" class="ml-auto min-w-5 rounded-full bg-danger px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-white" style="display:none"></span>
                    </a>
                }
            }
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionContact"]</p>
            @if (isSuperAdmin)
            {
                <a href="/feedback"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Feedback")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8 10h8M8 14h5M21 12a8.96 8.96 0 0 1-9 8.94A9 9 0 0 1 3 12a9 9 0 0 1 18 0Z"/>
                    </svg>
                    @L["Feedback_Title"]
                </a>
            }
            @if (false)
            {
                <a href="/notification"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Notification")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5m6 0a3 3 0 1 1-6 0"/>
                    </svg>
                    @L["Nav_Notifications"]
                </a>
            }
            <a href="/banner"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Banner")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="16" rx="2"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 15 4-4 5 5 3-3 4 4"/>
                    <circle cx="9" cy="9" r="1.3"/>
                </svg>
                @L["Nav_Banners"]
            </a>
            @if (false)
            {
                <a href="/certificate"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Certificate")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 3h8l4 4v14H4V3z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8M8 16h5"/>
                    </svg>
                    @L["Nav_Certificates"]
                </a>
            }
        </div>

        @if (isAdmin)
        {
            <div class="space-y-1">
                <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionSystem"]</p>
                @if (!isSuperAdmin || switched)
                {
                    <a href="/setting"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Setting")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 8.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1-.6H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15.4 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.2.38.31.8.31 1.24H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51.76Z"/>
                        </svg>
                        @L["Nav_Settings"]
                    </a>
                }
                <a href="/privacy-policy"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PrivacyPolicy")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12l2 2 4-4m5.6-2A11 11 0 0 1 12 21 11 11 0 0 1 2.4 10 11 11 0 0 1 12 3a11 11 0 0 1 8.6 4Z"/>
                    </svg>
                    @L["Nav_Privacy"]
                </a>
                @if (isSuperAdmin && !switched)
                {
                    <a href="/platform-setting"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PlatformSetting")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.05 16.95l-1.41 1.41m12.72 0-1.42-1.42M7.05 7.05 5.64 5.64M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/>
                        </svg>
                        @L["Nav_PlatformSettings"]
                    </a>
                }
            </div>
        }
    </nav>
</aside>

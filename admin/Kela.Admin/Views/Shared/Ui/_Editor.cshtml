@model EditorModel
@{
    var id = Model.Id ?? Model.Name;
}
@* Quill redaktoru məzmunu gizli textarea-ya yazır, ona görə formanın göndərilməsi
   dəyişmir (JS: AdminUI.initEditors). *@
<div>
    <label for="@id" class="mb-1 block text-sm font-semibold text-slate-600">@Model.Label</label>
    <div class="admin-editor" data-for="@id">
        <div class="admin-editor-body"></div>
    </div>
    <textarea id="@id" name="@Model.Name" class="hidden"></textarea>
</div>

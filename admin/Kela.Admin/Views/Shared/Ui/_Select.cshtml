@model SelectModel
@{
    var id = Model.Id ?? Model.Name;
}
<div>
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label for="@id" class="mb-1 block text-sm font-semibold text-slate-600">@Model.Label</label>
    }
    <select id="@id" name="@Model.Name" multiple="@(Model.Multiple ? "multiple" : null)" @(Model.NativeRequired ? "required" : null) data-required="@(Model.Required ? "true" : "false")" class="admin-field">
        @foreach (var o in Model.Options)
        {
            var selected = Model.Multiple ? Model.Values.Contains(o.Value) : o.Value == Model.Value;
            <option value="@o.Value" selected="@selected">@o.Text</option>
        }
    </select>
</div>

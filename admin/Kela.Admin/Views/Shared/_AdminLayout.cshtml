@inject Kela.Core.Modules.Setting.Abstractions.ISettingService SettingService
@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isAdmin = role is "admin" or "superadmin";
    var currentUserId = long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
    var roleLabel = role switch
    {
        "superadmin" => L["Role_SuperAdmin"],
        "admin" => L["Role_Admin"],
        "teacher" => L["Role_Teacher"],
        _ => role
    };
    var roleClass = role switch
    {
        "superadmin" => "badge-success",
        "admin" => "badge-primary",
        _ => "badge-neutral"
    };
    // Emoji bayraqlar bütün platformalarda eyni görünmür — SVG istifadə olunur.
    var langs = new (string Code, string Name)[]
    {
        ("az", "Azərbaycan"),
        ("ru", "Русский"),
        ("tr", "Türkçe"),
        ("en", "English")
    };
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentLangItem = langs.FirstOrDefault(l => l.Code == currentLang);
    var displayName = User.Identity?.Name ?? L["Common_User"];
    var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[..1].ToUpperInvariant();
    var jsKeys = new[] { "Lesson_Shared", "Common_Close", "Nav_Homework", "Homework_Create", "Homework_Edit", "Homework_Draft", "Homework_Published", "Homework_Manage", "Homework_Publish", "Homework_StatusAssigned", "Homework_StatusSubmitted", "Homework_StatusGraded", "Homework_StatusReturned", "Homework_Late", "Homework_Review", "Homework_NoSubmissions", "Homework_Answer", "Homework_Attachments", "Homework_NoFiles", "Homework_NotCompleted", "Homeworks_Search", "Js_ConfirmDeleteHomework", "Js_ConfirmPublishHomework", "Js_Published", "Limit_Title", "Limit_Buy", "Limit_Confirmed", "Limit_ContactAdmin", "Limit_NoOffer", "Js_ConfirmDeleteBanner", "Js_ConfirmDeleteNotification", "Js_ConfirmDeleteLesson", "Js_ConfirmDeleteSubject", "Js_ConfirmDeleteQuiz", "Js_ConfirmDeleteUser", "Js_ConfirmDeleteMaterial", "Js_ConfirmDeleteGroup", "Js_FileTooLarge", "Common_Uploading", "Common_UploadDone", "Upload_Preparing", "Upload_Interrupted", "Upload_LeaveTitle", "Upload_LeaveText", "Upload_LeaveConfirm", "Upload_ResumeTitle", "Upload_ResumeHint", "Upload_ResumePick", "Upload_ResumeMismatch", "Nav_Materials", "Upload_Remaining", "Upload_Failed", "Upload_Done", "Video_NotReady", "Video_Failed", "Video_Ready", "Video_Processing", "Video_Pending", "Video_Status", "Attendance_LegendNone", "Attendance_Absent", "Attendance_Present", "Attendance_Saved", "Js_NoStudents", "Attendance_PickDay", "Attendance_AllAbsent", "Attendance_AllPresent", "Attendance_MonthSummary", "Js_ConfirmDeleteStudent", "Js_ConfirmDeleteCertificate", "Js_ConfirmDeleteQuestion", "Node_Online", "Node_Offline", "Node_Disabled", "Node_NoDevices", "Node_NoCodes", "Node_ConfirmRevoke", "Node_ConfirmRequeue", "Node_Copied", "Node_Unused", "Node_Used", "Node_Expired", "Node_NoExpiry", "Node_Enable", "Node_Disable", "Node_Revoke", "Node_Requeue", "Job_Error", "Js_Deleted", "Js_Irreversible", "Js_AreYouSure", "Js_ConfirmResetDevice", "Js_ConfirmRemove", "Js_ConfirmRestore", "Js_NothingSelected", "Js_Added", "Js_Updated", "Js_Created", "Js_Restored", "Js_StatusChanged", "Js_Sent", "Js_Removed", "Js_Unlocked", "Js_CacheCleared", "Js_Saved", "Js_Applied", "Js_OrderUpdated", "Js_ErrorOccured", "Js_AdjustSearch", "Js_EditBanner", "Js_EditLesson", "Js_EditSubject", "Js_EditQuiz", "Js_EditUser", "Js_EditMaterial", "Js_EditGroup", "Js_EditCertificate", "Js_EditQuestion", "Js_SortLessons", "Js_SortLessonsSubject", "Js_SortQuizzes", "Js_SortMaterials", "Js_SelectLessonFirst", "Js_Edit", "Feedback_Title", "Feedback_Empty", "Feedback_ReplyPlaceholder", "Feedback_Read", "Feedback_PickThread", "Feedback_Send", "Feedback_Error", "Feedback_MarkRead", "Feedback_New", "Js_NoResults", "Js_SelectedCount", "Js_ConfirmBulkDelete", "Banner_Create", "Banner_Always", "Banner_Owner", "Banner_OwnerYou", "Banner_OwnerAdmin", "Certificate_Create", "Question_Create", "Quiz_Create", "Common_ResultCount", "Js_Details", "Js_Activate", "Js_Deactivate", "Attendance_NoGroups", "Common_Generate", "Common_Manage", "Common_Questions", "Common_RequiredFields", "Group_Create", "Group_WillGenerate", "Group_CopyJoinLink", "Group_JoinRequests", "Group_JoinApprove", "Group_JoinReject", "Group_JoinPending", "Group_JoinApproved", "Group_JoinRejected", "Js_LinkCopied", "Group_PickSubjectsFirst", "Nav_Lessons", "Nav_Groups", "Profile_PasswordMismatch", "Students_Devices", "Tenant_Switch", "Tenant_Approve", "Tenant_Reject", "Tenant_RejectConfirm", "Tenant_Pending", "Js_Old", "Js_Selected", "Js_All", "Js_EditPrefix", "Js_ManageSuffix", "Js_ContentKeysSuffix", "Js_StudentsCreated", "Js_Empty", "Js_NothingToSort", "Js_Voice", "Js_View", "Js_EditDelete", "Js_QuizCount", "Js_StudentCount", "Js_TotalQuestions", "Common_Cancel", "Students_ResetPassword", "Students_NewPassword", "Students_NewPasswordHint", "Students_PasswordReset", "Common_ChooseOne", "Common_Fullscreen", "Common_CurrentFile", "Common_Delete", "Common_ChooseFile", "Common_SelectGroup", "Common_Lesson", "Role_Teacher", "Common_General", "Common_Archived", "Lesson_SettingsTitle", "Sort_Title", "Common_Save", "Common_Active", "Common_Inactive", "Common_Restore", "Subject_Create", "Subject_SharedBadge", "User_Create", "Lesson_Create", "Privacy_Create", "DatePicker_PickDate", "DatePicker_PickDateTime", "DatePicker_Today", "DatePicker_Clear", "DatePicker_Apply", "DatePicker_Time", "DatePicker_PrevMonth", "DatePicker_NextMonth" };
    var jsStrings = jsKeys.ToDictionary(k => k, k => L[k].Value);


    // Brend loqosu: cari tenant-ın loqosu varsa o, yoxsa platforma loqosu, yoxsa default ikon.
    var tenantSetting = await SettingService.GetAsync();
    var platformSetting = await SettingService.GetPlatformAsync();
    ViewData["BrandLogo"] = !string.IsNullOrWhiteSpace(tenantSetting.Logo) ? tenantSetting.Logo : platformSetting.Logo;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kela Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/quill.snow.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="h-dvh overflow-hidden bg-background text-text-primary">
    <div class="flex h-full overflow-hidden">
        <partial name="Ui/_Sidebar" />

        <div id="overlay" class="fixed inset-0 z-20 hidden bg-slate-950/40 backdrop-blur-sm lg:hidden"></div>

        <div class="flex min-h-0 min-w-0 flex-1 flex-col">
            <header class="z-10 flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border bg-white/85 px-4 backdrop-blur sm:px-6">
                <div class="flex min-w-0 items-center gap-3">
                    <button id="menuToggle" class="grid h-10 w-10 place-items-center rounded-xl text-slate-600 hover:bg-surface-secondary lg:hidden">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                    <h1 class="truncate text-lg font-bold tracking-tight text-slate-900">@ViewData["Title"]</h1>
                </div>

                <div class="flex items-center gap-3">
                    @if (role == "superadmin" && !string.IsNullOrEmpty(User.FindFirst("tenant_name")?.Value))
                    {
                        <div class="hidden items-center gap-2 rounded-lg border border-primary bg-primary-light px-2.5 py-1.5 sm:flex">
                            <span class="text-xs font-bold text-primary">@User.FindFirst("tenant_name")!.Value</span>
                            <form method="post" action="/tenant/switch-off" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-xs font-bold text-danger hover:underline">@L["Tenant_SwitchOff"]</button>
                            </form>
                        </div>
                    }
                    <div class="relative shrink-0">
                        <button type="button" id="langMenuBtn" aria-label="Language"
                                class="flex items-center gap-2 rounded-xl border border-border bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-surface-secondary">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" /></svg>
                            @if (!string.IsNullOrEmpty(currentLangItem.Code))
                            {
                                <img src="~/img/flags/@(currentLangItem.Code).svg" alt="" class="h-4 w-6 rounded-[3px] object-cover ring-1 ring-black/10" />
                            }
                            else
                            {
                                <span class="text-base leading-none">🌐</span>
                            }
                            <span class="hidden sm:inline">@(currentLangItem.Name ?? currentLang.ToUpperInvariant())</span>
                            <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                        </button>
                        <div id="langBackdrop" class="fixed inset-0 z-40 hidden bg-slate-950/40 sm:hidden"></div>
                        <div id="langMenu"
                             class="fixed bottom-0 left-0 right-0 z-50 hidden rounded-t-3xl border-t border-border bg-white p-3 pb-[max(12px,env(safe-area-inset-bottom))] shadow-[0_-10px_40px_rgba(15,23,42,0.15)] sm:absolute sm:bottom-auto sm:left-auto sm:right-0 sm:top-full sm:mt-2 sm:w-48 sm:overflow-hidden sm:rounded-2xl sm:border sm:p-0 sm:shadow-xl">
                            <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-slate-200 sm:hidden"></div>
                            @foreach (var lang in langs)
                            {
                                <button type="button" data-action="setLang" data-args="@($"[\"{lang.Code}\"]")"
                                        class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition hover:bg-surface-secondary sm:rounded-none sm:py-2.5 @(lang.Code == currentLang ? "bg-primary-light text-primary" : "text-slate-600")">
                                    <img src="~/img/flags/@(lang.Code).svg" alt="" class="h-4 w-6 rounded-[3px] object-cover ring-1 ring-black/10" />
                                    <span class="flex-1 text-left">@lang.Name</span>
                                    @if (lang.Code == currentLang)
                                    {
                                        <svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    <div class="relative shrink-0">
                    <button type="button" id="userMenuBtn"
                            class="flex items-center gap-3 rounded-xl px-2 py-1.5 transition hover:bg-surface-secondary">
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary text-sm font-bold text-white">@initial</span>
                        <span class="hidden text-left sm:block">
                            <span class="block max-w-[180px] truncate text-sm font-bold leading-tight text-slate-900">@displayName</span>
                            <span class="@roleClass mt-0.5 !px-2 !py-0.5 !text-[11px]">@roleLabel</span>
                        </span>
                        <svg class="hidden h-4 w-4 text-slate-400 sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                    </button>

                    <div id="userMenu" class="absolute right-0 top-full z-20 mt-2 hidden w-60 overflow-hidden rounded-2xl border border-border bg-white shadow-xl">
                        <div class="border-b border-border px-4 py-3">
                            <p class="truncate text-sm font-bold text-slate-900">@displayName</p>
                            <p class="mt-0.5 text-xs font-medium text-slate-500">@roleLabel</p>
                        </div>
                        <a href="/profile" class="flex w-full items-center gap-2.5 border-b border-border px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-surface-secondary">
                            <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" /></svg>
                            @L["Nav_Profile"]
                        </a>
                        <form method="post" action="/login/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="flex w-full items-center gap-2.5 px-4 py-3 text-sm font-semibold text-danger transition hover:bg-danger-bg">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m12 0-4-4m4 4-4 4M21 4v16" /></svg>
                                @L["Common_Logout"]
                            </button>
                        </form>
                    </div>
                    </div>
                </div>
            </header>

            <main class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 lg:p-7">
                <div class="mx-auto w-full max-w-[1440px]">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <partial name="Ui/_LimitModal" />

    <script>window.L = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsStrings));</script>
    <script>window.ADMIN = { isAdmin: @(isAdmin ? "true" : "false"), isSuperAdmin: @(role == "superadmin" ? "true" : "false"), userId: @currentUserId };</script>
    @* Fon rejimində gedən yükləmə — istifadəçi modalı bağladıqdan sonra da görünür. *@
    <div id="uploadWidget" class="fixed bottom-5 right-5 z-[60] hidden w-80 rounded-2xl border border-border bg-white p-4 shadow-2xl">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <p id="uwTitle" class="truncate text-sm font-bold text-slate-800"></p>
                <p id="uwStatus" class="mt-0.5 text-[11px] text-slate-400"></p>
            </div>
            <span id="uwPercent" class="shrink-0 text-sm font-bold text-primary">0%</span>
        </div>
        <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
            <div id="uwBar" class="h-full rounded-full bg-primary transition-[width] duration-200" style="width:0%"></div>
        </div>
        <div class="mt-2 flex items-center justify-between text-[11px] font-medium text-slate-400">
            <span id="uwSpeed"></span>
            <span id="uwRemaining"></span>
        </div>
    </div>

    <script src="~/js/library/sweetalert2.min.js"></script>
    <script src="~/js/library/flowbite.min.js"></script>
    <script src="~/js/library/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
    <script src="~/js/helpers/media.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin-table.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin-modal.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin-form.js" asp-append-version="true"></script>
    <script src="~/js/helpers/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/helpers/admin-layout.js" asp-append-version="true"></script>
    @if (ViewData["Scripts"] is string[] pageScripts)
    {
        foreach (var script in pageScripts)
        {
            <script src="@script" asp-append-version="true"></script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

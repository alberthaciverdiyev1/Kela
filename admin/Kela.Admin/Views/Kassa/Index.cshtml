@model Kela.Core.Modules.Payments.Responses.KassaOverviewResponse
@{
    ViewData["Title"] = "Kassa";

    var payload = new
    {
        currencies = Model.Currencies.Select(c => new
        {
            currency = c.Currency,
            today = c.Today,
            thisMonth = c.ThisMonth,
            lastMonth = c.LastMonth,
            projected = c.ProjectedNextMonth,
            overdue = c.OverdueAmount,
            activePlans = c.ActivePlans
        }),
        monthly = Model.Monthly.Select(m => new { period = m.Period, currency = m.Currency, amount = m.Amount }),
        recent = Model.Recent.Select(r => new
        {
            id = r.Id,
            student = r.StudentName,
            paidOn = r.PaidOn.ToString("yyyy-MM-dd"),
            amount = r.Amount,
            currency = r.Currency,
            note = r.Note
        })
    };
}

<script>window.KASSA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(payload));</script>

<section class="admin-page">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-extrabold text-slate-900">Kassa</h1>
            <p class="mt-1 text-sm text-slate-500">Tələbələrdən daxil olan ödənişlər və aylıq gəlir.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (Model.Currencies.Select(c => c.Currency).Distinct().Count() > 1)
            {
                <select id="kassaCurrency" class="admin-field w-28">
                    @foreach (var code in Model.Currencies.Select(c => c.Currency).Distinct())
                    {
                        <option value="@code">@code</option>
                    }
                </select>
            }
            <a href="/kassa/export" class="admin-button-secondary">CSV yüklə</a>
            <button type="button" class="admin-button-primary" data-action="KassaPage.openPayment">
                Ödəniş qeyd et
            </button>
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        @foreach (var card in new (string Id, string Label, string Hint)[]
        {
            ("k-today", "Bu gün", "bugünkü mədaxil"),
            ("k-this", "Bu ay", "cari ay üzrə"),
            ("k-last", "Keçən ay", "əvvəlki ay üzrə"),
            ("k-projection", "Gələn ay (proqnoz)", "aktiv planlara əsasən"),
            ("k-overdue", "Ödənilməmiş borc", "vaxtı keçmiş planlar")
        })
        {
            <div class="admin-card p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@card.Label</p>
                <p id="@card.Id" class="mt-1 text-2xl font-extrabold text-slate-900">—</p>
                <p class="mt-1 text-xs text-slate-400">@card.Hint</p>
            </div>
        }
    </div>

    <div class="admin-card p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-base font-bold text-slate-900">Son 12 ay</h3>
            <span id="kassaDelta" class="text-sm font-semibold text-slate-500"></span>
        </div>
        <div id="kassaMonths" class="mt-4 flex h-36 items-end gap-1.5"></div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        @foreach (var cell in new (string Label, int Value, string Tone)[]
        {
            ("Aktiv plan", Model.ActivePlans, "text-slate-900"),
            ("Gecikmiş", Model.OverduePlans, "text-danger"),
            ("7 gündə bitir", Model.DueSoonPlans, "text-warning"),
            ("Ödəyən tələbə", Model.PayingStudents, "text-primary"),
            ("Aktiv tələbə", Model.StudentCount, "text-slate-900")
        })
        {
            <div class="admin-card px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@cell.Label</p>
                <p class="mt-1 text-xl font-extrabold @cell.Tone">@cell.Value</p>
            </div>
        }
    </div>

    <div class="admin-card">
        <div class="admin-toolbar">
            <h3 class="text-base font-bold text-slate-900">Son ödənişlər</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Tarix</th>
                        <th>Tələbə</th>
                        <th class="text-right">Məbləğ</th>
                        <th>Qeyd</th>
                        <th class="text-right">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody id="kassaRecent">
                    <tr><td colspan="5" class="text-sm text-slate-400">Yüklənir...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@{
    var paymentBody = await Html.PartialAsync("_PaymentModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "kassaPaymentModal",
    TitleId = "kassaPaymentTitle",
    Title = "Ödəniş qeyd et",
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = paymentBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

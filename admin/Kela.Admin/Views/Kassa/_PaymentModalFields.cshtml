<form id="kassaPaymentForm" class="space-y-4 p-6">
    <div>
        <label for="kassaStudent" class="mb-1 block text-sm font-semibold text-slate-600">Tələbə</label>
        <select id="kassaStudent" class="admin-field" data-native="1">
            <option value="">Yüklənir...</option>
        </select>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
        <div>
            <label for="kassaAmount" class="mb-1 block text-sm font-semibold text-slate-600">Məbləğ</label>
            <input id="kassaAmount" type="number" step="0.01" min="0.01" class="admin-field" />
        </div>
        <div>
            <label for="kassaPaidOn" class="mb-1 block text-sm font-semibold text-slate-600">Tarix</label>
            <input id="kassaPaidOn" type="date" class="admin-field" />
        </div>
    </div>

    <div>
        <label for="kassaNote" class="mb-1 block text-sm font-semibold text-slate-600">Qeyd</label>
        <input id="kassaNote" type="text" class="admin-field" placeholder="İstəyə bağlı" />
    </div>

    <p id="kassaStudentHint" class="text-xs text-slate-400"></p>

    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

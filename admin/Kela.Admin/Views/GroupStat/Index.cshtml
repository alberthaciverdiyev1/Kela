@{
    ViewData["Title"] = L["Nav_GroupStats"];
    var groups = (PagedResponse<Kela.Core.Modules.Group.Responses.GroupResponse>)ViewData["Groups"]!;
    // Boş variant yoxdur — səhifə açılan kimi ilk qrup seçili gəlir.
    var groupOptions = groups.Data.Select(g => new SelectOption { Value = g.Id.ToString(), Text = g.Name }).ToList();
    var typeOptions = new List<SelectOption>
    {
        new() { Value = "", Text = L["Common_All"] },
        new() { Value = "lesson", Text = L["Common_LessonExams"] },
        new() { Value = "general", Text = L["Common_General"] }
    };
}
<section class="admin-page">
    @{
        var groupStatHeaderExtra = new Microsoft.AspNetCore.Html.HtmlString(
            $@"<a id=""exportLink"" href=""#"" class=""admin-button-secondary"">⬇ Excel</a>");
    }
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = groupStatHeaderExtra })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-44", Select = new SelectModel { Name = "group_id", Id = "group_id", Label = L["Common_Group"], Options = groupOptions } },
                new() { WidthClass = "w-36", Select = new SelectModel { Name = "quiz_type", Id = "quiz_type", Label = L["Common_Type"], Options = typeOptions } }
            },
            ButtonText = L["Common_Show"],
            ButtonOnClick = "load()"
        })" />

        <div id="summary" class="hidden grid-cols-1 gap-4 p-5 sm:grid-cols-3"></div>

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Student"] },
                                    new() { Label = L["GroupStat_Attempt"], WidthClass = "w-32" },
                                    new() { Label = L["GroupStat_Completed"], WidthClass = "w-40" },
                                    new() { Label = L["Question_Correct"], WidthClass = "w-24" },
                                    new() { Label = L["GroupStat_Wrong"], WidthClass = "w-24" },
                                    new() { Label = L["GroupStat_Score"], WidthClass = "w-24" },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                

        </table>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
            </div>
        </div>
    </div>
</section>

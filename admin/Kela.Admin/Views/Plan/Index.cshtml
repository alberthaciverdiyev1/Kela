@{
    ViewData["Title"] = "Abunəlik planları";
    var headerExtra = new Microsoft.AspNetCore.Html.HtmlString(
        @"<button type=""button"" class=""admin-button-primary"" data-action=""PlanPage.create"">+ Yeni plan</button>");
}

<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="admin-card">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th>Qiymət</th>
                        <th>Tələbə</th>
                        <th>Müəllim</th>
                        <th>Video (saat/ay)</th>
                        <th>Depolama</th>
                        <th>Status</th>
                        <th class="text-right">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
    </div>
</section>

<div id="planModal" class="fixed inset-0 z-40 hidden items-start justify-center overflow-y-auto bg-slate-950/40 p-4">
    <div class="my-8 w-full max-w-3xl rounded-2xl border border-border bg-white p-6 shadow-xl">
        <h3 id="planTitle" class="mb-4 text-lg font-bold text-slate-900">Plan</h3>

        <form id="planForm" class="space-y-5">
            <input type="hidden" id="planId" />
            <input type="hidden" id="concurrent_conversions" value="2" />
            <input type="hidden" id="original_retention_days" value="0" />
            <input type="hidden" id="features" value="" />

            <div class="grid gap-3 sm:grid-cols-3">
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-600">Kod</label>
                    <input id="code" class="admin-field" placeholder="basic" required />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-600">Ad</label>
                    <input id="name" class="admin-field" placeholder="Basic" required />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-600">Aylıq qiymət</label>
                    <input id="monthly_price" type="number" step="0.01" min="0" class="admin-field" />
                </div>
            </div>

            <div>
                <label class="mb-1 block text-sm font-semibold text-slate-600">Təsvir</label>
                <input id="description" class="admin-field" maxlength="500" />
            </div>

            <div class="grid gap-3 sm:grid-cols-4">
                <div><label class="mb-1 block text-sm font-semibold text-slate-600">Valyuta</label><input id="currency" class="admin-field" value="AZN" /></div>
                <div><label class="mb-1 block text-sm font-semibold text-slate-600">İllik pulsuz ay</label><input id="yearly_free_months" type="number" min="0" max="12" class="admin-field" value="2" /></div>
                <div><label class="mb-1 block text-sm font-semibold text-slate-600">Sıra</label><input id="sort_order" type="number" class="admin-field" value="0" /></div>
                <div><label class="mb-1 block text-sm font-semibold text-slate-600">Status</label>
                    <select id="is_active" class="admin-field">
                        <option value="true">Aktiv</option>
                        <option value="false">Deaktiv</option>
                    </select>
                </div>
            </div>

            <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-400">Limitlər (0 = limitsiz)</p>
                <div class="grid gap-3 sm:grid-cols-3">
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Müəllim</label><input id="max_teachers" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Tələbə</label><input id="max_students" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Qrup</label><input id="max_groups" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Fənn</label><input id="max_subjects" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Dərs</label><input id="max_lessons" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Video (dəq/ay)</label><input id="monthly_video_minutes" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Depolama (GB)</label><input id="storage_gb" type="number" min="0" class="admin-field" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Maks. keyfiyyət</label>
                        <select id="max_video_height" class="admin-field">
                            <option value="720">720p</option>
                            <option value="1080">1080p</option>
                        </select>
                    </div>
                </div>
            </div>

            <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-400">Əlavə paketlər</p>
                <div class="grid gap-3 sm:grid-cols-3">
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Tələbə paketi (nəfər)</label><input id="addon_student_pack_size" type="number" min="1" class="admin-field" value="10" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Tələbə paketi qiyməti</label><input id="addon_student_pack_price" type="number" step="0.01" min="0" class="admin-field" /></div>
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Maks. əlavə həddi (%)</label>
                        <input id="max_addon_percent" type="number" min="0" max="500" class="admin-field" value="100" />
                        <p class="mt-1 text-xs text-slate-400">
                            Plan limitinin neçə faizi qədər əlavə paket almaq olar.
                            100 = limiti iki dəfə artırmaq, 0 = əlavə paket yoxdur.
                        </p>
                    </div>

                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Video paketi (dəq)</label><input id="addon_video_pack_minutes" type="number" min="1" class="admin-field" value="600" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Video paketi qiyməti</label><input id="addon_video_pack_price" type="number" step="0.01" min="0" class="admin-field" /></div>

                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Depolama paketi (GB)</label><input id="addon_storage_pack_gb" type="number" min="1" class="admin-field" value="50" /></div>
                    <div><label class="mb-1 block text-sm font-semibold text-slate-600">Depolama paketi qiyməti</label><input id="addon_storage_pack_price" type="number" step="0.01" min="0" class="admin-field" /></div>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="PlanPage.close()" class="admin-button admin-button-secondary">Ləğv et</button>
                <button type="submit" class="admin-button admin-button-primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Abunəlik planları";
    var headerExtra = new Microsoft.AspNetCore.Html.HtmlString(
        @"<button type=""button"" class=""admin-button-primary"" data-action=""PlanPage.create"">+ Yeni plan</button>");
    var planModalBody = await Html.PartialAsync("_FormFields");
}

<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="admin-card">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th>Qiymət</th>
                        <th>Tələbə</th>
                        <th>Qrup</th>
                        <th>Video (saat/ay)</th>
                        <th>Status</th>
                        <th class="text-right">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
    </div>
</section>

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "planModal",
    TitleId = "planTitle",
    Title = "Plan",
    WidthClass = "max-w-3xl",
    ShowError = false,
    Body = planModalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

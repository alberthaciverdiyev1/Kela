@{
    ViewData["Title"] = L["Nav_Attendance"];
    var groups = (PagedResponse<Kela.Core.Modules.Group.Responses.GroupResponse>)ViewData["Groups"]!;
}
<script>
    window.ATT_GROUPS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        groups.Data.Select(g => new { id = g.Id, name = g.Name })));
    window.ATT_LOCALE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        System.Globalization.CultureInfo.CurrentUICulture.Name));
</script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel())" />

    <div class="admin-card">
        <div class="border-b border-border p-5">
            <p class="mb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Common_Group"]</p>
            <div id="groupChips" class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1 [scrollbar-width:none]"></div>
        </div>

        <div class="grid gap-6 p-5 lg:grid-cols-[minmax(0,400px)_minmax(0,1fr)] lg:items-start">
            <div>
                <div id="calendar" class="rounded-2xl border border-border bg-white p-4"></div>
                <p id="monthSummary" class="mt-3 text-center text-sm text-slate-500"></p>
                <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500">
                    <span class="flex items-center gap-1.5"><i class="att-dot att-full"></i>@L["Attendance_LegendFull"]</span>
                    <span class="flex items-center gap-1.5"><i class="att-dot att-part"></i>@L["Attendance_LegendPartial"]</span>
                    <span class="flex items-center gap-1.5"><i class="att-dot att-low"></i>@L["Attendance_LegendLow"]</span>
                    <span class="flex items-center gap-1.5"><i class="att-dot att-none"></i>@L["Attendance_LegendNone"]</span>
                </div>
            </div>

            <div id="dayPanel" class="admin-empty">@L["Attendance_PickDay"]</div>
        </div>
    </div>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    var student = (StudentListItemResponse)ViewData["Student"]!;
    var stats = (StatisticsResponse)ViewData["Statistics"]!;
    var progress = (ProgressResponse)ViewData["Progress"]!;
    var results = (IReadOnlyList<QuizResultSummary>)ViewData["Results"]!;
    var violations = (IReadOnlyList<ScreenViolationResponse>)ViewData["Violations"]!;
}
<section class="admin-page">
    <div>
        <a href="/students" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
            Şagirdlər
        </a>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="admin-page-title">@student.FullName</h2>
            <p class="admin-page-subtitle">@student.Email @(string.IsNullOrEmpty(student.Phone) ? "" : "• " + student.Phone)</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            @if (student.IsActive)
            {
                <span class="badge badge-success">Aktiv</span>
            }
            else
            {
                <span class="badge badge-neutral">Deaktiv</span>
            }
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_lessons", Label = L["Lesson_Total"], Value = stats.Overview.TotalLessons.ToString(),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_contents", Label = L["Common_TotalMaterials"], Value = stats.Overview.TotalContents.ToString(), Accent = "bg-sky-100 text-sky-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M7 3h7l5 5v13H7V3Z' /><path stroke-linecap='round' stroke-linejoin='round' d='M14 3v6h5M10 14h6M10 18h4' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_done", Label = "Tamamlanan", Value = stats.Overview.CompletedContents.ToString(), Accent = "bg-success-bg text-success",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='m5 13 4 4L19 7' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "s_percent", Label = "Tamamlanma", Value = $"{stats.Overview.CompletionPercent}%", Accent = "bg-violet-100 text-violet-600",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 6v6l4 2M21 12A9 9 0 1 1 3 12a9 9 0 0 1 18 0Z' />" })" />
    </div>

    <div class="admin-card">
        <div class="border-b border-border p-4">
            <div class="admin-tabs" id="detailTabs">
                @foreach (var (tab, label) in new[] { ("subjects", L["Student_TabSubjects"].Value), ("lessons", L["Student_TabLessons"].Value), ("results", L["Student_TabExams"].Value), ("violations", L["Student_TabViolations"].Value) })
                {
                    <button type="button" data-tab="@tab" class="admin-tab@(tab == "subjects" ? " is-active" : "")">@label</button>
                }
            </div>
        </div>

        <div id="tab-subjects" data-tab-panel="subjects" class="detail-tab p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th class="w-16">#</th><th>@L["Common_Subject"]</th><th class="w-40">Material</th><th class="w-32">Tamamlanan</th><th class="w-40">Faiz</th></tr></thead>
                    <tbody>
                        @if (stats.BySubject.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-sm text-slate-400">@L["Common_NoData"]</td></tr>
                        }
                        else
                        {
                            var rowNo = 0;
                            foreach (var s in stats.BySubject)
                            {
                                rowNo++;
                                <tr>
                                    <td class="text-slate-400">@rowNo</td>
                                    <td class="font-semibold text-slate-800">@s.SubjectName</td>
                                    <td class="text-slate-500">@s.TotalContents</td>
                                    <td class="text-slate-500">@s.CompletedContents</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="h-2 w-24 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-primary" style="width:@(s.CompletionPercent)%"></div></div>
                                            <span class="text-sm font-semibold text-slate-700">@s.CompletionPercent%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-lessons" data-tab-panel="lessons" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th class="w-16">#</th><th>@L["Common_Lesson"]</th><th class="w-40">Tamamlanan</th><th class="w-40">Faiz</th><th>@L["Student_NextMaterial"]</th></tr></thead>
                    <tbody>
                        @if (progress.Items.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-sm text-slate-400">@L["Common_NoData"]</td></tr>
                        }
                        else
                        {
                            var rowNo = 0;
                            foreach (var p in progress.Items)
                            {
                                rowNo++;
                                <tr>
                                    <td class="text-slate-400">@rowNo</td>
                                    <td class="font-semibold text-slate-800">@p.LessonTitle</td>
                                    <td class="text-slate-500">@p.CompletedContents / @p.TotalContents</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="h-2 w-24 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-primary" style="width:@(p.ProgressPercent)%"></div></div>
                                            <span class="text-sm font-semibold text-slate-700">@p.ProgressPercent%</span>
                                        </div>
                                    </td>
                                    <td class="text-slate-500">@(p.NextContent?.Title ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-results" data-tab-panel="results" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th class="w-16">#</th><th>@L["Common_Exam"]</th><th class="w-32">@L["GroupStat_Attempt"]</th><th class="w-40">@L["Student_CorrectOverTotal"]</th><th class="w-32">Bal</th><th class="w-40">Tarix</th></tr></thead>
                    <tbody>
                        @if (results.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-sm text-slate-400">@L["Common_NoResults"]</td></tr>
                        }
                        else
                        {
                            var rowNo = 0;
                            foreach (var r in results)
                            {
                                rowNo++;
                                <tr>
                                    <td class="text-slate-400">@rowNo</td>
                                    <td class="font-semibold text-slate-800">@r.QuizTitle</td>
                                    <td class="text-slate-500">#@r.AttemptTime</td>
                                    <td class="text-slate-500">@r.CorrectCount / @r.TotalQuestions</td>
                                    <td><span class="font-semibold @(r.ScorePercent >= 50 ? "text-emerald-600" : "text-red-600")">@r.ScorePercent%</span></td>
                                    <td class="text-slate-500">@(r.StartDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="tab-violations" data-tab-panel="violations" class="detail-tab hidden p-4">
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead><tr><th class="w-16">#</th><th>@L["Common_Type"]</th><th>@L["Student_Page"]</th><th class="w-44">Tarix</th><th>@L["Student_UserAgent"]</th></tr></thead>
                    <tbody>
                        @if (violations.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-sm text-slate-400">@L["Student_NoViolations"]</td></tr>
                        }
                        else
                        {
                            var rowNo = 0;
                            foreach (var v in violations)
                            {
                                rowNo++;
                                <tr>
                                    <td class="text-slate-400">@rowNo</td>
                                    <td><span class="rounded bg-danger-bg px-2 py-0.5 text-xs font-semibold text-danger">@v.Type</span></td>
                                    <td class="text-slate-500">@(v.Path ?? "—")</td>
                                    <td class="text-slate-500">@v.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="max-w-xs truncate text-slate-400" title="@v.UserAgent">@(v.UserAgent ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

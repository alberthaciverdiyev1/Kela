@{
    ViewData["Title"] = L["Nav_Students"];
    var activeOptions = new List<SelectOption>
    {
        new() { Value = "", Text = L["Common_All"] },
        new() { Value = "true", Text = L["Common_Active"] },
        new() { Value = "false", Text = L["Common_Inactive"] }
    };
}
<section class="admin-page">
    @{
        var studentsHeaderExtra = new Microsoft.AspNetCore.Html.HtmlString($@"
            <button type=""button"" class=""admin-button-primary"" onclick=""openStudentCreate()"">+ {L["Students_Create"]}</button>
            <button type=""button"" id=""trashBtn"" class=""admin-button-secondary"" onclick=""toggleTrash()"">{L["Common_DeletedItems"]}</button>
            <a href=""/students/export"" class=""admin-button-secondary"">⬇ Excel</a>");
    }
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = studentsHeaderExtra })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Students_Search"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-36", Select = new SelectModel { Name = "filter_active", Id = "filter_active", Label = L["Common_Status"], Options = activeOptions } }
            },
            Sort = new FilterSortModel { },
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/students/bulk", CanActivate = true, CanDeactivate = true })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Name"] },
                                    new() { Label = L["Common_Email"] },
                                    new() { Label = L["Common_Phone"] },
                                    new() { Label = L["Common_Status"], WidthClass = "w-28" },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var devicesModalBody = await Html.PartialAsync("_DevicesModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "devicesModal",
    TitleId = "devicesTitle",
    Title = L["Students_Devices"],
    WidthClass = "max-w-md",
    ShowError = false,
    Body = devicesModalBody
})" />

@{
    var studentModalBody = await Html.PartialAsync("_CreateModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "studentModal",
    TitleId = "studentModalTitle",
    Title = L["Students_Create"],
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = studentModalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

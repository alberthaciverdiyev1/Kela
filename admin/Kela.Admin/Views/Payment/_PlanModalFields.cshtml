@using Kela.Core.Modules.Payments.Entities
<form id="plan-form" class="space-y-4 p-6">
    <input type="hidden" id="plan-student-id" />
    <partial name="Ui/_Select" model="@(new SelectModel {
        Name = "plan_template", Id = "plan-template", Label = "Şablon plan seç",
        Options = new List<SelectOption> { new() { Value = "", Text = "— Əl ilə daxil et —" } }
    })" />
    <div class="grid gap-4 sm:grid-cols-2">
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "plan_joined", Id = "plan-joined", Label = "Qoşulma tarixi", Type = "date", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "plan_due", Id = "plan-due", Label = "Növbəti ödəniş", Type = "date", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "plan_amount", Id = "plan-amount", Label = "Məbləğ", Type = "number", Required = true })" />
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "plan_currency", Id = "plan-currency", Label = "Valyuta", Options = Enum.GetNames<PaymentCurrency>().Select(c => new SelectOption { Value = c, Text = c }).ToList() })" />
        <partial name="Ui/_Select" model="@(new SelectModel {
            Name = "plan_frequency", Id = "plan-frequency", Label = "Period",
            Options = new List<SelectOption> { new() { Value = "monthly", Text = "Aylıq" }, new() { Value = "custom", Text = "Xüsusi gün sayı" } }
        })" />
        <div id="interval-wrap" class="hidden">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "plan_interval", Id = "plan-interval", Label = "Neçə gündən bir", Type = "number", Value = "30" })" />
        </div>
    </div>
    <div>
        <label for="plan-note" class="mb-1 block text-sm font-semibold text-slate-600">Qeyd</label>
        <textarea id="plan-note" maxlength="500" rows="2" class="admin-field h-auto py-2.5"></textarea>
    </div>
    <label id="plan-first-paid-wrap" class="flex items-start gap-2.5 rounded-xl bg-primary-light px-3.5 py-3 text-sm font-medium text-primary">
        <input type="checkbox" id="plan-first-paid" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />
        <span>İlk ödənişi indi qeyd et (bu gün üçün)</span>
    </label>
    <div class="flex justify-end gap-3 pt-1">
        <button type="button" class="admin-button-secondary" onclick="AdminUI.closeModal('planModal')">@L["Common_Cancel"]</button>
        <button type="submit" class="admin-button-primary">@L["Common_Save"]</button>
    </div>
</form>

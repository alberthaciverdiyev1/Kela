@using Kela.Core.Modules.Payments.Entities
<form id="default-plan-form" class="space-y-4 p-6">
    <p class="rounded-xl bg-primary-light px-3.5 py-2.5 text-sm font-medium text-primary">
        Bu plan ödəniş planı olmayan bütün aktiv şagirdlərə tətbiq olunacaq.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "default_joined", Id = "default-joined", Label = "Qoşulma tarixi", Type = "date", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "default_due", Id = "default-due", Label = "Növbəti ödəniş", Type = "date", Required = true })" />
        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "default_amount", Id = "default-amount", Label = "Məbləğ", Type = "number", Required = true })" />
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "default_currency", Id = "default-currency", Label = "Valyuta", Options = Enum.GetNames<PaymentCurrency>().Select(c => new SelectOption { Value = c, Text = c }).ToList() })" />
        <partial name="Ui/_Select" model="@(new SelectModel {
            Name = "default_frequency", Id = "default-frequency", Label = "Period",
            Options = new List<SelectOption> { new() { Value = "monthly", Text = "Aylıq" }, new() { Value = "custom", Text = "Xüsusi gün sayı" } }
        })" />
        <div id="default-interval-wrap" class="hidden">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "default_interval", Id = "default-interval", Label = "Neçə gündən bir", Type = "number", Value = "30" })" />
        </div>
    </div>
    <div>
        <label for="default-note" class="mb-1 block text-sm font-semibold text-slate-600">Qeyd</label>
        <textarea id="default-note" maxlength="500" rows="2" class="admin-field h-auto py-2.5"></textarea>
    </div>
    <div class="flex justify-end gap-3 pt-1">
        <button type="button" class="admin-button-secondary" onclick="AdminUI.closeModal('defaultPlanModal')">@L["Common_Cancel"]</button>
        <button type="submit" class="admin-button-primary">@L["Common_Create"]</button>
    </div>
</form>

@{
    ViewData["Title"] = "Ödənişlər";
    var headerExtra = new Microsoft.AspNetCore.Html.HtmlString(
        @"<button type=""button"" class=""admin-button-secondary"" onclick=""openDefaultPlan()"">Standart plan yarat</button>");
    var statusOptions = new List<SelectOption>
    {
        new() { Value = "", Text = "Hamısı" },
        new() { Value = "upcoming", Text = "Yaxınlaşan" },
        new() { Value = "overdue", Text = "Gecikən" },
        new() { Value = "unpaid", Text = "Plan yoxdur" },
        new() { Value = "current", Text = "Aktiv plan" }
    };
}
<section class="admin-page">
    <form id="antiforgery">@Html.AntiForgeryToken()</form>
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="mb-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-upcoming", Label = "Yaxınlaşan", Value = "0", Compact = true, ValueClass = "text-warning" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-overdue", Label = "Gecikən", Value = "0", Compact = true, ValueClass = "text-danger" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-unpaid", Label = "Plan yoxdur", Value = "0", Compact = true, ValueClass = "text-slate-700" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-current", Label = "Aktiv plan", Value = "0", Compact = true, ValueClass = "text-success" })" />
    </div>

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = "Şagird adı və ya email ilə axtar...",
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-48", Select = new SelectModel { Name = "status", Id = "payment-status", Label = "Status", Options = statusOptions } }
            },
            ButtonText = L["Common_Show"],
            ButtonOnClick = "loadList(1)"
        })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Columns = new List<TableColumnModel>
                            {
                                new() { Label = L["Common_Student"] },
                                new() { Label = "Qoşulma tarixi", WidthClass = "w-32" },
                                new() { Label = "Növbəti ödəniş", WidthClass = "w-32" },
                                new() { Label = "Məbləğ", WidthClass = "w-32" },
                                new() { Label = "Period", WidthClass = "w-32" },
                                new() { Label = L["Common_Status"], WidthClass = "w-28" },
                                new() { Label = L["Common_Actions"], Right = true }
                            }
                        })" />
                    <tbody id="payment-rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
    </div>
</section>

@{
    var planBody = await Html.PartialAsync("_PlanModalFields");
    var defaultPlanBody = await Html.PartialAsync("_DefaultPlanFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "planModal",
    TitleId = "planModalTitle",
    Title = "Ödəniş planı",
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = planBody
})" />

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "defaultPlanModal",
    Title = "Standart plan yarat",
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = defaultPlanBody
})" />

@using Kela.Core.Modules.Students.Responses
@using Kela.Core.Modules.Payments.Responses
@{
    var student = (StudentListItemResponse)ViewData["Student"]!;
    var history = (IReadOnlyList<StudentPaymentHistory>)ViewData["History"]!;
    var totalPaid = history.Sum(x => x.Amount);
    var headerExtra = new Microsoft.AspNetCore.Html.HtmlString(
        @"<a href=""/payment"" class=""admin-button-secondary"">← Geri</a>");
}
<section class="admin-page">
    <form id="antiforgery">@Html.AntiForgeryToken()</form>
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="admin-card mb-4 flex flex-wrap items-center justify-between gap-4 p-5">
        <div class="flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-primary-light text-primary">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" /></svg>
            </span>
            <div>
                <h2 class="text-lg font-bold text-slate-900">@student.FullName</h2>
                <p class="text-sm text-slate-500">@student.Email</p>
            </div>
        </div>
        <div class="flex gap-3">
            <div class="rounded-xl bg-surface-secondary px-4 py-3 text-center">
                <p class="text-xs font-semibold text-slate-500">Ödəniş sayı</p>
                <p class="mt-1 text-xl font-extrabold text-slate-900">@history.Count</p>
            </div>
            <div class="rounded-xl bg-primary-light px-4 py-3 text-center">
                <p class="text-xs font-semibold text-primary">Ümumi məbləğ</p>
                <p class="mt-1 text-xl font-extrabold text-primary">@totalPaid.ToString("0.00")</p>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="border-b border-border p-4">
            <h3 class="text-base font-bold text-slate-900">Ödəniş tarixçəsi</h3>
        </div>

        @if (history.Count == 0)
        {
            <div class="admin-empty p-10 text-center text-sm text-slate-400">Ödəniş tarixçəsi boşdur.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tarix</th>
                            <th>Məbləğ</th>
                            <th>Valyuta</th>
                            <th>Qeyd</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in history)
                        {
                            <tr>
                                <td class="text-slate-400">@(history.ToList().IndexOf(item) + 1)</td>
                                <td>@item.PaidOn.ToString("dd.MM.yyyy")</td>
                                <td class="font-semibold text-slate-800">@item.Amount.ToString("0.00")</td>
                                <td class="text-slate-500">@item.Currency</td>
                                <td class="text-slate-500">@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</td>
                                <td class="text-right">
                                    <button type="button" class="admin-row-action is-danger" onclick="deletePayment(@item.Id)">@L["Common_Delete"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

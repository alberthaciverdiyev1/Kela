@{
    var group = (GroupResponse)ViewData["Group"]!;
    var teachers = (PagedResponse<UserResponse>)ViewData["Teachers"]!;
    var teacherOptions = new List<SelectOption> { new() { Value = "", Text = L["Group_NoTeacher"] } };
    teacherOptions.AddRange(teachers.Data.Select(u => new SelectOption { Value = u.Id.ToString(), Text = $"{u.Name} {u.Surname}".Trim() }));
    var subjectCount = (int)ViewData["SubjectCount"]!;
    var quizCount = (int)ViewData["QuizCount"]!;
}
<section class="admin-page">
    @{
        var headerExtra = new Microsoft.AspNetCore.Html.HtmlString($@"
            <a href=""/group-stat?group_id={group.Id}"" class=""admin-button-secondary"">{L["Nav_GroupStats"]}</a>
            <button type=""button"" class=""admin-button-secondary"" onclick=""copyGroupLink()"">{L["Group_CopyJoinLink"]}</button>
            <button type=""button"" class=""admin-button-secondary"" onclick=""toggleGroupEdit()"">{L["Js_Edit"]}</button>
            <button type=""button"" class=""admin-button-danger"" onclick=""deleteGroup()"">{L["Common_Delete"]}</button>");
    }
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="grid gap-4 lg:grid-cols-3">
        <div class="admin-card p-5 lg:col-span-2">
            <div class="flex items-start gap-4">
                @if (!string.IsNullOrWhiteSpace(group.Image))
                {
                    <img src="@group.Image" alt="" class="h-16 w-16 shrink-0 rounded-2xl object-cover" />
                }
                else
                {
                    <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-primary-light text-primary">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87" /></svg>
                    </span>
                }
                <div class="min-w-0">
                    <h2 class="text-lg font-bold text-slate-900">@group.Name</h2>
                    <p class="mt-1 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(group.Description) ? "—" : group.Description)</p>
                    <p class="mt-2 text-xs font-semibold text-slate-400">
                        @L["Common_Teacher"]: @(teachers.Data.FirstOrDefault(t => t.Id == group.UserId) is { } t ? $"{t.Name} {t.Surname}".Trim() : L["Group_NoTeacher"])
                    </p>
                </div>
            </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1 lg:gap-3">
            <partial name="Ui/_StatCard" model="@(new StatCardModel { Label = L["Nav_Students"], Value = group.StudentCount.ToString(), Compact = true, ValueClass = "text-primary" })" />
            <partial name="Ui/_StatCard" model="@(new StatCardModel { Label = L["Nav_Subjects"], Value = subjectCount.ToString(), Compact = true })" />
            <partial name="Ui/_StatCard" model="@(new StatCardModel { Label = L["Nav_Exams"], Value = quizCount.ToString(), Compact = true })" />
        </div>
    </div>

    <div id="groupJoinToken" class="hidden" data-token="@group.JoinToken"></div>

    @* Qrupun özünü redaktə etmək (modalda olmayan imkan). *@
    <div id="groupEdit" class="admin-card mt-4 hidden p-5">
        <h3 class="mb-4 text-base font-bold text-slate-900">@L["Js_Edit"]</h3>
        <form id="groupEditForm" class="grid gap-4 sm:grid-cols-2">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "name", Id = "g_name", Label = L["Common_Name"], Value = group.Name, Required = true })" />
            @if (User.IsAdmin())
            {
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "user_id", Id = "g_teacher", Label = L["Common_Teacher"], Options = teacherOptions, Value = group.UserId?.ToString() ?? "" })" />
            }
            <div class="sm:col-span-2">
                <partial name="Ui/_Input" model="@(new InputModel { Name = "description", Id = "g_description", Label = L["Common_Description"], Value = group.Description })" />
            </div>
            <div class="sm:col-span-2">
                <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "image", Id = "g_image", Label = L["Common_Image"], Accept = ".jpg,.jpeg,.png", Hint = "jpg/png, max 5MB" })" />
            </div>
            <div class="flex justify-end gap-3 sm:col-span-2">
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", OnClick = "toggleGroupEdit()" })" />
                <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
            </div>
        </form>
    </div>

    <div class="admin-card mt-4">
        <div class="border-b border-border p-4">
            <div class="admin-tabs" id="manageTabs">
                @foreach (var (tab, label) in new[] { ("students", L["Nav_Students"].Value), ("joins", L["Group_JoinRequests"].Value), ("subjects", L["Nav_Subjects"].Value), ("quizzes", L["Nav_Exams"].Value), ("logs", L["Group_SubjectLogs"].Value) })
                {
                    <button type="button" data-tab="@tab" class="admin-tab@(tab == "students" ? " is-active" : "")">
                        @label
                        @if (tab == "joins")
                        {
                            <span id="joinTabBadge" class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-danger px-1.5 py-0.5 text-[10px] font-bold leading-none text-white" style="display:@(group.PendingJoins > 0 ? "inline-flex" : "none")">@group.PendingJoins</span>
                        }
                    </button>
                }
            </div>
        </div>

        <div class="p-4">
            <div id="tab-students" data-tab-panel="students" class="space-y-4">
                <div class="flex flex-wrap items-end gap-3">
                    <div class="min-w-56 flex-1"><partial name="Ui/_Select" model="@(new SelectModel { Name = "student_pick", Id = "studentPick", Label = L["Nav_Students"], Options = new List<SelectOption>() })" /></div>
                    <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Add"], OnClick = "assignMember('students')" })" />
                </div>
                <div id="studentsList" class="space-y-2"></div>
            </div>

            <div id="tab-joins" data-tab-panel="joins" class="hidden space-y-2">
                <div id="joinsList" class="space-y-2"></div>
            </div>

            <div id="tab-subjects" data-tab-panel="subjects" class="hidden space-y-4">
                <div class="flex flex-wrap items-end gap-3">
                    <div class="min-w-56 flex-1"><partial name="Ui/_Select" model="@(new SelectModel { Name = "subject_pick", Id = "subjectPick", Label = L["Nav_Subjects"], Options = new List<SelectOption>() })" /></div>
                    <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Add"], OnClick = "assignMember('subjects')" })" />
                </div>
                <div id="subjectsList" class="space-y-2"></div>
            </div>

            <div id="tab-quizzes" data-tab-panel="quizzes" class="hidden space-y-4">
                <div class="flex flex-wrap items-end gap-3">
                    <div class="min-w-56 flex-1"><partial name="Ui/_Select" model="@(new SelectModel { Name = "quiz_pick", Id = "quizPick", Label = L["Nav_Exams"], Options = new List<SelectOption>() })" /></div>
                    <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Add"], OnClick = "assignMember('quizzes')" })" />
                </div>
                <div id="quizzesList" class="space-y-2"></div>
            </div>

            <div id="tab-logs" data-tab-panel="logs" class="hidden space-y-2">
                <div id="logsList" class="space-y-2"></div>
            </div>
        </div>
    </div>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

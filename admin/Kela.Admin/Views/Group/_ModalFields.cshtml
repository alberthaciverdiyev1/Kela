@{
    var teachers = (PagedResponse<UserResponse>)ViewData["Teachers"]!;
    var defaultTeacher = ViewData["DefaultTeacherId"] as string ?? "";
    var teacherOptions = new List<SelectOption> { new() { Value = "", Text = L["Group_NoTeacher"] } };
    teacherOptions.AddRange(teachers.Data.Select(u => new SelectOption { Value = u.Id.ToString(), Text = $"{u.Name} {u.Surname}".Trim() }));
}

@* --- Addım göstəricisi (yalnız create) --- *@ 
<div id="wizardSteps" class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-border px-6 py-4">
    @foreach (var (n, label, hint) in new[]
    {
        (1, L["Group_StepInfo"].Value, L["Group_StepInfoHint"].Value),
        (2, L["Group_StepSubjects"].Value, L["Group_StepSubjectsHint"].Value),
        (3, L["Group_StepQuizzes"].Value, L["Group_StepQuizzesHint"].Value)
    })
    {
        <div class="flex items-center gap-2" data-step-item="@n">
            <span data-step-dot="@n" class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-bold text-slate-500 transition-colors">@n</span>
            <span class="leading-tight">
                <span data-step-label="@n" class="block text-sm font-semibold text-slate-500 transition-colors">@label</span>
                <span class="hidden text-[11px] text-slate-400 sm:block">@hint</span>
            </span>
        </div>
    }
</div>

<form id="entityForm" class="flex min-h-0 flex-1 flex-col">
    <input type="hidden" id="entityId" />
    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-6">
        @* Step 1 *@
        <div data-step-panel="1" class="space-y-4">
            <partial name="Ui/_Input" model="@(new InputModel { Name = "name", Id = "name", Label = L["Common_Name"], Required = true })" />
            <partial name="Ui/_Input" model="@(new InputModel { Name = "description", Id = "description", Label = L["Common_Description"] })" />
            @* Tək müəllim varsa seçim mənasızdır — sahə göstərilmir.
               Kursda birdən çox müəllim olanda admin seçir. *@
            @if (User.IsAdmin() && teachers.Total > 1)
            {
                <partial name="Ui/_Select" model="@(new SelectModel { Name = "user_id", Id = "user_id", Label = L["Common_Teacher"], Options = teacherOptions, Value = defaultTeacher })" />
            }
            <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "image", Id = "image", Label = L["Common_Image"], Accept = ".jpg,.jpeg,.png", Hint = "jpg/png, max 5MB" })" />
        </div>

        @* Step 2 *@
        <div data-step-panel="2" class="hidden space-y-3">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-slate-600">@L["Group_StepSubjects"] <span id="count-subjects" class="ml-1 text-xs font-bold text-primary"></span></p>
                <label class="flex items-center gap-2 text-xs font-bold text-primary"><input type="checkbox" data-change-action="toggleAllFrom" data-list="subjectsList" class="h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />@L["Group_SelectAll"]</label>
            </div>
            <div id="subjectsList" class="max-h-[45vh] space-y-1 overflow-y-auto rounded-xl border border-border p-2">
                <div class="p-3 text-sm text-slate-400">@L["Common_LoadingResults"]</div>
            </div>
        </div>

        @* Step 3 *@
        <div data-step-panel="3" class="hidden space-y-3">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-slate-600">@L["Group_StepQuizzes"] <span id="count-quizzes" class="ml-1 text-xs font-bold text-primary"></span></p>
                <label class="flex items-center gap-2 text-xs font-bold text-primary"><input type="checkbox" data-change-action="toggleAllFrom" data-list="quizzesList" class="h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />@L["Group_SelectAll"]</label>
            </div>
            <input id="quizSearch" type="search" class="admin-field" placeholder="@L["Common_SearchPlaceholder"]" data-input-action="filterQuizzes" />
            <div id="quizzesList" class="max-h-[40vh] space-y-1 overflow-y-auto rounded-xl border border-border p-2">
                <div class="p-3 text-sm text-slate-400">@L["Common_LoadingResults"]</div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-between gap-3 border-t border-border p-5">
        <button type="button" id="prevBtn" data-action="wizardPrev" class="admin-button-secondary hidden">@L["Common_Back"]</button>
        <div class="ml-auto flex gap-3">
            <button type="button" data-modal-close class="admin-button-secondary">@L["Common_Cancel"]</button>
            <button type="button" id="nextBtn" data-action="wizardNext" class="admin-button-primary">@L["Common_Next"]</button>
            <button type="submit" id="saveBtn" class="admin-button-primary hidden">@L["Common_Save"]</button>
        </div>
    </div>
</form>

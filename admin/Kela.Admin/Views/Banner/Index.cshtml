@{
    ViewData["Title"] = L["Nav_Banners"];
}
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Banner_Create"],
        StatCard = new StatCardModel {
            Id = "stat_total",
            Label = L["Banner_Total"],
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M4 5h16v14H4z' /><path stroke-linecap='round' stroke-linejoin='round' d='m4 15 4-4 5 5 3-3 4 4' /><circle cx='9' cy='9' r='1.5' />"
        }
    })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Banner_Search"],
            Sort = new FilterSortModel { },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Search"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/banner/bulk" })" />

        <div class="relative">
            <div id="listLoader" class="admin-loader"><div class="spinner"></div></div>
            <div class="overflow-x-auto">
                <table class="admin-table">
                    <partial name="Ui/_TableHead" model="@(new TableHeadModel
                        {
                            Selectable = true,
                            Columns = new List<TableColumnModel>
                            {
                                    new() { Label = L["Common_Image"], WidthClass = "w-28" },
                                    new() { Label = L["Common_Title"] },
                                    new() { Label = L["Banner_Owner"], WidthClass = "w-36" },
                                    new() { Label = L["Common_Status"], WidthClass = "w-28" },
                                    new() { Label = L["Banner_ActiveUntil"], WidthClass = "w-32" },
                                    new() { Label = L["Common_Actions"], Right = true },
                            }
                        })" />
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>

        <partial name="Ui/_TableFooter" model="@(new TableFooterModel())" />
</section>

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "modal",
    TitleId = "modalTitle",
    Title = L["Banner_Create"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

@{
    ViewData["Title"] = "Plan şablonları";
    var enabled = ViewData["TemplatesEnabled"] is true;
}

@if (enabled)
{
    <section class="admin-page">
        <form id="antiforgery">@Html.AntiForgeryToken()</form>
        <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { CreateText = "Yeni şablon", CreateAction = "openTemplate" })" />

        <div class="admin-card">
            <partial name="Ui/_Table" model="@(new TableModel
            {
            BodyId = "template-rows",
            Columns = new List<TableColumnModel>
            {
            new() { Label = "Şablon adı" },
            new() { Label = "Məbləğ", WidthClass = "w-32" },
            new() { Label = "Valyuta", WidthClass = "w-24" },
            new() { Label = "Period", WidthClass = "w-36" },
            new() { Label = L["Common_Actions"], Right = true }
            }
            })" />
        </div>
    </section>

    var templateBody = await Html.PartialAsync("_TemplateModalFields");

    <partial name="Ui/_Modal" model="@(new ModalModel
    {
        Id = "templateModal",
        TitleId = "templateModalTitle",
        Title = "Plan şablonu",
        WidthClass = "max-w-lg",
        ShowError = false,
        Body = templateBody
    })" />
}
else
{
    <section class="admin-page">
        <div class="admin-card p-6 sm:p-8">
            <div class="mx-auto max-w-lg text-center">
                <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-primary-light text-primary">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m9 0h-9a1.5 1.5 0 0 0-1.5 1.5v7.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5v-7.5a1.5 1.5 0 0 0-1.5-1.5Z"/>
                    </svg>
                </span>
                <h2 class="mt-4 text-lg font-bold text-slate-900">Plan şablonları planınızda yoxdur</h2>
                <p class="mt-2 text-sm text-slate-500">
                    Cari abunəlik planı hazır plan şablonlarından istifadəyə icazə vermir.
                    Ödənişləri əl ilə daxil edə bilərsiniz; şablonlar üçün planı yüksəldin.
                </p>
                <div class="mt-5 flex flex-wrap justify-center gap-2">
                    <a href="/payment" class="admin-button-secondary">Ödənişlərə keç</a>
                    <a href="/plan-catalog" class="admin-button-primary">Planları gör</a>
                </div>
            </div>
        </div>
    </section>
}

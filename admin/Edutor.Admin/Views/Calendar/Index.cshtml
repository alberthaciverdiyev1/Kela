@{
    ViewData["Title"] = L["Nav_Calendar"];
}
<script>
    window.CAL_LOCALE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        System.Globalization.CultureInfo.CurrentUICulture.Name));
</script>
<section class="admin-page">
    <div class="admin-card flex flex-col overflow-hidden" style="height: calc(100vh - 150px); min-height: 520px">
        <div class="flex flex-wrap items-center gap-2 border-b border-border px-4 py-3">
            <button type="button" id="calToday" class="admin-button admin-button-secondary h-9">@L["Calendar_Today"]</button>
            <div class="flex items-center">
                <button type="button" id="calPrev" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100" aria-label="previous">‹</button>
                <button type="button" id="calNext" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100" aria-label="next">›</button>
            </div>
            <p id="calLabel" class="text-lg font-bold text-slate-800"></p>

            <div class="ml-auto flex items-center gap-2">
                <div id="calViews" class="flex overflow-hidden rounded-xl border border-border">
                    <button type="button" data-view="month" class="cal-view-btn px-3 py-1.5 text-sm font-semibold">@L["Calendar_Month"]</button>
                    <button type="button" data-view="week" class="cal-view-btn border-l border-border px-3 py-1.5 text-sm font-semibold">@L["Calendar_Week"]</button>
                    <button type="button" data-view="day" class="cal-view-btn border-l border-border px-3 py-1.5 text-sm font-semibold">@L["Calendar_Day"]</button>
                </div>
                <button type="button" id="calNew" class="admin-button admin-button-primary h-9">@L["Calendar_NewEvent"]</button>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 border-b border-border px-4 py-1.5 text-[11px] font-semibold text-slate-500">
            <span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full" style="background:#27815e"></i>@L["Calendar_Event"]</span>
            <span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full" style="background:#f59e0b"></i>@L["Calendar_Homework"]</span>
            <span id="calRange" class="ml-auto"></span>
        </div>

        <div id="calendarGrid" class="min-h-0 flex-1 overflow-auto"></div>
    </div>
</section>

<div id="eventModal" data-modal class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4">
    <div data-modal-panel class="flex max-h-[90vh] w-full max-w-xl flex-col rounded-2xl border border-border bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border px-5 py-4">
            <div>
                <h3 id="eventModalTitle" class="text-lg font-bold text-slate-900">@L["Calendar_NewEvent"]</h3>
                <p id="eventModalSubtitle" class="mt-0.5 text-xs text-slate-500"></p>
            </div>
            <button type="button" data-modal-close aria-label="@L["Common_Close"]"
                    class="grid h-9 w-9 place-items-center rounded-lg border border-danger/25 bg-danger-bg text-danger transition hover:bg-danger hover:text-white">✕</button>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto">
            <form id="eventForm" class="space-y-5 p-5">
                <input type="hidden" id="eventId" />

                <div id="eventError" class="hidden rounded-xl bg-danger-bg px-3 py-2 text-sm font-semibold text-danger"></div>

                <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "eventTitle", Label = L["Calendar_Title"], Required = true, Placeholder = L["Calendar_Title"] })" />

                <partial name="Ui/_Editor" model="@(new EditorModel { Id = "eventDescription", Name = "description", Label = L["Calendar_Description"], Placeholder = L["Calendar_Description"], Compact = true })" />

                <div class="space-y-3">
                    <partial name="Ui/_Input" model="@(new InputModel { Name = "date", Id = "eventDate", Label = L["Common_Date"], Type = "date", Required = true })" />
                    <div class="grid grid-cols-2 gap-3">
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "start", Id = "eventStart", Label = L["Calendar_Start"], Type = "time", Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "end", Id = "eventEnd", Label = L["Calendar_End"], Type = "time", Required = true })" />
                    </div>
                </div>

                <div>
                    <span class="mb-2 block text-sm font-semibold text-slate-600">@L["Calendar_Color"]</span>
                    <div id="eventPalette" class="flex flex-wrap items-center gap-2"></div>
                </div>

                <div class="flex items-center justify-between border-t border-border pt-4">
                    <button type="button" id="eventDelete" class="admin-button-ghost hidden !text-danger hover:!bg-danger-bg"
                            data-action="Calendar.deleteEvent">@L["Common_Delete"]</button>
                    <div class="ml-auto flex items-center gap-2">
                        <button type="button" class="admin-button-secondary" data-modal-close>@L["Common_Cancel"]</button>
                        <button type="submit" class="admin-button-primary">@L["Common_Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

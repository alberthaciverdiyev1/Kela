@{
    ViewData["Title"] = L["Nav_Calendar"];
}
<script>
    window.CAL_LOCALE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        System.Globalization.CultureInfo.CurrentUICulture.Name));
</script>
<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel())" />

    <div class="grid gap-4 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)] lg:items-start">
        <div class="admin-card p-5">
            <div id="calendar"></div>
            <p id="monthSummary" class="mt-3 text-center text-sm text-slate-500"></p>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500">
                <span class="flex items-center gap-1.5"><i class="cal-dot cal-note"></i>@L["Calendar_Note"]</span>
                <span class="flex items-center gap-1.5"><i class="cal-dot cal-homework"></i>@L["Calendar_Homework"]</span>
            </div>
        </div>

        <div id="dayPanel" class="admin-card admin-empty p-5">@L["Calendar_SelectDay"]</div>
    </div>
</section>

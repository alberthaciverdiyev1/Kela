@model Edutor.Core.Modules.Payments.Responses.CashboxOverviewResponse
@{
    ViewData["Title"] = "Kassa";

    var payload = new
    {
        currencies = Model.Currencies.Select(c => new
        {
            currency = c.Currency,
            today = c.Today,
            thisMonth = c.ThisMonth,
            expectedThisMonth = c.ExpectedThisMonth,
            lastMonth = c.LastMonth,
            projected = c.ProjectedNextMonth,
            overdue = c.OverdueAmount,
            activePlans = c.ActivePlans
        }),
        monthly = Model.Monthly.Select(m => new { period = m.Period, currency = m.Currency, amount = m.Amount }),
        recent = Model.Recent.Select(r => new
        {
            id = r.Id,
            student = r.StudentName,
            paidOn = r.PaidOn.ToString("yyyy-MM-dd"),
            amount = r.Amount,
            currency = r.Currency,
            note = r.Note
        })
    };
}

<script>window.CASHBOX = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(payload));</script>

<section class="admin-page">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-extrabold text-slate-900">@L["Cashbox_Title"]</h1>
            <p class="mt-1 text-sm text-slate-500">@L["Cashbox_Subtitle"]</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (Model.Currencies.Select(c => c.Currency).Distinct().Count() > 1)
            {
                <select id="cashboxCurrency" class="admin-field w-28">
                    @foreach (var code in Model.Currencies.Select(c => c.Currency).Distinct())
                    {
                        <option value="@code">@code</option>
                    }
                </select>
            }
            <button type="button" class="admin-button-primary" data-action="CashboxPage.openPayment">
                @L["Payment_Record"]
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-3">
        @foreach (var card in new (string Id, string Label, string Hint)[]
        {
            ("k-today", L["Cashbox_Today"], L["Cashbox_TodayHint"]),
            ("k-this", L["Cashbox_ThisMonth"], L["Cashbox_ThisMonthHint"]),
            ("k-expected", L["Cashbox_Expected"], L["Cashbox_ExpectedHint"]),
            ("k-last", L["Cashbox_LastMonth"], L["Cashbox_LastMonthHint"]),
            ("k-projection", L["Cashbox_Projection"], L["Cashbox_ProjectionHint"]),
            ("k-overdue", L["Cashbox_OverdueDebt"], L["Cashbox_OverdueDebtHint"])
        })
        {
            <div class="admin-card p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@card.Label</p>
                <p id="@card.Id" class="mt-1 text-2xl font-extrabold text-slate-900">—</p>
                <p class="mt-1 text-xs text-slate-400">@card.Hint</p>
            </div>
        }
    </div>

    <div class="admin-card p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-base font-bold text-slate-900">@L["Cashbox_Last12"]</h3>
            <span id="cashboxDelta" class="text-sm font-semibold text-slate-500"></span>
        </div>
        <div id="cashboxMonths" class="mt-4 flex h-36 items-end gap-1.5"></div>
    </div>

    <div class="grid grid-cols-2 gap-4 xl:grid-cols-5">
        @foreach (var cell in new (string Label, int Value, string Tone)[]
        {
            ("Aktiv plan", Model.ActivePlans, "text-slate-900"),
            (L["Cashbox_Overdue"], Model.OverduePlans, "text-danger"),
            (L["Cashbox_DueSoon"], Model.DueSoonPlans, "text-warning"),
            (L["Cashbox_PayingStudents"], Model.PayingStudents, "text-primary"),
            (L["Cashbox_ActiveStudents"], Model.StudentCount, "text-slate-900")
        })
        {
            <div class="admin-card px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@cell.Label</p>
                <p class="mt-1 text-xl font-extrabold @cell.Tone">@cell.Value</p>
            </div>
        }
    </div>

    <div class="admin-card">
        <div class="admin-toolbar flex flex-wrap items-center gap-2">
            <div class="min-w-0">
                <h3 class="text-base font-bold text-slate-900">@L["Cashbox_RecentPayments"]</h3>
                <p id="cashboxRangeTotal" class="text-xs font-semibold text-slate-500"></p>
            </div>
            <div class="ml-auto flex flex-wrap items-center gap-2">
                <partial name="Ui/_DatePicker" model="@(new DatePickerModel { Id = "cashboxFrom", Type = "date", Class = "!h-9 w-36", AriaLabel = L["Common_FromDate"] })" />
                <span class="text-slate-400">–</span>
                <partial name="Ui/_DatePicker" model="@(new DatePickerModel { Id = "cashboxTo", Type = "date", Class = "!h-9 w-36", AriaLabel = L["Common_ToDate"] })" />
                <button type="button" class="admin-button-secondary" data-action="CashboxPage.applyRange">@L["Common_Filter"]</button>
                <button type="button" class="admin-button-ghost" data-action="CashboxPage.clearRange">@L["Common_Reset"]</button>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Common_Date"]</th>
                        <th>@L["Common_Student"]</th>
                        <th class="text-right">@L["Common_Amount"]</th>
                        <th>@L["Common_Note"]</th>
                        <th class="text-right">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody id="cashboxRecent">
                    <tr><td colspan="5" class="text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@{
    var paymentBody = await Html.PartialAsync("_PaymentModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "cashboxPaymentModal",
    TitleId = "cashboxPaymentTitle",
    Title = L["Payment_Record"],
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = paymentBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

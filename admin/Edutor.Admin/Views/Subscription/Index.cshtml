@model Edutor.Core.Modules.Subscription.Responses.SubscriptionResponse?
@using Edutor.Core.Modules.Tenant.Responses
@using Edutor.Admin.Models.Ui
@{
    ViewData["Title"] = L["Subscription_Title"];
    var tenants = ViewData["Tenants"] as IReadOnlyList<TenantResponse>;
    var selectedTenantId = ViewData["SelectedTenantId"] as long?;
    var usage = Model?.Usage;

    string Bar(int used, int max) => max <= 0 ? $"{used} / {L["Subscription_Unlimited"]}" : $"{used} / {max}  ({Math.Min(100, (int)Math.Round(used * 100.0 / max))}%)";

    string Width(long used, long max)
        => max <= 0 ? "8" : Math.Clamp((int)Math.Round(used * 100.0 / max), 2, 100).ToString();

    string Tone(long used, long max)
        => max > 0 && used >= max ? "bg-danger" : max > 0 && used * 100 / max >= 80 ? "bg-amber-500" : "bg-primary";

    var statusLabel = usage?.Status switch
    {
        "readonly" => (L["Subscription_StatusReadonly"], "warning"),
        "suspended" => (L["Subscription_StatusSuspended"], "danger"),
        _ => (L["Subscription_StatusActive"], "success")
    };

    var tenantSelect = tenants is { Count: > 0 }
        ? new SelectModel
        {
            Id = "subscriptionTenant",
            Name = "tenant_id",
            Label = "Tenant",
            Value = selectedTenantId?.ToString(),
            ChangeAction = "SubscriptionPage.switchTenant",
            Options = tenants.Select(t => new SelectOption { Value = t.Id.ToString(), Text = t.Name }).ToList()
        }
        : null;

    var gaugeRows = usage is null
        ? []
        : new (string Label, int Used, int Max)[]
        {
            (L["Subscription_GaugeStudent"], usage.Students, usage.MaxStudents),
            (L["Subscription_GaugeGroup"], usage.Groups, usage.MaxGroups),
            (L["Subscription_GaugeVideo"], usage.VideoMinutes / 60, usage.MonthlyVideoMinutes / 60)
        };

    // Paketin formasını (birdəfəlik/aylıq) və ödəniş vaxtını yalnız superadmin seçir;
    // tenant admini və müəllim plan limitini satın almaq üçün müraciət göndərir.
    var canManageLimits = User.IsInRole(AuthRoles.SuperAdmin);
    var billWithPlan = Model?.Usage.BillAddonsWithPlan == true;
    var tenantActive = ViewData["TenantActive"] as bool?;

    // Yumşaq hədd (80%): limit dolmadan əvvəl xəbərdarlıq.
    var alerts = new List<string>();
    if (usage is not null)
    {
        var gauges = new (string Label, int Used, int Max)[]
        {
            (L["Subscription_GaugeStudent"], usage.Students, usage.MaxStudents),
            (L["Subscription_GaugeGroup"], usage.Groups, usage.MaxGroups),
            (L["Subscription_GaugeVideo"], usage.VideoMinutes / 60, usage.MonthlyVideoMinutes / 60)
        };

        alerts.AddRange(gauges
            .Where(g => g.Max > 0 && g.Used * 100 / g.Max >= 80)
            .Select(g => $"{g.Label}: {g.Used} / {g.Max}"));
    }
}

@if (usage is not null)
{
    <script>window.SUBSCRIPTION_CONTEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        billAddonsWithPlan = billWithPlan,
        canManageLimits
    }));</script>
}

<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel())" />

    @if (tenantSelect is not null)
    {
        <div class="flex justify-end">
            <div class="w-full sm:w-[22rem]">
                <partial name="Ui/_Select" model="tenantSelect" />
            </div>
        </div>
    }

    @if (alerts.Count > 0)
    {
        <div class="admin-card border border-warning/40 bg-warning-bg p-4">
            <p class="text-sm font-bold text-warning">@L["Subscription_LimitsNear"]</p>
            <p class="mt-1 text-sm text-slate-700">
                @string.Join(" · ", alerts) — @L["Subscription_LimitsNearHint"]
            </p>
        </div>
    }

    @if (Model?.Plan is null)
    {
        <div class="admin-card p-5">
            <p class="text-sm text-slate-500">
                @(tenants is { Count: > 0 }
                    ? L["Subscription_SelectTenantHint"]
                    : L["Subscription_NoPlanHint"])
            </p>

            @if (canManageLimits && selectedTenantId is long planlessTenantId)
            {
                <button type="button"
                        class="admin-button-primary mt-4"
                        data-action="PlanModal.open"
                        data-args='[@planlessTenantId, null, ""]'>
                    @L["Subscription_AssignPlan"]
                </button>
            }
        </div>
    }
    else
    {
        var used = usage!;
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="admin-card p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Subscription_CurrentPlan"]</p>
                <p class="mt-1 text-2xl font-extrabold text-slate-900">@Model.Plan.Name</p>
                <p class="mt-1 text-sm text-slate-500">@Model.Plan.MonthlyPrice @Model.Plan.Currency @L["Common_PerMonth"]</p>
                <div class="mt-3">
                    <span class="badge badge-@statusLabel.Item2">@statusLabel.Item1</span>
                </div>

                @if (canManageLimits && selectedTenantId is long currentTenantId)
                {
                    <button type="button"
                            class="admin-button admin-button-secondary mt-3 w-full justify-center"
                            data-action="PlanModal.open"
                            data-args='[@currentTenantId, @Model.Plan.Id, "@(used.ExpiresAt?.ToString("yyyy-MM-dd"))"]'>
                        @L["Subscription_ChangePlan"]
                    </button>
                }
                <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Subscription_Uploads"]</p>
                <div class="mt-1 flex flex-wrap gap-1">
                    @{
                        var allowedUploads = new (string Label, bool Allowed)[]
                        {
                            ("Video", used.AllowVideoUpload),
                            ("PDF", used.AllowFileUpload),
                            (L["Common_Audio"], used.AllowAudioUpload)
                        };
                    }
                    @foreach (var upload in allowedUploads)
                    {
                        <span class="badge badge-@(upload.Allowed ? "success" : "danger")">@upload.Label</span>
                    }
                </div>
            </div>

            <div class="admin-card p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Subscription_Duration"]</p>
                @if (used.ExpiresAt is { } expires)
                {
                    <p class="mt-1 text-2xl font-extrabold text-slate-900">@expires.ToString("dd.MM.yyyy")</p>
                    <p class="mt-1 text-sm text-slate-500">@(used.DaysLeft is { } d && d > 0 ? L["Subscription_DaysLeft", d] : L["Subscription_ExpiredHint"])</p>
                }
                else
                {
                    <p class="mt-1 text-2xl font-extrabold text-slate-900">@L["Subscription_Unlimited"]</p>
                    <p class="mt-1 text-sm text-slate-500">@L["Subscription_NoExpiry"]</p>
                }

                @if (canManageLimits && selectedTenantId is long statusTenantId && tenantActive is bool isActive)
                {
                    <button type="button"
                            class="admin-button @(isActive ? "admin-button-danger" : "admin-button-secondary") mt-4 w-full justify-center"
                            data-action="SubscriptionPage.toggleSuspend"
                            data-args='[@statusTenantId, @(isActive ? "true" : "false")]'>
                        @(isActive ? L["Subscription_Suspend"] : L["Subscription_Resume"])
                    </button>
                }
            </div>

            <div class="admin-card p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Subscription_VideoThisMonth"]</p>
                <p class="mt-1 text-2xl font-extrabold text-slate-900">
                    @(used.MonthlyVideoMinutes > 0
                        ? $"{used.VideoMinutes / 60} / {used.MonthlyVideoMinutes / 60}"
                        : (used.VideoMinutes / 60).ToString())
                </p>
                <p class="mt-1 text-sm text-slate-500">@L["Subscription_Hours"]</p>
            </div>
        </div>

        <div class="admin-card p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-base font-bold text-slate-900">@L["Subscription_Usage"]</h3>

                @if (canManageLimits && selectedTenantId is long limitsTenantId)
                {
                    <button type="button"
                            class="admin-button admin-button-secondary"
                            data-action="LimitOverridesModal.open"
                            data-args='[@limitsTenantId]'>
                        @L["Subscription_CustomizeLimits"]
                    </button>
                }
            </div>

            <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
                @foreach (var row in gaugeRows)
                {
                    <div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-medium text-slate-600">@row.Label</span>
                            <span class="font-semibold text-slate-800">@Bar(row.Used, row.Max)</span>
                        </div>
                        <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
                            <div class="h-full rounded-full @Tone(row.Used, row.Max)" style="width:@(Width(row.Used, row.Max))%"></div>
                        </div>
                    </div>
                }
            </div>

        </div>

        @if (used.AddonOffers.Count > 0 || !canManageLimits)
        {
            <div class="admin-card p-5">
                <h3 class="mb-2 text-base font-bold text-slate-900">@L["Subscription_AddonTitle"]</h3>

                @if (canManageLimits)
                {
                    <p class="mb-4 text-sm text-slate-500">
                        @L["Subscription_AddonAdminHint"]
                    </p>

                    <div class="grid gap-3 sm:grid-cols-3">
                        @foreach (var offer in used.AddonOffers)
                        {
                            <div class="flex flex-col rounded-xl border border-border bg-surface-secondary p-4">
                                <p class="font-bold text-slate-900">@offer.Label</p>
                                <p class="mt-1 text-sm text-slate-500">1 @offer.Unit</p>
                                <p class="mt-2 text-lg font-extrabold text-primary">@offer.UnitPrice @Model.Plan.Currency</p>

                                <button type="button"
                                        class="admin-button-primary mt-3 w-full"
                                        data-action="SubscriptionPage.addAddon"
                                        data-args='["@offer.Kind"]'>
                                    @L["Subscription_Add"]
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mb-4 text-sm text-slate-500">
                        @L["Subscription_AddonUserHint"]
                    </p>

                    <div class="grid gap-3 sm:grid-cols-3">
                        @if (used.AddonOffers.Count == 0)
                        {
                            <p class="text-sm text-slate-500">@L["Subscription_NoAddonOffers"]</p>
                        }
                        @foreach (var offer in used.AddonOffers)
                        {
                            <form class="flex flex-col rounded-xl border border-border bg-surface-secondary p-4" data-addon-request>
                                <input type="hidden" name="kind" value="@offer.Kind" />
                                <p class="font-bold text-slate-900">@offer.Label</p>
                                <p class="mt-1 text-sm text-slate-500">1 @offer.Unit — @offer.UnitPrice @Model.Plan.Currency</p>

                                <label class="mt-3 block text-xs font-semibold text-slate-600">
                                    @L["Subscription_Quantity"]
                                    <input name="quantity" type="number" min="1" max="10000" value="1" class="admin-field mt-1" />
                                </label>

                                <label class="mt-2 block text-xs font-semibold text-slate-600">
                                    @L["Subscription_PaymentTiming"]
                                    <select name="payment_timing" class="admin-field mt-1" data-selected="1">
                                        <option value="now">@L["Subscription_PayNow"]</option>
                                        @if (billWithPlan)
                                        {
                                            <option value="with_plan">@L["Subscription_PayWithPlan"]</option>
                                        }
                                    </select>
                                </label>
                                @if (!billWithPlan)
                                {
                                    <p class="mt-1 text-xs text-slate-400">
                                        @L["Subscription_PayWithPlanDisabled"]
                                    </p>
                                }

                                <input name="note" type="text" maxlength="190" placeholder="@L["Subscription_NoteOptional"]"
                                       class="admin-field mt-2" />

                                <button type="submit" class="admin-button-primary mt-3 w-full justify-center">
                                    @L["Subscription_SendRequest"]
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (!canManageLimits)
        {
            <div class="admin-card p-5">
                <h3 class="mb-3 text-base font-bold text-slate-900">@L["Subscription_MyRequests"]</h3>
                <div class="overflow-x-auto">
                    <table class="admin-table">
                        <thead>
                        <tr>
                            <th>@L["Common_Date"]</th>
                            <th>@L["Common_Type"]</th>
                            <th>@L["Subscription_Quantity"]</th>
                            <th>@L["Subscription_PaymentTiming"]</th>
                            <th>@L["Common_Status"]</th>
                            <th>@L["Common_Note"]</th>
                        </tr>
                        </thead>
                        <tbody id="subscriptionAddonRequests">
                        <tr><td colspan="6" class="p-4 text-center text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (canManageLimits)
        {
            <div class="admin-card p-5">
                <h3 class="mb-3 text-base font-bold text-slate-900">@L["Subscription_ActiveAddons"]</h3>
                <div class="overflow-x-auto">
                    <table class="admin-table">
                        <thead>
                        <tr>
                            <th>@L["Common_Period"]</th>
                            <th>@L["Common_Type"]</th>
                            <th>@L["Subscription_Quantity"]</th>
                            <th>@L["Subscription_Form"]</th>
                            <th>@L["Common_Payment"]</th>
                            <th>@L["Common_Amount"]</th>
                            <th class="text-right">@L["Common_Actions"]</th>
                        </tr>
                        </thead>
                        <tbody id="subscriptionAddons">
                        <tr><td colspan="7" class="p-4 text-center text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-card p-5">
                <h3 class="mb-3 text-base font-bold text-slate-900">@L["Subscription_UsageHistory"]</h3>
                <div class="overflow-x-auto">
                    <table class="admin-table">
                        <thead>
                        <tr>
                            <th>@L["Common_Period"]</th>
                            <th>@L["Subscription_VideoHours"]</th>
                            <th>@L["Subscription_Storage"]</th>
                            <th>@L["Subscription_ExtraStudents"]</th>
                            <th>@L["Subscription_ExtraGroups"]</th>
                            <th>@L["Subscription_ExtraVideoHours"]</th>
                        </tr>
                        </thead>
                        <tbody id="subscriptionUsageHistory">
                        <tr><td colspan="6" class="p-4 text-center text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</section>

<partial name="Ui/_PlanModal" />
<partial name="Ui/_LimitOverridesModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

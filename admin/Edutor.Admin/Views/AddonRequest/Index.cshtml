@{
    ViewData["Title"] = L["AddonRequest_Title"];
    var isSuperAdmin = User.IsInRole(AuthRoles.SuperAdmin);
}

<section class="admin-page space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">@L["AddonRequest_Title"]</h1>
            <p class="mt-1 text-sm text-slate-500">
                @(isSuperAdmin
                    ? L["AddonRequest_AdminDesc"]
                    : L["AddonRequest_UserDesc"])
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button" class="admin-button-secondary" data-filter="">@L["Common_All"]</button>
            <button type="button" class="admin-button-secondary" data-filter="pending">@L["Requests_Pending"]</button>
            <button type="button" class="admin-button-secondary" data-filter="approved">@L["Requests_Approved"]</button>
            <button type="button" class="admin-button-secondary" data-filter="rejected">@L["Requests_Rejected"]</button>
        </div>
    </div>

    <div class="admin-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                <tr>
                    @if (isSuperAdmin)
                    {
                        <th>Tenant</th>
                    }
                    <th>@L["Common_Type"]</th>
                    <th>@L["Subscription_Quantity"]</th>
                    <th>@L["Subscription_PaymentTiming"]</th>
                    <th>@L["Common_Amount"]</th>
                    <th>@L["AddonRequest_Requester"]</th>
                    <th>@L["Common_Date"]</th>
                    <th>@L["Common_Status"]</th>
                    <th class="text-right">@L["Common_Actions"]</th>
                </tr>
                </thead>
                <tbody id="addonRequestRows">
                <tr><td colspan="9" class="p-6 text-center text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

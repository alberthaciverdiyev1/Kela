@{
    ViewData["Title"] = L["Payment_Title"];
    var statusOptions = new List<SelectOption>
    {
        new() { Value = "", Text = L["Common_All"] },
        new() { Value = "upcoming", Text = L["Payment_Upcoming"] },
        new() { Value = "overdue", Text = L["Payment_Overdue"] },
        new() { Value = "unpaid", Text = L["Payment_NoPlan"] },
        new() { Value = "current", Text = L["Payment_ActivePlan"] }
    };
}
<section class="admin-page">
    <form id="antiforgery">@Html.AntiForgeryToken()</form>
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel())" />

    <div class="mb-4 grid grid-cols-2 gap-3 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-upcoming", Label = L["Payment_Upcoming"], Value = "0", Compact = true, ValueClass = "text-warning" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-overdue", Label = L["Payment_Overdue"], Value = "0", Compact = true, ValueClass = "text-danger" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-unpaid", Label = L["Payment_NoPlan"], Value = "0", Compact = true, ValueClass = "text-slate-700" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel { Id = "count-current", Label = L["Payment_ActivePlan"], Value = "0", Compact = true, ValueClass = "text-success" })" />
    </div>

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Payment_SearchPlaceholder"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-48", Select = new SelectModel { Name = "status", Id = "payment-status", Label = "Status", Options = statusOptions } }
            },
            ButtonText = L["Common_Show"]
        })" />

        <partial name="Ui/_Table" model="@(new TableModel
{
BodyId = "payment-rows",
Columns = new List<TableColumnModel>
{
new() { Label = L["Common_Student"] },
new() { Label = L["Common_JoinedDate"], WidthClass = "w-32" },
new() { Label = L["Payment_NextDue"], WidthClass = "w-32" },
new() { Label = L["Common_Amount"], WidthClass = "w-32" },
new() { Label = L["Common_Period"], WidthClass = "w-32" },
new() { Label = L["Common_Status"], WidthClass = "w-28" },
new() { Label = L["Common_Actions"], Right = true }
}
})" />
    </div>
</section>

@{
    var planBody = await Html.PartialAsync("_PlanModalFields");
    var recordBody = await Html.PartialAsync("_RecordPaymentFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "recordModal",
    Title = L["Payment_Record"],
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = recordBody
})" />

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "planModal",
    TitleId = "planModalTitle",
    Title = L["Payment_Plan"],
    WidthClass = "max-w-lg",
    ShowError = false,
    Body = planBody
})" />

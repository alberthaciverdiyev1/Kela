@{
    ViewData["Title"] = L["GroupRequest_Title"];
}

<section class="admin-page space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">@L["GroupRequest_Title"]</h1>
            <p class="mt-1 text-sm text-slate-500">
                @L["GroupRequest_Desc"]
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button" class="admin-button-secondary" data-filter="">@L["Common_All"]</button>
            <button type="button" class="admin-button-secondary" data-filter="pending">@L["Requests_Pending"]</button>
            <button type="button" class="admin-button-secondary" data-filter="approved">@L["Requests_Approved"]</button>
            <button type="button" class="admin-button-secondary" data-filter="rejected">@L["Requests_Rejected"]</button>
        </div>
    </div>

    <div class="admin-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>Qrup</th>
                    <th>@L["Common_Student"]</th>
                    <th>@L["Common_Email"]</th>
                    <th>Tarix</th>
                    <th>Status</th>
                    <th class="text-right">@L["Common_Actions"]</th>
                </tr>
                </thead>
                <tbody id="groupRequestRows">
                <tr><td colspan="6" class="p-6 text-center text-sm text-slate-400">@L["Common_LoadingDots"]</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@* Plan limiti dolanda göstərilən əlavə paket modalı — məzmunu admin.js doldurur. *@
<div id="limitModal" data-modal class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="flex w-full max-w-md flex-col rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-border p-5">
            <h3 class="text-lg font-bold text-slate-900">@L["Limit_Title"]</h3>
            <button type="button" data-modal-close aria-label="@L["Common_Close"]"
                    class="grid h-9 w-9 place-items-center rounded-lg border border-danger/25 bg-danger-bg text-danger transition hover:bg-danger hover:text-white">✕</button>
        </div>

        <div class="space-y-4 p-5">
            <p id="limitMessage" class="text-sm text-slate-600"></p>

            <div id="limitOffer" class="hidden rounded-xl border border-border bg-surface-secondary p-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p id="limitOfferLabel" class="font-bold text-slate-900"></p>
                        <p id="limitOfferDetail" class="mt-1 text-sm text-slate-500"></p>
                    </div>
                    <p id="limitOfferPrice" class="shrink-0 font-extrabold text-primary"></p>
                </div>
                <div id="limitPacksRow" class="mt-3">
                    <label for="limitPacks" class="mb-1 block text-sm font-semibold text-slate-600">@L["Limit_Packs"]</label>
                    <input id="limitPacks" type="number" min="1" value="1" class="admin-field" />
                </div>
                <div id="limitModeRow" class="mt-3 hidden">
                    <label for="limitMode" class="mb-1 block text-sm font-semibold text-slate-600">@L["Limit_RequestMode"]</label>
                    <select id="limitMode" class="admin-field" data-selected="1">
                        <option value="one_time">@L["Limit_OneTime"]</option>
                        <option value="monthly">@L["Limit_Monthly"]</option>
                    </select>
                </div>
            </div>

            <p id="limitNote" class="hidden text-sm text-slate-500"></p>
            <div id="limitError" class="hidden rounded-xl bg-danger-bg px-3 py-2 text-sm font-semibold text-danger"></div>
        </div>

        <div class="flex justify-end gap-2 border-t border-border p-5">
            <button type="button" data-modal-close class="admin-button-secondary">@L["Common_Cancel"]</button>
            <button type="button" id="limitBuy" class="admin-button-primary">@L["Limit_Buy"]</button>
        </div>
    </div>
</div>

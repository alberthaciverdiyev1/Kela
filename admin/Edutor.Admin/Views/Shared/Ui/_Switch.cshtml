@model SwitchModel
@{
    var id = Model.Id ?? Model.Name;
}
<label for="@id" class="inline-flex cursor-pointer items-center gap-3">
    <span class="relative">
        <input id="@id" name="@Model.Name" type="checkbox" checked="@Model.Checked" class="peer sr-only" />
        <span class="block h-6 w-11 rounded-full bg-slate-300 transition-colors peer-checked:bg-primary"></span>
        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
    </span>
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <span class="text-sm font-medium text-slate-700">@Model.Label</span>
    }
</label>

@inject Edutor.Core.Modules.Tenant.Abstractions.ITenantService TenantService
@inject Edutor.Core.Modules.User.Abstractions.IUserService UserService
@{
    var controller = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    var tenantAccountType = await TenantService.GetCurrentAccountTypeAsync();
    var isIndividualTeacher = tenantAccountType == "teacher";
    var isAdmin = User.IsInRole(AuthRoles.Admin) || User.IsInRole(AuthRoles.SuperAdmin);
    var isSuperAdmin = User.IsInRole(AuthRoles.SuperAdmin);
    var switched = !string.IsNullOrEmpty(User.FindFirst("tenant_name")?.Value);
    var isPlatformOwner = isSuperAdmin && !switched;
    var canSeeKassa = (isAdmin || isIndividualTeacher) && !isPlatformOwner;
    var brandLogo = ViewData["BrandLogo"] as string;

    // Hər istifadəçi menyunu özünə uyğunlaşdırır — gizlədilən açarlar users.hidden_sidebar_items-də saxlanır.
    var userId = long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    var hiddenItems = userId > 0
        ? new HashSet<string>(await UserService.GetSidebarHiddenAsync(userId))
        : new HashSet<string>();

    string Active(string c) => controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        ? "bg-primary-light text-primary"
        : "text-slate-600 hover:bg-surface-secondary hover:text-slate-900";

    string IsHidden(string key) => hiddenItems.Contains(key) ? "hidden" : "";
}
<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-30 flex w-[260px] -translate-x-full flex-col border-r border-border bg-white transition-transform duration-200 lg:static lg:shrink-0 lg:translate-x-0">
    <div class="flex h-16 shrink-0 items-center gap-3 border-b border-border px-5">
        @if (!string.IsNullOrWhiteSpace(brandLogo))
        {
            <img src="@brandLogo" alt="Logo" class="h-10 w-10 shrink-0 rounded-xl object-contain"/>
        }
        else
        {
            <div
                class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-700 text-white shadow-sm">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z"/>
                </svg>
            </div>
        }
        <div class="min-w-0">
            <p class="text-base font-extrabold leading-none tracking-tight text-slate-900">Edutor</p>
            <p class="mt-1 text-xs font-medium text-slate-400">@L["Sidebar_AdminPanel"]</p>
        </div>
        <button type="button" id="navEditBtn" title="@L["Sidebar_Customize"]"
                aria-label="@L["Sidebar_Customize"]"
                class="ml-auto grid h-9 w-9 shrink-0 place-items-center rounded-xl text-slate-400 transition hover:bg-surface-secondary hover:text-slate-700">
            <svg class="nav-icon-edit h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h6m4 0h6M4 17h10m4 0h2"/>
                <circle cx="12" cy="7" r="2"/><circle cx="16" cy="17" r="2"/>
            </svg>
            <svg class="nav-icon-done h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/>
            </svg>
        </button>
    </div>

    <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionMain"]</p>
            <a href="/dashboard" data-nav-key="dashboard"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Dashboard") @IsHidden("dashboard")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10h14V10"/>
                </svg>
                @L["Nav_Dashboard"]
            </a>
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionTeaching"]</p>
            <a href="/subject" data-nav-key="subject"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Subject") @IsHidden("subject")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="m4 7 8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4"/>
                </svg>
                @L["Nav_Subjects"]
            </a>
            <a href="/lesson" data-nav-key="lesson"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Lesson") @IsHidden("lesson")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 6.253v13m0-13C10.8 5.5 9 5 7 5S3.2 5.5 2 6.253v13C3.2 18.5 5 18 7 18s3.8.5 5 1.253m0-13C13.2 5.5 15 5 17 5s3.8.5 5 1.253v13C20.8 18.5 19 18 17 18s-3.8.5-5 1.253"/>
                </svg>
                @L["Nav_Lessons"]
            </a>
            <a href="/lesson-content" data-nav-key="lesson-content"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("LessonContent") @IsHidden("lesson-content")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h12"/>
                </svg>
                @L["Nav_Materials"]
            </a>
            <a href="/question" data-nav-key="question"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Question") @IsHidden("question")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"/>
                </svg>
                @L["Nav_Questions"]
            </a>
            <a href="/quiz" data-nav-key="quiz"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Quiz") @IsHidden("quiz")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 12.75 11.25 15 15 11.25M9 3.75H7.5A2.25 2.25 0 0 0 5.25 6v13.5A2.25 2.25 0 0 0 7.5 21.75h9a2.25 2.25 0 0 0 2.25-2.25V6a2.25 2.25 0 0 0-2.25-2.25H15M9 3.75a2.25 2.25 0 1 1 4.5 0M9 3.75h6"/>
                </svg>
                @L["Nav_Exams"]
            </a>
            <a href="/homework" data-nav-key="homework"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Homework") @IsHidden("homework")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4"/>
                </svg>
                @L["Nav_Homework"]
            </a>
            <a href="/attendance" data-nav-key="attendance"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Attendance") @IsHidden("attendance")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8 4v3m8-3v3M4 9h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm3.5 9 1.5 1.5L13 13"/>
                </svg>
                @L["Nav_Attendance"]
            </a>
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionManagement"]</p>
            <a href="/group" data-nav-key="group"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Group") @IsHidden("group")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198v.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>
                </svg>
                @L["Nav_Groups"]
                <span id="groupJoinBadge" class="ml-auto min-w-5 rounded-full bg-danger px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-white" style="display:none"></span>
            </a>
            <a href="/group-stat" data-nav-key="group-stat"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("GroupStat") @IsHidden("group-stat")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
                </svg>
                @L["Nav_GroupStats"]
            </a>
            <a href="/students" data-nav-key="students"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Students") @IsHidden("students")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"/>
                </svg>
                @L["Nav_Students"]
            </a>
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionFinance"]</p>
            @if (isPlatformOwner)
            {
                <a href="/platform-finance" data-nav-key="platform-finance"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PlatformFinance") @IsHidden("platform-finance")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8M21 7v6h-6"/>
                    </svg>
                    @L["Nav_PlatformFinance"]
                </a>
            }
            @if (!isPlatformOwner)
            {
            <a href="/subscription" data-nav-key="subscription"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Subscription") @IsHidden("subscription")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Abunəlik
            </a>
            }
            @if (isSuperAdmin)
            {
                <a href="/plan" data-nav-key="plan"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Plan") @IsHidden("plan")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7"/></svg>
                    Planlar
                </a>
            }
            @if (isAdmin && !isPlatformOwner)
            {
                <a href="/payment" data-nav-key="payment"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Payment") @IsHidden("payment")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" d="M3 10h18m-4 5h2"/></svg>
                    Ödənişlər
                </a>
                <a href="/payment-plan" data-nav-key="payment-plan"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PaymentPlan") @IsHidden("payment-plan")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 3h8a2 2 0 0 1 2 2v16l-6-3-6 3V5a2 2 0 0 1 2-2Zm0 6h8M8 13h5"/>
                    </svg>
                    Plan şablonları
                </a>
            }
            @if (canSeeKassa)
            {
                <a href="/kassa" data-nav-key="kassa"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Kassa") @IsHidden("kassa")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25m-18 0v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>
                    </svg>
                    Kassa
                </a>
            }
        </div>

        <div class="space-y-1">
            <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionContent"]</p>
            <a href="/banner" data-nav-key="banner"
               class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Banner") @IsHidden("banner")">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="16" rx="3"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="m10 8.75 5.5 3.25L10 15.25v-6.5Z"/>
                </svg>
                @L["Nav_Banners"]
            </a>
            @if (isSuperAdmin)
            {
                <a href="/privacy-policy" data-nav-key="privacy-policy"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PrivacyPolicy") @IsHidden("privacy-policy")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12l2 2 4-4m5.6-2A11 11 0 0 1 12 21 11 11 0 0 1 2.4 10 11 11 0 0 1 12 3a11 11 0 0 1 8.6 4Z"/>
                    </svg>
                    @L["Nav_Privacy"]
                </a>
            }
            @if (false)
            {
                <a href="/notification" data-nav-key="notification"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Notification") @IsHidden("notification")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5m6 0a3 3 0 1 1-6 0"/>
                    </svg>
                    @L["Nav_Notifications"]
                </a>
            }
            @if (false)
            {
                <a href="/certificate" data-nav-key="certificate"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Certificate") @IsHidden("certificate")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 3h8l4 4v14H4V3z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8M8 16h5"/>
                    </svg>
                    @L["Nav_Certificates"]
                </a>
            }
        </div>

        @if (isAdmin)
        {
            <div class="space-y-1">
                <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionSystem"]</p>
                <a href="/user" data-nav-key="user"
                   class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("User") @IsHidden("user")">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 4.354a4 4 0 1 1 0 5.292M15 21H3v-1a6 6 0 0 1 12 0v1Zm0 0h6v-1a6 6 0 0 0-9-5.197"/>
                    </svg>
                    @L["Nav_Users"]
                </a>
                @if (!isSuperAdmin || switched)
                {
                    <a href="/setting" data-nav-key="setting"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("Setting") @IsHidden("setting")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 8.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1-.6H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6V3a2 2 0 1 1 4 0v.09A1.65 1.65 0 0 0 15.4 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.2.38.31.8.31 1.24H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51.76Z"/>
                        </svg>
                        @L["Nav_Settings"]
                    </a>
                }
                @if (isSuperAdmin && !switched)
                {
                    <a href="/platform-setting" data-nav-key="platform-setting"
                       class="flex h-10 items-center gap-3 rounded-xl px-3 text-[15px] font-medium transition @Active("PlatformSetting") @IsHidden("platform-setting")">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.05 16.95l-1.41 1.41m12.72 0-1.42-1.42M7.05 7.05 5.64 5.64M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/>
                        </svg>
                        @L["Nav_PlatformSettings"]
                    </a>
                }
            </div>
        }

        @if (isSuperAdmin)
        {
            <div class="space-y-1">
                <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">@L["Sidebar_SectionPlatform"]</p>
                <a href="/tenant" data-nav-key="tenant"

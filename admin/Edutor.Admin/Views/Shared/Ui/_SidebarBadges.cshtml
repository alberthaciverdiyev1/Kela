@model string
@* JS (admin-layout.js) doldurur: sadə sayğac — mətnin yanında boz etiket; müraciət/mesaj/bildiriş — zəng + qırmızı nişan. *@
<span class="sidebar-badges flex min-w-0 flex-1 items-center gap-1.5" data-sidebar-key="@Model">
    <span class="sidebar-count hidden min-w-5 rounded-full bg-slate-100 px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-slate-500"></span>
    <span class="ml-auto flex shrink-0 items-center gap-1.5">
        <svg class="sidebar-new hidden h-4 w-4 shrink-0 text-danger" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="1.9" role="img" title="@L["Sidebar_NewHint"]" aria-label="@L["Sidebar_NewHint"]">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
        </svg>
        <span class="sidebar-alert-count hidden min-w-5 rounded-full bg-danger px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-white"></span>
        <span class="sidebar-label hidden rounded-full bg-primary-light px-1.5 py-0.5 text-[10px] font-bold leading-none text-primary"></span>
    </span>
</span>

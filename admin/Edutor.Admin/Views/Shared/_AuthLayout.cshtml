<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Edutor</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="@(ViewData["FullBleed"] is true ? "min-h-screen bg-white text-slate-800" : "flex min-h-screen items-center justify-center bg-slate-100 p-4 text-slate-800")">
    @{
        var langs = new (string Code, string Name)[]
        {
            ("az", "Azərbaycan"),
            ("ru", "Русский"),
            ("tr", "Türkçe"),
            ("en", "English")
        };
        var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    }
    <div class="fixed right-4 top-4 z-50">
        <div class="relative">
            <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" /></svg>
            <select id="authLang"
                    class="appearance-none rounded-xl border border-[#e2e8e4] bg-white/95 py-2 pl-8 pr-8 text-sm font-semibold text-slate-600 shadow-sm outline-none transition hover:bg-[#f5faf7] focus:border-primary">
                @foreach (var lang in langs)
                {
                    <option value="@lang.Code" selected="@(lang.Code == currentLang)">@lang.Name</option>
                }
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
        </div>
    </div>

    @RenderBody()
    <script>
        document.getElementById('authLang')?.addEventListener('change', function () {
            var code = this.value;
            document.cookie = '.AspNetCore.Culture=c=' + code + '|uic=' + code + ';path=/;max-age=31536000';
            location.reload();
        });
    </script>
    @if (ViewData["Scripts"] is string[] pageScripts)
    {
        foreach (var script in pageScripts)
        {
            <script src="@script" asp-append-version="true"></script>
        }
    }
</body>
</html>

@{
    ViewData["Title"] = L["Nav_Materials"];
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var lessonFilter = new List<SelectOption> { new() { Value = "", Text = L["Common_All"] } };
    lessonFilter.AddRange(lessons.Data.Select(l => new SelectOption { Value = l.Id.ToString(), Text = l.Title }));
}
<section class="admin-page">
    @* Yarımçıq qalmış yükləmə: istifadəçi eyni faylı seçəndə yalnız qalan hissələr göndərilir. *@
    <div id="resumePanel" class="admin-card mb-4 hidden items-center justify-between gap-3 p-4">
        <div class="min-w-0">
            <p class="text-sm font-bold text-slate-800">@L["Upload_ResumeTitle"]</p>
            <p id="resumeHint" class="mt-0.5 truncate text-xs text-slate-500"></p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <label class="admin-button-primary cursor-pointer">
                <input id="resumeFile" type="file" class="hidden" data-change-action="resumeUpload" />
                @L["Upload_ResumePick"]
            </label>
            <button type="button" class="admin-button-secondary" data-action="cancelResume">@L["Common_Cancel"]</button>
        </div>
    </div>
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel {
        CreateText = L["Common_NewMaterial"],
        Sortable = true })" />

    <div class="admin-card">
        <partial name="Ui/_FilterBar" model="@(new FilterBarModel {
            SearchPlaceholder = L["Common_SearchPlaceholder"],
            Selects = new List<FilterSelectModel> {
                new() { WidthClass = "w-44", Select = new SelectModel { Name = "filter_lesson", Id = "filter_lesson", Label = L["Common_Lesson"], Options = lessonFilter, Value = (string?)ViewData["SelectedLessonId"] } }
            },
            Sort = new FilterSortModel {
                    Extra = new List<SelectOption> { new() { Value = "order_asc", Text = L["Sort_Manual"] } } },
            Trash = true,
            TrashText = L["Common_DeletedItems"],
            ButtonText = L["Common_Show"]
        })" />

        <partial name="Ui/_BulkBar" model="@(new BulkBarModel { Url = "/lesson-content/bulk", CanActivate = true, CanDeactivate = true })" />

        <partial name="Ui/_Table" model="@(new TableModel
        {
            Selectable = true,
            Columns = new List<TableColumnModel>
            {
                    new() { Label = L["Common_Title"] },
                    new() { Label = L["Common_Lesson"], WidthClass = "w-48" },
                    new() { Label = L["Common_Type"], WidthClass = "w-28" },
                    new() { Label = L["Video_Status"], WidthClass = "w-32" },
                    new() { Label = L["Common_File"], WidthClass = "w-24" },
                    new() { Label = L["Common_Active"], WidthClass = "w-24" },
                    new() { Label = L["Common_Actions"], Right = true },
            }
        })" />
</section>

@{
    var previewHeader = await Html.PartialAsync("_PreviewHeader");
    var previewBody = await Html.PartialAsync("_PreviewBody");
}

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "previewModal",
    TitleId = "previewTitle",
    WidthClass = "max-w-3xl",
    ShowError = false,
    HeaderExtra = previewHeader,
    Body = previewBody
})" />

@{
    var modalBody = await Html.PartialAsync("_ModalFields");
}

<partial name="Ui/_Modal" model="@(new ModalModel {
    Title = L["Common_NewMaterial"],
    WidthClass = "max-w-lg",
    Body = modalBody
})" />
<partial name="Ui/_SortModal" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

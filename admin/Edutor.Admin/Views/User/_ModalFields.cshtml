@{
    var typeOptions = new List<SelectOption>
    {
        new() { Value = "teacher", Text = L["Role_Teacher"] },
        new() { Value = "student", Text = L["Role_Student"] },
        new() { Value = "admin", Text = L["Role_Admin"] }
    };
    if (User.IsInRole(AuthRoles.SuperAdmin))
    {
        typeOptions.Add(new() { Value = "superadmin", Text = L["Role_SuperAdmin"] });
    }
}
<form id="entityForm" class="space-y-4 p-6">
    <input type="hidden" id="entityId" />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "name", Id = "name", Label = L["Common_Name"] })" />
        <partial name="Ui/_Input" model="@(new InputModel { Name = "surname", Id = "surname", Label = L["User_Surname"] })" />
    </div>
    <partial name="Ui/_Input" model="@(new InputModel { Name = "email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />
    <partial name="Ui/_Input" model="@(new InputModel { Name = "phoneNumber", Id = "phoneNumber", Label = L["Common_Phone"] })" />
    <partial name="Ui/_Select" model="@(new SelectModel { Name = "type", Id = "type", Label = L["Common_Type"], Options = typeOptions })" />
    <div>
        <label for="password" class="mb-1 block text-sm font-medium text-slate-700">@L["Common_Password"]</label>
        <div class="relative">
            <input id="password" type="password" autocomplete="new-password" class="admin-field pr-24" />
            <div class="absolute inset-y-0 right-1.5 flex items-center gap-1">
                <button type="button" id="togglePassword" class="grid h-8 w-8 place-items-center rounded-lg text-slate-400 transition hover:bg-surface-secondary hover:text-slate-600" title="@L["User_ShowPassword"]" aria-label="@L["User_ShowPassword"]">
                    <svg class="password-eye h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    <svg class="password-eye-off hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m3 3 18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.9 5.2A10.5 10.5 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3 3.9M6.6 6.6C3.6 8.5 2 12 2 12s3.5 7 10 7a10 10 0 0 0 4.4-1" /></svg>
                </button>
                <button type="button" id="generatePassword" class="grid h-8 w-8 place-items-center rounded-lg text-slate-400 transition hover:bg-surface-secondary hover:text-primary" title="@L["User_GeneratePassword"]" aria-label="@L["User_GeneratePassword"]">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.7 15a7 7 0 0 0 12.6 1.4M18.3 9A7 7 0 0 0 5.7 7.6" /></svg>
                </button>
            </div>
        </div>
        <p id="passwordHint" class="mt-1 hidden text-xs text-slate-400">@L["User_PasswordHint"]</p>
    </div>
    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

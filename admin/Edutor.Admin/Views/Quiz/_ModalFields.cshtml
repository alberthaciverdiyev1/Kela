@{
    var lessons = (PagedResponse<LessonResponse>)ViewData["Lessons"]!;
    var subjects = (PagedResponse<SubjectResponse>)ViewData["Subjects"]!;
    var subjectNames = subjects.Data.ToDictionary(s => s.Id, s => s.Name);
    // Eyni adlı dərslər müxtəlif fənlərdə ola bilər — seçimdə fənn adı da yazılır.
    var lessonOptions = lessons.Data.Select(l => new SelectOption
    {
        Value = l.Id.ToString(),
        Text = subjectNames.TryGetValue(l.SubjectId, out var subjectName) ? $"{subjectName} — {l.Title}" : l.Title
    }).ToList();
    var subjectFilterOptions = new List<SelectOption> { new() { Value = "", Text = L["Common_All"] } };
    subjectFilterOptions.AddRange(subjects.Data.Select(s => new SelectOption { Value = s.Id.ToString(), Text = s.Name }));
    var typeOptions = new List<SelectOption> { new() { Value = "lesson", Text = L["Common_LessonExam"] }, new() { Value = "general", Text = L["Common_General"] } };
}
<partial name="Ui/_OptionMap" model="@(new OptionMapModel { Name = "LESSON_SUBJECTS", Items = lessons.Data.ToDictionary(l => l.Id, l => l.SubjectId.ToString()) })" />
<form id="entityForm" class="space-y-4 p-6">
    <input type="hidden" id="entityId" />
    <input type="hidden" id="sort_order" />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "subject_filter", Id = "subject_filter", Label = L["Common_Subject"], Options = subjectFilterOptions })" />
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "lesson_id", Id = "lesson_id", Label = L["Common_Lesson"], Required = true, Options = lessonOptions })" />
    </div>
    <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = L["Common_Title"], Required = true })" />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "duration_minutes", Id = "duration_minutes", Label = L["Quiz_DurationMin"], Type = "number", Min = "1", Step = "1", Value = "1", Required = true })" />
        <partial name="Ui/_Select" model="@(new SelectModel { Name = "type", Id = "type", Label = L["Common_Type"], Options = typeOptions })" />
    </div>
    <div class="flex flex-wrap gap-6">
        <partial name="Ui/_Switch" model="@(new SwitchModel { Name = "is_active", Id = "is_active", Label = L["Common_Active"], Checked = true })" />
        <partial name="Ui/_Switch" model="@(new SwitchModel { Name = "is_repeat", Id = "is_repeat", Label = L["Quiz_Repeat"], Checked = false })" />
    </div>
    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

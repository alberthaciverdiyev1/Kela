@model Edutor.Admin.Models.DashboardPageModel
@{
    ViewData["Title"] = L["Nav_Dashboard"];
    var stats = Model.Stats;
    var finance = Model.Finance;
    var first = Model.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.UserName;
    var activeRatio = stats.Students.Total == 0
        ? 0
        : (int)Math.Round(stats.Students.Active * 100.0 / stats.Students.Total);
    var perGroup = stats.Students.Groups == 0
        ? 0
        : (int)Math.Round(stats.Students.Total * 1.0 / stats.Students.Groups);

    var content = new (string Label, int Value)[]
    {
        (L["Nav_Subjects"], stats.Content.Subjects),
        (L["Nav_Lessons"], stats.Content.Lessons),
        (L["Nav_Materials"], stats.Content.Contents),
        (L["Dashboard_Videos"], stats.Content.Videos),
        (L["Dashboard_Files"], stats.Content.Files),
        (L["Dashboard_Voices"], stats.Content.Voices),
        (L["Nav_Exams"], stats.Content.Quizzes),
        (L["Common_Questions"], stats.Content.Questions),
    };
    var contentTones = new[] { "primary", "info", "violet", "warning", "primary", "info", "violet", "warning" };
    var contentChartJson = System.Text.Json.JsonSerializer.Serialize(
        content.Select((c, i) => new { label = c.Label, value = c.Value, tone = contentTones[i % contentTones.Length] }));

    var studentsJson = System.Text.Json.JsonSerializer.Serialize(new object[]
    {
        new { label = L["Common_Active"].Value, value = stats.Students.Active, tone = "primary" },
        new { label = L["Common_Inactive"].Value, value = Math.Max(0, stats.Students.Total - stats.Students.Active), tone = "slate" }
    });

    var topJson = System.Text.Json.JsonSerializer.Serialize(
        stats.TopSubjects.Select(x => new { label = x.Name, value = x.LessonCount, tone = "info" }));
}

<section class="admin-page space-y-5">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary to-primary-700 px-5 py-6 text-white shadow-sm sm:px-7">
        <div class="pointer-events-none absolute -right-14 -top-24 h-64 w-64 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-28 right-32 h-56 w-56 rounded-full bg-white/5"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-5">
            <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wider text-white/60">
                    @DateTime.Now.ToString("dddd, d MMMM yyyy")
                </p>
                <h1 class="mt-1 text-2xl font-extrabold tracking-tight">@L["Dashboard_Greeting"], @first</h1>
                <p class="mt-1 max-w-xl text-sm text-white/75">@L["Dashboard_Subtitle"]</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/group"
                   class="inline-flex h-10 items-center gap-2 rounded-xl bg-white/15 px-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/25">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
                    </svg>
                    @L["Dashboard_NewGroup"]
                </a>
                <a href="/students"
                   class="inline-flex h-10 items-center gap-2 rounded-xl bg-white/15 px-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/25">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
                    </svg>
                    @L["Dashboard_AddStudent"]
                </a>
                <a href="/homework"
                   class="inline-flex h-10 items-center gap-2 rounded-xl bg-white px-3.5 text-sm font-semibold text-primary-700 shadow-sm transition hover:bg-white/90">
                    @L["Nav_Homework"]
                </a>
                @if (finance is not null)
                {
                    <a href="/kassa"
                       class="inline-flex h-10 items-center gap-2 rounded-xl bg-white px-3.5 text-sm font-semibold text-primary-700 shadow-sm transition hover:bg-white/90">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                            <rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" d="M3 10h18m-4 5h2"/>
                        </svg>
                        @L["Dashboard_Finance"]
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Nav_Students"], Value = stats.Students.Total.ToString(),
            Accent = "bg-primary-light text-primary",
            Hint = string.Format(L["Dashboard_NewThisWeek"], stats.Students.New7d),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Dashboard_ActiveStudentCount"], Value = stats.Students.Active.ToString(),
            Accent = "bg-success-bg text-success",
            Hint = string.Format(L["Dashboard_ActiveRatio"], activeRatio),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='m5 13 4 4L19 7' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Nav_Groups"], Value = stats.Students.Groups.ToString(),
            Accent = "bg-violet-100 text-violet-600",
            Hint = string.Format(L["Dashboard_PerGroup"], perGroup),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Dashboard_AttendanceToday"],
            Value = $"{stats.Attendance.TodayPresent}/{stats.Attendance.TodayRecords}",
            Accent = "bg-sky-100 text-sky-600",
            Hint = stats.Attendance.TodayRecords == 0
                ? L["Dashboard_NoAttendance"].Value
                : string.Format(L["Dashboard_AttendanceRecords"], stats.Attendance.TodayRecords),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M8 4v3m8-3v3M4 9h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm3.5 9 1.5 1.5L13 13' />" })" />
    </div>

    @if (finance is not null)
    {
        var payload = new
        {
            currencies = finance.Currencies.Select(c => new
            {
                currency = c.Currency,
                today = c.Today,
                thisMonth = c.ThisMonth,
                expected = c.ExpectedThisMonth,
                lastMonth = c.LastMonth,
                projected = c.ProjectedNextMonth,
                overdue = c.OverdueAmount,
                activePlans = c.ActivePlans
            }),
            monthly = finance.Monthly.Select(m => new { period = m.Period, currency = m.Currency, amount = m.Amount })
        };

        <div class="grid gap-4 xl:grid-cols-3">
            <div class="admin-card p-5 xl:col-span-2">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h3 class="text-base font-bold text-slate-900">@L["Dashboard_Finance"]</h3>
                        <p class="mt-0.5 text-xs font-semibold text-slate-400">@L["Dashboard_Last12"]</p>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (finance.Currencies.Count > 1)
                        {
                            <select id="dashCurrency" class="admin-field !h-9 w-24">
                                @foreach (var code in finance.Currencies.Select(c => c.Currency))
                                {
                                    <option value="@code">@code</option>
                                }
                            </select>
                        }
                        <a href="/kassa" class="text-sm font-semibold text-primary hover:text-primary-700">@L["Dashboard_OpenKassa"] →</a>
                    </div>
                </div>

                <div class="mt-4 flex flex-wrap items-end gap-x-8 gap-y-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Dashboard_ThisMonth"]</p>
                        <p id="dashMonth" class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">—</p>
                        <p id="dashDelta" class="mt-1 text-xs font-semibold text-slate-400"></p>
                    </div>
                    <div class="grid flex-1 grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
                        @foreach (var cell in new (string Id, string Label, string Tone)[]
                        {
                            ("dashToday", L["Dashboard_Today"], "text-slate-900"),
                            ("dashExpected", L["Dashboard_Expected"], "text-slate-900"),
                            ("dashOverdue", L["Dashboard_Overdue"], "text-danger"),
                            ("dashProjected", L["Dashboard_Projected"], "text-primary")
                        })
                        {
                            <div>
                                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">@cell.Label</p>
                                <p id="@cell.Id" class="mt-0.5 text-sm font-extrabold @cell.Tone">—</p>
                            </div>
                        }
                    </div>
                </div>

                <div id="dashFinanceChart" class="mt-5 flex h-32 items-end gap-1.5"></div>
            </div>

            <div class="admin-card p-5">
                <h3 class="text-base font-bold text-slate-900">@L["Dashboard_PlanStatus"]</h3>
                <div class="mt-4 space-y-3">
                    @foreach (var row in new (string Label, int Value, string Tone)[]
                    {
                        (L["Dashboard_ActivePlans"], finance.ActivePlans, "text-slate-900"),
                        (L["Dashboard_Overdue"], finance.OverduePlans, "text-danger"),
                        (L["Dashboard_DueSoon"], finance.DueSoonPlans, "text-warning"),
                        (L["Dashboard_PayingStudents"], finance.PayingStudents, "text-primary")
                    })
                    {
                        <div class="flex items-center justify-between rounded-xl bg-surface-secondary px-3.5 py-2.5">
                            <span class="text-sm font-medium text-slate-600">@row.Label</span>
                            <span class="text-base font-extrabold @row.Tone">@row.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="grid gap-4 xl:grid-cols-3">
            <div class="admin-card xl:col-span-2">
                <div class="admin-toolbar flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-base font-bold text-slate-900">@L["Dashboard_RecentPayments"]</h3>
                    <a href="/kassa" class="text-sm font-semibold text-primary hover:text-primary-700">@L["Dashboard_SeeAll"] →</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>@L["Common_Date"]</th>
                                <th>@L["Nav_Students"]</th>
                                <th class="text-right">@L["Dashboard_Amount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in finance.Recent.Take(6))
                            {
                                <tr>
                                    <td class="whitespace-nowrap text-slate-500">@payment.PaidOn.ToString("dd.MM.yyyy")</td>
                                    <td class="font-semibold text-slate-800">@payment.StudentName</td>
                                    <td class="whitespace-nowrap text-right font-bold text-slate-900">
                                        @payment.Amount.ToString("N2") @payment.Currency
                                    </td>
                                </tr>
                            }
                            @if (finance.Recent.Count == 0)
                            {
                                <tr><td colspan="3" class="text-sm text-slate-400">@L["Dashboard_NoPayments"]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-card p-5">
                <h3 class="mb-4 text-base font-bold text-slate-900">@L["Dashboard_RecentStudents"]</h3>
                <ul class="space-y-3">
                    @foreach (var st in stats.RecentStudents)
                    {
                        <li class="flex items-center gap-3">
                            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-light text-xs font-bold uppercase text-primary">
                                @string.Concat(st.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]))
                            </span>
                            <span class="min-w-0 flex-1 truncate text-sm font-semibold text-slate-700">@st.FullName</span>
                            <span class="shrink-0 text-xs text-slate-400">@st.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </li>
                    }
                    @if (stats.RecentStudents.Count == 0)
                    {
                        <li class="text-sm text-slate-400">@L["Common_NoData"]</li>
                    }
                </ul>
            </div>
        </div>

        <script>window.DASH_FINANCE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(payload));</script>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <div class="admin-card p-5 lg:col-span-3">
                <h3 class="mb-2 text-base font-bold text-slate-900">@L["Dashboard_RecentStudents"]</h3>
                <ul class="divide-y divide-border text-sm">
                    @foreach (var st in stats.RecentStudents)
                    {
                        <li class="flex items-center justify-between py-3">
                            <span class="text-slate-700">@st.FullName</span>
                            <span class="text-slate-400">@st.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </li>
                    }
                    @if (stats.RecentStudents.Count == 0)
                    {
                        <li class="py-3 text-slate-400">@L["Common_NoData"]</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="grid gap-4 xl:grid-cols-3">
        <div class="admin-card p-5 xl:col-span-2">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Dashboard_Content"]</h3>
            <div class="space-y-3" data-chart="@contentChartJson"></div>
        </div>

        <div class="admin-card p-5">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Nav_Students"]</h3>
            <div class="flex flex-col items-center gap-4" data-chart="@studentsJson" data-chart-kind="donut"></div>
        </div>
    </div>

    <div class="grid gap-4 xl:grid-cols-3">
        <div class="admin-card p-5">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Dashboard_TopSubjects"]</h3>
            @if (stats.TopSubjects.Count > 0)
            {
                <div class="space-y-3" data-chart="@topJson"></div>
            }
            else
            {
                <p class="text-sm text-slate-400">@L["Js_Empty"]</p>
            }
        </div>

        <div class="grid gap-4 sm:grid-cols-2 xl:col-span-2">
            <partial name="Ui/_StatCard" model="@(new StatCardModel {
                Label = L["Dashboard_QuizAttempts"], Value = stats.Activity.QuizAttempts30d.ToString(),
                ValueClass = "text-primary", Compact = true })" />
            <partial name="Ui/_StatCard" model="@(new StatCardModel {
                Label = L["Dashboard_ActiveStudents"], Value = stats.Activity.StudentsAttempted30d.ToString(),
                ValueClass = "text-primary", Compact = true })" />
        </div>
    </div>
</section>

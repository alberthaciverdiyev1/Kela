@model Edutor.Admin.Models.PlatformDashboardModel
@using Edutor.Core.Modules.Subscription.Responses
@{
    ViewData["Title"] = L["Nav_Dashboard"];
    var f = Model.Finance;
    var first = Model.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.UserName;
    var totals = f.Currencies.FirstOrDefault();
    var growth = totals is null || totals.RevenueLastMonth <= 0
        ? (decimal?)null
        : Math.Round((totals.RevenueThisMonth - totals.RevenueLastMonth) / totals.RevenueLastMonth * 100, 0);
    var payload = new
    {
        currencies = f.Currencies.Select(c => new { currency = c.Currency, mrr = c.Mrr, arr = c.Arr,
            thisMonth = c.RevenueThisMonth, lastMonth = c.RevenueLastMonth, addons = c.AddonThisMonth,
            allTime = c.RevenueAllTime, paying = c.PayingTenants }),
        monthly = f.Monthly.Select(m => new { period = m.Period, currency = m.Currency, total = m.Total }),
        stats = new { total = f.TotalTenants, active = f.ActiveTenants, pending = f.PendingTenants },
        i18n = new { growth = L["Revenue_DeltaGrowth"].Value, noLastMonth = L["Revenue_NoLastMonth"].Value }
    };
    var planJson = System.Text.Json.JsonSerializer.Serialize(
        f.Plans.Where(p => p.Tenants > 0).Select(p => new { label = p.PlanName, value = p.Tenants, tone = "info" }));
}

<section class="admin-page space-y-5">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-navy to-slate-900 px-5 py-6 text-white shadow-sm sm:px-7">
        <div class="pointer-events-none absolute -right-14 -top-24 h-64 w-64 rounded-full bg-white/10"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-5">
            <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wider text-white/60">
                    @DateTime.Now.ToString("dddd, d MMMM yyyy")
                </p>
                <h1 class="mt-1 text-2xl font-extrabold tracking-tight">@L["Dashboard_Greeting"], @first</h1>
                <p class="mt-1 max-w-xl text-sm text-white/75">@L["Revenue_Subtitle"]</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/tenant" class="inline-flex h-10 items-center gap-2 rounded-xl bg-white/15 px-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/25">
                    @L["Nav_Tenants"]
                </a>
                <a href="/plan" class="inline-flex h-10 items-center gap-2 rounded-xl bg-white/15 px-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/25">
                    @L["Nav_Plans"]
                </a>
                <a href="/platform-finance" class="inline-flex h-10 items-center gap-2 rounded-xl bg-white px-3.5 text-sm font-semibold text-navy shadow-sm transition hover:bg-white/90">
                    @L["Nav_PlatformFinance"]
                </a>
            </div>
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Revenue_Mrr"], Value = totals is null ? "—" : $"{totals.Mrr:N2} {totals.Currency}",
            Accent = "bg-primary-light text-primary",
            Hint = totals is null ? null : string.Format(L["Revenue_PayingTenantsHint"], totals.PayingTenants),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M3 17l6-6 4 4 8-8M21 7v6h-6' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Revenue_ThisMonth"],
            Value = totals is null ? "—" : $"{totals.RevenueThisMonth:N2} {totals.Currency}",
            Accent = "bg-success-bg text-success",
            Hint = growth is null ? null : string.Format(L["Revenue_GrowthTop"], growth),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 3v18M17 8H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Revenue_ActiveTenants"], Value = $"{f.ActiveTenants}/{f.TotalTenants}",
            Accent = "bg-sky-100 text-sky-600",
            Hint = string.Format(L["Revenue_TotalTenantsHint"], f.TotalTenants),
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M14 21V9h4a2 2 0 0 1 2 2v10M2 21h20' />" })" />
        <partial name="Ui/_StatCard" model="@(new StatCardModel {
            Label = L["Revenue_PendingTenants"], Value = f.PendingTenants.ToString(),
            Accent = "bg-warning-bg text-warning",
            Icon = "<path stroke-linecap='round' stroke-linejoin='round' d='M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' />" })" />
    </div>

    <div class="grid gap-4 xl:grid-cols-3">
        <div class="admin-card p-5 xl:col-span-2">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">@L["Revenue_MonthlyChart"]</h3>
                    <p class="mt-0.5 text-xs font-semibold text-slate-400">@L["Revenue_SplitHint"]</p>
                </div>
                @if (f.Currencies.Count > 1)
                {
                    <select id="pfCurrency" class="admin-field !h-9 w-24">
                        @foreach (var currency in f.Currencies) { <option value="@currency.Currency">@currency.Currency</option> }
                    </select>
                }
            </div>
            <div id="pfChart" class="mt-5 flex h-40 items-end gap-1.5"></div>
            <p id="pfChartEmpty" class="mt-3 hidden text-sm text-slate-400">@L["Common_NoData"]</p>
        </div>

        <div class="admin-card p-5">
            <h3 class="mb-4 text-base font-bold text-slate-900">@L["Revenue_PlanDistribution"]</h3>
            <div class="space-y-3" data-chart="@planJson"></div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-toolbar flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-base font-bold text-slate-900">@L["Revenue_TenantRevenue"]</h3>
            <a href="/platform-finance" class="text-sm font-semibold text-primary hover:text-primary-700">@L["Dashboard_SeeAll"] →</a>
        </div>
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Revenue_Tenant"]</th>
                        <th>@L["Revenue_Plan"]</th>
                        <th class="text-right">@L["Revenue_MonthlyFee"]</th>
                        <th class="text-right">@L["Revenue_ThisMonth"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in f.Tenants.Take(6))
                    {
                        <tr>
                            <td class="font-semibold text-slate-800">@row.TenantName</td>
                            <td class="text-slate-600">@(row.PlanName ?? L["Revenue_NoPlan"].Value)</td>
                            <td class="whitespace-nowrap text-right text-slate-700">@row.MonthlyPrice.ToString("N2") @row.Currency</td>
                            <td class="whitespace-nowrap text-right font-bold text-slate-900">@row.RevenueThisMonth.ToString("N2") @row.Currency</td>
                        </tr>
                    }
                    @if (f.Tenants.Count == 0)
                    {
                        <tr><td colspan="4" class="text-sm text-slate-400">@L["Common_NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script>window.PLATFORM_FINANCE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(payload));</script>
</section>

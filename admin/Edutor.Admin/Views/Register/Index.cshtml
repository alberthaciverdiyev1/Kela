@{
    Layout = "_AuthLayout";
    ViewData["FullBleed"] = true;
    ViewData["Title"] = L["Tenant_RegisterTitle"];
    var success = ViewData["Success"] is true;
}
<div class="flex min-h-screen w-full items-center justify-center bg-surface-secondary px-4 py-10">
    <section class="w-full max-w-[45rem] rounded-2xl bg-white p-6 shadow-sm sm:p-8">
        @if (success)
        {
            <div class="py-4 text-center">
                <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-emerald-50 text-emerald-600">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                </span>
                <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900">@L["Tenant_RegisterSuccessTitle"]</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-500">@L["Tenant_RegisteredPending"]</p>
                <a href="/login" class="admin-button-primary mt-7 inline-flex w-full justify-center">@L["Tenant_RegisterBackToLogin"]</a>
            </div>
        }
        else
        {
            <div>
                <h1 class="text-2xl font-bold leading-tight text-slate-900">@L["Tenant_RegisterTitle"]</h1>
            </div>

            @if (ViewData["Error"] is string err)
            {
                <div class="mt-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
            }

            <form method="post" action="/register" enctype="multipart/form-data" class="mt-7 space-y-6"
                  data-register-form data-start-step="@(ViewData["Error"] is string ? "2" : "1")">
                @Html.AntiForgeryToken()

                <div data-register-step="1" class="space-y-5">
                    <div>
                        <p class="mb-2 text-sm font-semibold text-slate-600">@L["Tenant_AccountType"]</p>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="cursor-pointer">
                                <input type="radio" name="AccountType" value="course" class="peer sr-only" checked data-account-type />
                                <span class="flex h-full items-center gap-3 rounded-xl border border-border bg-surface-secondary p-3.5 transition peer-checked:border-primary peer-checked:bg-primary-light">
                                    <svg class="h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H11v15H6.5A2.5 2.5 0 0 0 4 19Zm16 0V6.5A2.5 2.5 0 0 0 17.5 4H13v15h4.5A2.5 2.5 0 0 1 20 19Z" /></svg>
                                    <span class="text-sm font-semibold text-slate-800">@L["Tenant_AccountTypeCourse"]</span>
                                </span>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="AccountType" value="teacher" class="peer sr-only" data-account-type />
                                <span class="flex h-full items-center gap-3 rounded-xl border border-border bg-surface-secondary p-3.5 transition peer-checked:border-primary peer-checked:bg-primary-light">
                                    <svg class="h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" /></svg>
                                    <span class="text-sm font-semibold text-slate-800">@L["Tenant_AccountTypeTeacher"]</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div id="courseBlock" class="space-y-4">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Tenant_RegisterSectionCourse"]</p>
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "CourseName", Id = "courseName", Label = L["Tenant_CourseName"], Required = true })" />
                        <div>
                            <p class="mb-1 block text-sm font-semibold text-slate-600">@L["Tenant_RegisterLogo"]</p>
                            <label for="logo" class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-surface-secondary px-3 py-3 text-sm font-medium text-slate-500 transition hover:border-primary hover:bg-primary-light hover:text-primary">
                                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0 4 4m-4-4L8 8M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                                <span id="logoName" class="truncate">@L["Common_ChooseFile"]</span>
                                <input id="logo" name="Logo" type="file" accept="image/png,image/jpeg,image/webp" class="hidden"
                                       data-logo-input data-empty="@L["Common_ChooseFile"]" />
                            </label>
                        </div>
                    </div>

                    <button type="button" class="admin-button-primary w-full" data-register-next>@L["Common_Next"]</button>
                </div>

                <div data-register-step="2" class="hidden space-y-5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@L["Tenant_RegisterSectionAdmin"]</p>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "AdminName", Id = "adminName", Label = L["Common_Name"], Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { Name = "AdminSurname", Id = "adminSurname", Label = L["Common_Surname"] })" />
                    </div>

                    <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Email", Id = "email", Label = L["Common_Email"], Type = "email", Required = true })" />

                    <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "PhoneNumber", Id = "phoneNumber", Label = L["Common_Phone"], Type = "tel", Required = true })" />

                    <div class="grid gap-4 sm:grid-cols-2">
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "Password", Id = "password", Label = L["Common_Password"], Type = "password", Required = true })" />
                        <partial name="Ui/_Input" model="@(new InputModel { NativeRequired = true, Name = "ConfirmPassword", Id = "confirmPassword", Label = L["Tenant_ConfirmPassword"], Type = "password", Required = true })" />
                    </div>

                    <label class="flex items-start gap-2.5 rounded-xl bg-surface-secondary px-3.5 py-3 text-sm text-slate-600">
                        <input type="checkbox" name="AcceptTerms" value="true" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-primary focus:ring-primary" />
                        <span>
                            @L["Tenant_AcceptTerms"]
                            <a href="/register/terms" target="_blank" class="font-semibold text-primary hover:underline">@L["Tenant_TermsLink"]</a>
                        </span>
                    </label>

                    <div class="hidden" aria-hidden="true">
                        <label>Website <input type="text" name="Website" tabindex="-1" autocomplete="off" /></label>
                    </div>

                    <div class="flex gap-3">
                        <button type="button" class="admin-button-primary w-1/3 bg-slate-200 text-slate-700 hover:bg-slate-300" data-register-back>@L["Common_Back"]</button>
                        <button type="submit" class="admin-button-primary flex-1">@L["Tenant_RegisterSubmit"]</button>
                    </div>
                </div>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                @L["Tenant_AlreadyHaveAccount"]
                <a href="/login" class="font-semibold text-primary hover:underline">@L["Common_SignIn"]</a>
            </p>
        }
    </section>
</div>

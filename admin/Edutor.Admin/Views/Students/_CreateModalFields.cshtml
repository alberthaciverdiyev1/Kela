@{
    var groups = ViewData["Groups"] as PagedResponse<Edutor.Core.Modules.Group.Responses.GroupResponse>;
    var groupOptions = new List<SelectOption> { new() { Value = "", Text = L["Common_None"] } };
    if (groups is not null)
    {
        groupOptions.AddRange(groups.Data.Select(g => new SelectOption { Value = g.Id.ToString(), Text = g.Name }));
    }
}
<form id="studentForm" class="space-y-4 p-6">
    <partial name="Ui/_Input" model="@(new InputModel { Name = "fullName", Id = "s_fullName", Label = L["Common_FullName"], Required = true })" />
    <partial name="Ui/_Input" model="@(new InputModel { Name = "email", Id = "s_email", Label = L["Common_Email"], Type = "email", Required = true })" />
    <partial name="Ui/_Input" model="@(new InputModel { Name = "phone", Id = "s_phone", Label = L["Common_Phone"] })" />
    <partial name="Ui/_Input" model="@(new InputModel { Name = "password", Id = "s_password", Label = L["Common_Password"], Placeholder = L["Students_PasswordOptional"] })" />
    <partial name="Ui/_Select" model="@(new SelectModel { Name = "group_id", Id = "s_group", Label = L["Common_Group"], Options = groupOptions })" />

    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Create"], Type = "submit" })" />
    </div>
</form>

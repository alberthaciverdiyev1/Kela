<form id="entityForm" class="space-y-4 p-6">
    <input type="hidden" id="entityId" />

    <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = L["Common_Title"], Required = true, Placeholder = L["Note_TitlePlaceholder"] })" />

    <div>
        <label for="body" class="mb-1 block text-sm font-semibold text-slate-600">@L["Note_Body"]</label>
        <textarea id="body" name="body" rows="4" maxlength="2000" class="admin-field"
                  placeholder="@L["Note_BodyPlaceholder"]"></textarea>
    </div>

    <partial name="Ui/_Input" model="@(new InputModel { Name = "date", Id = "date", Label = L["Note_Date"], Type = "date" })" />

    <div>
        <label for="contentId" class="mb-1 block text-sm font-semibold text-slate-600">@L["Note_Material"]</label>
        <input id="contentSearch" type="search" class="admin-field mb-2" placeholder="@L["Note_SearchMaterial"]"
               data-input-action="noteSearchContents" />
        <select id="contentId" name="contentId" class="admin-field">
            <option value="">@L["Note_NoMaterial"]</option>
        </select>
    </div>

    <div id="positionRow" class="hidden">
        <partial name="Ui/_Input" model="@(new InputModel { Name = "positionSeconds", Id = "positionSeconds", Label = L["Note_Position"], Type = "number", Min = "0" })" />
    </div>

    <div>
        <span class="mb-1 block text-sm font-semibold text-slate-600">@L["Note_Share"]</span>
        <div class="flex flex-wrap gap-2">
            <button type="button" id="btnPrivate" class="admin-button-secondary h-9 px-4"
                    data-action="noteSetVisibility" data-args='["private"]'>@L["Note_Private"]</button>
            <button type="button" id="btnShared" class="admin-button-secondary h-9 px-4"
                    data-action="noteSetVisibility" data-args='["shared"]'>@L["Note_Shared"]</button>
        </div>
        <input type="hidden" id="visibility" name="visibility" value="private" />
    </div>

    <div id="sharePanel" class="hidden space-y-2 rounded-xl border border-slate-200 p-3">
        <p class="text-sm font-semibold text-slate-600">@L["Note_ShareWith"]</p>
        <input id="userSearch" type="search" class="admin-field" placeholder="@L["Note_SearchUsers"]"
               data-input-action="noteSearchUsers" />
        <div id="userList" class="max-h-40 space-y-1 overflow-y-auto"></div>
    </div>

    <partial name="Ui/_Switch" model="@(new SwitchModel { Name = "isDone", Id = "isDone", Label = L["Note_Done"], Checked = false })" />

    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>

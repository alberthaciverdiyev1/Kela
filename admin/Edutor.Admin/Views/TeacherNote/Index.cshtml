@{
    ViewData["Title"] = L["Nav_Notes"];
}
<section class="admin-page">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <div class="relative w-full sm:ml-auto sm:w-72">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 10.5A6.5 6.5 0 1 1 4 10.5a6.5 6.5 0 0 1 13 0Z" />
            </svg>
            <input id="noteSearch" type="search" class="admin-field pl-9" placeholder="@L["Note_Search"]" />
        </div>
        <button type="button" id="noteNew" class="admin-button-primary shrink-0">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
            </svg>
            @L["Note_Create"]
        </button>
    </div>

    <div id="noteComposerWrap" class="admin-card hidden">
        <form id="noteComposer" class="space-y-4 p-5 sm:p-6">
            <div class="flex items-start gap-3">
                <input id="noteTitle" type="text" maxlength="190" placeholder="@L["Note_TitlePlaceholder"]"
                       class="admin-field flex-1 text-base font-semibold" />
                <button type="button" id="notePinToggle"
                        class="admin-button-secondary h-[46px] shrink-0 px-3"
                        data-action="TeacherNotes.toggleDraftPin" aria-pressed="false">
                    <svg id="notePinIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 3 21 9.5l-2 2-2.5-.5-4.4 4.4.9 3-1.5 1.5-4-4L3.9 21H3v-.9l5.1-5.1-4-4L5.5 9.5l3 .9L12.9 6l-.5-2.5 2-2Z" />
                    </svg>
                    <span id="notePinLabel">@L["Note_Pin"]</span>
                </button>
            </div>

            <partial name="Ui/_Editor" model="@(new EditorModel { Id = "noteBody", Name = "body", Label = L["Note_Body"], Placeholder = L["Note_BodyPlaceholder"] })" />

            <div class="flex flex-wrap items-center gap-3 border-t border-border pt-4">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-500">@L["Calendar_Color"]</span>
                    <div id="notePalette" class="flex flex-wrap items-center gap-1.5"></div>
                </div>

                <div class="ml-auto flex items-center gap-2">
                    <button type="button" class="admin-button-secondary" data-action="TeacherNotes.cancelComposer">@L["Common_Cancel"]</button>
                    <button type="submit" class="admin-button-primary">@L["Common_Save"]</button>
                </div>
            </div>
        </form>
    </div>

    <div id="noteBoard" class="space-y-6"></div>
</section>

<form id="antiforgery">@Html.AntiForgeryToken()</form>

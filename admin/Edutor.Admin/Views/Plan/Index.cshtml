@{
    ViewData["Title"] = L["Plan_Title"];
    var headerExtra = new Microsoft.AspNetCore.Html.HtmlString(
        $@"<button type=""button"" class=""admin-button-primary"" data-action=""PlanPage.create"">{L["Plan_New"]}</button>");
    var planModalBody = await Html.PartialAsync("_FormFields");
}

<section class="admin-page">
    <partial name="Ui/_PageHeader" model="@(new PageHeaderModel { Extra = headerExtra })" />

    <div class="admin-card">
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Plan_Column"]</th>
                        <th>@L["Plan_Price"]</th>
                        <th>@L["Plan_Trial"]</th>
                        <th>@L["Common_Student"]</th>
                        <th>@L["Common_Group"]</th>
                        <th>@L["Plan_VideoHoursMonth"]</th>
                        <th>@L["Subscription_Uploads"]</th>
                        <th>@L["Plan_Templates"]</th>
                        <th>@L["Common_Status"]</th>
                        <th class="text-right">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
    </div>
</section>

<partial name="Ui/_Modal" model="@(new ModalModel
{
    Id = "planModal",
    TitleId = "planTitle",
    Title = L["Plan_Column"],
    WidthClass = "max-w-3xl",
    ShowError = false,
    Body = planModalBody
})" />

<form id="antiforgery">@Html.AntiForgeryToken()</form>

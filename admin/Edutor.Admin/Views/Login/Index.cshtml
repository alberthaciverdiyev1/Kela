@{
    Layout = "_AuthLayout";
    ViewData["FullBleed"] = true;
    ViewData["Title"] = L["Login_Title"];
}
<div class="flex min-h-screen w-full items-center justify-center bg-surface-secondary px-4 py-8 font-sans text-slate-800">
    <section class="w-full max-w-[45rem] rounded-2xl bg-white p-6 shadow-sm sm:p-8">
        <div class="mx-auto w-full">
                <div class="mb-7">
                    <img src="~/img/logo.png" alt="Bubora" class="mb-4 h-12 w-auto mix-blend-multiply" />
                    <h1 class="text-2xl font-bold leading-tight text-slate-900">@L["Login_HeroTitle"]</h1>
                </div>

                @if (ViewData["Error"] is string err)
                {
                    <div class="mb-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
                }

                <form method="post" action="/login" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div class="space-y-[15px] border-t border-[#edf1ee] pt-5">
                        <div>
                            <label for="email" class="mb-[7px] block text-sm font-[750] text-[#071e27]">@L["Common_Email"]</label>
                            <div class="flex h-12 items-center gap-3 rounded-xl border border-border bg-white px-3 transition focus-within:border-primary">
                                <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 6 10 7 10-7" /></svg>
                                <input id="email" name="Email" type="email" required autocomplete="email" placeholder="@L["Login_EmailPlaceholder"]" class="w-full border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" />
                            </div>
                        </div>
                        <div>
                            <label for="password" class="mb-[7px] block text-sm font-[750] text-[#071e27]">@L["Common_Password"]</label>
                            <div class="flex h-12 items-center gap-3 rounded-xl border border-border bg-white px-3 transition focus-within:border-primary">
                                <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="12" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                                <input id="password" name="Password" type="password" required autocomplete="current-password" placeholder="@L["Login_PasswordPlaceholder"]" class="w-full border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" />
                                <button type="button" id="passwordToggle"
                                        data-show-label="@L["Login_ShowPassword"]"
                                        data-hide-label="@L["Login_HidePassword"]"
                                        aria-label="@L["Login_ShowPassword"]"
                                        class="flex shrink-0 border-0 bg-transparent p-[5px] text-[#7d8798] transition hover:text-[#0b8d48]">
                                    <svg id="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg id="eyeOff" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 3 21 21" /><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" /><path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c5.1 0 9 5 9 7a11.7 11.7 0 0 1-3.1 3.8" /><path d="M6.1 6.1C3.8 7.6 3 10 3 12c0 2 3.9 7 9 7 1.1 0 2.1-.2 3.1-.6" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="mt-1 h-[51px] w-full rounded-[26px] border-0 bg-gradient-to-r from-[#128c4b] to-[#0b8d48] text-base font-[750] text-white shadow-[0_10px_18px_#0b8d4814] transition hover:brightness-95">@L["Common_SignIn"]</button>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    @L["Login_NoAccount"]
                    <a href="/register" class="font-semibold text-primary hover:underline">@L["Tenant_Register"]</a>
                </p>
        </div>
    </section>
</div>

@using Edutor.Core.Modules.Tenant.Responses
@{
    Layout = "_AuthLayout";
    ViewData["FullBleed"] = true;
    ViewData["Title"] = L["Login_Title"];
    var tenantList = ViewData["Tenants"] as IReadOnlyList<TenantResponse> ?? new List<TenantResponse>();
}
<div class="flex min-h-screen w-full items-center justify-center bg-surface-secondary px-4 py-8 font-sans text-slate-800">
    <section class="w-full max-w-[45rem] rounded-2xl bg-white p-6 shadow-sm sm:p-8">
        <div class="mx-auto w-full">
                <div class="mb-7">
                    <p class="text-sm font-semibold text-primary">Edutor</p>
                    <h1 class="mt-1.5 text-2xl font-bold leading-tight text-slate-900">@L["Login_HeroTitle"]</h1>
                    <p class="mt-2 text-sm leading-relaxed text-slate-500">@L["Login_Subtitle"]</p>
                </div>

                @if (ViewData["Error"] is string err)
                {
                    <div class="mb-5 rounded-xl border border-red-100 bg-red-50 px-3.5 py-3 text-sm font-medium text-red-600">@err</div>
                }

                <form method="post" action="/login" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <fieldset aria-labelledby="tenantLegend">
                        <legend id="tenantLegend" class="mb-2 block text-sm font-semibold text-slate-700">@L["Common_Tenant"]</legend>

                        @* 2 sətir × 5 kart — ilk 10 tenant. *@
                        <div class="mr-[-20px] flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:mr-0 lg:flex-wrap lg:overflow-visible">
                            @foreach (var t in tenantList.Take(10))
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="peer sr-only" required />
                                    <span class="flex h-20 w-[76px] shrink-0 flex-col items-center justify-center gap-[7px] rounded-[17px] border border-[#f0f1f2] bg-[#f9fafb] px-1 text-center text-[#101e27] transition peer-checked:border-[#098849] peer-checked:bg-[#effaf1] peer-checked:text-[#087e42]">
                                        @if (!string.IsNullOrWhiteSpace(t.Logo))
                                        {
                                            <img src="@t.Logo" alt="" class="h-[38px] w-[38px] rounded-xl object-cover" />
                                        }
                                        else
                                        {
                                            <span class="grid h-[38px] w-[38px] place-items-center rounded-xl bg-[#e8f0eb] text-sm font-bold text-[#27815e]">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                                        }
                                        <span class="w-full truncate text-[10px] font-medium">@t.Name</span>
                                    </span>
                                </label>
                            }
                        </div>

                        @* İlk 10-dan sonrakı müəssisələr modalda; seçim üçün gizli radio. *@
                        @foreach (var t in tenantList.Skip(10))
                        {
                            <input type="radio" name="TenantId" value="@t.Id" data-name="@t.Name" class="hidden" required />
                        }

                        <button type="button" id="tenantSeeAll"
                                class="mt-2 flex w-full items-center justify-center gap-1.5 rounded-xl border border-[#e2e8e4] bg-white px-4 py-2.5 text-sm font-semibold text-[#27815e] transition hover:bg-[#f5faf7]">
                            @L["Login_SeeAll"]
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                        </button>

                        <p id="tenantPicked" class="mt-2 hidden text-xs font-semibold text-primary"></p>
                        @if (tenantList.Count == 0)
                        {
                            <p class="mt-2 text-sm text-slate-400">@L["Js_Empty"]</p>
                        }
                    </fieldset>

                    <div class="space-y-[15px] border-t border-[#edf1ee] pt-5">
                        <div>
                            <label for="email" class="mb-[7px] block text-sm font-[750] text-[#071e27]">@L["Common_Email"]</label>
                            <div class="flex h-12 items-center gap-3 rounded-xl border border-border bg-white px-3 transition focus-within:border-primary">
                                <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 6 10 7 10-7" /></svg>
                                <input id="email" name="Email" type="email" required autocomplete="email" class="w-full border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" />
                            </div>
                        </div>
                        <div>
                            <label for="password" class="mb-[7px] block text-sm font-[750] text-[#071e27]">@L["Common_Password"]</label>
                            <div class="flex h-12 items-center gap-3 rounded-xl border border-border bg-white px-3 transition focus-within:border-primary">
                                <svg class="shrink-0 text-[#7d8798]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="12" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                                <input id="password" name="Password" type="password" required autocomplete="current-password" class="w-full border-0 bg-transparent text-sm text-[#10232c] outline-none placeholder:text-[#a0a8b7]" />
                                <button type="button" id="passwordToggle"
                                        data-show-label="@L["Login_ShowPassword"]"
                                        data-hide-label="@L["Login_HidePassword"]"
                                        aria-label="@L["Login_ShowPassword"]"
                                        class="flex shrink-0 border-0 bg-transparent p-[5px] text-[#7d8798] transition hover:text-[#0b8d48]">
                                    <svg id="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg id="eyeOff" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 3 21 21" /><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" /><path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c5.1 0 9 5 9 7a11.7 11.7 0 0 1-3.1 3.8" /><path d="M6.1 6.1C3.8 7.6 3 10 3 12c0 2 3.9 7 9 7 1.1 0 2.1-.2 3.1-.6" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="mt-1 h-[51px] w-full rounded-[26px] border-0 bg-gradient-to-r from-[#128c4b] to-[#0b8d48] text-base font-[750] text-white shadow-[0_10px_18px_#0b8d4814] transition hover:brightness-95">@L["Common_SignIn"]</button>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    @L["Login_NoAccount"]
                    <a href="/register" class="font-semibold text-primary hover:underline">@L["Tenant_Register"]</a>
                </p>
        </div>
    </section>
</div>

@* Bütün müəssisələr axtarışlı modalda göstərilir. *@
<div id="tenantModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
    <div class="flex max-h-[80vh] w-full max-w-md flex-col rounded-2xl bg-white p-5 shadow-xl">
        <div class="mb-3 flex items-center justify-between">
            <strong class="text-base text-slate-900">@L["Login_SelectCourse"]</strong>
            <button type="button" id="tenantModalClose" aria-label="@L["Common_Close"]" class="text-2xl leading-none text-slate-400 transition hover:text-slate-700">&times;</button>
        </div>
        <input id="tenantSearch" type="search" placeholder="@L["Login_SearchCourse"]" class="admin-field mb-3" autocomplete="off" />
        <div id="tenantModalList" class="flex-1 space-y-1 overflow-auto">
            @foreach (var t in tenantList)
            {
                <button type="button" data-tenant-id="@t.Id" data-tenant-name="@t.Name"
                        class="tenant-option flex w-full items-center gap-3 rounded-xl border border-transparent px-2 py-2.5 text-left text-slate-700 transition hover:bg-slate-50">
                    @if (!string.IsNullOrWhiteSpace(t.Logo))
                    {
                        <img src="@t.Logo" alt="" class="h-8 w-8 shrink-0 rounded-full object-cover" />
                    }
                    else
                    {
                        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-bold text-primary">@(string.IsNullOrWhiteSpace(t.Name) ? "?" : t.Name.Trim()[..1].ToUpper())</span>
                    }
                    <span class="truncate text-sm font-medium">@t.Name</span>
                </button>
            }
        </div>
    </div>
</div>

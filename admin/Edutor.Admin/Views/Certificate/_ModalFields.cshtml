@using Edutor.Core.Modules.Certificate
@{
    var templates = (IReadOnlyList<CertificateTemplate>)(ViewData["Templates"] ?? CertificateTemplates.All);
}
<form id="entityForm" class="space-y-4 p-6">
    <input type="hidden" id="entityId" />

    <partial name="Ui/_Input" model="@(new InputModel { Name = "title", Id = "title", Label = L["Common_Title"], Required = true, Placeholder = L["Certificate_TitlePlaceholder"] })" />

    <div>
        <label class="mb-2 block text-sm font-semibold text-slate-600">@L["Certificate_Template"]</label>
        <input type="hidden" id="templateKey" name="templateKey" value="@(templates.Count > 0 ? templates[0].Key : "")" />
        <div id="templateGrid" class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            @foreach (var t in templates)
            {
                <button type="button" data-key="@t.Key" data-action="selectTemplate" data-args="@($"[\"{t.Key}\"]")"
                        class="overflow-hidden rounded-xl border-2 border-slate-200 bg-white p-1.5 text-center transition hover:border-primary">
                    <img src="/certificate-templates/previews/@(t.Key).png" alt="@t.Name"
                         class="aspect-[4/3] w-full rounded-lg bg-slate-100 object-cover"
                         data-img-error="templateFallback" />
                    <span class="tmpl-fallback hidden aspect-[4/3] w-full items-center justify-center rounded-lg bg-slate-100 text-xs font-semibold text-slate-400">@t.Name</span>
                    <span class="mt-1.5 block text-xs font-semibold text-slate-600">@t.Name</span>
                </button>
            }
        </div>
    </div>

    <div>
        <label for="bodyText" class="mb-1 block text-sm font-semibold text-slate-600">@L["Common_Text"]</label>
        <textarea id="bodyText" name="bodyText" rows="4" class="admin-field"
                  placeholder="A certificate is awarded to an individual who has attained a specific accomplishment or achievement..."></textarea>
    </div>

    <partial name="Ui/_FileUpload" model="@(new FileUploadModel { Name = "signature", Id = "signature", Label = L["Certificate_SignaturePng"], Accept = ".png", Hint = "png, max 5MB" })" />

    <div class="flex justify-end gap-3 pt-2">
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Cancel"], Variant = "secondary", Dismiss = true })" />
        <partial name="Ui/_Button" model="@(new ButtonModel { Text = L["Common_Save"], Type = "submit" })" />
    </div>
</form>
